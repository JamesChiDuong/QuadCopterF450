#ifndef  __print_driver_h__
#define  __print_driver_h__
//============================================================================//
// Includes
//============================================================================//
//#include "stm32f10x.h"
#include "stm32fxxx_hal_user.h"
#include "Default.h"
#include "base_typedef.h"
//============================================================================//
#define  print_line_range_max        ((uchar)48)        //一行打印範圍
#define  print_col_range_max         ((uchar)16)        //一列打印範圍

//*****************************************************************************
//*****************************************************************************
//-----------                    宏定義設置                   -----------------
//-----------                    條件編譯開關                 -----------------
//-----------------------------------------------------------------------------
#define    moto_print_step_cyc_volue   ((uchar)4)       //電機打印一行的步進數
#define    moto_noload_step_cyc_volue  ((uchar)100)     //電機走紙步進數

#define    print_task_cnt_cycle         ((uchar)16)     //打印任務週期

//#define    print_pixel_amp_en                           //像素點寬度放大兩倍使能
//******************************************************//
//******************************************************//

typedef struct
{
	void (*prt_mb_set)(BIT_ENUM s);    //步進電機B端端口控制   TRUE高電平  FALSE低電平
	void (*prt_mnb_set)(BIT_ENUM s);   //步進電機NB端端口控制  TRUE高電平  FALSE低電平
	void (*prt_ma_set)(BIT_ENUM s);    //步進電機A端端口控制   TRUE高電平  FALSE低電平
	void (*prt_mna_set)(BIT_ENUM s);   //步進電機NA端端口控制  TRUE高電平  FALSE低電平

	void (*prt_di_set)(BIT_ENUM s);    //打印機di端口控制    TRUE高電平  FALSE低電平
	void (*prt_clk_set)(BIT_ENUM s);   //打印機clk端口控制   TRUE高電平  FALSE低電平
	void (*prt_lat_set)(BIT_ENUM s);   //打印機lat端口控制   TRUE高電平  FALSE低電平

	void (*prt_heat_set)(BIT_ENUM s);  //打印機加熱端口控制   TRUE使能   FALSE禁止 (外部控制為高電平即可使能)

	//void (*prt_font)(uint addr, uchar *dst);
	//參數addr指待查的字符的地址(編碼)
	//參數*dst是指定查找到點陣信息後將結果放到該緩衝器中
}
PRINT_DRIVER_S;


void print_data_init(PRINT_DRIVER_S * src);
//參數初始化

void print_driver_init(uint sp);
//驅動初始化
//參數SP為打印速度設置    取值範圍(50-1200)，最好不要用臨界值

BIT_ENUM print_read_state(void);
//讀取打印狀態
//函數返回值      TRUE表示忙狀態      FALSE表示空閒狀態
//若打印機正在忙，則不會響應其他命令

BIT_ENUM print_base_task_hdl(void);
//打印任務調度處理
//開始打印時，調用該函數，該函數的調用頻率為5KHz，週期為200微秒
//用定時器中斷來做，精確控制步進電機
//函數返回值    TRUE表示正在運行    FALSE表示該次運行週期結束

BIT_ENUM print_move_paper_config(void);
//配置打印機走紙
//函數返回值返回設置走紙任務是否成功  TRUE設置成成功  FALSE設置失敗(忙狀態造成)

BIT_ENUM print_one_line(uchar x, uint lgth, uchar *s_buff, uint *cnt);
//打印一行字符
//參數x為行打印的起始地址，取值範圍為0-47，總打印的範圍單行為48個字符或24個漢字
//參數lgth為待打印字符計數
//參數s_buff為待打印的字符編碼
//參數cnt返回還剩下待打印的字節個數
//函數返回值返回本次操作命令是否被執行  TRUE成功  FALSE失敗(忙狀態造成)
//
//注意:本行實際打印的字節數可以是因為回車換行符或者是超過了打印範圍
//注意:換行必須同時出現回車換行符，否則視為字符處理
//============================================================================//
#endif //__print_driver_h__
