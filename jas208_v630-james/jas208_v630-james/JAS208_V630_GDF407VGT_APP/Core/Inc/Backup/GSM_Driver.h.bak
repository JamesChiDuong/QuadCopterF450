// GSM events
typedef enum
{
	GSM_EVENT_NULL = 0,

	GSM_EVENT_INIT,

	GSM_EVENT_PROCESS,


	GSM_EVENT_ME_FUNC_READY,

	GSM_EVENT_SIM_READY,

	GSM_EVENT_SIM_NOT_READY,
	
	GSM_EVENT_SIM_NOT_INSERTED,

	GSM_EVENT_QUSIM_OK,

	GSM_EVENT_SMS_READY,

	GSM_EVENT_PHONEBOOK_READY,
	
	GSM_EVENT_POWERED_DOWN,


	GSM_EVENT_RECV_MSG,

	GSM_EVENT_RECV_CALL,

	GSM_EVENT_RECV_PACKET,

	GSM_EVENT_CONN_CLOSED,

	GSM_EVENT_PDP_DEACT,

	GSM_EVENT_NO_CARRIER,


	GSM_EVENT_SENDSMS_SUCCESS,

	GSM_EVENT_SENDSMS_ERROR,

	GSM_EVENT_SENDSMS_NO_RESPONSE,


	GSM_EVENT_OPEN_SUCCESS,

	GSM_EVENT_OPEN_ERROR,

	GSM_EVENT_OPEN_NO_RESPONSE,


	GSM_EVENT_CLOSE_SUCCESS,

	GSM_EVENT_CLOSE_ERROR,

	GSM_EVENT_CLOSE_NO_RESPONSE,


	GSM_EVENT_LOGIN_SUCCESS,

	GSM_EVENT_LOGIN_ERROR,

	GSM_EVENT_LOGIN_NO_RESPONSE,


	GSM_EVENT_SETDIR_SUCCESS,

	GSM_EVENT_SETDIR_ERROR,

	GSM_EVENT_SETDIR_NO_RESPONSE,


  GSM_EVENT_UPLOAD_SUCCESS,
	
	GSM_EVENT_UPLOAD_ERROR,
	
	GSM_EVENT_UPLOAD_NO_RESPONSE,
	

	GSM_EVENT_DOWNLOAD_CONNECT,

	GSM_EVENT_DOWNLOAD_SUCCESS,

	GSM_EVENT_DOWNLOAD_ERROR,

	GSM_EVENT_DOWNLOAD_NO_RESPONSE,


	GSM_EVENT_GETSIZE_SUCCESS,

	GSM_EVENT_GETSIZE_ERROR,

	GSM_EVENT_GETSIZE_NO_RESPONSE,


	GSM_EVENT_GETDATE_SUCCESS,

	GSM_EVENT_GETDATE_ERROR,

	GSM_EVENT_GETDATE_NO_RESPONSE,


	GSM_EVENT_TRANSLEN_SUCCESS,

	GSM_EVENT_TRANSLEN_ERROR,

	GSM_EVENT_TRANSLEN_NO_RESPONSE,
	
	
	GSM_EVENT_FILEDEL_SUCCESS,

	GSM_EVENT_FILEDEL_ERROR,

	GSM_EVENT_FILEDEL_NO_RESPONSE,
	

	GSM_EVENT_LOGOUT_SUCCESS,

	GSM_EVENT_LOGOUT_ERROR,

	GSM_EVENT_LOGOUT_NO_RESPONSE

} GSM_EventTypeDef;

// GSM command packet source
typedef enum
{
	GSM_CMD_SRC_NULL = 0U,

	GSM_CMD_SRC_SMS,

	GSM_CMD_SRC_TCP_1,

  #if ENABLE_MULTI_SERVER
	GSM_CMD_SRC_TCP_2
  #endif

} GSM_CmdSrcTypeDef;

// GSM FTP function result
typedef enum 
{
  GSM_FTP_OK = 0U,
	
	GSM_FTP_NET_ERR,
	
	GSM_FTP_OTHER_ERR,
	
	GSM_FTP_FINISH
	
} GSM_FTP_ResTypeDef;

// Message command components
#pragma pack(1)
typedef struct
{
	char *pcShort;

	char *pcSET;

} MsgCmdTypeDef;
#pragma pack()
#endif


