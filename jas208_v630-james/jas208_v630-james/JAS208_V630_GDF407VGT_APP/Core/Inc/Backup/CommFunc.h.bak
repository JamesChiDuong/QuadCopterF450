#ifndef _COMM_FUNC_H_
#define _COMM_FUNC_H_
//============================================================================//


//============================================================================//
// User Includes
//============================================================================//

#include "stm32fxxx_hal_user.h"
#include "DataType.h"


//============================================================================//
// User Defines
//============================================================================//

#define PI						              3.14159265358979323e0

// radius(®|«×) = PI/180
#define radius					            1.74532925199432957e-002

// radian(©·«× or Ñy«×) = 180/PI
#define radian					            5.72957795130823208e1

#define EarthRadius				          6378137ul

#define mS_2_uS(mS)				          ((mS) * 1000) // Millisecond to microsecond

#define mS_2_S(mS)				          ((mS) / 1000) // Millisecond to second

#define mS_2_Hz(mS)				          ((float)1000 / (mS)) // Millisecond to Hertz

#define S_2_mS(S)				            ((S) * 1000) // Second to millisecond

#define S_2_uS(S)				            ((S) * 1000000) // Second to micro second

#define S_2_MIN(S)				          ((S) / 60) // Second to minute

#define S_2_HOUR(S)				          ((S) / 3600) // Second to hour

#define S_2_DAY(S)				          ((S) / 86400) // Second to day

#define MINUTE_2_SECOND(MIN)	      ((MIN) * 60) // Minute to second

#define HOUR_2_SECOND(HOUR)		      ((HOUR) * 3600) // Hour to second

#define DAY_2_SECOND(DAY)		        ((DAY) * 86400) // Day to second

#define KM_2_MILES(KM)			        ((KM) * 0.621371) // Kilometre to mile

#define KM_2_M(KM)				          ((KM) * 1000) // Kilometre to metre

#define KM_2_CM(KM)				          ((KM) * 100000) // Kilometre to centimetre

#define KM_2_MM(KM)				          ((KM) * 1000000) // Kilometre to millimetre

#define MILES_2_KM(MI)			        ((MI) * 1.609344) // Mile to kilometre

#define KNOT_2_M(KNOT)			        ((KNOT) * 1852) // Knot to metre

#define M_2_KNOT(M)				          ((M) * 0.00053995) // Metre to knot

#define M_2_100M(M)				          ((M) / 100) // Metre to 100 metres

#define M_2_FT(M)				            ((M) * 3.280840) // Metre to foot

#define M_2_10M(M)				          ((M) / 10) // Metre to 10 metre

#define M_2_HM(M)				            ((M) / 100) // Metre to 100 metres

#define M_4_100M(M)				          ((M) * 100) // Metre for 100 metre

#define HM_2_M(HM)				          ((HM) * 100) // 100 metres to metre

#define M_2_KM(M)				            ((M) / 1000) // Metre to kilometre

#define M_2_CM(M)				            ((M) * 100) // Metre to centimetre

#define M_2_MM(M)				            ((M) * 1000) // Metre to millimetre

#define MM_2_M(MM)				          ((MM) / 1000) // Millimetre to metre

#define CRC8_RESET_VAL              (0x00) // CRC8 reset value

#define CRC16_RESET_VAL             (0x0000) // CRC16 reset value

#define CRC32_RESET_VAL             (0x00000000) // CRC32 reset value

// Calculate CRC32 value
#define CALC_CRC32(CRC32, INPUT) \
        CRC32 = ((CRC32) >> 8) ^ u32CRC32_TABLE[(INPUT) ^ ((CRC32) & 0x000000FF)]
				
#define FUNC_SKIP_NUM_MAX           5U // Maximum number of functions allowed to be skipped

#define FUNC_SKIP_TIMEOUT_MAX       3600U // Maximum function skip time out, 1 hour


