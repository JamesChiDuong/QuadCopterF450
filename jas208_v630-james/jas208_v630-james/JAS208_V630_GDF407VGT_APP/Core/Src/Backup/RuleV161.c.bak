				//}
				procSD_1M_Step = PROC_STEP_6;

				break;
			}

		// Step 6: Write data to file DETAIL_SPEED_DAY
		case PROC_STEP_6:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	sd1MinBuf.u16Index = 0;

				//	bRes = SD_WriteBuffToAddr(FILENAME_DETAILSPEED_DAY_TMP, u8DetailSpeed.u8DateBCD, DATELENS,
