				procSD_1M_Step = PROC_STEP_16;

				break;
			}

		// Step 16: Change PositionData.u8Index
		case PROC_STEP_16:
			{
				if(PositionData.u8Index >= 59)
				{
					PositionData.u8Index = 0;

					LOGprintf("\r\n> ### 1Hr PosData ###");
				}
				else
				{
					PositionData.u8Index++;
				}

				memset(&stRecDriving, 0x00, sizeof(DriveDataTypeDef));

				stRecDriving.u8DriveCode = g_Setting.u8DrvStatus;

				memset(stRecDriving.u8DriverName, '\0', sizeof(stRecDriving.u8DriverName));

				memcpy(stRecDriving.u8DriverName, &g_Setting.u32DrvIdNum, 4);

				memcpy(stRecDriving.u8DriveDateBCD, u8SpeedDateBCD, 7);

				bIsDrv1 = TRUE;

				procSD_1M_Step = PROC_STEP_17;

				break;
			}

		// Step 17: Get file DRIVE index
		case PROC_STEP_17:
			{
				u8BufIdx = SD_RECORD_DRIVE_QUEUE_MAX;

				for(int i = 0; i < SD_RECORD_DRIVE_QUEUE_MAX; i++)
				{
					if(sd1MinBuf.bRequest[i] == FALSE)
					{
						u8BufIdx = i;

						break;
					}
				}

				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					#if !ENABLE_INDEX_BUFFER
					bRes = SD_ReadFileToBuff(FILENAME_DRIVE_TMP, (uint8_t *)&stRecDriving.u16BlockIndex, HEADLENS);

					if(!bRes)
					{
						u8SD_1MinRetryCnt++;

						if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
						{
							LOGprintf("\r\n> SD 1 min get file %s index FAIL.", FILENAME_DRIVE_TMP);

							u8SD_1MinRetryCnt = 0;

							procSD_1M_Step = PROC_STEP_20;

							break;
						}

						procSD_1M_Step = PROC_STEP_17;

						break;
					}
					#else
					V161_GetFileIdx(FILENAME_DRIVE_TMP, &stRecDriving.u16BlockIndex);
					#endif

					stRecDriving.u16BlockIndex++;

					u8SD_1MinRetryCnt = 0;

					procSD_1M_Step = PROC_STEP_18;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_RECORD_DRIVE_QUEUE_MAX)
					{
						procSD_1M_Step = PROC_STEP_NULL;

						break;
					}

					stRecDriving.u16BlockIndex = u16DrvIdx;

					stRecDriving.u16BlockIndex++;

					procSD_1M_Step = PROC_STEP_18;
				}

				break;
			}

		// Step 18: Write new index to file DRIVE
		case PROC_STEP_18:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					sdRecDrvBuf.u16DrvBlockIndex = 0;

					#if !ENABLE_INDEX_BUFFER
					bRes = SD_WriteBuffToFile(FILENAME_DRIVE_TMP, (uint8_t *)&stRecDriving.u16BlockIndex, HEADLENS);

					if(!bRes)
					{
						u8SD_1MinRetryCnt++;

						if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
						{
							LOGprintf("\r\n> SD 1 min write new index %d to file %s FAIL.",
							           stRecDriving.u16BlockIndex, FILENAME_DRIVE_TMP);

							u8SD_1MinRetryCnt = 0;

							procSD_1M_Step = PROC_STEP_20;

							break;
						}

						procSD_1M_Step = PROC_STEP_18;

						break;
					}
					#else
					V161_SaveFileIdx(FILENAME_DRIVE_TMP, stRecDriving.u16BlockIndex);
					#endif

					u8SD_1MinRetryCnt = 0;

					u16DrvIdx = stRecDriving.u16BlockIndex;

					procSD_1M_Step = PROC_STEP_19;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_RECORD_DRIVE_QUEUE_MAX)
					{
						procSD_1M_Step = PROC_STEP_NULL;

						break;
					}

					u16DrvIdx = stRecDriving.u16BlockIndex;

					sdRecDrvBuf.u16DrvBlockIndex = stRecDriving.u16BlockIndex;

					bSD_SaveDatRequest = TRUE;

					procSD_1M_Step = PROC_STEP_19;
				}

				break;
			}

		// Step 19: Write data to file DRIVE
		case PROC_STEP_19:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					sdRecDrvBuf.u16DrvBlockIndex = 0;

					bRes = SD_WriteBuffToAddr(FILENAME_DRIVE_TMP, (uint8_t *)&stRecDriving.u8DriverName, DRIVINGLENS,
					                          HEADLENS + ((stRecDriving.u16BlockIndex - 1) * DRIVINGLENS));

					if(!bRes)
					{
						u8SD_1MinRetryCnt++;

						if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
						{
							LOGprintf("\r\n> SD 1 min write data to file %s FAIL.", FILENAME_DRIVE_TMP);

							u8SD_1MinRetryCnt = 0;

							procSD_1M_Step = PROC_STEP_20;

							break;
						}

						procSD_1M_Step = PROC_STEP_19;

						break;
					}

					u8SD_1MinRetryCnt = 0;

					procSD_1M_Step = PROC_STEP_20;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_RECORD_DRIVE_QUEUE_MAX)
					{
						procSD_1M_Step = PROC_STEP_NULL;

						break;
					}

					snprintf((char *)sdRecDrvBuf.u8Data[u8BufIdx], DRIVINGLENS, "%s", (char *)&stRecDriving.u8DriverName);

					sdRecDrvBuf.u32DriveAddr[u8BufIdx] = HEADLENS + ((stRecDriving.u16BlockIndex - 1) * DRIVINGLENS);

					sdRecDrvBuf.u16DrvBlockIndex = stRecDriving.u16BlockIndex;

					sdRecDrvBuf.bRequest[u8BufIdx] = TRUE;

					bSD_SaveDatRequest = TRUE;

					procSD_1M_Step = PROC_STEP_20;
				}

				break;
			}

		// Step 20: Get file DRIVE_DAY index
		case PROC_STEP_20:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	#if !ENABLE_INDEX_BUFFER
				//	bRes = SD_ReadFileToBuff(FILENAME_DRIVE_DAY_TMP, (uint8_t *)&u16DriveActCntDay, HEADLENS);

				//	if(!bRes)
				//	{
				//		u8SD_1MinRetryCnt++;

				//		if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
				//		{
				//			LOGprintf("\r\n> SD 1 min get file %s index FAIL.", FILENAME_DRIVE_DAY_TMP);

				//			u8SD_1MinRetryCnt = 0;

				//			procSD_1M_Step = PROC_STEP_23;

				//			break;
				//		}

				//		procSD_1M_Step = PROC_STEP_20;

				//		break;
				//	}
				//	#else
				//	V161_GetFileIdx(FILENAME_DRIVE_DAY_TMP, &u16DriveActCntDay);
				//	#endif

				//	u8SD_1MinRetryCnt = 0;

				//	u16DriveActCntDay++;

				//	procSD_1M_Step = PROC_STEP_21;
				//}
				// If make VDR file then write to SD buffer
				//else
				//{
				//	if(u8BufIdx == SD_RECORD_DRIVE_QUEUE_MAX)
				//	{
				//		procSD_1M_Step = PROC_STEP_NULL;

				//		break;
				//	}

				//	procSD_1M_Step = PROC_STEP_21;
				//}

        procSD_1M_Step = PROC_STEP_21;

				break;
			}

		// Step 21: Write new index to file DRIVE_DAY
		case PROC_STEP_21:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	sdRecDrvBuf.u16DriveActCntDay = 0;

				//	#if !ENABLE_INDEX_BUFFER
				//	bRes = SD_WriteBuffToFile(FILENAME_DRIVE_DAY_TMP, (uint8_t *)&u16DriveActCntDay, HEADLENS);

				//	if(!bRes)
				//	{
				//		u8SD_1MinRetryCnt++;

				//		if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
				//		{
				//			LOGprintf("\r\n> SD 1 min write new index %d to file %s FAIL.",
				//			           u16DriveActCntDay, FILENAME_DRIVE_DAY_TMP);

				//			u8SD_1MinRetryCnt = 0;

				//			procSD_1M_Step = PROC_STEP_23;

				//			break;
				//		}

				//		procSD_1M_Step = PROC_STEP_21;

				//		break;
				//	}
				//	#else
				//	V161_SaveFileIdx(FILENAME_DRIVE_DAY_TMP, u16DriveActCntDay);
				//	#endif

				//	u16DrvDayIdx = u16DriveActCntDay;

				//	u8SD_1MinRetryCnt = 0;

				//	procSD_1M_Step = PROC_STEP_22;
				//}
				// If make VDR file then write to SD buffer
				//else
				//{
				//	if(u8BufIdx == SD_RECORD_DRIVE_QUEUE_MAX)
				//	{
				//		procSD_1M_Step = PROC_STEP_NULL;

				//		break;
				//	}

				//	procSD_1M_Step = PROC_STEP_22;
				//}
				
				procSD_1M_Step = PROC_STEP_22;

				break;
			}

		// Step 22: Write data to file DRIVE_DAY
		case PROC_STEP_22:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	sdRecDrvBuf.u16DriveActCntDay = 0;

				//	bRes = SD_WriteBuffToAddr(FILENAME_DRIVE_DAY_TMP, (uint8_t *)&stRecDriving.u8DriverName, DRIVINGLENS,
				//	                          HEADLENS + ((u16DriveActCntDay - 1) * DRIVINGLENS));

				//	if(!bRes)
				//	{
				//		u8SD_1MinRetryCnt++;

				//		if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
				//		{
				//			LOGprintf("\r\n> SD 1 min write data %d to file %s FAIL.",
				//			           FILENAME_DRIVE_DAY_TMP);

				//			u8SD_1MinRetryCnt = 0;

				//			procSD_1M_Step = PROC_STEP_23;

				//			break;
				//		}

				//		procSD_1M_Step = PROC_STEP_22;

				//		break;
				//	}

				//	u8SD_1MinRetryCnt = 0;

				//	procSD_1M_Step = PROC_STEP_23;
				//}
				// If make VDR file then write to SD buffer
				//else
				//{
				//	if(u8BufIdx == SD_RECORD_DRIVE_QUEUE_MAX)
				//	{
				//		procSD_1M_Step = PROC_STEP_NULL;

				//		break;
				//	}

				//	procSD_1M_Step = PROC_STEP_23;
				//}

        procSD_1M_Step = PROC_STEP_23;
 
				break;
			}

		// Step 23: Move to driver 2 or finish
		case PROC_STEP_23:
			{
				// If the current data is for driver 1 then continue to write data for driver 2
				if(bIsDrv1 == TRUE)
				{
					memset(&stRecDriving, 0x00, sizeof(DriveDataTypeDef));

					stRecDriving.u8DriveCode = g_Setting.u8DrvStatus2;

					memset(stRecDriving.u8DriverName, '\0', sizeof(stRecDriving.u8DriverName));

					memcpy(stRecDriving.u8DriverName, &g_Setting.u32DrvIdNum2, 4);

					memcpy(stRecDriving.u8DriveDateBCD, u8SpeedDateBCD, 7);

					bIsDrv1 = FALSE;

					procSD_1M_Step = PROC_STEP_17;
				}
				// If the current data is for driver 2 then finish
				else
				{
					bIsDrv1 = TRUE;

					//LOGprintf("\r\n> ### One Min Rec OK ###");

					procSD_1M_Step = PROC_STEP_NULL;
				}

				break;
			}

		default:
			break;
	}
}

//============================================================================//
// @brief  Do 1 min task with SD buffer enabled.
// @param  None.
// @retval None.
//============================================================================//
void V161_1MinLogProc(void)
{
	u8SD_1MinRetryCnt = 0;

	procSD_1M_Step = PROC_STEP_1;

	while(procSD_1M_Step != PROC_STEP_NULL)
	{
		V161_1MinLogStepProc();
	}
}

//============================================================================//
// @brief  Handle extended record task.
// @param  None.
// @retval None.
//============================================================================//
static void V161_RecExtStepProc(void)
{
  static ExternalDataTypeDef stExternalData;
	static uint8_t u8BCDTime[7];
	//static uint16_t u16Idx;
	static time_t ttBuf;
	static uint8_t u8BufIdx;
	bool bRes;
	
	
	if(procRecExtStep == PROC_STEP_NULL)
		return;

	switch((int)procRecExtStep)
	{
		// Step 1: Get file EXTERNAL index
		case PROC_STEP_1:
			{
				memset(&stExternalData, 0x00, sizeof(ExternalDataTypeDef));
	
				ttBuf = System_GetTime();
				
				SecToBCDTime(ttBuf, u8BCDTime);
				
				memcpy(stExternalData.u8DateBCD, u8BCDTime, 7);
				
				stExternalData.u8IOStatus = g_SysInfo.tEXTIO.word;
				
				stExternalData.u32Distance = (uint32_t)(g_SysInfo.tVehicleState.dDistance / 100);
				
				u8BufIdx = SD_RECORD_EXTEND_QUEUE_MAX;

				for(int i = 0; i < SD_RECORD_EXTEND_QUEUE_MAX; i++)
				{
					if(sd1MinBuf.bRequest[i] == FALSE)
					{
						u8BufIdx = i;

						break;
					}
				}

				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					#if !ENABLE_INDEX_BUFFER
					bRes = SD_ReadFileToBuff(FILENAME_EXTERNAL_TMP, (uint8_t *)&stExternalData.u16BlockIndex, HEADLENS);

					if(!bRes)
					{
						u8SD_RecExtRetryCnt++;

						if(u8SD_RecExtRetryCnt == SD_REC_EXT_TASK_RETRY_MAX)
						{
							RTOSprintf("\r\n> SD record extend get file %s index FAIL.", FILENAME_EXTERNAL_TMP);

							u8SD_RecExtRetryCnt = 0;

							procRecExtStep = PROC_STEP_4;

							break;
						}

						procRecExtStep = PROC_STEP_1;

						break;
					}
					#else
					V161_GetFileIdx(FILENAME_EXTERNAL_TMP, &stExternalData.u16BlockIndex);
					#endif

					stExternalData.u16BlockIndex++;

					u8SD_RecExtRetryCnt = 0;

					procRecExtStep = PROC_STEP_2;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_RECORD_EXTEND_QUEUE_MAX)
					{
						procRecExtStep = PROC_STEP_NULL;

						break;
					}

					stExternalData.u16BlockIndex = u16RecExtIdx;

					stExternalData.u16BlockIndex++;

					procRecExtStep = PROC_STEP_2;
				}

				break;
			}

		// Step 2: Write new index to file EXTERNAL
		case PROC_STEP_2:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					sdRecExtBuf.u16RecExtBlockIndex = 0;

					#if !ENABLE_INDEX_BUFFER
					bRes = SD_WriteBuffToFile(FILENAME_EXTERNAL_TMP, (uint8_t *)&stExternalData.u16BlockIndex, HEADLENS);

					if(!bRes)
					{
						u8SD_RecExtRetryCnt++;

						if(u8SD_RecExtRetryCnt == SD_REC_EXT_TASK_RETRY_MAX)
						{
							RTOSprintf("\r\n> SD record extend write new index %d to file %s FAIL.",
							           stExternalData.u16BlockIndex, FILENAME_EXTERNAL_TMP);

							u8SD_RecExtRetryCnt = 0;

							procRecExtStep = PROC_STEP_4;

							break;
						}

						procRecExtStep = PROC_STEP_2;

						break;
					}
					#else
					V161_SaveFileIdx(FILENAME_EXTERNAL_TMP, stExternalData.u16BlockIndex);
					#endif

					u8SD_RecExtRetryCnt = 0;

					u16RecExtIdx = stExternalData.u16BlockIndex;

					procRecExtStep = PROC_STEP_3;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_RECORD_EXTEND_QUEUE_MAX)
					{
						procRecExtStep = PROC_STEP_NULL;

						break;
					}

					u16RecExtIdx = stExternalData.u16BlockIndex;

					sdRecExtBuf.u16RecExtBlockIndex = stExternalData.u16BlockIndex;

					bSD_SaveDatRequest = TRUE;

					procRecExtStep = PROC_STEP_3;
				}

				break;
			}

		// Step 3: Write data to file EXTERNAL
		case PROC_STEP_3:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					sdRecExtBuf.u16RecExtBlockIndex = 0;

					bRes = SD_WriteBuffToAddr(FILENAME_EXTERNAL_TMP, (uint8_t *)&stExternalData.u8DateBCD, EXTLENS,
					                          HEADLENS + ((stExternalData.u16BlockIndex - 1) * EXTLENS));

					if(!bRes)
					{
						u8SD_RecExtRetryCnt++;

						if(u8SD_RecExtRetryCnt == SD_REC_EXT_TASK_RETRY_MAX)
						{
							RTOSprintf("\r\n> SD record extend write data to file %s FAIL.", FILENAME_EXTERNAL_TMP);

							u8SD_RecExtRetryCnt = 0;

							procRecExtStep = PROC_STEP_4;

							break;
						}

						procRecExtStep = PROC_STEP_3;

						break;
					}

					u8SD_RecExtRetryCnt = 0;

					procRecExtStep = PROC_STEP_4;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_RECORD_EXTEND_QUEUE_MAX)
					{
						procRecExtStep = PROC_STEP_NULL;

						break;
					}

					snprintf((char *)sdRecExtBuf.u8Data[u8BufIdx], EXTLENS, "%s", (char *)&stExternalData.u8DateBCD);

					sdRecExtBuf.u32RecExtAddr[u8BufIdx] = HEADLENS + ((stExternalData.u16BlockIndex - 1) * EXTLENS);

					sdRecExtBuf.u16RecExtBlockIndex = stExternalData.u16BlockIndex;

					sdRecExtBuf.bRequest[u8BufIdx] = TRUE;

					bSD_SaveDatRequest = TRUE;

					procRecExtStep = PROC_STEP_4;
				}

				break;
			}

		// Step 4: Get file EXTERNAL_DAY index
		case PROC_STEP_4:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	#if !ENABLE_INDEX_BUFFER
				//	bRes = SD_ReadFileToBuff(FILENAME_EXTERNAL_DAY_TMP, (uint8_t *)&u16Idx, HEADLENS);

				//	if(!bRes)
				//	{
				//		u8SD_RecExtRetryCnt++;

				//		if(u8SD_RecExtRetryCnt == SD_REC_EXT_TASK_RETRY_MAX)
				//		{
				//			RTOSprintf("\r\n> SD record extend get file %s index FAIL.", FILENAME_EXTERNAL_DAY_TMP);

				//			u8SD_RecExtRetryCnt = 0;

				//			procRecExtStep = PROC_STEP_7;

				//			break;
				//		}

				//		procRecExtStep = PROC_STEP_4;

				//		break;
				//	}
				//	#else
				//	V161_GetFileIdx(FILENAME_EXTERNAL_DAY_TMP, &u16Idx);
				//	#endif

				//	u8SD_RecExtRetryCnt = 0;

				//	u16Idx++;

				//	procRecExtStep = PROC_STEP_5;
				//}
				// If make VDR file then write to SD buffer
				//else
				//{
				//	if(u8BufIdx == SD_RECORD_EXTEND_QUEUE_MAX)
				//	{
				//		procRecExtStep = PROC_STEP_NULL;

				//		break;
				//	}

				//	procRecExtStep = PROC_STEP_5;
				//}

        procRecExtStep = PROC_STEP_5;

				break;
			}

		// Step 5: Write new index to file EXTERNAL_DAY
		case PROC_STEP_5:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	sdRecExtBuf.u16Idx = 0;

				//	#if !ENABLE_INDEX_BUFFER
				//	bRes = SD_WriteBuffToFile(FILENAME_EXTERNAL_DAY_TMP, (uint8_t *)&u16Idx, HEADLENS);

				//	if(!bRes)
				//	{
				//		u8SD_RecExtRetryCnt++;

				//		if(u8SD_RecExtRetryCnt == SD_REC_EXT_TASK_RETRY_MAX)
				//		{
				//			RTOSprintf("\r\n> SD record extend write new index %d to file %s FAIL.",
				//			           u16Idx, FILENAME_EXTERNAL_DAY_TMP);

				//			u8SD_RecExtRetryCnt = 0;

				//			procRecExtStep = PROC_STEP_7;

				//			break;
				//		}

				//		procRecExtStep = PROC_STEP_5;

				//		break;
				//	}
				//	#else
				//	V161_SaveFileIdx(FILENAME_EXTERNAL_DAY_TMP, u16Idx);
				//	#endif

				//	u16RecExtDayIdx = u16Idx;

				//	u8SD_RecExtRetryCnt = 0;

				//	procRecExtStep = PROC_STEP_6;
				//}
				// If make VDR file then write to SD buffer
				//else
				//{
				//	if(u8BufIdx == SD_RECORD_EXTEND_QUEUE_MAX)
				//	{
				//		procRecExtStep = PROC_STEP_NULL;

				//		break;
				//	}

				//	procRecExtStep = PROC_STEP_6;
				//}
				
				procRecExtStep = PROC_STEP_6;

				break;
			}

		// Step 6: Write data to file EXTERNAL_DAY
		case PROC_STEP_6:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	sdRecExtBuf.u16Idx = 0;

				//	bRes = SD_WriteBuffToAddr(FILENAME_EXTERNAL_DAY_TMP, (uint8_t *)&stExternalData.u8DateBCD, EXTLENS,
				//	                          HEADLENS + ((u16Idx - 1) * EXTLENS));

				//	if(!bRes)
				//	{
				//		u8SD_RecExtRetryCnt++;

				//		if(u8SD_RecExtRetryCnt == SD_REC_EXT_TASK_RETRY_MAX)
				//		{
				//			RTOSprintf("\r\n> SD record extend write data %d to file %s FAIL.",
				//			           FILENAME_EXTERNAL_DAY_TMP);

				//			u8SD_RecExtRetryCnt = 0;
        
				//			procRecExtStep = PROC_STEP_7;

				//			break;
				//		}

				//		procRecExtStep = PROC_STEP_6;

				//		break;
				//	}

				//	u8SD_RecExtRetryCnt = 0;

				//	procRecExtStep = PROC_STEP_7;
				//}
				// If make VDR file then write to SD buffer
				//else
				//{
				//	if(u8BufIdx == SD_RECORD_EXTEND_QUEUE_MAX)
				//	{
				//		procRecExtStep = PROC_STEP_NULL;

				//		break;
				//	}

				//	procRecExtStep = PROC_STEP_7;
				//}
				
				procRecExtStep = PROC_STEP_7;

				break;
			}
			
	  case PROC_STEP_7:
		{
			procRecExtStep = PROC_STEP_NULL;
		  
			break;
		}
		
		default:
			break;
	}
}

//============================================================================//
// @brief  Writing record to extended record file.
// @param  None.
// @retval None.
//============================================================================//
void V161_RecordExternslData(void)
{
	u8SD_RecExtRetryCnt = 0;

	procRecExtStep = PROC_STEP_1;

	while(procRecExtStep != PROC_STEP_NULL)
	{
		V161_RecExtStepProc();
	}
}
#else
//============================================================================//
// @brief  Do 1 min task without SD buffer.
// @param  None.
// @retval None.
//============================================================================//
void V161_1MinLogProc(void)
{
	//bool bRes;
  uint32_t u32Buf = 0;
	uint16_t u16Buf = 0;
	uint8_t PosData[11] = {0}, u8OneMinAvgSpeed = 0;
	uint8_t i, j;
	DriveDataTypeDef stRecDriving;
	VdrPositionDataTypeDef stVdrPos;


	SecToBCDTime(ttSysLogTime, u8SpeedDateBCD);

	memcpy(u8DetailSpeed.u8DateBCD, u8SpeedDateBCD, 7);

	RTOSprintf("\r\n> ### %02X%02X/%02X/%02X %02X:%02X:%02X, One Min Rec ###",
					    u8SpeedDateBCD[0], u8SpeedDateBCD[1], u8SpeedDateBCD[2],
					    u8SpeedDateBCD[3], u8SpeedDateBCD[4], u8SpeedDateBCD[5],
					    u8SpeedDateBCD[6]);

	u16Buf = 0;
	
	j = 0;

	for(i = 0; i < 60; i++)
	{
		u16Buf += (uint16_t)u8SpeedBuf[i][0];
 		u16Buf += (uint16_t)u8SpeedBuf[i][1];

		u8DetailSpeed.u8SpeedData[j] = u8SpeedBuf[i][0];
		u8DetailSpeed.u8SpeedData[j + 1] = u8SpeedBuf[i][1];

		j += 2;
	}

	u8OneMinAvgSpeed = (uint8_t)(u16Buf / 120);
	
	u8DetailSpeed.u16BlockIndex++;

	if(u8DetailSpeed.u16BlockIndex > DSPEEDMAX)
	{
		u8DetailSpeed.u16BlockIndex = 1;
	}

	// DETAIL_SPEED and DETAIL_SPEED_DAY 
	
	#if !ENABLE_INDEX_BUFFER
	SD_WriteBuffToFile(FILENAME_DETAILSPEED_TMP, (uint8_t *)&u8DetailSpeed.u16BlockIndex, HEADLENS);
	#else
	V161_SaveFileIdx(FILENAME_DETAILSPEED_TMP, u8DetailSpeed.u16BlockIndex);
	#endif

	SD_WriteBuffToAddr(FILENAME_DETAILSPEED_TMP, u8DetailSpeed.u8DateBCD, DATELENS,
						         HEADLENS + ((u8DetailSpeed.u16BlockIndex - 1) * DATELENS));

  /*
	// One Day Data file
	#if !ENABLE_INDEX_BUFFER
  SD_ReadFileToBuff(FILENAME_DETAILSPEED_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_DETAILSPEED_DAY_TMP, &u16Index);
  #endif
	
	u16Index++;

  #if !ENABLE_INDEX_BUFFER
	SD_WriteBuffToFile(FILENAME_DETAILSPEED_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#else
	V161_SaveFileIdx(FILENAME_DETAILSPEED_DAY_TMP, u16Index);
  #endif
	
	SD_AddBuffToFile(FILENAME_DETAILSPEED_DAY_TMP, u8DetailSpeed.u8DateBCD, DATELENS);
  */
	
	taskInfo[TASK_LOG_PROC].u16TaskStep++;
	
	// Min-VDR Record
	V161_WriteDetailSpeedToVDR(u8DetailSpeed);
	
	taskInfo[TASK_LOG_PROC].u16TaskStep++;
	
	// If new hour then create new block for POSITION and POSITION_DAY
	if(PositionData.u8Index == 0)
	{
		LOGprintf("\r\n> ### New POSITION Block ###");

		memset(PositionData.u8DateBCD, 0x00, POSLENS);
		memcpy(PositionData.u8DateBCD, u8SpeedDateBCD, 7);

		PositionData.u16BlockIndex++;

		if(PositionData.u16BlockIndex > POSMAX)
		{
			PositionData.u16BlockIndex = 1;
		}

		#if !ENABLE_INDEX_BUFFER
		SD_WriteBuffToFile(FILENAME_POSITION_TMP, (uint8_t *)&PositionData.u16BlockIndex, HEADLENS);
		#else
		V161_SaveFileIdx(FILENAME_POSITION_TMP, PositionData.u16BlockIndex);
    #endif
		
		SD_WriteBuffToAddr(FILENAME_POSITION_TMP, PositionData.u8DateBCD, POSLENS,
									     HEADLENS + ((PositionData.u16BlockIndex - 1) * POSLENS));

    /*
		// Daily file
		#if !ENABLE_INDEX_BUFFER
		SD_ReadFileToBuff(FILENAME_POSITION_DAY_TMP, (uint8_t *)&u16Index2, HEADLENS);
		#else
		V161_GetFileIdx(FILENAME_POSITION_DAY_TMP, &u16Index2);
    #endif
		
		u16Index2++;

		#if !ENABLE_INDEX_BUFFER
		SD_WriteBuffToFile(FILENAME_POSITION_DAY_TMP, (uint8_t *)&u16Index2, HEADLENS);
		#else
		V161_SaveFileIdx(FILENAME_POSITION_DAY_TMP, u16Index2);
    #endif
		
		SD_WriteBuffToAddr(FILENAME_POSITION_DAY_TMP, PositionData.u8DateBCD, POSLENS,
									     HEADLENS + ((u16Index2 - 1) * POSLENS));
    */
	}

	//RTOSprintf("\r\n> ### PositionData.u8Index: %d ###", PositionData.u8Index);

	// POSITION and POSITION_DAY
	u16Buf = g_SysInfo.tGPS_Data.gpsLon.u8ddd * 100 + g_SysInfo.tGPS_Data.gpsLon.u8mm;

	memcpy(&PosData[0], &u16Buf, 2);
	memcpy(&PosData[2], &g_SysInfo.tGPS_Data.gpsLon.u16mmmm, 2);

	u16Buf = g_SysInfo.tGPS_Data.gpsLat.u8dd * 100 + g_SysInfo.tGPS_Data.gpsLat.u8mm;

	memcpy(&PosData[4], &u16Buf, 2);
	memcpy(&PosData[6], &g_SysInfo.tGPS_Data.gpsLat.u16mmmm, 2);
	
	u16Buf = (uint16_t)g_SysInfo.tGPS_Data.fAltitude;
	
	memcpy(&PosData[8], &u16Buf, 2);

	PosData[10] = u8OneMinAvgSpeed;

	u32Buf = 0;

	u32Buf = HEADLENS + ((PositionData.u16BlockIndex-1) * POSLENS) + (PositionData.u8Index * 11) + BCDDATE;

	//RTOSprintf("\r\n> ### BIdx: %d, Idx: %d, Addr: 0x%04X ###", PositionData.u16BlockIndex, PositionData.u8Index, u32Address);

	SD_WriteBuffToAddr(FILENAME_POSITION_TMP, (uint8_t *)&PosData,	11, u32Buf);

  /*
	// One day file
  #if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_POSITION_DAY_TMP, (uint8_t *)&u16Index2, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_POSITION_DAY_TMP, &u16Index2);
	#endif

	if(u16Index2 == 0)
	{
		u16Index2 = 1;

		#if !ENABLE_INDEX_BUFFER
		SD_WriteBuffToFile(FILENAME_POSITION_DAY_TMP, (uint8_t *)&u16Index2, HEADLENS);
		#else
		V161_SaveFileIdx(FILENAME_POSITION_DAY_TMP, u16Index2);
		#endif
	}

	u32Buf = HEADLENS + ((u16Index2 - 1) * POSLENS) + (PositionData.u8Index * 11) + BCDDATE;

	//LOGprintf("\r\n> ### BIdx: %d, Idx: %d, Addr: 0x%04X ###", PositionData.u16BlockIndex, PositionData.u8Index, u32Address);

	SD_WriteBuffToAddr(FILENAME_POSITION_DAY_TMP, (uint8_t *)&PosData,	11, u32Buf);

	//LOGprintf("\r\n> ### BIdx: %d, DayBIdx: %d, Pos_Idx2: %d ###", PositionData.u16BlockIndex, u16Index2, PositionData.u8Index);
  */

	if(PositionData.u8Index >= 59)
	{
		PositionData.u8Index = 0;

		LOGprintf("\r\n> ### 1Hr PosData ###");
	}
	else
	{
		PositionData.u8Index++;
	}

	// Min-VDR Record
	memcpy(stVdrPos.u8DateBCD, u8SpeedDateBCD, 7);
	memcpy(stVdrPos.u8Position , PosData, 11);
	
	taskInfo[TASK_LOG_PROC].u16TaskStep++;
	
	V161_WritePositionToVDR(stVdrPos);
	
	taskInfo[TASK_LOG_PROC].u16TaskStep++;
	
	//================================================================================================

	//RTOSprintf("\r\n> ### u32DrvIdNum ###");

	memset(&stRecDriving, 0x00, sizeof(DriveDataTypeDef));

	stRecDriving.u8DriveCode = g_Setting.tDrvInfo[0].u8DrvStatus;

	memset(stRecDriving.u8DriverName, '\0', sizeof(stRecDriving.u8DriverName));

	memcpy(stRecDriving.u8DriverName, &g_Setting.tDrvInfo[0].u32DrvIdNum, 4);

	memcpy(stRecDriving.u8DriveDateBCD, u8SpeedDateBCD, 7);
	
	taskInfo[TASK_LOG_PROC].u16TaskStep++;

	V161_RecordDriving(stRecDriving);
	
	taskInfo[TASK_LOG_PROC].u16TaskStep++;

	memset(&stRecDriving, 0x00, sizeof(DriveDataTypeDef));

	stRecDriving.u8DriveCode = g_Setting.tDrvInfo[1].u8DrvStatus;

	memset(stRecDriving.u8DriverName, '\0', sizeof(stRecDriving.u8DriverName));

	memcpy(stRecDriving.u8DriverName, &g_Setting.tDrvInfo[1].u32DrvIdNum, 4);

	memcpy(stRecDriving.u8DriveDateBCD, u8SpeedDateBCD, 7);
	
	taskInfo[TASK_LOG_PROC].u16TaskStep++;

	V161_RecordDriving(stRecDriving);
	
	taskInfo[TASK_LOG_PROC].u16TaskStep++;

	V161_WriteDrvStatusToVDR(u8SpeedDateBCD);

	//LOGprintf("\r\n> ### One Min Rec OK ###");

	// Gary Test
	//u32PosFileSize = SD_GetFileSize(FILENAME_POSITION_DAY_TMP);
	//LOGprintf("\r\n> ### Pos_size: %d ###", u32PosFileSize);
}

//============================================================================//
// @brief  Writing record to extended record file.
// @param  None.
// @retval None.
//============================================================================//
void V161_RecordExternslData(void)
{
	ExternalDataTypeDef stExternalData;
	uint8_t u8BCDTime[7];
	//uint16_t u16Idx;
	time_t ttBuf;
	
	
	//RTOSprintf("\r\n> ### V161 Record Externsl Data ###");
	
	memset(&stExternalData, 0x00, sizeof(ExternalDataTypeDef));
	
	ttBuf = System_GetTime();
	
	SecToBCDTime(ttBuf, u8BCDTime);
	
	memcpy(stExternalData.u8DateBCD, u8BCDTime, 7);
	
	stExternalData.u8IOStatus = g_SysInfo.tEXTIO.word;
	
	stExternalData.u32Distance = (uint32_t)(g_SysInfo.tVehicleState.dDistance / 100);
	
	#if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_EXTERNAL_TMP, (uint8_t *)&stExternalData.u16BlockIndex, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_EXTERNAL_TMP, &stExternalData.u16BlockIndex);
	#endif
	
	stExternalData.u16BlockIndex++;
	
	#if !ENABLE_INDEX_BUFFER
	SD_WriteBuffToFile(FILENAME_EXTERNAL_TMP, (uint8_t *)&stExternalData.u16BlockIndex, HEADLENS);
	#else
	V161_SaveFileIdx(FILENAME_EXTERNAL_TMP, stExternalData.u16BlockIndex);
	#endif
	
	//RTOSprintf("\r\n> Dist log: %d (0x%08X)", stExternalData.u32Distance, stExternalData.u32Distance);
	
	SD_WriteBuffToAddr(FILENAME_EXTERNAL_TMP, (uint8_t *)&stExternalData.u8DateBCD, EXTLENS,
	                   HEADLENS + ((stExternalData.u16BlockIndex - 1) * EXTLENS));
/*	
	// Record to Day File
	#if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_EXTERNAL_DAY_TMP, (uint8_t *)&u16Idx, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_EXTERNAL_DAY_TMP, &u16Idx);
	#endif
	
	u16Idx++;
	
	#if !ENABLE_INDEX_BUFFER
	SD_WriteBuffToFile(FILENAME_EXTERNAL_DAY_TMP, (uint8_t *)&u16Idx, HEADLENS);
	#else
	V161_SaveFileIdx(FILENAME_EXTERNAL_DAY_TMP, u16Idx);
	#endif
	
	SD_WriteBuffToAddr(FILENAME_EXTERNAL_DAY_TMP, (uint8_t *)&stExternalData.u8DateBCD, EXTLENS,
	                   HEADLENS + ((u16Idx - 1) * EXTLENS));
*/		
	// Min-VDR Record
	V161_WriteExternalToVDR(stExternalData);
}
#endif

void V161_CheckVDRHeader(void)
{
	bool bRes;
	uint8_t u8VDRHeader[2];
	
	
	u8VDRHeader[0] = 0xBB;
	u8VDRHeader[1] = 0x00;
	
	bRes = SD_CheckFileExist(FILENAME_MIN_VDR_TMP);
	
	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_MIN_VDR_TMP, HEADLENS, TRUE);
		
		SD_WriteBuffToAddr(FILENAME_MIN_VDR_TMP, u8VDRHeader, HEADLENS, 0);
	}
}

