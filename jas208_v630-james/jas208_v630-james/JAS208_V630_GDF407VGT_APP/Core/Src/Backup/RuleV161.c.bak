		// Step 15: Write data to file POSITION_DAY
		case PROC_STEP_15:
			{
				//uint32_t u32Addr = HEADLENS + ((u16Index2 - 1) * POSLENS) + BCDDATE + (PositionData.u8Index * POSITIONLENS);

				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
