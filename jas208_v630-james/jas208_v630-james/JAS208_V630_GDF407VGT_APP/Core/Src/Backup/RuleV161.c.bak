//============================================================================//
// @brief  Check the existance of record files and initialize files that do not exist.
// @param  None.
// @retval None.
//============================================================================//
void V161_CheckRecordFile(void)
{
	bool bRes;
	TechnicalDataTypeDef stTechnical;
	uint8_t u8BCDTime[7], u8Buf, u8Header[2];

	
	LOGprintf("\r\n> ### V16.1 Check Record File ###");

	RTOSprintf("\r\n> [SYS]%04X", SYS_STATE_CHECK_RECORD_FILE);

	//Table 5-1

	bRes = SD_CheckFileExist(FILENAME_BREAKDOWN_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_BREAKDOWN_TMP, SHORTHEAD + (BYTEMAX * BREAKDOWNLENS), TRUE);
	}

	//Table 5-2
	bRes = SD_CheckFileExist(FILENAME_EVENT_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_EVENT_TMP, SHORTHEAD + (BYTEMAX * EVENTLENS), TRUE);
	}

	// Table 6
	bRes = SD_CheckFileExist(FILENAME_DETAILSPEED_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_DETAILSPEED_TMP, HEADLENS + (DATELENS * DSPEEDMAX), FALSE);
		
		#if ENABLE_INDEX_BUFFER
		V161_SaveFileIdx(FILENAME_DETAILSPEED_TMP, 0);
		#endif
	}

	// Table 6 Day
	/*
	bRes = SD_CheckFileExist(FILENAME_DETAILSPEED_DAY_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_DETAILSPEED_DAY_TMP, HEADLENS, TRUE);
		
		#if ENABLE_INDEX_BUFFER
		V161_SaveFileIdx(FILENAME_DETAILSPEED_DAY_TMP, 0);
		#endif

		u16DS_DayIdx = 0;
	}
	*/

	//Table 7
	bRes = SD_CheckFileExist(FILENAME_TECHNICAL_TMP);

	if(bRes == FALSE)
	{
		memset(&stTechnical, '\0', sizeof(TechnicalDataTypeDef));

		strncpy((char *)stTechnical.u8Company, (char *)u8Company, sizeof(u8Company));
		strncpy((char *)stTechnical.u8Address, (char *)u8Address, sizeof(u8Address));
		strncpy((char *)stTechnical.u8DeviceNum, (char *)u8DeviceNum, sizeof(u8DeviceNum));
		//strncpy((char *)stTechnical.u8FwNum, (char *)u8FwNum, sizeof(u8FwNum));
		//strncpy((char *)stTechnical.u8FwDateBCD, (char *)u8FwDateBCD, sizeof(u8FwDateBCD));
		
		memset(u8BCDTime, '\0', sizeof(u8BCDTime));
		
		sprintf((char *)u8BCDTime, "%04d", VERSION_BUILD);
		
		strncpy((char *)stTechnical.u8FwNum, (char *)u8BCDTime, 4);
		
		u8BCDTime[0] = 0x20;
		
		u8Buf = FIRMWARE_DATE[2];
		u8BCDTime[1] = ((u8Buf << 4) & 0xF0) | (FIRMWARE_DATE[3] & 0x0F);
		u8Buf = FIRMWARE_DATE[4];
		u8BCDTime[2] = ((u8Buf << 4) & 0xF0) | (FIRMWARE_DATE[5] & 0x0F);
		u8Buf = FIRMWARE_DATE[6];
		u8BCDTime[3] = ((u8Buf << 4) & 0xF0) | (FIRMWARE_DATE[7] & 0x0F);
		
		u8BCDTime[4] = 0x00;
		u8BCDTime[5] = 0x00;
		u8BCDTime[6] = 0x00;
		
		strncpy((char *)stTechnical.u8FwDateBCD, (char *)u8BCDTime, sizeof(u8BCDTime));
		strncpy((char *)stTechnical.u8MakeYear, (char *)u8MakeYear, sizeof(u8MakeYear));
		strncpy((char *)stTechnical.u8CertNum, (char *)u8CertNum, sizeof(u8CertNum));
		strncpy((char *)stTechnical.u8BusID, (char *)g_Setting.tBusInfo.cBus_ID, sizeof(g_Setting.tBusInfo.cBus_ID));

		SD_WriteBuffToFile(FILENAME_TECHNICAL_TMP, (uint8_t*)&stTechnical.u8Company, sizeof(TechnicalDataTypeDef));
	}

	// Table 7-1
	bRes = SD_CheckFileExist(FILENAME_CALIBRATION_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_CALIBRATION_TMP, HEADLENS + (CALIBRATIONLENS * CALMAX), TRUE);
	}

	// Table 7-2
	bRes = SD_CheckFileExist(FILENAME_ADJUST_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_ADJUST_TMP, SHORTHEAD + (ADJUSTLENS * BYTEMAX), TRUE);
	}

	//Table 7-3
	bRes = SD_CheckFileExist(FILENAME_DRIVING_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_DRIVING_TMP, SHORTHEAD + (DRIVERTIMELENS * BYTEMAX), TRUE);
	}

	//Table 7-4
	bRes = SD_CheckFileExist(FILENAME_REST_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_REST_TMP, SHORTHEAD + (RESTLENS * BYTEMAX), TRUE);
	}

	// Table 8
	bRes = SD_CheckFileExist(FILENAME_DRIVE_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_DRIVE_TMP, HEADLENS + (DRIVINGLENS * WORDMAX), FALSE);
		
		#if ENABLE_INDEX_BUFFER
		V161_SaveFileIdx(FILENAME_DRIVE_TMP, 0);
		#endif

		u16DrvIdx = 0;
	}

	// Table 8 Day
	/*
	bRes = SD_CheckFileExist(FILENAME_DRIVE_DAY_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_DRIVE_DAY_TMP, HEADLENS, TRUE);
		
		#if ENABLE_INDEX_BUFFER
		V161_SaveFileIdx(FILENAME_DRIVE_DAY_TMP, 0);
		#endif

		u16DrvDayIdx = 0;
	}
	*/

	// Table 9
	bRes = SD_CheckFileExist(FILENAME_POSITION_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_POSITION_TMP, HEADLENS + (POSLENS * POSMAX), FALSE);
		
		#if ENABLE_INDEX_BUFFER
		V161_SaveFileIdx(FILENAME_POSITION_TMP, 0);
		#endif
	}

	// Table 9 Day
	/*
	bRes = SD_CheckFileExist(FILENAME_POSITION_DAY_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_POSITION_DAY_TMP, (HEADLENS + POSLENS), TRUE);

		#if ENABLE_INDEX_BUFFER
		V161_SaveFileIdx(FILENAME_POSITION_DAY_TMP, 0);
		#endif
		
		u16PosDayIdx = 0;
	}
	*/
	
	// Table 10
	bRes = SD_CheckFileExist(FILENAME_EXTERNAL_TMP);

	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_EXTERNAL_TMP, HEADLENS + (EXTLENS * WORDMAX), FALSE);
		
		#if ENABLE_INDEX_BUFFER
		V161_SaveFileIdx(FILENAME_EXTERNAL_TMP, 0);
		#endif
		
		u16RecExtIdx = 0;
	}
	
	// Table 10 Day
	/*
	bRes = SD_CheckFileExist(FILENAME_EXTERNAL_DAY_TMP);
	
	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_EXTERNAL_DAY_TMP, HEADLENS, TRUE);
		
		#if ENABLE_INDEX_BUFFER
		V161_SaveFileIdx(FILENAME_EXTERNAL_DAY_TMP, 0);
		#endif
		
		u16RecExtDayIdx = 0;
	}
	*/
	
	// Min-VDR Record file
	bRes = SD_CheckFileExist(FILENAME_MIN_VDR_TMP);
	
	if(bRes == FALSE)
	{
		SD_CreateFile(FILENAME_MIN_VDR_TMP, HEADLENS, TRUE);
		
		u8Header[0] = 0xBB;
		u8Header[1] = 0x00;
		SD_WriteBuffToAddr(FILENAME_MIN_VDR_TMP, u8Header, HEADLENS, 0);
		
		//V161_WriteTechnicalToVDR();
		V161_RecordTechnical(1);
		
	}
	
	//Folder VDR
	bRes = SD_CheckDirExist("VDR");
	
	if(bRes == FALSE)
	{
		SD_MakeDir("VDR");
	}

	//Folder DTR
	bRes = SD_CheckDirExist("DTR");
	
	if(bRes == FALSE)
	{
		SD_MakeDir("DTR");
	}
}

//============================================================================//
// @brief  Initialize detail speed file handling.
// @param  None.
// @retval None.
//============================================================================//
void V161_DetailSpeedInit(void)
{
	LOGprintf("\r\n> ### V161 DetailSpeed Init ###");

	#if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_DETAILSPEED_TMP, (uint8_t *)&u8DetailSpeed.u16BlockIndex, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_DETAILSPEED_TMP, &u8DetailSpeed.u16BlockIndex);
	#endif

	u8DetailSpeed.u8Index = 0;

	g_Setting.tDrvInfo[0].u8DrvStatus = 0;

	g_Setting.tDrvInfo[1].u8DrvStatus = 0;
}

//============================================================================//
// @brief  Initialize position file handling.
// @param  None.
// @retval None
//============================================================================//
void V161_PositionInit(void)
{
	LOGprintf("\r\n> ### V161 Position Init ###");

	#if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_POSITION_TMP, (uint8_t *)&PositionData.u16BlockIndex, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_POSITION_TMP, &PositionData.u16BlockIndex);
	#endif

	PositionData.u8Index = 0;
}

#if 0
//============================================================================//
// @brief  Make VDR file for the whole current day.
// @param  None.
// @retval TRUE: Operation is successful.
//         FALSE: Operation is failed.
//============================================================================//
bool V161_MoveDataProc(void)
{
	bool bRes;
	char cFileName[50] = {0};
	uint8_t	CheckSum = 0, u8BCDTime[7], u8Buf;
	uint8_t u8Len1 = 0, u8Len2 = 0, u8Len3 = 0;
	uint16_t u16Len1 = 0, i, j;
	uint32_t u32FileSize, u32DataSize = 0, u32GetSize = 0;

	DataBlockTypeDef stTableData;
	BreakdownDataTypeDef stBreakDown;
	EventDataTypeDef stEvent;
	DetailSpeedTypeDef stDetailSpeed;
	CalibrationDataTypeDef stCalibration;
	AdjustDataTypeDef stAdjust;
	DrivingTimeTypeDef stDrivingTime;
	RestDataTypeDef stRestTime;
	DriveDataTypeDef stDriving;
	PositionDataTypeDef stPositionData;
	ExternalDataTypeDef stExternal;
	
	time_t ttFileTime;
	//Gary Test Time
	uint32_t u32TickTime;


	LOGprintf("\r\n>================================================");

	LOGprintf("\r\n> ### V161 MoveDataProc ###");

	u32TickTime = HAL_GetTick();

	//RTOSprintf("\r\n> [SYS]%04X", SYS_STATE_MAKE_VDR_START);

	if(bKeepDayDataFlag == TRUE)
	{
		ttFileTime = g_SysInfo.ttNow;

		SecToBCDTime(ttFileTime, u8BCDTime);

		sprintf(cFileName, "%s/D%02X%02X%02X%02X_%02X%02X%02X_%s.VDR",
		        (char *)FOLDERNAME_VDR,
		        u8BCDTime[0], u8BCDTime[1], u8BCDTime[2], u8BCDTime[3],
		        u8BCDTime[4], u8BCDTime[5], u8BCDTime[6], g_Setting.tBusInfo.cBus_ID);
	}
	else
	{
		//ttFileTime = (g_SysInfo.ttNow + MINUTE_2_SECOND(1)) - DAY_2_SECOND(1);
		ttFileTime = ttLastLogTime;

		SecToBCDTime(ttFileTime, u8BCDTime);

		sprintf(cFileName, "%s/D%02X%02X%02X%02X_235959_%s.VDR",
		        (char *)FOLDERNAME_VDR,
		        u8BCDTime[0], u8BCDTime[1], u8BCDTime[2], u8BCDTime[3], g_Setting.tBusInfo.cBus_ID);
	}

	LOGprintf("\r\n> ### VDR filename: %s ###", cFileName);

	SD_RemoveFile(cFileName);

	if(bKeepDayDataFlag == TRUE)
	{
		// Copy Day File
		V161_CopyDayFile();
	}
	else
	{
		// Rename Day File
		V161_RenameDayFile();

		// ReCreate Day File
		V161_RecreateDayFile();
	}

	//========================================================================================
	// Write Block header
	LOGprintf("\r\n> ### Write VDR Header ###");
	
	SD_WriteBuffToFile(cFileName,(uint8_t *)&u16BlockCnt, HEADLENS);
	
	//========================================================================================

	LOGprintf("\r\n> ### MAKE_TABLE5_STEP ###");

	u8Len1 = 0;

	SD_ReadFileToBuff(FILENAME_BREAKDOWN_TMP, &u8Len1, SHORTHEAD);

	u8Len2 = 0;

	SD_ReadFileToBuff(FILENAME_EVENT_TMP, &u8Len2, SHORTHEAD);

	// Make header
	
	stTableData.u8Code = 0x00;
	
	memcpy(stTableData.u8Name, u8Table5Name, 18);
	
	stTableData.u32Lens = SHORTHEAD + (u8Len1 * BREAKDOWNLENS) + SHORTHEAD + (u8Len2 * EVENTLENS);
	
	SD_AddBuffToFile(cFileName, &stTableData.u8Code, sizeof(DataBlockTypeDef));

	SD_AddBuffToFile(cFileName, (uint8_t*)&u8Len1, SHORTHEAD);

	if(u8Len1 > 0)
	{
		for(i = 0; i < u8Len1; i++)
		{
			SD_ReadAddrToBuff(FILENAME_BREAKDOWN_TMP, &stBreakDown.u8Code, BREAKDOWNLENS, SHORTHEAD + (i * BREAKDOWNLENS));

			SD_AddBuffToFile(cFileName, &stBreakDown.u8Code, BREAKDOWNLENS);
		}
	}

	SD_AddBuffToFile(cFileName, (uint8_t *)&u8Len2, SHORTHEAD);

	if(u8Len2 > 0)
	{
		for(i = 0; i < u8Len2; i++)
		{
			SD_ReadAddrToBuff(FILENAME_EVENT_TMP, &stEvent.u8Code, EVENTLENS, SHORTHEAD + (i * EVENTLENS));

			SD_AddBuffToFile(cFileName, &stEvent.u8Code, EVENTLENS);
		}
	}

	//========================================================================================

	LOGprintf("\r\n> ### MAKE_TABLE6_STEP ###");

	memset(&stDetailSpeed, 0x00, sizeof(DetailSpeedTypeDef));

	bRes = SD_CheckFileExist(FILENAME_DETAILSPEED_DAY_2_TMP);

	if(bRes == TRUE)
	{
		SD_ReadFileToBuff(FILENAME_DETAILSPEED_DAY_2_TMP, (uint8_t *)&stDetailSpeed.u16BlockIndex, HEADLENS);
	}
	else
	{
		stDetailSpeed.u16BlockIndex = 0;
	}

	//RTOSprintf("\r\n> ### u8DetailSpeed Lens: %d ###", stDetailSpeed.u16BlockIndex);

	// Make header
	stTableData.u8Code = 0x01;

	memcpy(stTableData.u8Name, u8Table6Name, 18);

	stTableData.u32Lens = HEADLENS + (stDetailSpeed.u16BlockIndex * DATELENS);

	SD_AddBuffToFile(cFileName, (uint8_t *)&stTableData.u8Code, sizeof(DataBlockTypeDef));

	if (stDetailSpeed.u16BlockIndex > 0)
	{
		u32FileSize = SD_GetFileSize(FILENAME_DETAILSPEED_DAY_2_TMP);

		u32DataSize = 0;

		u32GetSize = 0;

		do
		{
			//RTOSprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);

			if ((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}
			
			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
			
			SD_ReadAddrToBuff(FILENAME_DETAILSPEED_DAY_2_TMP, u8VDR_Buf, u32GetSize, u32DataSize);
			
			SD_AddBuffToFile(cFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
		}
		while(u32DataSize < u32FileSize);
	}
	else
	{
		u8Buf = 0x00;

		SD_AddBuffToFile(cFileName, &u8Buf, HEADLENS);
	}

	//========================================================================================

	LOGprintf("\r\n> ### MAKE_TABLE7_STEP ###");

	u16Len1 = 0;

	SD_ReadFileToBuff(FILENAME_CALIBRATION_TMP, (uint8_t*)&u16Len1, HEADLENS);

	u8Len1 = 0;

	SD_ReadFileToBuff(FILENAME_ADJUST_TMP, &u8Len1, SHORTHEAD);

	u8Len2 = 0;

	SD_ReadFileToBuff(FILENAME_DRIVING_TMP, &u8Len2, SHORTHEAD);

	u8Len3 = 0;

	SD_ReadFileToBuff(FILENAME_REST_TMP, &u8Len3, SHORTHEAD);

	// Make header
	stTableData.u8Code = 0x02;

	memcpy(stTableData.u8Name, u8Table7Name, 18);

	stTableData.u32Lens = sizeof(TechnicalDataTypeDef);
	stTableData.u32Lens += HEADLENS + (u16Len1 * CALIBRATIONLENS);
	stTableData.u32Lens += SHORTHEAD + (u8Len1 * ADJUSTLENS);
	stTableData.u32Lens += SHORTHEAD + (u8Len2 * DRIVERTIMELENS);
	stTableData.u32Lens += SHORTHEAD + (u8Len3 * RESTLENS);

	SD_AddBuffToFile(cFileName, (uint8_t *)&stTableData.u8Code, sizeof(DataBlockTypeDef));

	//SD_MakeTwoFilesInOne(FILENAME_TECHNICAL_TMP, filename);
	u32FileSize = SD_GetFileSize(FILENAME_TECHNICAL_TMP);
	u32DataSize = 0;
	u32GetSize = 0;

	do
	{
		if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}

		//RTOSprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d, u32GetSize: %d ###",
		//		u32FileSize, u32DataSize, u32GetSize);

    osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

	  if(osRes != osOK)
	  {
	    RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
	    return; 
	  }

		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

		SD_ReadAddrToBuff(FILENAME_TECHNICAL_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

		SD_AddBuffToFile(cFileName, u8VDR_Buf, u32GetSize);
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);

		u32DataSize += u32GetSize;

	}
	while(u32DataSize < u32FileSize);

	SD_AddBuffToFile(cFileName, (uint8_t *)&u16Len1, HEADLENS);

	if(u16Len1 > 0)
	{
		for(i = 0; i < u16Len1; i++)
		{
			SD_ReadAddrToBuff(FILENAME_CALIBRATION_TMP, (uint8_t *)&stCalibration.u8NameID,
			                  CALIBRATIONLENS, HEADLENS+(i*CALIBRATIONLENS));

			SD_AddBuffToFile(cFileName, (uint8_t *)&stCalibration.u8NameID, CALIBRATIONLENS);
		}
	}

	SD_AddBuffToFile(cFileName, (uint8_t *)&u8Len1, SHORTHEAD);

	if(u8Len1 > 0)
	{
		for(i = 0; i < u16Len1; i++)
		{
			SD_ReadAddrToBuff(FILENAME_ADJUST_TMP, (uint8_t *)&stAdjust.u8BeforeDateBCD,
			                  ADJUSTLENS, SHORTHEAD+(i*ADJUSTLENS));

			SD_AddBuffToFile(cFileName, (uint8_t *)&stAdjust.u8BeforeDateBCD, ADJUSTLENS);
		}
	}

	SD_AddBuffToFile(cFileName, (uint8_t *)&u8Len2, SHORTHEAD);

	if(u8Len2 > 0)
	{
		for(i = 0; i < u8Len2; i++)
		{
			SD_ReadAddrToBuff(FILENAME_DRIVING_TMP, (uint8_t *)&stDrivingTime.u8BeforeDateBCD,
			                  DRIVERTIMELENS, SHORTHEAD + (i * DRIVERTIMELENS));

			SD_AddBuffToFile(cFileName, (uint8_t *)&stDrivingTime.u8BeforeDateBCD, DRIVERTIMELENS);
		}
	}

	SD_AddBuffToFile(cFileName, (uint8_t *)&u8Len3, SHORTHEAD);

	if(u8Len3 > 0)
	{
		for(i = 0; i < u8Len3; i++)
		{
			SD_ReadAddrToBuff(FILENAME_REST_TMP, (uint8_t *)&stRestTime.u8BeforeDateBCD,
			                  RESTLENS, SHORTHEAD + (i * RESTLENS));

			SD_AddBuffToFile(cFileName, (uint8_t *)&stRestTime.u8BeforeDateBCD, RESTLENS);
		}
	}

	//========================================================================================

	LOGprintf("\r\n> ### MAKE_TABLE8_STEP ###");

	memset(&stDriving, 0x00, sizeof(DriveDataTypeDef));

	bRes = SD_CheckFileExist(FILENAME_DRIVE_DAY_2_TMP);

	if(bRes == TRUE)
	{
		SD_ReadFileToBuff(FILENAME_DRIVE_DAY_2_TMP, (uint8_t *)&stDriving.u16BlockIndex, HEADLENS);
	}
	else
	{
		stDriving.u16BlockIndex = 0;
	}

	// Make header
	stTableData.u8Code = 0x03;

	memcpy(stTableData.u8Name, u8Table8Name, 18);

	stTableData.u32Lens = HEADLENS + (stDriving.u16BlockIndex * DRIVINGLENS);

	SD_AddBuffToFile(cFileName, (uint8_t *)&stTableData.u8Code, sizeof(DataBlockTypeDef));

	if (stDriving.u16BlockIndex > 0)
	{
		u32FileSize = SD_GetFileSize(FILENAME_DRIVE_DAY_2_TMP);

		u32DataSize = 0;

		u32GetSize = 0;

		do
		{
			//RTOSprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);

			if ((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}
			
			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
			
			SD_ReadAddrToBuff(FILENAME_DRIVE_DAY_2_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

			SD_AddBuffToFile(cFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
		}
		while(u32DataSize < u32FileSize);
	}
	else
	{
		u8Buf = 0x00;

		SD_AddBuffToFile(cFileName, &u8Buf, HEADLENS);
	}

	//========================================================================================

	LOGprintf("\r\n> ### MAKE_TABLE9_STEP ###");

	u8Buf = 0x00;

	memset(&stPositionData, 0x00, sizeof(PositionDataTypeDef));

	bRes = SD_CheckFileExist(FILENAME_POSITION_DAY_2_TMP);

	if(bRes == TRUE)
	{
		SD_ReadFileToBuff(FILENAME_POSITION_DAY_2_TMP, (uint8_t *)&stPositionData.u16BlockIndex, HEADLENS);
	}
	else
	{
		stPositionData.u16BlockIndex = 0;
	}

	// Make header
	stTableData.u8Code = 0x04;

	memcpy(stTableData.u8Name, u8Table9Name, 18);

	stTableData.u32Lens = HEADLENS + (stPositionData.u16BlockIndex * POSLENS);

	SD_AddBuffToFile(cFileName, (uint8_t *)&stTableData.u8Code, sizeof(DataBlockTypeDef));

	if(stPositionData.u16BlockIndex > 0)
	{
		u32FileSize = SD_GetFileSize(FILENAME_POSITION_DAY_2_TMP);

		u32DataSize = 0;

		u32GetSize = 0;

		do
		{
			//LOGprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);

			if ((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}
			
			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
			
			SD_ReadAddrToBuff(FILENAME_POSITION_DAY_2_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

			SD_AddBuffToFile(cFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
		}
		while(u32DataSize < u32FileSize);
	}
	else
	{
		u8Buf = 0x00;

		SD_AddBuffToFile(cFileName, &u8Buf, HEADLENS);
	}

	//========================================================================================

	LOGprintf("\r\n> ### MAKE_TABLE10_STEP ###");

	u8Buf = 0x00;

	memset(&stExternal, 0x00, sizeof(ExternalDataTypeDef));

	bRes = SD_CheckFileExist(FILENAME_EXTERNAL_DAY_2_TMP);

	if(bRes == TRUE)
	{
		SD_ReadFileToBuff(FILENAME_EXTERNAL_DAY_2_TMP, (uint8_t *)&stExternal.u16BlockIndex, HEADLENS);
	}
	else
	{
		stPositionData.u16BlockIndex = 0;
	}

	// Make header
	stTableData.u8Code = 0x05;

	memcpy(stTableData.u8Name, u8Table10Name, 18);

	stTableData.u32Lens = HEADLENS + (stExternal.u16BlockIndex * EXTLENS);

	SD_AddBuffToFile(cFileName, (uint8_t *)&stTableData.u8Code, sizeof(DataBlockTypeDef));

	if(stExternal.u16BlockIndex > 0)
	{
		u32FileSize = SD_GetFileSize(FILENAME_EXTERNAL_DAY_2_TMP);

		u32DataSize = 0;

		u32GetSize = 0;

		do
		{
			//RTOSprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);

			if ((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}
			
			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
			
			SD_ReadAddrToBuff(FILENAME_EXTERNAL_DAY_2_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

			SD_AddBuffToFile(cFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
		}
		while(u32DataSize < u32FileSize);
	}
	else
	{
		u8Buf = 0x00;

		SD_AddBuffToFile(cFileName, &u8Buf, HEADLENS);
	}

	//========================================================================================	
	
	LOGprintf("\r\n> ### Make CheckSum ###");

	u32FileSize = SD_GetFileSize(cFileName);

	u32DataSize = 0;

	u32GetSize = 0;

	CheckSum = 0;

	do
	{
		//RTOSprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);

		if ((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}
		
		osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

	  if(osRes != osOK)
	  {
	    RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
	    return; 
	  }

		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

		SD_ReadAddrToBuff(cFileName, u8VDR_Buf, u32GetSize, u32DataSize);

		for(i = 0; i < u32GetSize; i++)
		{
			CheckSum = CheckSum ^ u8VDR_Buf[i];
		}
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);

		u32DataSize += u32GetSize;
	}
	while(u32DataSize < u32FileSize);

	LOGprintf("\r\n> ### CheckSum Make OK!! ###");

	SD_AddBuffToFile(cFileName, &CheckSum, SHORTHEAD);

	if (bKeepDayDataFlag == FALSE)
	{
		LOGprintf("\r\n> ### Drive Status Record ###");
		
		u8Buf = 0;
		
		ttFileTime = System_GetTime();
		
		u8Buf = ((ttFileTime - ttLastLogTime) / DAY_2_SECOND(1))+1;
		//RTOSprintf("\r\n> ### Before Day: %d ###", u8Buf);

		for(j=0; j<u8Buf; j++)
		{
			for(i = 0; i < 13; i++)
			{
				g_Setting.stDrvRecDay[i].u32WorkTime = g_Setting.stDrvRecDay[i+1].u32WorkTime;
				g_Setting.stDrvRecDay[i].u32PauseTime = g_Setting.stDrvRecDay[i+1].u32PauseTime;
				g_Setting.stDrvRecDay[i].u32StandByTime = g_Setting.stDrvRecDay[i+1].u32StandByTime;
				g_Setting.stDrvRecDay[i].u32RestTime = g_Setting.stDrvRecDay[i+1].u32RestTime;

				g_Setting.stDrvRecDay2[i].u32WorkTime = g_Setting.stDrvRecDay2[i+1].u32WorkTime;
				g_Setting.stDrvRecDay2[i].u32PauseTime = g_Setting.stDrvRecDay2[i+1].u32PauseTime;
				g_Setting.stDrvRecDay2[i].u32StandByTime = g_Setting.stDrvRecDay2[i+1].u32StandByTime;
				g_Setting.stDrvRecDay2[i].u32RestTime = g_Setting.stDrvRecDay2[i+1].u32RestTime;
			}
			
			g_Setting.stDrvRecDay[13].u32WorkTime = 0;
			g_Setting.stDrvRecDay[13].u32PauseTime = 0;
			g_Setting.stDrvRecDay[13].u32StandByTime = 0;
			g_Setting.stDrvRecDay[13].u32RestTime = 0;

			g_Setting.stDrvRecDay2[13].u32WorkTime = 0;
			g_Setting.stDrvRecDay2[13].u32PauseTime = 0;
			g_Setting.stDrvRecDay2[13].u32StandByTime = 0;
			g_Setting.stDrvRecDay2[13].u32RestTime = 0;
		}

		System_SaveSetting();
	}

	SD_RemoveFile(FILENAME_DETAILSPEED_DAY_2_TMP);
	SD_RemoveFile(FILENAME_DRIVE_DAY_2_TMP);
	SD_RemoveFile(FILENAME_POSITION_DAY_2_TMP);
	SD_RemoveFile(FILENAME_EXTERNAL_DAY_2_TMP);

	//RTOSprintf("\r\n> [SYS]%04X", SYS_STATE_MAKE_VDR_STOP);

//=================================================================================		

	LOGprintf("\r\n> ### Make VDR OK!! ###");

	LOGprintf("\r\n> ### Make VDR Used: %d ms ###", HAL_GetTick() - u32TickTime);

	if (bKeepDayDataFlag == TRUE)
	{
		USB_DownloadFile(cFileName);
		
		bKeepDayDataFlag = FALSE;
	}

	return TRUE;
}
#endif

#if 0
//============================================================================//
// @brief  Make VDR file for a number of hours.
// @param  u8GetHour: Number of hour to make the VDR file.
// @retval None.
//============================================================================//
bool V161_CreateHourDataProc(uint8_t u8GetHour)
{
	char szHourFileName[100] = {0};
	uint8_t u8BCDTime2[7] = {0};
	uint8_t u8Buff = 0, u8Buff2 = 0, u8Buff3 = 0, u8CheckSum = 0;
	uint16_t u16Buf = 0, u16Buf2 = 0, u16Idx, i;
	uint32_t u32StartSec = 0, u32Sec = 0, u32EndSec, u32TableLens[6];
	uint32_t u32FileSize, u32DataSize = 0, u32GetSize = 0;
	uint16_t u16Idx1, u16Idx2, u16Idx3;

	DetailSpeedTypeDef stDSpeed;
	DriveDataTypeDef stDriveData;
	PositionDataTypeDef	stPosData;
	BreakdownDataTypeDef stBKData;
	EventDataTypeDef stEData;
	CalibrationDataTypeDef stCalData;
	AdjustDataTypeDef stAdjData;
	DrivingTimeTypeDef stDriData;
	RestDataTypeDef stRestData;
	ExternalDataTypeDef stExternal;

	//Gary Test use time
	//uint32_t u32TickTime = 0;
	uint32_t u32TickTime_All = 0;


	//================================================================================

	LOGprintf("\r\n> ### V161 CreateHourDataProc, Get %d Hour Data ###", u8GetHour);

	u32TickTime_All = HAL_GetTick();

	bDoneHourVDRFile = FALSE;

	for(i = 0; i < 6; i++)
	{
		u32TableLens[i] = 0;
	}

	//================================================================================

	LOGprintf("\r\n> ### Make Start & End time ###");

	u32EndSec = System_GetTime();

	u32StartSec = u32EndSec - HOUR_2_SECOND(u8GetHour);

	SecToBCDTime(u32EndSec, u8BCDTime2);

	if(bHourDataFlag == FALSE)
	{
		sprintf(szHourFileName, "%s/D%02X%02X%02X%02X_%02X%02X%02X_%s.VDR",
		        (char *)FOLDERNAME_VDR,
		        u8BCDTime2[0], u8BCDTime2[1], u8BCDTime2[2], u8BCDTime2[3],
		        u8BCDTime2[4], u8BCDTime2[5], u8BCDTime2[6], g_Setting.tBusInfo.cBus_ID);
	}
	else
	{
		sprintf(szHourFileName, "%s/D%02X%02X%02X%02X_%02X_%02d_%s.VDR",
		        (char *)FOLDERNAME_VDR,
		        u8BCDTime2[0], u8BCDTime2[1], u8BCDTime2[2], u8BCDTime2[3],
		        u8BCDTime2[4], u8HourDataCnt, g_Setting.tBusInfo.cBus_ID);

		memset(cPC_HourFileName, 0x00, sizeof(cPC_HourFileName));

		sprintf(cPC_HourFileName, "%s", szHourFileName);
	}

	LOGprintf("\r\n> ### HourFileName: %s ###", szHourFileName);

	if(SD_CheckFileExist(szHourFileName))
		SD_RemoveFile(szHourFileName);

	LOGprintf("\r\n> ### End Time: %02X%02X/%02X/%02X %02X:%02X:%02X  Sec: %d ###",
	           u8BCDTime2[0], u8BCDTime2[1], u8BCDTime2[2], u8BCDTime2[3],
	           u8BCDTime2[4], u8BCDTime2[5], u8BCDTime2[6], u32EndSec);

	SecToBCDTime(u32StartSec, u8BCDTime2);

	LOGprintf("\r\n> ### Start Time: %02X%02X/%02X/%02X %02X:%02X:%02X Sec: %d ###",
	           u8BCDTime2[0], u8BCDTime2[1], u8BCDTime2[2], u8BCDTime2[3],
	           u8BCDTime2[4], u8BCDTime2[5], u8BCDTime2[6], u32StartSec);

	//================================================================================

	LOGprintf("\r\n> ### Add Hearder to Hour VDR ###");

	SD_WriteBuffToFile(szHourFileName, (uint8_t *)&u16BlockCnt, 2);

	//================================================================================

	LOGprintf("\r\n> ### Add TABLE 5 to Hour VDR ###");

	//u32TickTime = HAL_GetTick();

	u8Buff = 0x00;
	
	SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table5Name, 18);

	u8Buff = 0x00;
	
	SD_ReadFileToBuff(FILENAME_BREAKDOWN_TMP, &u8Buff, SHORTHEAD);
	u32TableLens[0] += (BREAKDOWNLENS * u8Buff) + SHORTHEAD;

	u8Buff2 = 0x00;
	
	SD_ReadFileToBuff(FILENAME_EVENT_TMP, &u8Buff2, SHORTHEAD);
	u32TableLens[0] += (EVENTLENS * u8Buff2) + SHORTHEAD;

	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[0], 4);

	SD_AddBuffToFile(szHourFileName, (uint8_t*)&u8Buff, SHORTHEAD);
	
	if(u8Buff > 0)
	{
		for(i = 0; i < u8Buff; i++)
		{
			SD_ReadAddrToBuff(FILENAME_BREAKDOWN_TMP, &stBKData.u8Code, BREAKDOWNLENS, SHORTHEAD + (i * BREAKDOWNLENS));
			
			SD_AddBuffToFile(szHourFileName, &stBKData.u8Code, BREAKDOWNLENS);
		}
	}

	SD_AddBuffToFile(szHourFileName, (uint8_t*)&u8Buff2, SHORTHEAD);
	
	if(u8Buff2 > 0)
	{
		for(i = 0; i<u8Buff2; i++)
		{
			SD_ReadAddrToBuff(FILENAME_EVENT_TMP, &stEData.u8Code, EVENTLENS, SHORTHEAD + (i * EVENTLENS));
			
			SD_AddBuffToFile(szHourFileName, &stEData.u8Code, EVENTLENS);
		}
	}

	//LOGprintf("\r\n> Table 5 used %d ms", (HAL_GetTick() - u32TickTime));

	//================================================================================

	LOGprintf("\r\n> ### Add TABLE 6 to Hour VDR ###");

	//u32TickTime = HAL_GetTick();

	u16Idx = 0;
	u16Buf = 0;
	u16Buf2 = 0;
	u8Buff = 0x01;
	
	SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table6Name, 18);

	#if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_DETAILSPEED_TMP, (uint8_t *)&u16Idx, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_DETAILSPEED_TMP, &u16Idx);
	#endif
	
	if(u16Idx > 1)
	{
		u16Buf = u16Idx - 1;

		do
		{
			SD_ReadAddrToBuff(FILENAME_DETAILSPEED_TMP, (uint8_t *)&stDSpeed.u8DateBCD,
			                  DATELENS, HEADLENS + (u16Buf * DATELENS));
			
			u32Sec = BCDTimeToSec(stDSpeed.u8DateBCD);

			u16Buf--;
			u16Buf2++;

			if(u16Buf == 0)
				break;
		
		}while(u32Sec > u32StartSec);

		u16Buf2++;
	}

	u32TableLens[1] = HEADLENS + (u16Buf2 * DATELENS);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[1], 4);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf2, HEADLENS);

	if (u16Idx > 0)
	{
		u32FileSize = HEADLENS + (u16Idx * DATELENS);
		
		u32DataSize = HEADLENS + (u16Buf * DATELENS);
		
		u32GetSize = 0;

		do
		{
			if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}

			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

			SD_ReadAddrToBuff(FILENAME_DETAILSPEED_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

			SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
			
		} while(u32DataSize < u32FileSize);
	}

	//LOGprintf("\r\n> Table 6 used %d ms", (HAL_GetTick() - u32TickTime));

	//================================================================================

	LOGprintf("\r\n> ### Add TABLE 7 to Hour VDR ###");

	//u32TickTime = HAL_GetTick();

	u8Buff = 0x02;
	
	SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table7Name, 18);

	u16Buf = 0;
	
	SD_ReadFileToBuff(FILENAME_CALIBRATION_TMP, (uint8_t *)&u16Buf, HEADLENS);

	u8Buff = 0;
	
	SD_ReadFileToBuff(FILENAME_ADJUST_TMP, &u8Buff, SHORTHEAD);

	u8Buff2 = 0;
	
	SD_ReadFileToBuff(FILENAME_DRIVING_TMP, &u8Buff2, SHORTHEAD);

	u8Buff3 = 0;
	
	SD_ReadFileToBuff(FILENAME_REST_TMP, &u8Buff3, SHORTHEAD);


	u32TableLens[2] += sizeof(TechnicalDataTypeDef);
	u32TableLens[2] += HEADLENS + (u16Buf * CALIBRATIONLENS);
	u32TableLens[2] += SHORTHEAD + (u8Buff * ADJUSTLENS);
	u32TableLens[2] += SHORTHEAD + (u8Buff2 * DRIVERTIMELENS);
	u32TableLens[2] += SHORTHEAD + (u8Buff3 * RESTLENS);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[2], 4);

	u32FileSize = SD_GetFileSize(FILENAME_TECHNICAL_TMP);
	
	u32DataSize = 0;
	u32GetSize = 0;

	do
	{
		if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}
		
		osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

	  if(osRes != osOK)
	  {
	    RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
	    return; 
	  }

		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
		
		SD_ReadAddrToBuff(FILENAME_TECHNICAL_TMP, u8VDR_Buf, u32GetSize, u32DataSize);
		
		SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);
		
		u32DataSize += u32GetSize;
	}
	while(u32DataSize < u32FileSize);

	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf, HEADLENS);
	
	if(u16Buf > 0)
	{
		for(i = 0; i < u16Buf; i++)
		{
			SD_ReadAddrToBuff(FILENAME_CALIBRATION_TMP, (uint8_t *)&stCalData.u8NameID,
			                  CALIBRATIONLENS, HEADLENS+(i * CALIBRATIONLENS));
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&stCalData.u8NameID, CALIBRATIONLENS);
		}
	}

	SD_AddBuffToFile(szHourFileName, &u8Buff, SHORTHEAD);
	
	if(u8Buff > 0)
	{
		for(i = 0; i < u8Buff; i++)
		{
			SD_ReadAddrToBuff(FILENAME_ADJUST_TMP, (uint8_t *)&stAdjData.u8BeforeDateBCD,
			                  ADJUSTLENS, SHORTHEAD + (i * ADJUSTLENS));
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&stAdjData.u8BeforeDateBCD, ADJUSTLENS);
		}
	}

	SD_AddBuffToFile(szHourFileName, &u8Buff2, SHORTHEAD);
	
	if(u8Buff2 > 0)
	{
		for(i=0; i < u8Buff2; i++)
		{
			SD_ReadAddrToBuff(FILENAME_DRIVING_TMP, (uint8_t *)&stDriData.u8BeforeDateBCD,
			                  DRIVERTIMELENS, SHORTHEAD + (i * DRIVERTIMELENS));
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&stDriData.u8BeforeDateBCD, DRIVERTIMELENS);
		}
	}

	SD_AddBuffToFile(szHourFileName, &u8Buff3, SHORTHEAD);
	
	if(u8Buff3 > 0)
	{
		for(i = 0; i < u8Buff3; i++)
		{
			SD_ReadAddrToBuff(FILENAME_REST_TMP, (uint8_t *)&stRestData.u8BeforeDateBCD,
			                  RESTLENS, SHORTHEAD + (i * RESTLENS));
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&stRestData.u8BeforeDateBCD, RESTLENS);
		}
	}

	//RTOSprintf("\r\n> Table 7 used %d ms", (HAL_GetTick() - u32TickTime));

	//================================================================================

	LOGprintf("\r\n> ### Add TABLE 8 to Hour VDR ###");

	//u32TickTime = HAL_GetTick();

	u16Buf = 0;
	u16Buf2 = 0;
	u16Idx = 0;

	u8Buff = 0x03;
	
	SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table8Name, 18);

	#if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_DRIVE_TMP, (uint8_t *)&u16Idx, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_DRIVE_TMP, &u16Idx);
	#endif
	
	u16DrvIdx = u16Idx;

	if(u16Idx > 1)
	{
		u16Idx2 = u16Idx - 1;
		u16Idx1 = 0;

		do
		{
			u16Idx3 = u16Idx1 + ((u16Idx2 - u16Idx1) / 2);
			
			SD_ReadAddrToBuff(FILENAME_DRIVE_TMP, (uint8_t *)&stDriveData.u8DriverName,
			                  DRIVINGLENS, HEADLENS + (u16Idx3 * DRIVINGLENS));
			
			u32Sec = BCDTimeToSec(stDriveData.u8DriveDateBCD);

			if(u32Sec > u32StartSec)
			{
				u16Idx2 = u16Idx3;
			}
			else
			{
				u16Idx1 = u16Idx3;
			}

			if((u16Idx2 - u16Idx1) < 2)
			{
				if (u32Sec > u32StartSec)
				{
					u16Idx3 -= 2;
				}
				
				break;
			}
			
		}while(u32Sec != u32StartSec);
	}

	u16Buf2 = u16Idx - u16Idx3;
	u16Buf = u16Idx3;
	
	u32TableLens[3] = HEADLENS + (u16Buf2 * DRIVINGLENS);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[3], 4);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf2, HEADLENS);

	if(u16Idx > 0)
	{
		u32FileSize = HEADLENS + (u16Idx * DRIVINGLENS);
		u32DataSize = HEADLENS + (u16Buf * DRIVINGLENS);
		u32GetSize = 0;

		do
		{
			if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}

			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

			SD_ReadAddrToBuff(FILENAME_DRIVE_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

			SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
			
		} while(u32DataSize < u32FileSize);
	}

	//RTOSprintf("\r\n> Table 8 used %d ms", (HAL_GetTick() - u32TickTime));

	//================================================================================

	LOGprintf("\r\n> ### Add TABLE 9 to Hour VDR ###");

	//u32TickTime = HAL_GetTick();

	u16Buf = 0;
	u16Buf2 = 0;
	u16Idx = 0;

	u8Buff = 0x04;
	SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table9Name, 18);

	#if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_POSITION_TMP, (uint8_t *)&u16Idx, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_POSITION_TMP, &u16Idx);
	#endif

	if(u16Idx > 1)
	{
		u16Buf = u16Idx - 1;

		do
		{
			SD_ReadAddrToBuff(FILENAME_POSITION_TMP, (uint8_t *)&stPosData.u8DateBCD,
			                  POSLENS, HEADLENS + (u16Buf * POSLENS));
			
			u32Sec = BCDTimeToSec(stPosData.u8DateBCD);

			u16Buf--;
			u16Buf2++;

			if(u16Buf == 0)
				break;

		} while(u32Sec > u32StartSec);

		u16Buf2++;
	}

	u32TableLens[4] = HEADLENS + (u16Buf2 * POSLENS);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[4], 4);
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf2, HEADLENS);

	if (u16Idx > 0)
	{
		u32FileSize = HEADLENS + (u16Idx * POSLENS);
		u32DataSize = HEADLENS + (u16Buf * POSLENS);
		u32GetSize = 0;

		do
		{
			if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}

			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

			SD_ReadAddrToBuff(FILENAME_POSITION_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

			SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
		}
		while(u32DataSize < u32FileSize);
	}

	//RTOSprintf("\r\n> Table 9 used %d ms", (HAL_GetTick() - u32TickTime));

	//================================================================================

	LOGprintf("\r\n> ### Add TABLE 10 to Hour VDR ###");

	//u32TickTime = HAL_GetTick();

	u16Buf = 0;
	u16Buf2 = 0;
	u16Idx = 0;

	u8Buff = 0x05;
	SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table10Name, 18);

	#if !ENABLE_INDEX_BUFFER
	SD_ReadFileToBuff(FILENAME_EXTERNAL_TMP, (uint8_t *)&u16Idx, HEADLENS);
	#else
	V161_GetFileIdx(FILENAME_EXTERNAL_TMP, &u16Idx);
	#endif

	if(u16Idx > 1)
	{
		u16Buf = u16Idx - 1;

		do
		{
			SD_ReadAddrToBuff(FILENAME_EXTERNAL_TMP, (uint8_t *)&stExternal.u8DateBCD,
			                  EXTLENS, HEADLENS + (u16Buf * EXTLENS));
			
			u32Sec = BCDTimeToSec(stPosData.u8DateBCD);

			u16Buf--;
			u16Buf2++;

			if(u16Buf == 0)
				break;

		}
		while(u32Sec > u32StartSec);

		u16Buf2++;
	}

	u32TableLens[5] = HEADLENS + (u16Buf2 * EXTLENS);
	
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[5], 4);
	SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf2, HEADLENS);

	if (u16Idx > 0)
	{
		u32FileSize = HEADLENS + (u16Idx * EXTLENS);
		u32DataSize = HEADLENS + (u16Buf * EXTLENS);
		
		u32GetSize = 0;

		do
		{
			if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}

			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

			SD_ReadAddrToBuff(FILENAME_EXTERNAL_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

			SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
		}
		while(u32DataSize < u32FileSize);
	}

	//LOGprintf("\r\n> Table 9 used %d ms", (HAL_GetTick() - u32TickTime));

	//================================================================================

	LOGprintf("\r\n> ### Add CheckSum to Hour VDR ###");

	//u32TickTime = HAL_GetTick();

	u32FileSize = SD_GetFileSize(szHourFileName);
	
	u32DataSize = 0;
	u32GetSize = 0;
	u8CheckSum = 0;

	do
	{
		if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}
		
		osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

	  if(osRes != osOK)
	  {
	    RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
	    return; 
	  }

		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

		SD_ReadAddrToBuff(szHourFileName, u8VDR_Buf, u32GetSize, u32DataSize);
	
		for(i=0; i < u32GetSize; i++)
		{
			u8CheckSum = u8CheckSum ^ u8VDR_Buf[i];
		}
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);

		u32DataSize += u32GetSize;
	}
	while(u32DataSize < u32FileSize);

	SD_AddBuffToFile(szHourFileName, &u8CheckSum, SHORTHEAD);

	//LOGprintf("\r\n> CheckSum used %d ms", (HAL_GetTick() - u32TickTime));

	LOGprintf("\r\n> ### Hour file OK, Used: %d ms ###", (HAL_GetTick() - u32TickTime_All));

	//================================================================================

	//RTOSprintf("\r\n> ### Start USB Download Process ###");

	//strcpy(g_cVDRFileName, szHourFileName);

	if(bDLRS232Flag == FALSE)
	{
		LOGprintf("\r\n> ### Download Now ###");

		bIsDelVDRFileFlag = TRUE;
		
		//g_bUSBDownloadFlg = TRUE;
		USB_DownloadFile(szHourFileName);
	}

	bDLRS232Flag = FALSE;

	bHourDataFlag = FALSE;

	//================================================================================
	LOGprintf("\r\n> ### V161_CreateHourDataProc OK ###");

	bDoneHourVDRFile = TRUE;

	return TRUE;
}

#endif

void V161_CreateHourDataProc(uint8_t u8GetHour)
{
	static char szHourFileName[100] = {0};
	uint8_t u8BCDTime2[7] = {0};
	static uint8_t u8Buff = 0, u8Buff2 = 0, u8Buff3 = 0, u8CheckSum = 0;
	static uint16_t u16Buf = 0, u16Buf2 = 0, u16Idx;
	uint16_t  i;
	static uint32_t u32StartSec = 0, u32Sec = 0, u32EndSec, u32TableLens[6];
	static uint32_t u32FileSize, u32DataSize = 0, u32GetSize = 0;
	static uint16_t u16Idx1, u16Idx2, u16Idx3;
	static DetailSpeedTypeDef stDSpeed;
	static DriveDataTypeDef stDriveData;
	static PositionDataTypeDef	stPosData;
	static BreakdownDataTypeDef stBKData;
	static EventDataTypeDef stEData;
	static CalibrationDataTypeDef stCalData;
	static AdjustDataTypeDef stAdjData;
	static DrivingTimeTypeDef stDriData;
	static RestDataTypeDef stRestData;
	static ExternalDataTypeDef stExternal;
	static uint32_t u32TickTime_All = 0;
	osStatus osRes;
	
	
	if(procCreateHourData == PROC_STEP_NULL)
		return;
	
	LOGprintf("\r\n> ### procCreateHourData: %d ###", (int)procCreateHourData);
	
	switch((int)procCreateHourData)
	{
		case PROC_STEP_1:
			LOGprintf("\r\n> ### V161 CreateHourDataProc, Get %d Hour Data ###", u8GetHour);

			u32TickTime_All = HAL_GetTick();

			//bDoneHourVDRFile = FALSE;

			for(i = 0; i < 6; i++)
			{
				u32TableLens[i] = 0;
			}
			
			procCreateHourData = PROC_STEP_2;
			
			break;
			
		case PROC_STEP_2:
			LOGprintf("\r\n> ### Make Start & End time ###");

			u32EndSec = System_GetTime();

			u32StartSec = u32EndSec - HOUR_2_SECOND(u8GetHour);

			SecToBCDTime(u32EndSec, u8BCDTime2);

			if(bHourDataFlag == FALSE)
			{
				sprintf(szHourFileName, "%s/D%02X%02X%02X%02X_%02X%02X%02X_%s.VDR",
				        (char *)FOLDERNAME_VDR,
				        u8BCDTime2[0], u8BCDTime2[1], u8BCDTime2[2], u8BCDTime2[3],
				        u8BCDTime2[4], u8BCDTime2[5], u8BCDTime2[6], g_Setting.tBusInfo.cBus_ID);
			}
			else
			{
				sprintf(szHourFileName, "%s/D%02X%02X%02X%02X_%02X_%02d_%s.VDR",
				        (char *)FOLDERNAME_VDR,
				        u8BCDTime2[0], u8BCDTime2[1], u8BCDTime2[2], u8BCDTime2[3],
				        u8BCDTime2[4], u8HourDataCnt, g_Setting.tBusInfo.cBus_ID);

				memset(cPC_HourFileName, 0x00, sizeof(cPC_HourFileName));

				sprintf(cPC_HourFileName, "%s", szHourFileName);
			}

			LOGprintf("\r\n> ### HourFileName: %s ###", szHourFileName);
			
			if(SD_CheckFileExist(szHourFileName))
				SD_RemoveFile(szHourFileName);

			LOGprintf("\r\n> ### End Time: %02X%02X/%02X/%02X %02X:%02X:%02X  Sec: %d ###",
			           u8BCDTime2[0], u8BCDTime2[1], u8BCDTime2[2], u8BCDTime2[3],
			           u8BCDTime2[4], u8BCDTime2[5], u8BCDTime2[6], u32EndSec);
			           
			procCreateHourData = PROC_STEP_3;
			break;
			
		case PROC_STEP_3:
			SecToBCDTime(u32StartSec, u8BCDTime2);

			LOGprintf("\r\n> ### Start Time: %02X%02X/%02X/%02X %02X:%02X:%02X Sec: %d ###",
			           u8BCDTime2[0], u8BCDTime2[1], u8BCDTime2[2], u8BCDTime2[3],
			           u8BCDTime2[4], u8BCDTime2[5], u8BCDTime2[6], u32StartSec);

			LOGprintf("\r\n> ### Add Hearder to Hour VDR ###");

			SD_WriteBuffToFile(szHourFileName, (uint8_t *)&u16BlockCnt, 2);
			
			procCreateHourData = PROC_STEP_4;
			
			break;
			
			
		case PROC_STEP_4:
			LOGprintf("\r\n> ### Add TABLE 5 to Hour VDR ###");

			u8Buff = 0x00;
			SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table5Name, 18);

			u8Buff = 0x00;
			SD_ReadFileToBuff(FILENAME_BREAKDOWN_TMP, &u8Buff, SHORTHEAD);
			u32TableLens[0] += (BREAKDOWNLENS * u8Buff) + SHORTHEAD;

			u8Buff2 = 0x00;
			SD_ReadFileToBuff(FILENAME_EVENT_TMP, &u8Buff2, SHORTHEAD);
			u32TableLens[0] += (EVENTLENS * u8Buff2) + SHORTHEAD;

			SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[0], 4);
				
			procCreateHourData = PROC_STEP_5;
				
			break;
			
		case PROC_STEP_5:
			SD_AddBuffToFile(szHourFileName, (uint8_t*)&u8Buff, SHORTHEAD);
			
			if(u8Buff > 0)
			{
				for(i = 0; i < u8Buff; i++)
				{
					SD_ReadAddrToBuff(FILENAME_BREAKDOWN_TMP, &stBKData.u8Code, BREAKDOWNLENS, SHORTHEAD + (i * BREAKDOWNLENS));
					
					SD_AddBuffToFile(szHourFileName, &stBKData.u8Code, BREAKDOWNLENS);
				}
			}
			
			procCreateHourData = PROC_STEP_6;
			
			break;
			
		case PROC_STEP_6:
			SD_AddBuffToFile(szHourFileName, (uint8_t*)&u8Buff2, SHORTHEAD);
			
			if(u8Buff2 > 0)
			{
				for(i = 0; i<u8Buff2; i++)
				{
					SD_ReadAddrToBuff(FILENAME_EVENT_TMP, &stEData.u8Code, EVENTLENS, SHORTHEAD + (i * EVENTLENS));
					
					SD_AddBuffToFile(szHourFileName, &stEData.u8Code, EVENTLENS);
				}
			}
			
			procCreateHourData = PROC_STEP_7;
			
			break;
			
		case PROC_STEP_7:	
			LOGprintf("\r\n> ### Add TABLE 6 to Hour VDR ###");

			u16Idx = 0;
			u16Buf = 0;
			u16Buf2 = 0;
			u8Buff = 0x01;
			
			SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
			
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table6Name, 18);

			#if !ENABLE_INDEX_BUFFER
			SD_ReadFileToBuff(FILENAME_DETAILSPEED_TMP, (uint8_t *)&u16Idx, HEADLENS);
			#else
			V161_GetFileIdx(FILENAME_DETAILSPEED_TMP, &u16Idx);
			#endif
			
			if (u16Idx > 1)
			{
				u16Buf = u16Idx - 1;
				
				procCreateHourData = PROC_STEP_8;
			}
			else
			{
				procCreateHourData = PROC_STEP_10;
			}
			break;
			
		case PROC_STEP_8:
			SD_ReadAddrToBuff(FILENAME_DETAILSPEED_TMP, (uint8_t *)&stDSpeed.u8DateBCD,
			                  DATELENS, HEADLENS + (u16Buf * DATELENS));
			
			u32Sec = BCDTimeToSec(stDSpeed.u8DateBCD);

			u16Buf--;
			u16Buf2++;

			if(u16Buf == 0)
				break;
				
			procCreateHourData = PROC_STEP_9;
				
			break;
			
		
		case PROC_STEP_9:
			if(u32Sec > u32StartSec)
			{
				procCreateHourData = PROC_STEP_8;
			}
			else
			{
				u16Buf2++;
				
				procCreateHourData = PROC_STEP_10;
			}
			break;
		
		case PROC_STEP_10:
			u32TableLens[1] = HEADLENS + (u16Buf2 * DATELENS);
			
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[1], 4);
			
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf2, HEADLENS);
			
			procCreateHourData = PROC_STEP_11;
			
			break;
			
		case PROC_STEP_11:
			if(u16Idx > 0)
			{
				u32FileSize = HEADLENS + (u16Idx * DATELENS);
				
				u32DataSize = HEADLENS + (u16Buf * DATELENS);
				
				u32GetSize = 0;
				
				procCreateHourData = PROC_STEP_12;
			}
			else
			{
				procCreateHourData = PROC_STEP_14;
			}
			break;
		
		case PROC_STEP_12:
			if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}

			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

			SD_ReadAddrToBuff(FILENAME_DETAILSPEED_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

			SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
			
			procCreateHourData = PROC_STEP_13;
			
			break;
			
		case PROC_STEP_13:
			if(u32DataSize < u32FileSize)
			{
				procCreateHourData = PROC_STEP_12;
			}
			else
			{
				procCreateHourData = PROC_STEP_14;
			}
			break;
			
		case PROC_STEP_14:
			LOGprintf("\r\n> ### Add TABLE 7 to Hour VDR ###");

			u8Buff = 0x02;
			SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
			SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table7Name, 18);

			u16Buf = 0;
			SD_ReadFileToBuff(FILENAME_CALIBRATION_TMP, (uint8_t *)&u16Buf, HEADLENS);

			u8Buff = 0;
			SD_ReadFileToBuff(FILENAME_ADJUST_TMP, &u8Buff, SHORTHEAD);

			u8Buff2 = 0;
			SD_ReadFileToBuff(FILENAME_DRIVING_TMP, &u8Buff2, SHORTHEAD);

			u8Buff3 = 0;
			SD_ReadFileToBuff(FILENAME_REST_TMP, &u8Buff3, SHORTHEAD);
			
			procCreateHourData = PROC_STEP_15;
			break;
			
			case PROC_STEP_15:
				u32TableLens[2] += sizeof(TechnicalDataTypeDef);
				u32TableLens[2] += HEADLENS + (u16Buf * CALIBRATIONLENS);
				u32TableLens[2] += SHORTHEAD + (u8Buff * ADJUSTLENS);
				u32TableLens[2] += SHORTHEAD + (u8Buff2 * DRIVERTIMELENS);
				u32TableLens[2] += SHORTHEAD + (u8Buff3 * RESTLENS);
				
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[2], 4);

				u32FileSize = SD_GetFileSize(FILENAME_TECHNICAL_TMP);
				
				u32DataSize = 0;
				u32GetSize = 0;
				
				procCreateHourData = PROC_STEP_16;
				break;
				
			case PROC_STEP_16:
				if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
				{
					u32GetSize = MOVE_DATA_MAX_SIZE;
				}
				else
				{
					u32GetSize = u32FileSize - u32DataSize;
				}
				
				osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

				if(osRes != osOK)
				{
					RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
			
					return; 
				}

				memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
				
				SD_ReadAddrToBuff(FILENAME_TECHNICAL_TMP, u8VDR_Buf, u32GetSize, u32DataSize);
				
				SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
				
				osMutexRelease(mutex_data_buf1_user);
				
				u32DataSize += u32GetSize;
				
				procCreateHourData = PROC_STEP_17;
				break;
				
			case PROC_STEP_17:
				if(u32DataSize < u32FileSize)
				{
					procCreateHourData = PROC_STEP_16;
				}
				else
				{
					procCreateHourData = PROC_STEP_18;
				}
				break;
				
			case PROC_STEP_18:
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf, HEADLENS);
				
				if(u16Buf > 0)
				{
					for(i = 0; i < u16Buf; i++)
					{
						SD_ReadAddrToBuff(FILENAME_CALIBRATION_TMP, (uint8_t *)&stCalData.u8NameID,
						                  CALIBRATIONLENS, HEADLENS+(i * CALIBRATIONLENS));
						SD_AddBuffToFile(szHourFileName, (uint8_t *)&stCalData.u8NameID, CALIBRATIONLENS);
					}
				}
				
				procCreateHourData = PROC_STEP_19;
				break;
				
			case PROC_STEP_19:
				SD_AddBuffToFile(szHourFileName, &u8Buff, SHORTHEAD);
				
				if(u8Buff > 0)
				{
					for(i = 0; i < u8Buff; i++)
					{
						SD_ReadAddrToBuff(FILENAME_ADJUST_TMP, (uint8_t *)&stAdjData.u8BeforeDateBCD,
						                  ADJUSTLENS, SHORTHEAD + (i * ADJUSTLENS));
						SD_AddBuffToFile(szHourFileName, (uint8_t *)&stAdjData.u8BeforeDateBCD, ADJUSTLENS);
					}
				}
				
				procCreateHourData = PROC_STEP_20;
				break;
				
			case PROC_STEP_20:
				SD_AddBuffToFile(szHourFileName, &u8Buff2, SHORTHEAD);
				
				if(u8Buff2 > 0)
				{
					for(i=0; i < u8Buff2; i++)
					{
						SD_ReadAddrToBuff(FILENAME_DRIVING_TMP, (uint8_t *)&stDriData.u8BeforeDateBCD,
						                  DRIVERTIMELENS, SHORTHEAD + (i * DRIVERTIMELENS));
						SD_AddBuffToFile(szHourFileName, (uint8_t *)&stDriData.u8BeforeDateBCD, DRIVERTIMELENS);
					}
				}
				
				procCreateHourData = PROC_STEP_21;
				break;
				
			case PROC_STEP_21:
				SD_AddBuffToFile(szHourFileName, &u8Buff3, SHORTHEAD);
				
				if(u8Buff3 > 0)
				{
					for(i = 0; i < u8Buff3; i++)
					{
						SD_ReadAddrToBuff(FILENAME_REST_TMP, (uint8_t *)&stRestData.u8BeforeDateBCD,
						                  RESTLENS, SHORTHEAD + (i * RESTLENS));
						SD_AddBuffToFile(szHourFileName, (uint8_t *)&stRestData.u8BeforeDateBCD, RESTLENS);
					}
				}
				
				procCreateHourData = PROC_STEP_22;
				break;
				
			case PROC_STEP_22:
				LOGprintf("\r\n> ### Add TABLE 8 to Hour VDR ###");

				u16Buf = 0;
				u16Buf2 = 0;
				u16Idx = 0;

				u8Buff = 0x03;
				
				SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table8Name, 18);

				#if !ENABLE_INDEX_BUFFER
				SD_ReadFileToBuff(FILENAME_DRIVE_TMP, (uint8_t *)&u16Idx, HEADLENS);
				#else
				V161_GetFileIdx(FILENAME_DRIVE_TMP, &u16Idx);
				#endif
				
				u16DrvIdx = u16Idx;
				
				if(u16Idx > 1)
				{
					u16Idx2 = u16Idx - 1;
					u16Idx1 = 0;
					procCreateHourData = PROC_STEP_23;
				}
				else
				{
					procCreateHourData = PROC_STEP_25;
				}
				break;
				
			case PROC_STEP_23:
				u16Idx3 = u16Idx1 + ((u16Idx2 - u16Idx1) / 2);
				
				SD_ReadAddrToBuff(FILENAME_DRIVE_TMP, (uint8_t *)&stDriveData.u8DriverName,
				                  DRIVINGLENS, HEADLENS + (u16Idx3 * DRIVINGLENS));
				
				u32Sec = BCDTimeToSec(stDriveData.u8DriveDateBCD);

				if (u32Sec > u32StartSec)
				{
					u16Idx2 = u16Idx3;
				}
				else
				{
					u16Idx1 = u16Idx3;
				}

				procCreateHourData = PROC_STEP_24;
				
				if ((u16Idx2 - u16Idx1) < 2)
				{
					if (u32Sec > u32StartSec)
					{
						u16Idx3 -= 2;
					}
					
					procCreateHourData = PROC_STEP_25;
				}
				break;
				
			case PROC_STEP_24:
				if(u32Sec != u32StartSec)
				{
					procCreateHourData = PROC_STEP_23;
				}
				else
				{
					procCreateHourData = PROC_STEP_25;
				}
				break;
				
			case PROC_STEP_25:
				u16Buf2 = u16Idx - u16Idx3;
				u16Buf = u16Idx3;
				
				u32TableLens[3] = HEADLENS + (u16Buf2 * DRIVINGLENS);
				
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[3], 4);
				
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf2, HEADLENS);
				
				if(u16Idx > 0)
				{
					u32FileSize = HEADLENS + (u16Idx * DRIVINGLENS);
					u32DataSize = HEADLENS + (u16Buf * DRIVINGLENS);
					u32GetSize = 0;
					procCreateHourData = PROC_STEP_26;
				}
				else
				{
					procCreateHourData = PROC_STEP_28;
				}
				
				break;
				
			case PROC_STEP_26:
				if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
				{
					u32GetSize = MOVE_DATA_MAX_SIZE;
				}
				else
				{
					u32GetSize = u32FileSize - u32DataSize;
				}
				
				osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

				if(osRes != osOK)
				{
					RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
			
					return; 
				}

				memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

				SD_ReadAddrToBuff(FILENAME_DRIVE_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

				SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
				
				osMutexRelease(mutex_data_buf1_user);

				u32DataSize += u32GetSize;
				
				procCreateHourData = PROC_STEP_27;
				
				break;
				
			case PROC_STEP_27:
				if(u32DataSize < u32FileSize)
				{
					procCreateHourData = PROC_STEP_26;
				}
				else
				{
					procCreateHourData = PROC_STEP_28;
				}
				break;
				
			case PROC_STEP_28:
				LOGprintf("\r\n> ### Add TABLE 9 to Hour VDR ###");

				u16Buf = 0;
				u16Buf2 = 0;
				u16Idx = 0;

				u8Buff = 0x04;
				SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table9Name, 18);

				#if !ENABLE_INDEX_BUFFER
				SD_ReadFileToBuff(FILENAME_POSITION_TMP, (uint8_t *)&u16Idx, HEADLENS);
				#else
				V161_GetFileIdx(FILENAME_POSITION_TMP, &u16Idx);
				#endif
				
				if(u16Idx > 1)
				{
					u16Buf = u16Idx - 1;
					procCreateHourData = PROC_STEP_29;
				}
				else
				{
					procCreateHourData = PROC_STEP_31;
				}
				break;
			
			case PROC_STEP_29:
				SD_ReadAddrToBuff(FILENAME_POSITION_TMP, (uint8_t *)&stPosData.u8DateBCD,
				                  POSLENS, HEADLENS + (u16Buf * POSLENS));
				
				u32Sec = BCDTimeToSec(stPosData.u8DateBCD);

				u16Buf--;
				u16Buf2++;

				if(u16Buf == 0)
					break;
					
				procCreateHourData = PROC_STEP_30;
				break;
				
			case PROC_STEP_30:
				if(u32Sec > u32StartSec)
				{
					procCreateHourData = PROC_STEP_29;
				}
				else
				{
					u16Buf2++;
					procCreateHourData = PROC_STEP_31;
				}
				break;
				
			case PROC_STEP_31:
				u32TableLens[4] = HEADLENS + (u16Buf2 * POSLENS);
				
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[4], 4);
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf2, HEADLENS);
				
				if (u16Idx > 0)
				{
					u32FileSize = HEADLENS + (u16Idx * POSLENS);
					u32DataSize = HEADLENS + (u16Buf * POSLENS);
					u32GetSize = 0;
					procCreateHourData = PROC_STEP_32;
				}
				else
				{
					procCreateHourData = PROC_STEP_34;
				}
				break;
				
			case PROC_STEP_32:
				if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
				{
					u32GetSize = MOVE_DATA_MAX_SIZE;
				}
				else
				{
					u32GetSize = u32FileSize - u32DataSize;
				}
				
				osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

				if(osRes != osOK)
				{
					RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
			
					return; 
				}

				memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

				SD_ReadAddrToBuff(FILENAME_POSITION_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

				SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
				
				osMutexRelease(mutex_data_buf1_user);

				u32DataSize += u32GetSize;
				
				procCreateHourData = PROC_STEP_33;
				
				break;
				
			case PROC_STEP_33:
				if(u32DataSize < u32FileSize)
				{
					procCreateHourData = PROC_STEP_32;
				}
				else
				{
					procCreateHourData = PROC_STEP_34;
				}
				break;
				
			case PROC_STEP_34:
				LOGprintf("\r\n> ### Add TABLE 10 to Hour VDR ###");

				u16Buf = 0;
				u16Buf2 = 0;
				u16Idx = 0;

				u8Buff = 0x05;
				SD_AddBuffToFile(szHourFileName, &u8Buff, 1);
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u8Table10Name, 18);

				#if !ENABLE_INDEX_BUFFER
				SD_ReadFileToBuff(FILENAME_EXTERNAL_TMP, (uint8_t *)&u16Idx, HEADLENS);
				#else
				V161_GetFileIdx(FILENAME_EXTERNAL_TMP, &u16Idx);
				#endif
				
				if(u16Idx > 1)
				{
					u16Buf = u16Idx - 1;
					procCreateHourData = PROC_STEP_35;
				}
				else
				{
					procCreateHourData = PROC_STEP_37;
				}
				
				break;
				
			case PROC_STEP_35:
				SD_ReadAddrToBuff(FILENAME_EXTERNAL_TMP, (uint8_t *)&stExternal.u8DateBCD,
				                  EXTLENS, HEADLENS + (u16Buf * EXTLENS));
				
				u32Sec = BCDTimeToSec(stPosData.u8DateBCD);

				u16Buf--;
				u16Buf2++;

				if(u16Buf == 0)
					break;
					
				procCreateHourData = PROC_STEP_36;
					
				break;
			
			case PROC_STEP_36:
				if(u32Sec > u32StartSec)
				{
					procCreateHourData = PROC_STEP_35;
				}
				else
				{
					u16Buf2++;
					procCreateHourData = PROC_STEP_37;
				}
				break;
				
			case PROC_STEP_37:
				u32TableLens[5] = HEADLENS + (u16Buf2 * EXTLENS);
				
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u32TableLens[5], 4);
				SD_AddBuffToFile(szHourFileName, (uint8_t *)&u16Buf2, HEADLENS);
				
				procCreateHourData = PROC_STEP_38;
				break;
				
			case PROC_STEP_38:
				if (u16Idx > 0)
				{
					u32FileSize = HEADLENS + (u16Idx * EXTLENS);
					u32DataSize = HEADLENS + (u16Buf * EXTLENS);
					u32GetSize = 0;
					
					procCreateHourData = PROC_STEP_39;
				}
				else
				{
					procCreateHourData = PROC_STEP_41;
				}
				break;
				
			case PROC_STEP_39:
				if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
				{
					u32GetSize = MOVE_DATA_MAX_SIZE;
				}
				else
				{
					u32GetSize = u32FileSize - u32DataSize;
				}
				
				osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

				if(osRes != osOK)
				{
					RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
			
					return; 
				}

				memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

				SD_ReadAddrToBuff(FILENAME_EXTERNAL_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

				SD_AddBuffToFile(szHourFileName, u8VDR_Buf, u32GetSize);
				
				osMutexRelease(mutex_data_buf1_user);

				u32DataSize += u32GetSize;
				
				procCreateHourData = PROC_STEP_40;
				break;
				
			case PROC_STEP_40:
				if(u32DataSize < u32FileSize)
				{
					procCreateHourData = PROC_STEP_39;
				}
				else
				{
					procCreateHourData = PROC_STEP_41;
				}
				break;
				
			case PROC_STEP_41:
				LOGprintf("\r\n> ### Add CheckSum to Hour VDR ###");

				u32FileSize = SD_GetFileSize(szHourFileName);
				
				u32DataSize = 0;
				u32GetSize = 0;
				u8CheckSum = 0;
				
				procCreateHourData = PROC_STEP_42;
				break;
				
			case PROC_STEP_42:
				if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
				{
					u32GetSize = MOVE_DATA_MAX_SIZE;
				}
				else
				{
					u32GetSize = u32FileSize - u32DataSize;
				}
				
				osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

				if(osRes != osOK)
				{
					RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
			
					return; 
				}

				memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

				SD_ReadAddrToBuff(szHourFileName, u8VDR_Buf, u32GetSize, u32DataSize);
			
				for(i=0; i < u32GetSize; i++)
				{
					u8CheckSum = u8CheckSum ^ u8VDR_Buf[i];
				}
				
				osMutexRelease(mutex_data_buf1_user);

				u32DataSize += u32GetSize;
				
				procCreateHourData = PROC_STEP_43;
				
				break;
				
			case PROC_STEP_43:
				if(u32DataSize < u32FileSize)
				{
					procCreateHourData = PROC_STEP_42;
				}
				else
				{
					procCreateHourData = PROC_STEP_44;
				}
				break;
				
			case PROC_STEP_44:
				SD_AddBuffToFile(szHourFileName, &u8CheckSum, SHORTHEAD);

				LOGprintf("\r\n> ### Hour file OK, Used: %d ms ###", (HAL_GetTick() - u32TickTime_All));
				
				//RTOSprintf("\r\n> ### Start USB Download Process ###");

				//strcpy(g_cVDRFileName, szHourFileName);

				if(bDLRS232Flag == FALSE)
				{
					LOGprintf("\r\n> ### Download Now ###");

					bIsDelVDRFileFlag = TRUE;
					
					//g_bUSBDownloadFlg = TRUE;
					USB_DownloadFile(szHourFileName);
				}
				
				procCreateHourData = PROC_STEP_45;
				break;
				
			case PROC_STEP_45:
				bDLRS232Flag = FALSE;

				bHourDataFlag = FALSE;

				LOGprintf("\r\n> ### V161_CreateHourDataProc OK ###");

				//bDoneHourVDRFile = TRUE;
				bDoneHourVDRFile = FALSE;
				
				procCreateHourData = PROC_STEP_NULL;
				break;

			default:
				procCreateHourData = PROC_STEP_NULL;
				break;
	}
}

#if 0
//============================================================================//
// @brief  Rename record day file.
// @param  None.
// @retval None.
//============================================================================//
void V161_RenameDayFile(void)
{
	#if ENABLE_INDEX_BUFFER
	uint16_t u16Index;
	#endif
	char *pOld, *pNew, cBufStr[100], cBufStr2[100];
	


	LOGprintf("\r\n> ### V161 Rename Day File ###");

	RTOSprintf("\r\n> [SYS]%04X", SYS_STATE_RENAME_DAY_FILE);
	
	#if ENABLE_INDEX_BUFFER
		u16Index = 0;
		V161_GetFileIdx(FILENAME_DETAILSPEED_DAY_TMP, &u16Index);
		SD_WriteBuffToFile(FILENAME_DETAILSPEED_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#endif

	pNew = cBufStr;

	pOld = cBufStr2;

	sprintf(pOld, "%s", FILENAME_DETAILSPEED_DAY_TMP);

	sprintf(pNew, "%s", FILENAME_DETAILSPEED_DAY_2_TMP);

	SD_RemoveFile(pNew);

	SD_Rename(pOld, pNew);
	
	#if ENABLE_INDEX_BUFFER
		u16Index = 0;
		V161_GetFileIdx(FILENAME_DRIVE_DAY_TMP, &u16Index);
		SD_WriteBuffToFile(FILENAME_DRIVE_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#endif

	sprintf(pOld, "%s", FILENAME_DRIVE_DAY_TMP);

	sprintf(pNew, "%s", FILENAME_DRIVE_DAY_2_TMP);

	SD_RemoveFile(pNew);

	SD_Rename(pOld, pNew);
	
	#if ENABLE_INDEX_BUFFER
		u16Index = 0;
		V161_GetFileIdx(FILENAME_POSITION_DAY_TMP, &u16Index);
		SD_WriteBuffToFile(FILENAME_POSITION_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#endif

	sprintf(pOld, "%s", FILENAME_POSITION_DAY_TMP);

	sprintf(pNew, "%s", FILENAME_POSITION_DAY_2_TMP);

	SD_RemoveFile(pNew);

	SD_Rename(pOld, pNew);
	
	#if ENABLE_INDEX_BUFFER
		u16Index = 0;
		V161_GetFileIdx(FILENAME_EXTERNAL_DAY_TMP, &u16Index);
		SD_WriteBuffToFile(FILENAME_EXTERNAL_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#endif
	
	sprintf(pOld, "%s", FILENAME_EXTERNAL_DAY_TMP);

	sprintf(pNew, "%s", FILENAME_EXTERNAL_DAY_2_TMP);

	SD_RemoveFile(pNew);

	SD_Rename(pOld, pNew);
}

//============================================================================//
// @brief  Recreate record day file.
// @param  None.
// @retval None.
//============================================================================//
void V161_RecreateDayFile(void)
{
	LOGprintf("\r\n> ### V161 Recreate Day File ###");

	RTOSprintf("\r\n> [SYS]%04X", SYS_STATE_RECREATE_DAY_FILE);

	SD_RemoveFile(FILENAME_DETAILSPEED_DAY_TMP);

	SD_CreateFile(FILENAME_DETAILSPEED_DAY_TMP, HEADLENS, TRUE);
	
	#if ENABLE_INDEX_BUFFER
	V161_SaveFileIdx(FILENAME_DETAILSPEED_DAY_TMP, 0);
	#endif

	u16DS_DayIdx = 0;

	SD_RemoveFile(FILENAME_DRIVE_DAY_TMP);

	SD_CreateFile(FILENAME_DRIVE_DAY_TMP, HEADLENS, TRUE);

	#if ENABLE_INDEX_BUFFER
	V161_SaveFileIdx(FILENAME_DRIVE_DAY_TMP, 0);
	#endif
	
	u16DrvDayIdx = 0;

	SD_RemoveFile(FILENAME_POSITION_DAY_TMP);

	SD_CreateFile(FILENAME_POSITION_DAY_TMP, (HEADLENS + POSLENS), TRUE);
	
	#if ENABLE_INDEX_BUFFER
	V161_SaveFileIdx(FILENAME_POSITION_DAY_TMP, 0);
	#endif

	u16PosDayIdx = 0;

	PositionData.u8Index = 0;
	
	SD_RemoveFile(FILENAME_EXTERNAL_DAY_TMP);

	SD_CreateFile(FILENAME_EXTERNAL_DAY_TMP, HEADLENS, TRUE);
	
	#if ENABLE_INDEX_BUFFER
	V161_SaveFileIdx(FILENAME_EXTERNAL_DAY_TMP, 0);
	#endif
	
	u16RecExtDayIdx = 0;
}

//============================================================================//
// @brief  Make copies of day files.
// @param  None.
// @retval None.
//============================================================================//
void V161_CopyDayFile(void)
{
	#if ENABLE_INDEX_BUFFER
		uint16_t u16Index;
	#endif
	
	uint32_t u32FileSize, u32DataSize = 0, u32GetSize = 0;

	
	LOGprintf("\r\n> ### V161_Copy Day File ###");

	//LOGprintf("\r\n> FILENAME_DETAILSPEED_DAY_TMP Copy");
	
	#if ENABLE_INDEX_BUFFER
	u16Index = 0;
	V161_GetFileIdx(FILENAME_DETAILSPEED_DAY_TMP, &u16Index);
	SD_WriteBuffToFile(FILENAME_DETAILSPEED_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#endif
	
	u32FileSize = SD_GetFileSize(FILENAME_DETAILSPEED_DAY_TMP);
	
	u32DataSize = 0;
	
	u32GetSize = 0;
	
	do
	{
		//LOGprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);
		
		if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}
		
		osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

		if(osRes != osOK)
		{
			RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
			return; 
		}
		
		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
		
		SD_ReadAddrToBuff(FILENAME_DETAILSPEED_DAY_TMP, u8VDR_Buf, u32GetSize, u32DataSize);
		
		SD_AddBuffToFile(FILENAME_DETAILSPEED_DAY_2_TMP, u8VDR_Buf, u32GetSize);
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);
		
		u32DataSize += u32GetSize;
	}
	while(u32DataSize < u32FileSize);

	//LOGprintf("\r\n> FILENAME_DRIVE_DAY_TMP Copy");
	
	#if ENABLE_INDEX_BUFFER
	u16Index = 0;
	V161_GetFileIdx(FILENAME_DRIVE_DAY_TMP, &u16Index);
	SD_WriteBuffToFile(FILENAME_DRIVE_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#endif
	
	u32FileSize = SD_GetFileSize(FILENAME_DRIVE_DAY_TMP);
	u32DataSize = 0;
	u32GetSize = 0;
	
	do
	{
		//LOGprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);
		
		if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}
		
		osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

		if(osRes != osOK)
		{
			RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
			return; 
		}
		
		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
		
		SD_ReadAddrToBuff(FILENAME_DRIVE_DAY_TMP, u8VDR_Buf, u32GetSize, u32DataSize);
		
		SD_AddBuffToFile(FILENAME_DRIVE_DAY_2_TMP, u8VDR_Buf, u32GetSize);
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);
		
		u32DataSize += u32GetSize;
	}
	while(u32DataSize < u32FileSize);

	//LOGprintf("\r\n> FILENAME_POSITION_DAY_TMP Copy");
	
	#if ENABLE_INDEX_BUFFER
	u16Index = 0;
	V161_GetFileIdx(FILENAME_POSITION_DAY_TMP, &u16Index);
	SD_WriteBuffToFile(FILENAME_POSITION_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#endif
	
	u32FileSize = SD_GetFileSize(FILENAME_POSITION_DAY_TMP);
	u32DataSize = 0;
	u32GetSize = 0;
	
	do
	{
		//LOGprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);
		
		if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}
		
		osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

		if(osRes != osOK)
		{
			RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
			return; 
		}
		
		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
		
		SD_ReadAddrToBuff(FILENAME_POSITION_DAY_TMP, u8VDR_Buf, u32GetSize, u32DataSize);

		SD_AddBuffToFile(FILENAME_POSITION_DAY_2_TMP, u8VDR_Buf, u32GetSize);
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);

		u32DataSize += u32GetSize;
	}
	while(u32DataSize < u32FileSize);
	
	//LOGprintf("\r\n> FILENAME_EXTERNAL_DAY_TMP Copy");
	
	#if ENABLE_INDEX_BUFFER
	u16Index = 0;
	V161_GetFileIdx(FILENAME_EXTERNAL_DAY_TMP, &u16Index);
	SD_WriteBuffToFile(FILENAME_EXTERNAL_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);
	#endif
	
	u32FileSize = SD_GetFileSize(FILENAME_EXTERNAL_DAY_TMP);
	u32DataSize = 0;
	u32GetSize = 0;
	
	do
	{
		//LOGprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);
		
		if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}
		
		osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

		if(osRes != osOK)
		{
			RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
			return; 
		}
		
		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
		
		SD_ReadAddrToBuff(FILENAME_EXTERNAL_DAY_TMP, u8VDR_Buf, u32GetSize, u32DataSize);
		
		SD_AddBuffToFile(FILENAME_EXTERNAL_DAY_2_TMP, u8VDR_Buf, u32GetSize);
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);
		
		u32DataSize += u32GetSize;
	}
	while(u32DataSize < u32FileSize);
}
#endif

//============================================================================//
// @brief  Copy file.
// @param  pcSrcFileName: Pointer to a char array storing the source file name.
//         pcDstFileName: Pointer to a char array storing the destination file name.
// @retval None.
//============================================================================//
void V161_CopyFile(char *pcScrFileName, char *pcDstFileName)
{
	uint32_t u32FileSize, u32DataSize = 0, u32GetSize = 0;

	
	LOGprintf("\r\n> ### V161_CopyFile ###");

	u32FileSize = SD_GetFileSize(pcScrFileName);
	
	u32DataSize = 0;
	
	u32GetSize = 0;
	
	do
	{
		//RTOSprintf("\r\n> ### u32FileSize: %d, u32DataSize: %d ###", u32FileSize, u32DataSize);
		if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
		{
			u32GetSize = MOVE_DATA_MAX_SIZE;
		}
		else
		{
			u32GetSize = u32FileSize - u32DataSize;
		}
		
		osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

	  if(osRes != osOK)
	  {
	    RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
	
	    return; 
	  }
		
		memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));
		
		SD_ReadAddrToBuff(pcScrFileName, u8VDR_Buf, u32GetSize, u32DataSize);
		
		SD_AddBuffToFile(pcDstFileName, u8VDR_Buf, u32GetSize);
		
		osMutexRelease(mutex_data_buf1_user);
		
		HAL_Delay(2);
		
		u32DataSize += u32GetSize;
	}
	while(u32DataSize < u32FileSize);
}

//============================================================================//
// @brief  Save event to SD card.
// @param  u8EventIndex: Event index.
// @retval None.
//============================================================================//
bool V161_SaveEvent(uint8_t u8EventIndex)
{
	EventDataTypeDef stRecEvent;
	uint32_t u32NowSec;
	
	
	stRecEvent.u8Code = u8EventIndex;

	u32NowSec = System_GetTime();

	SecToBCDTime(u32NowSec, stRecEvent.u8DateStartBCD);

	memcpy(stRecEvent.u8DateStopBCD, stRecEvent.u8DateStartBCD, 7);
	
	V161_RecordEvent(stRecEvent);
	
	if(u8EventIndex == 1)
	{
		stPwrOffEvent.bIsShowFlag = TRUE;
		stPwrOffEvent.u8EventTime[0] = stRecEvent.u8DateStartBCD[4];
		stPwrOffEvent.u8EventTime[1] = stRecEvent.u8DateStartBCD[5];
		stPwrOffEvent.u8EventTime[2] = stRecEvent.u8DateStartBCD[6];
	}
	
	return TRUE;
}

//============================================================================//
// @brief  Write technical data to a file.
// @param  pcFileName: Pointer to the name of the file to write to.
// @retval None.
//============================================================================//
void V161_WriteTechnicalToFile(char *pcFileName)
{
	bool bRes;
	VdrTechnicalDataTypeDef stVdrTechnical;

	
	memset(&stVdrTechnical, '\0', sizeof(VdrTechnicalDataTypeDef));
	
	stVdrTechnical.u8TableCode = 0x03;
	
	strncpy((char *)stVdrTechnical.u8Name, (char *)u8Table7Name, sizeof(u8Table7Name));
	
	stVdrTechnical.u32Lens = sizeof(TechnicalDataTypeDef);

	bRes = SD_ReadFileToBuff(FILENAME_TECHNICAL_TMP, (uint8_t *)&stVdrTechnical.stTechData, sizeof(TechnicalDataTypeDef));

	if(bRes == TRUE)
	{
		bRes = SD_AddBuffToFile(pcFileName, (uint8_t *)&stVdrTechnical, sizeof(VdrTechnicalDataTypeDef));
	
		if(bRes == TRUE)
		{
			LOGprintf("\r\n> V161_WriteTechnicalToFile OK. ");
		}
		else
		{
			LOGprintf("\r\n> V161_WriteTechnicalToFile NG. ");
		}
	}
}

//============================================================================//
// @brief  Write record to breakdown file.
// @param  stBreakDown: Record data in BreakdownDataTypeDef format.
// @retval None.
//============================================================================//
void V161_RecordBreakdown(BreakdownDataTypeDef stBreakDown)
{
	SD_ReadFileToBuff(FILENAME_BREAKDOWN_TMP, (uint8_t *)&stBreakDown.u8BlockIndex, SHORTHEAD);

	stBreakDown.u8BlockIndex++;

	SD_WriteBuffToFile(FILENAME_BREAKDOWN_TMP, (uint8_t *)&stBreakDown.u8BlockIndex, SHORTHEAD);

	if(stBreakDown.u8BlockIndex != 0)
	{
		SD_WriteBuffToAddr(FILENAME_BREAKDOWN_TMP, &stBreakDown.u8Code, BREAKDOWNLENS,
											SHORTHEAD + ((stBreakDown.u8BlockIndex - 1) * BREAKDOWNLENS));
	}
	else
	{
		SD_WriteBuffToAddr(FILENAME_BREAKDOWN_TMP, &stBreakDown.u8Code, BREAKDOWNLENS, SHORTHEAD);
	}
	
	V161_WriteBreakdownToVDR(stBreakDown);
}

//============================================================================//
// @brief  Write record to event file.
// @param  stEvent: Record data in EventDataTypeDef format.
// @retval None
//============================================================================//
void V161_RecordEvent(EventDataTypeDef stEvent)
{
	uint8_t i;

	EventDataTypeDef stEvent2;

	SD_ReadFileToBuff(FILENAME_EVENT_TMP, (uint8_t *) & stEvent.u8BlockIndex, SHORTHEAD);

	stEvent.u8EventCnt = 1;

	for(i=0; i<stEvent.u8BlockIndex; i++)
	{
		SD_ReadAddrToBuff(FILENAME_EVENT_TMP, (uint8_t *) & stEvent2.u8Code, EVENTLENS, SHORTHEAD + (i * EVENTLENS));

		if (stEvent.u8Code == stEvent2.u8Code)
		{
			stEvent.u8EventCnt = stEvent2.u8EventCnt + 1;
		}
	}

	stEvent.u8BlockIndex++;

	SD_WriteBuffToFile(FILENAME_EVENT_TMP, (uint8_t *) & stEvent.u8BlockIndex, SHORTHEAD);

	if(stEvent.u8BlockIndex != 0)
	{
		SD_WriteBuffToAddr(FILENAME_EVENT_TMP, &stEvent.u8Code, EVENTLENS,
											SHORTHEAD + ((stEvent.u8BlockIndex - 1) * EVENTLENS));
	}
	else
	{
		SD_WriteBuffToAddr(FILENAME_EVENT_TMP, &stEvent.u8Code, EVENTLENS, SHORTHEAD);
	}
	
	V161_WriteEventToVDR(stEvent);
}

