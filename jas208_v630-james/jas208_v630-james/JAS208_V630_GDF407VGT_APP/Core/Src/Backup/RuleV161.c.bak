#if ENABLE_INDEX_BUFFER
//============================================================================//
// @brief  Initialize index buffer mechanism.
// @param  None.
// @retval None.
//============================================================================//
void V161_IndexFileNameInit(void)
{
  for(int i = 0; i < MAX_INDEXED_FILE_NUM; i++)
  {
	  memset(cIndexedFileName[i], 0x00, sizeof(cIndexedFileName[i]));
	}
	
	sprintf(cIndexedFileName[0], "%s", FILENAME_DETAILSPEED_TMP);
	
	sprintf(cIndexedFileName[1], "%s", FILENAME_POSITION_TMP);
	
	sprintf(cIndexedFileName[2], "%s", FILENAME_DRIVE_TMP);
	
	sprintf(cIndexedFileName[3], "%s", FILENAME_EXTERNAL_TMP);
}

//============================================================================//
// @brief  Save file indices from backup registers to SD card or IC MX25L.
// @param  None.
// @retval None.
//============================================================================//
void V161_SaveFileIdxAll(void)
{
	bool bRes;
	MX25L_StatusTypeDef mxlRes;
	uint16_t u16IndexList[MAX_INDEXED_FILE_NUM] = {0};
	
	
  for(int i = 0; i < MAX_INDEXED_FILE_NUM; i++)
  {
	  if(strlen(cIndexedFileName[i]) > 0)
		{
		  u16IndexList[i] = (uint16_t)HW_ReadBackupRegister(i + BKP_FILE_INDEX_START);
			
			bRes = SD_WriteBuffToAddr(cIndexedFileName[i], (uint8_t *)&u16IndexList[i], 2, 0);
			
			if(bRes == FALSE)
			{
			  RTOSprintf("\r\n> SD save index %d to file %s ERROR", u16IndexList[i], cIndexedFileName[i]);
			}
		}
	}
	
	mxlRes = MX25L_SectorErase((uint16_t)(EXFLASH_FILE_INDEX_START_ADDR / MX25L_SECTOR_SIZE));
	
	if(mxlRes != MX25L_OK)
	{
	  RTOSprintf("\r\n MX25L erase sector at address %d ERROR %d", EXFLASH_FILE_INDEX_START_ADDR, mxlRes);
		
		return;
	}
	
	mxlRes = MX25L_PageProgram(EXFLASH_FILE_INDEX_START_ADDR, (uint8_t *)&u16IndexList[0], sizeof(u16IndexList));
	
	if(mxlRes != MX25L_OK)
	{
	  RTOSprintf("\r\n MX25L save file index ERROR %d", mxlRes);
	}
}

//============================================================================//
// @brief  Load file indices from SD card or IC MX25L to backup registers.
// @param  None.
// @retval None.
//============================================================================//
void V161_LoadFileIdxAll(void)
{
  bool bRes;
	MX25L_StatusTypeDef mxlRes;
	uint16_t u16IndexList[MAX_INDEXED_FILE_NUM] = {0};
	
	
	for(int i = 0; i < MAX_INDEXED_FILE_NUM; i++)
  {
	  if(strlen(cIndexedFileName[i]) > 0)
		{
			bRes = SD_ReadAddrToBuff(cIndexedFileName[i], (uint8_t *)&u16IndexList[i], 2, 0);
			
			if(bRes == FALSE)
			{
				LOGprintf("\r\n SD get file %s index ERROR.", cIndexedFileName[i]);
				
				break;
			}
			
		  HW_WriteBackupRegister(i + BKP_FILE_INDEX_START, u16IndexList[i]);
			
			//RTOSprintf("\r\n> File %s initial index:%d", cIndexedFileName[i], u16IndexList[i]);
		}
	}
	
	if(!bRes)
	{
	  mxlRes = MX25L_MultiBytesRead(EXFLASH_FILE_INDEX_START_ADDR, 
		                              (uint8_t *)&u16IndexList[0], sizeof(u16IndexList));
		
		if(mxlRes != MX25L_OK)
		{
		  LOGprintf("\r\n MX25L get file index ERROR %d", mxlRes);
		}
	}
}

//============================================================================//
// @brief  Save a file index to a backup register.
// @param  pcFileName: Pointer to a string storing file name.
//         u16Idx: Index of the file.
// @retval TRUE: Operation is successful.
//         FALSE: Operation is failed.
//============================================================================//
bool V161_SaveFileIdx(char *pcFileName, uint16_t u16Idx)
{
  bool bRes = FALSE;
	uint8_t u8FileNum;
	
	
	for(int i = 0; i < MAX_INDEXED_FILE_NUM; i++)
	{
	  if(strncmp(cIndexedFileName[i], pcFileName, strlen(cIndexedFileName[i])) == 0)
		{
		  bRes = TRUE;
			
			u8FileNum = i;
			
			break;
		}
	}
	
	if(bRes == FALSE)
	{
		LOGprintf("\r\n> Save file %s index FAIL.", pcFileName);
		
		return FALSE;
	}
	
	HW_WriteBackupRegister(u8FileNum + BKP_FILE_INDEX_START, u16Idx);
	
	return TRUE;
}

//============================================================================//
// @brief  Get a file index from backup register.
// @param  pcFileName: Pointer to a string storing file name.
//         pu16Idx: Pointer to a uint16_t variable to store index of the file.
// @retval TRUE: Operation is successful.
//         FALSE: Operation is failed.
//============================================================================//
bool V161_GetFileIdx(char *pcFileName, uint16_t *pu16Idx)
{
  bool bRes = FALSE;
	uint8_t u8FileNum;
	
	
	for(int i = 0; i < MAX_INDEXED_FILE_NUM; i++)
	{
	  if(strncmp(cIndexedFileName[i], pcFileName, strlen(cIndexedFileName[i])) == 0)
		{
		  bRes = TRUE;
			
			u8FileNum = i;
			
			break;
		}
	}
	
	if(bRes == FALSE)
	{
		LOGprintf("\r\n> Get file %s index FAIL.", pcFileName);
		
		return FALSE;
	}
	
	*pu16Idx = (uint16_t)HW_ReadBackupRegister(u8FileNum + BKP_FILE_INDEX_START);
	
	return TRUE;
}
#endif

