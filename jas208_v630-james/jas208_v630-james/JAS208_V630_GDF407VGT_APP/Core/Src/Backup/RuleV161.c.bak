	                   HEADLENS + ((u16DriveActCntDay - 1) * DRIVINGLENS));
	*/
}

//============================================================================//
// @brief  Write record to technical file.
// @param  None.
// @retval None
//============================================================================//
void V161_RecordTechnical(uint8_t u8Item)
{
	bool res;
	TechnicalDataTypeDef stTechnical;
	time_t ttRecTime;
	uint8_t u8BCDTime[7], u8Buf;


	memset(&stTechnical, '\0', sizeof(TechnicalDataTypeDef));

	res = SD_CheckFileExist(FILENAME_TECHNICAL_TMP);
	if(res == TRUE)
	{
		SD_ReadFileToBuff(FILENAME_TECHNICAL_TMP, (uint8_t *)&stTechnical, sizeof(TechnicalDataTypeDef));
		
		if(u8Item == 1)
		{
			strncpy((char *)stTechnical.u8BusID, (char *)g_Setting.tBusInfo.cBus_ID, sizeof(g_Setting.tBusInfo.cBus_ID));
		}
		else if(u8Item == 2)
		{
			ttRecTime = System_GetTime();
			SecToBCDTime(ttRecTime, u8BCDTime);
			strncpy((char *)stTechnical.u8FwDateBCD, (char *)u8BCDTime, sizeof(u8BCDTime));
		}
		else if(u8Item == 3)
		{
			memset(u8BCDTime, '\0', sizeof(u8BCDTime));
			sprintf((char *)u8BCDTime, "%04d", VERSION_BUILD);
			strncpy((char *)stTechnical.u8FwNum, (char *)u8BCDTime, 4);
		}
	}
	else
	{
		strncpy((char *)stTechnical.u8Company, (char *)u8Company, sizeof(u8Company));
		strncpy((char *)stTechnical.u8Address, (char *)u8Address, sizeof(u8Address));
		strncpy((char *)stTechnical.u8DeviceNum, (char *)u8DeviceNum, sizeof(u8DeviceNum));
		
		memset(u8BCDTime, '\0', sizeof(u8BCDTime));
		
		sprintf((char *)u8BCDTime, "%04d", VERSION_BUILD);
		
		strncpy((char *)stTechnical.u8FwNum, (char *)u8BCDTime, 4);
		
		u8BCDTime[0] = 0x20;
		
		u8Buf = FIRMWARE_DATE[2];
		u8BCDTime[1] = ((u8Buf << 4) & 0xF0) | (FIRMWARE_DATE[3] & 0x0F);
		u8Buf = FIRMWARE_DATE[4];
		u8BCDTime[2] = ((u8Buf << 4) & 0xF0) | (FIRMWARE_DATE[5] & 0x0F);
		u8Buf = FIRMWARE_DATE[6];
		u8BCDTime[3] = ((u8Buf << 4) & 0xF0) | (FIRMWARE_DATE[7] & 0x0F);
		
		u8BCDTime[4] = 0x00;
		u8BCDTime[5] = 0x00;
		u8BCDTime[6] = 0x00;
		
		strncpy((char *)stTechnical.u8FwDateBCD, (char *)u8BCDTime, sizeof(u8BCDTime));
		strncpy((char *)stTechnical.u8MakeYear, (char *)u8MakeYear, sizeof(u8MakeYear));
		strncpy((char *)stTechnical.u8CertNum, (char *)u8CertNum, sizeof(u8CertNum));
		strncpy((char *)stTechnical.u8BusID, (char *)g_Setting.tBusInfo.cBus_ID, sizeof(g_Setting.tBusInfo.cBus_ID));
	}
	
	SD_WriteBuffToFile(FILENAME_TECHNICAL_TMP, (uint8_t *)&stTechnical.u8Company, sizeof(TechnicalDataTypeDef));
	
	V161_WriteTechnicalToVDR();
}

//============================================================================//
// @brief  Write record to calibration file.
// @param  stCalibration: Record data in stCalibration format.
// @retval None
//============================================================================//
void V161_RecordCalibration(CalibrationDataTypeDef stCalibration)
{
	SD_ReadFileToBuff(FILENAME_CALIBRATION_TMP, (uint8_t *)&stCalibration.u16BlockIndex, HEADLENS);

	stCalibration.u16BlockIndex++;

	SD_WriteBuffToFile(FILENAME_CALIBRATION_TMP, (uint8_t *)&stCalibration.u16BlockIndex, HEADLENS);

	if(stCalibration.u16BlockIndex != 0)
	{
		SD_WriteBuffToAddr(FILENAME_CALIBRATION_TMP, (uint8_t *)&stCalibration.u8NameID, CALIBRATIONLENS,
											HEADLENS + ((stCalibration.u16BlockIndex-1) * CALIBRATIONLENS));
	}
	else
	{
		SD_WriteBuffToAddr(FILENAME_CALIBRATION_TMP, (uint8_t *)&stCalibration.u8NameID, CALIBRATIONLENS, HEADLENS);
	}

	V161_WriteCalibrationToVDR(stCalibration);
}

