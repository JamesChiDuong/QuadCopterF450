		// Step 12: Write data to file POSITION
		case PROC_STEP_12:
			{
				uint32_t u32Addr = 0;


				u16Buf = g_SysInfo.tGPS_Data.gpsLon.u8ddd * 100 + g_SysInfo.tGPS_Data.gpsLon.u8mm;

				memcpy(&PosData[0], &u16Buf, 2);
				memcpy(&PosData[2], &g_SysInfo.tGPS_Data.gpsLon.u16mmmm, 2);

				u16Buf = g_SysInfo.tGPS_Data.gpsLat.u8dd * 100 + g_SysInfo.tGPS_Data.gpsLat.u8mm;

				memcpy(&PosData[4], &u16Buf, 2);
				memcpy(&PosData[6], &g_SysInfo.tGPS_Data.gpsLat.u16mmmm, 2);
				memcpy(&PosData[8], &g_SysInfo.tGPS_Data.fAltitude, 2);

				PosData[10] = u8OneMinAvgSpeed;

				u32Addr = HEADLENS + ((PositionData.u16BlockIndex - 1) * POSLENS) +
				          BCDDATE + (PositionData.u8Index * POSITIONLENS);

				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					bRes = SD_WriteBuffToAddr(FILENAME_POSITION_TMP, PosData, POSITIONLENS, u32Addr);

					if(!bRes)
					{
						u8SD_1MinRetryCnt++;

						if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
						{
							LOGprintf("\r\n> SD 1 min write data to file %s FAIL.", FILENAME_POSITION_TMP);

							u8SD_1MinRetryCnt = 0;

							procSD_1M_Step = PROC_STEP_13;

							break;
						}

						procSD_1M_Step = PROC_STEP_12;

						break;
					}

					u8SD_1MinRetryCnt = 0;

					procSD_1M_Step = PROC_STEP_13;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_1MIN_QUEUE_MAX)
					{
						procSD_1M_Step = PROC_STEP_16;

						break;
					}

					snprintf((char *)sd1MinBuf.u8PositionData[u8BufIdx], POSITIONLENS, "%s", (char *)PosData);

					sd1MinBuf.u32PositionAddr[u8BufIdx] = u32Addr;

					sd1MinBuf.bRequest[u8BufIdx] = TRUE;

					bSD_SaveDatRequest = TRUE;

					procSD_1M_Step = PROC_STEP_13;
				}

				break;
			}

		// Step 13: Get file POSITION_DAY block index
		case PROC_STEP_13:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
