//============================================================================//
// @brief  Add 1 minute data to VDR file.
// @param  None.
// @retval None.
//============================================================================//
void V161_Make1MinVDR(void)
{
	#if ENABLE_GSM_NET
	bool bResult = FALSE;
	#endif
	char cFilename[40], cFtpFilename[40];
	uint8_t	u8CheckSum, u8BCDTime[7], u8Buf;
	uint16_t i;
	uint32_t u32FileSize, u32DataSize, u32GetSize, u32TickTime;
	time_t ttFileTime;
	
	
	if(bDoVDR_HourFlag == TRUE)
	{
		u32TickTime = HAL_GetTick();
	
		RTOSprintf("\r\n> ### Make Hour VDR Start ###");

		ttFileTime = g_SysInfo.ttNow;
		
		SecToBCDTime(ttFileTime, u8BCDTime);
		
		sprintf(cFilename, "%s/D%02X%02X%02X%02X_%02X%02X%02X_%s.VDR",
						FOLDERNAME_VDR, u8BCDTime[0], u8BCDTime[1], u8BCDTime[2], u8BCDTime[3], 
						u8BCDTime[4], u8BCDTime[5], u8BCDTime[6],	g_Setting.tBusInfo.cBus_ID);
		
		RTOSprintf("\r\n> ### Hour VDR filename: %s ###", cFilename);
		
		SD_RemoveFile(cFilename);

		V161_CopyFile(FILENAME_MIN_VDR_TMP, cFilename);

		V161_WriteTechnicalToFile(cFilename);
		
		RTOSprintf("\r\n> ### Make Hour VDR CheckSum ###");

		u32FileSize = SD_GetFileSize(cFilename);

		u32DataSize = 0;

		u32GetSize = 0;

		u8CheckSum = 0;

		do
		{
			if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}

			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

			SD_ReadAddrToBuff(cFilename, u8VDR_Buf, u32GetSize, u32DataSize);

			for(i = 0; i < u32GetSize; i++)
			{
				u8CheckSum = u8CheckSum ^ u8VDR_Buf[i];
			}
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
		}
		while(u32DataSize < u32FileSize);

		RTOSprintf("\r\n> ### CheckSum Make OK!! ###");

		SD_AddBuffToFile(cFilename, &u8CheckSum, SHORTHEAD);
		
		RTOSprintf("\r\n> ### Make Hour VDR OK, Used: %d ms ###", HAL_GetTick() - u32TickTime);

		bIsDelVDRFileFlag = TRUE;
			
		USB_DownloadFile(cFilename);

		RTOSprintf("\r\n> ### Make Hour VDR End ###");
		
		bDoVDR_HourFlag = FALSE;
	}
	else if(bDoVDR_DayFlag == TRUE)
	{
		u32TickTime = HAL_GetTick();
	
		RTOSprintf("\r\n> ### Make Day VDR Start ###");

		RTOSprintf("\r\n> ### ttLastLogTime: %d ###", ttLastLogTime);
		
		ttFileTime = ttLastLogTime;
		
		SecToBCDTime(ttFileTime, u8BCDTime);
		
		sprintf(cFilename, "%s/D%02X%02X%02X%02X_235959_%s.VDR",
						FOLDERNAME_VDR, u8BCDTime[0], u8BCDTime[1], u8BCDTime[2], u8BCDTime[3],
						g_Setting.tBusInfo.cBus_ID);
		
		sprintf(cFtpFilename, "D%02X%02X%02X%02X_235959_%s.VDR",
						u8BCDTime[0], u8BCDTime[1], u8BCDTime[2], u8BCDTime[3], g_Setting.tBusInfo.cBus_ID);

		RTOSprintf("\r\n> ### Day VDR filename: %s ###", cFilename);
		
		SD_RemoveFile(cFilename);
		
		SD_Rename(FILENAME_MIN_VDR_TMP, cFilename);
		
		SD_CreateFile(FILENAME_MIN_VDR_TMP, HEADLENS, TRUE);
		
		u8Buf = 0xBB;
		
		SD_WriteBuffToAddr(FILENAME_MIN_VDR_TMP, &u8Buf, 1, 0);
		
		V161_RecordExternslData();

		V161_WriteTechnicalToFile(cFilename);
		
		RTOSprintf("\r\n> ### Make Day VDR CheckSum ###");

		u32FileSize = SD_GetFileSize(cFilename);

		u32DataSize = 0;

		u32GetSize = 0;

		u8CheckSum = 0;

		do
		{
			if((u32FileSize - u32DataSize) >= MOVE_DATA_MAX_SIZE)
			{
				u32GetSize = MOVE_DATA_MAX_SIZE;
			}
			else
			{
				u32GetSize = u32FileSize - u32DataSize;
			}
			
			osStatus osRes = osMutexWait(mutex_data_buf1_user, S_2_mS(5));

			if(osRes != osOK)
			{
				RTOSprintf("\r\n> Can't acquire DATA BUF1 mutex to transfer file. osRes:%d", osRes);
		
				return; 
			}

			memset(u8VDR_Buf, 0x00, sizeof(u8VDR_Buf));

			SD_ReadAddrToBuff(cFilename, u8VDR_Buf, u32GetSize, u32DataSize);

			for(i = 0; i < u32GetSize; i++)
			{
				u8CheckSum = u8CheckSum ^ u8VDR_Buf[i];
			}
			
			osMutexRelease(mutex_data_buf1_user);
			
			HAL_Delay(2);

			u32DataSize += u32GetSize;
		}
		while(u32DataSize < u32FileSize);

		RTOSprintf("\r\n> ### CheckSum Make OK!! ###");

		SD_AddBuffToFile(cFilename, &u8CheckSum, SHORTHEAD);
		
		RTOSprintf("\r\n> ### Make Day VDR OK, Used: %d ms ###", HAL_GetTick() - u32TickTime);
		
		#if ENABLE_GSM_NET
		RTOSprintf("\r\n> ### Send Day VDR to FTP ###");
		
		bResult = GSM_FTP_FileUploadRequest(cFtpFilename, cFtpFilename, FOLDERNAME_VDR, FOLDERNAME_VDR, 0);
			
		if(bResult)
			RTOSprintf("\r\n@ Request to upload file %s/%s to FTP server as %s/%s OK.",
								 FOLDERNAME_VDR, cFtpFilename, FOLDERNAME_VDR, cFtpFilename);
		else
			RTOSprintf("\r\n@ Request to upload file %s/%s to FTP server as %s/%s ERROR.",
								 FOLDERNAME_VDR, cFtpFilename, FOLDERNAME_VDR, cFtpFilename);
		#endif
		
		RTOSprintf("\r\n> ### Make Day VDR End ###");
		
		bDoVDR_DayFlag = FALSE;
	}
}
