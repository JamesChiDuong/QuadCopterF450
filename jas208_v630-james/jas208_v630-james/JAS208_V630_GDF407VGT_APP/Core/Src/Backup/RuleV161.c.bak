	//	if(!bRes)
	//	{
	//		LOGprintf("\r\n> SD write file %s index %d FAIL. Skip writing driving data.",
	//		           FILENAME_EXTERNAL_DAY_TMP, sdRecExtBuf.u16Idx);
	//	}
	//	#else
	//	V161_SaveFileIdx(FILENAME_EXTERNAL_DAY_TMP, sdRecExtBuf.u16Idx);
