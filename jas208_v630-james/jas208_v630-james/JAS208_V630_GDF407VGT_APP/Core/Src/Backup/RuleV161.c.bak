	V161_SDBuf_SaveDataInit();

	LOGprintf("\r\n> SD finish writing buffered data.");
}

//============================================================================//
// @brief  Process request to do 1 min task.
// @param  None.
// @retval None.
//============================================================================//
static void V161_1MinLogStepProc(void)
{
	bool bRes;
	static uint8_t u8OneMinAvgSpeed = 0;
	//static uint16_t u16Index = 0;
	//static uint16_t u16Index2 = 0;
	static uint16_t u16Buf = 0;
	static uint8_t PosData[POSITIONLENS] = {0};
	static DriveDataTypeDef stRecDriving;
	//static uint16_t u16DriveActCntDay;
	static bool bIsDrv1 = TRUE;
	static uint8_t u8BufIdx;


	if(procSD_1M_Step == PROC_STEP_NULL)
		return;

	switch((int)procSD_1M_Step)
	{
		// Step 1: Calculate 1 min average speed and select an SD buffer slot.
		case PROC_STEP_1:
			{
				uint8_t j = 0;


				SecToBCDTime(ttSysLogTime, u8SpeedDateBCD);

				memcpy(u8DetailSpeed.u8DateBCD, u8SpeedDateBCD, 7);

				LOGprintf("\r\n> ### %02X%02X/%02X/%02X %02X:%02X:%02X, One Min Rec ###",
				           u8SpeedDateBCD[0], u8SpeedDateBCD[1], u8SpeedDateBCD[2],
				           u8SpeedDateBCD[3], u8SpeedDateBCD[4], u8SpeedDateBCD[5],
				           u8SpeedDateBCD[6]);

				u16Buf = 0;
				j = 0;

				for(int i = 0; i < 60; i++)
				{
					u16Buf += (uint16_t)u8SpeedBuf[i][0];
					u16Buf += (uint16_t)u8SpeedBuf[i][1];

					u8DetailSpeed.u8SpeedData[j] = u8SpeedBuf[i][0];
					u8DetailSpeed.u8SpeedData[j + 1] = u8SpeedBuf[i][1];

					j += 2;
				}

				u8OneMinAvgSpeed = (uint8_t)(u16Buf / 120);

				u8BufIdx = SD_1MIN_QUEUE_MAX;

				for(int i = 0; i < SD_1MIN_QUEUE_MAX; i++)
				{
					if(sd1MinBuf.bRequest[i] == FALSE)
					{
						u8BufIdx = i;

						break;
					}
				}

				procSD_1M_Step = PROC_STEP_2;

				break;
			}

		// Step 2: Write new index to file DETAIL_SPEED
		case PROC_STEP_2:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					sd1MinBuf.u16DSBlockIndex = 0;

					u8DetailSpeed.u16BlockIndex++;

					if(u8DetailSpeed.u16BlockIndex > DSPEEDMAX)
					{
						u8DetailSpeed.u16BlockIndex = 1;
					}

					#if !ENABLE_INDEX_BUFFER
					bRes = SD_WriteBuffToFile(FILENAME_DETAILSPEED_TMP, (uint8_t *)&u8DetailSpeed.u16BlockIndex, HEADLENS);
				
					if(!bRes)
					{
						u8SD_1MinRetryCnt++;

						if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
						{
							LOGprintf("\r\n> SD 1 min write index %d to file %s FAIL.", u8DetailSpeed.u16BlockIndex,
												 FILENAME_DETAILSPEED_TMP);

							u8SD_1MinRetryCnt = 0;

							procSD_1M_Step = PROC_STEP_4;

							break;
						}

						procSD_1M_Step = PROC_STEP_2;

						break;
					}
					#else
					V161_SaveFileIdx(FILENAME_DETAILSPEED_TMP, u8DetailSpeed.u16BlockIndex);
					#endif

					u8SD_1MinRetryCnt = 0;

					procSD_1M_Step = PROC_STEP_3;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_1MIN_QUEUE_MAX)
					{
						procSD_1M_Step = PROC_STEP_16;

						break;
					}

					sd1MinBuf.u16DSBlockIndex = u8DetailSpeed.u16BlockIndex;

					bSD_SaveDatRequest = TRUE;

					procSD_1M_Step = PROC_STEP_3;
				}

				break;
			}

		// Step 3: Write data to file DETAIL_SPEED
		case PROC_STEP_3:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					sd1MinBuf.u16DSBlockIndex = 0;

					bRes = SD_WriteBuffToAddr(FILENAME_DETAILSPEED_TMP, u8DetailSpeed.u8DateBCD, DATELENS,
					                          HEADLENS + ((u8DetailSpeed.u16BlockIndex - 1) * DATELENS));

					if(!bRes)
					{
						u8SD_1MinRetryCnt++;

						if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
						{
							LOGprintf("\r\n> SD 1 min write data to file %s FAIL.", FILENAME_DETAILSPEED_TMP);

							u8SD_1MinRetryCnt = 0;

							procSD_1M_Step = PROC_STEP_4;

							break;
						}

						procSD_1M_Step = PROC_STEP_3;

						break;
					}

					u8SD_1MinRetryCnt = 0;

					procSD_1M_Step = PROC_STEP_4;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_1MIN_QUEUE_MAX)
					{
						procSD_1M_Step = PROC_STEP_16;

						break;
					}

					snprintf((char *)sd1MinBuf.u8DetailSpeedData[u8BufIdx], DATELENS, "%s", (char *)u8DetailSpeed.u8DateBCD);

					sd1MinBuf.u32DetailSpeedAddr[u8BufIdx] = HEADLENS + ((u8DetailSpeed.u16BlockIndex - 1) * DATELENS);

					sd1MinBuf.u16DSBlockIndex = u8DetailSpeed.u16BlockIndex;

					sd1MinBuf.bRequest[u8BufIdx] = TRUE;

					bSD_SaveDatRequest = TRUE;

					procSD_1M_Step = PROC_STEP_4;
				}

				break;
			}

		// Step 4: Get file DETAIL_SPEED_DAY index
		case PROC_STEP_4:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	#if !ENABLE_INDEX_BUFFER
				//	bRes = SD_ReadFileToBuff(FILENAME_DETAILSPEED_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);

				//	if(!bRes)
				//	{
				//		u8SD_1MinRetryCnt++;

				//		if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
				//		{
				//			LOGprintf("\r\n> SD 1 min read file %s index FAIL.", FILENAME_DETAILSPEED_DAY_TMP);

				//			u8SD_1MinRetryCnt = 0;

				//			procSD_1M_Step = PROC_STEP_7;

				//			break;
				//		}

				//		procSD_1M_Step = PROC_STEP_4;

				//		break;
				//	}
				//	#else
				//	V161_GetFileIdx(FILENAME_DETAILSPEED_DAY_TMP, &u16Index);
				//	#endif				

				//	u8SD_1MinRetryCnt = 0;

				//	u16DS_DayIdx = u16Index;

				//	u16Index++;

				//	procSD_1M_Step = PROC_STEP_5;
				//}
				// If make VDR file then write to SD buffer
				//else
				//{
				//	if(u8BufIdx == SD_1MIN_QUEUE_MAX)
				//	{
				//		procSD_1M_Step = PROC_STEP_16;

				//		break;
				//	}

				//	procSD_1M_Step = PROC_STEP_5;
				//}
				
				procSD_1M_Step = PROC_STEP_5;

				break;
			}

		// Step 5: Write new index to file DETAIL_SPEED_DAY
		case PROC_STEP_5:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				//if(V161_SDBuf_IsHighLoading() == FALSE)
				//{
				//	sd1MinBuf.u16Index = 0;

				//	#if !ENABLE_INDEX_BUFFER
				//	bRes = SD_WriteBuffToFile(FILENAME_DETAILSPEED_DAY_TMP, (uint8_t *)&u16Index, HEADLENS);

				//	if(!bRes)
				//	{
				//		u8SD_1MinRetryCnt++;

				//		if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
				//		{
				//			LOGprintf("\r\n> SD 1 min write new index %d to file %s FAIL.", u16Index,
				//			           FILENAME_DETAILSPEED_DAY_TMP);

				//			u8SD_1MinRetryCnt = 0;

				//			procSD_1M_Step = PROC_STEP_7;

				//			break;
				//		}

				//		procSD_1M_Step = PROC_STEP_5;

				//		break;
				//	}
				//	#else
				//	V161_SaveFileIdx(FILENAME_DETAILSPEED_DAY_TMP, u16Index);
				//	#endif

				//	u8SD_1MinRetryCnt = 0;

				//	u16DS_DayIdx = u16Index;

				//	procSD_1M_Step = PROC_STEP_6;
				//}
