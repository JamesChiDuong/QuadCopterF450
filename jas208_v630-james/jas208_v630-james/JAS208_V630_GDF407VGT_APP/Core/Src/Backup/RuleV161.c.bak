			{
				bRes = SD_WriteBuffToAddr((char *)FILENAME_DETAILSPEED_TMP, sd1MinBuf.u8DetailSpeedData[i], DATELENS,
																	sd1MinBuf.u32DetailSpeedAddr[i]);

				if(!bRes)
