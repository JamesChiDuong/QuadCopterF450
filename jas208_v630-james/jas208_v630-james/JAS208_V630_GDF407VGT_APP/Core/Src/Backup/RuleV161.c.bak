				//}
				
				procSD_1M_Step = PROC_STEP_10;

				break;
			}

		// Step 10: Write new block index to file POSITION_DAY
		case PROC_STEP_10:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
