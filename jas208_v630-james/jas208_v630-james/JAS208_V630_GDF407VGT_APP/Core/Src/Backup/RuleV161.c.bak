				//}

        procSD_1M_Step = PROC_STEP_7;
 
				break;
			}

		// Step 7: Write new block index to file POSITION
		case PROC_STEP_7:
			{
				if(PositionData.u8Index != 0)
				{
					procSD_1M_Step = PROC_STEP_12;

					break;
				}

				PositionData.u16BlockIndex++;

				if(PositionData.u16BlockIndex > POSMAX)
				{
					PositionData.u16BlockIndex = 1;
				}

				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					sd1MinBuf.u16PosBlockIndex = 0;

					#if !ENABLE_INDEX_BUFFER
					bRes = SD_WriteBuffToFile(FILENAME_POSITION_TMP, (uint8_t *)&PositionData.u16BlockIndex, HEADLENS);

					if(!bRes)
					{
						u8SD_1MinRetryCnt++;

						if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
						{
							LOGprintf("\r\n> SD 1 min write block index %d to file %s FAIL.", PositionData.u16BlockIndex,
							           FILENAME_POSITION_TMP);

							u8SD_1MinRetryCnt = 0;

							procSD_1M_Step = PROC_STEP_9;

							break;
						}

						procSD_1M_Step = PROC_STEP_7;

						break;
					}
					#else
					V161_SaveFileIdx(FILENAME_POSITION_TMP, PositionData.u16BlockIndex);
					#endif

					u8SD_1MinRetryCnt = 0;

					procSD_1M_Step = PROC_STEP_8;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_1MIN_QUEUE_MAX)
					{
						procSD_1M_Step = PROC_STEP_16;

						break;
					}

					sd1MinBuf.u16PosBlockIndex = PositionData.u16BlockIndex;

					sd1MinBuf.b1HourRequest = TRUE;

					bSD_SaveDatRequest = TRUE;

					procSD_1M_Step = PROC_STEP_8;
				}

				break;
			}

		// Step 8: Write hour data to file POSITION
		case PROC_STEP_8:
			{
				memset(PositionData.u8DateBCD, 0x00, POSLENS);
				memcpy(PositionData.u8DateBCD, u8SpeedDateBCD, 7);

				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
				if(V161_SDBuf_IsHighLoading() == FALSE)
				{
					sd1MinBuf.u16PosBlockIndex = 0;

					bRes = SD_WriteBuffToAddr(FILENAME_POSITION_TMP, PositionData.u8DateBCD, POSLENS,
					                          HEADLENS + ((PositionData.u16BlockIndex - 1) * POSLENS));

					if(!bRes)
					{
						u8SD_1MinRetryCnt++;

						if(u8SD_1MinRetryCnt == SD_1MIN_TASK_RETRY_MAX)
						{
							LOGprintf("\r\n> SD 1 min write hour data to file %s FAIL.", FILENAME_POSITION_TMP);

							u8SD_1MinRetryCnt = 0;

							procSD_1M_Step = PROC_STEP_9;

							break;
						}

						procSD_1M_Step = PROC_STEP_8;

						break;
					}

					u8SD_1MinRetryCnt = 0;

					procSD_1M_Step = PROC_STEP_9;
				}
				// If make VDR file then write to SD buffer
				else
				{
					if(u8BufIdx == SD_1MIN_QUEUE_MAX)
					{
						procSD_1M_Step = PROC_STEP_16;

						break;
					}

					memset(PositionData.u8DateBCD, 0x00, POSLENS);
					memcpy(PositionData.u8DateBCD, u8SpeedDateBCD, 7);

					snprintf((char *)sd1MinBuf.u8Position1HourData, POSLENS, "%s", (char *)PositionData.u8DateBCD);

					sd1MinBuf.u32Position1HourAddr = HEADLENS + ((PositionData.u16BlockIndex - 1) * POSLENS);

					sd1MinBuf.u16PosBlockIndex = PositionData.u16BlockIndex;

					sd1MinBuf.b1HourRequest = TRUE;

					bSD_SaveDatRequest = TRUE;

					procSD_1M_Step = PROC_STEP_9;
				}

				break;
			}

		// Step 9: Get file POSITION_DAY block index
		case PROC_STEP_9:
			{
				// If not do making VDR file/PC download/USB download/printing then read/ write directly to SD card
