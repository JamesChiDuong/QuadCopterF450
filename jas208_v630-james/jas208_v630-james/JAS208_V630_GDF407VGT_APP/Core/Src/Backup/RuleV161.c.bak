//============================================================================//
// @brief  Writing record to rest file.
// @param  stRestTime: Record data in RestDataTypeDef format.
// @retval None.
//============================================================================//
void V161_RecordRestTime(RestDataTypeDef stRestTime)
{
	SD_ReadFileToBuff(FILENAME_REST_TMP, (uint8_t *)&stRestTime.u8BlockIndex, SHORTHEAD);

	stRestTime.u8BlockIndex++;

	SD_WriteBuffToFile(FILENAME_REST_TMP, (uint8_t *)&stRestTime.u8BlockIndex, SHORTHEAD);

	if(stRestTime.u8BlockIndex != 0)
	{
		SD_WriteBuffToAddr(FILENAME_REST_TMP, (uint8_t *)&stRestTime.u8BeforeDateBCD, RESTLENS,
											SHORTHEAD + ((stRestTime.u8BlockIndex-1) * RESTLENS));
	}
	else
	{
		SD_WriteBuffToAddr(FILENAME_REST_TMP, (uint8_t *)&stRestTime.u8BeforeDateBCD, RESTLENS, SHORTHEAD);
	}
	
	V161_WriteRestToVDR(stRestTime);
}

#if ENABLE_SD_BUFFER
//============================================================================//
// @brief  Check if the system is in SD high loading status.
// @param  None.
// @retval TRUE: SD is in high loading.
//         FALSE: SD is not in high loading.
//============================================================================//
bool V161_SDBuf_IsHighLoading(void)
{
	if((bDoVDR_HourFlag == TRUE) || (bDoVDR_DayFlag == TRUE))
		return TRUE;

	if(bDoHourVDRFlag == TRUE)
		return TRUE;

	if(bPC_Trans == TRUE)
		return TRUE;

	if(procUSB_TransStep != PROC_STEP_NULL)
		return TRUE;

	if(bPRN_Run == TRUE)
		return TRUE;
  
	return FALSE;
}

//============================================================================//
// @brief  Initialize SD buffer mechanism.
// @param  None.
// @retval None.
//============================================================================//
void V161_SDBuf_SaveDataInit(void)
{
	for(int i = 0; i < SD_1MIN_QUEUE_MAX; i++)
	{
		sd1MinBuf.bRequest[i] = FALSE;
		sd1MinBuf.u32DetailSpeedAddr[i] = 0;
		sd1MinBuf.u32DetailSpeedDayAddr[i] = 0;
		sd1MinBuf.u32PositionAddr[i] = 0;
		sd1MinBuf.u32PositionDayAddr[i] = 0;
	}

	sd1MinBuf.u32Position1HourAddr = 0;
	sd1MinBuf.u32PositionDay1HourAddr = 0;

	sd1MinBuf.b1HourRequest = FALSE;
	sd1MinBuf.b_u16Index2Save = FALSE;

	sd1MinBuf.u32DetailSpeedLen = DATELENS;
	sd1MinBuf.u32DetailSpeedDayLen = DATELENS;
	sd1MinBuf.u32Position1HourLen = POSLENS;
	sd1MinBuf.u32PositionDay1HourLen = POSLENS;
	sd1MinBuf.u32PositionLen = POSITIONLENS;
	sd1MinBuf.u32PositionDayLen = POSITIONLENS;

	for(int i = 0; i < SD_RECORD_DRIVE_QUEUE_MAX; i++)
	{
		sdRecDrvBuf.bRequest[i] = FALSE;
		sdRecDrvBuf.u32DriveAddr[i] = 0;
		sdRecDrvBuf.u32DriveDayAddr[i] = 0;
	}

	sdRecDrvBuf.u32DatLen = DRIVINGLENS;
	
	for(int i = 0; i < SD_RECORD_EXTEND_QUEUE_MAX; i++)
	{
		sdRecExtBuf.bRequest[i] = FALSE;
		sdRecExtBuf.u32RecExtAddr[i] = 0;
		sdRecExtBuf.u32RecExtDayAddr[i] = 0;
	}

	sdRecExtBuf.u32DatLen = EXTLENS;
}

//============================================================================//
// @brief  Handle SD buffer saving data request.
// @param  None.
// @retval None.
//============================================================================//
void V161_SDBuf_SaveDataProc(void)
{
	bool bRes;


	LOGprintf("\r\n> Write SD buffered data.");

	if(sd1MinBuf.u16DSBlockIndex > 0)
	{
		#if !ENABLE_INDEX_BUFFER
		bRes = SD_WriteBuffToFile((char *)FILENAME_DETAILSPEED_TMP, (uint8_t *)&sd1MinBuf.u16DSBlockIndex, HEADLENS);

		if(!bRes)
		{
			LOGprintf("\r\n> SD write 1 min buffered index %d to file %s FAIL.",
			          sd1MinBuf.u16DSBlockIndex, FILENAME_DETAILSPEED_TMP);
