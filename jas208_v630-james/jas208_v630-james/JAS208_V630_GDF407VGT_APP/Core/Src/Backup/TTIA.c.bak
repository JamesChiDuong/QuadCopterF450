{
	uint16_t BufLen = 0;
	TROUBLE_SEND_t *TROUBLE_SEND;


	memset(gTTIA_MsgBuf, 0x00, sizeof(gTTIA_MsgBuf));

	TROUBLE_SEND = (TROUBLE_SEND_t*)gTTIA_MsgBuf;

	TTIA_MsgPkgHeadCreate((PACKAGE_HEADER_t*)&TROUBLE_SEND->Head);

	TROUBLE_SEND->Head.InfoLen = sizeof(TROUBLE_INFO_t);

