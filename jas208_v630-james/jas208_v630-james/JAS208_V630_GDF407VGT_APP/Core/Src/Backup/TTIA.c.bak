	DataSend_AddDataToQue((uint8_t*)TROUBLE_SEND, BufLen);
}

void TTIA_MsgSendOD(void)
{
	uint16_t BufLen = 0;
	OD_SEND_t *OD_SEND;


	memset(gTTIA_MsgBuf, 0x00, sizeof(gTTIA_MsgBuf));

	OD_SEND = (OD_SEND_t*)gTTIA_MsgBuf;

	TTIA_MsgPkgHeadCreate((PACKAGE_HEADER_t*)&OD_SEND->Head);

	//OD_SEND->Info.Route;

	OD_SEND->Info.PkgNum = 1;

	//OD_SEND->Info.Record

	OD_SEND->Head.InfoLen = sizeof(OD_INFO_t);

	BufLen = sizeof(PACKAGE_HEADER_t) + OD_SEND->Head.InfoLen;

	DataSend_AddDataToQue((uint8_t*)OD_SEND, BufLen);
}

void TTIA_MsgReply(GSM_SocketDataTypeDef SocketData)
{
	uint8_t *pBuf;
	PACKAGE_HEADER_t *PkgHead;


	if(SocketData.SocketNum != 0)
		return;

	memset(gTTIA_MsgBuf, 0x00, sizeof(gTTIA_MsgBuf));

	pBuf = gTTIA_MsgBuf;

	memcpy(pBuf, SocketData.cData, SocketData.u16DataLen);

	PkgHead = (PACKAGE_HEADER_t*)gTTIA_MsgBuf;

	pBuf += sizeof(PACKAGE_HEADER_t);

	if(PkgHead->MessageID == TTIA_MSG_SEND_ALARM)
	{
		return;
	}

	// 回應封包序號比對
	if(PkgHead->Sequence != usiPkgHeadSequChk)
		return;

	if(PkgHead->MessageID == TTIA_MSG_REPLY_REGISTER)
	{
		TTIA_MsgReplyRegister(pBuf);
	}

	bTTIA_MsgReplyOK = TRUE;
}

void TTIA_MsgProc(void)
{
	switch(gTTIA_MsgProc)
	{
		case MSG_BREAK:
			TTIA_MsgGetQueue();

		  break;

		case MSG_INIT:
			TTIA_MsgClrReg();

			SetTID_TTIAInfoProc();

			SetTID_TTIABuild();


			TTIA_EdrAppendQueue(EDR_INIT, NULL);


			gTTIA_MsgProc = MSG_SEND_REGISTER;
		break;

		case MSG_SEND_REGISTER:
			if(strlen(g_SysInfo.MobileInfo.IMSI) == 0
				 || strlen(g_SysInfo.MobileInfo.IMEI) == 0)
				break;

			TTIA_MsgSendRegister();

			gTTIA_MsgProc = MSG_BREAK;

			break;

		case MSG_REPLY_REGISTER:
			if(bTTIA_MsgReplyOK == TRUE)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF REGISTER MSG REPLY is %d mS\r\n", SysTick_2_mS(HAL_GetTick() - uiTTIA_MsgSendStart));
			}
			else if(HAL_GetTick() - uiTTIA_MsgSendStart >= MSG_TIMEOUT_DEF)
			{
				gTTIA_MsgProc = MSG_BREAK;

				// 重新註冊
				TTIA_MsgAppendQueue(MSG_SEND_REGISTER, NULL);

				RTOSprintf("\r\n> PRINTF REGISTER MSG REPLY Timeout!!\r\n");
			}

		  break;

		case MSG_SEND_ROUTE:
			TTIA_MsgSendRoute();

			gTTIA_MsgProc = MSG_BREAK;

		  break;

		case MSG_REPLY_ROUTE:
			if(bTTIA_MsgReplyOK == TRUE)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF ROUTE MSG REPLY is %d mS\r\n", SysTick_2_mS(HAL_GetTick() - uiTTIA_MsgSendStart));
			}

			else if(HAL_GetTick() - uiTTIA_MsgSendStart >= MSG_TIMEOUT_DEF)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF ROUTE MSG REPLY Timeout!!\r\n");
			}

			break;

		case MSG_SEND_REPORT:
			TTIA_MsgSendReport();

			gTTIA_MsgProc = MSG_BREAK;

		  break;

		case MSG_REPLY_REPORT:
			if(bTTIA_MsgReplyOK == TRUE)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF REPORT MSG REPLY is %d mS\r\n", SysTick_2_mS(HAL_GetTick() - uiTTIA_MsgSendStart));
			}
			else if(HAL_GetTick() - uiTTIA_MsgSendStart >= MSG_TIMEOUT_DEF)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF REPORT MSG REPLY Timeout!!\r\n");
			}

		  break;

		case MSG_SEND_ALARM:
			gTTIA_MsgProc = MSG_BREAK;

		  break;

		case MSG_REPLY_ALARM:
			gTTIA_MsgProc = MSG_BREAK;

		  break;

		case MSG_SEND_EVENT:
			TTIA_MsgSendEvent();

			gTTIA_MsgProc = MSG_BREAK;

		  break;

		case MSG_REPLY_EVENT:
			if(bTTIA_MsgReplyOK == TRUE)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF EVENT MSG REPLY is %d mS\r\n", SysTick_2_mS(HAL_GetTick() - uiTTIA_MsgSendStart));
			}
			else if(HAL_GetTick() - uiTTIA_MsgSendStart >= MSG_TIMEOUT_DEF)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF EVENT MSG REPLY Timeout!!\r\n");
			}

		break;

		case MSG_SEND_SHUTDOWN:
			TTIA_MsgSendShutdown();

			gTTIA_MsgProc = MSG_BREAK;

		  break;

		case MSG_REPLY_SHUTDOWN:
			if(bTTIA_MsgReplyOK == TRUE)
			{
				gTTIA_MsgProc = MSG_BREAK;

				TTIA_MsgClrReg();

				ClrTID_TTIAInfoProc();

				ClrTID_TTIABuild();

				RTOSprintf("\r\n> PRINTF SHUTDOWN MSG REPLY is %d mS\r\n", SysTick_2_mS(HAL_GetTick() - uiTTIA_MsgSendStart));
			}
			else if(HAL_GetTick() - uiTTIA_MsgSendStart >= MSG_TIMEOUT_DEF)
			{
				gTTIA_MsgProc = MSG_BREAK;

				TTIA_MsgClrReg();

				ClrTID_TTIAInfoProc();

				ClrTID_TTIABuild();

				RTOSprintf("\r\n> PRINTF SHUTDOWN MSG REPLY Timeout!!\r\n");
			}

		  break;

		case MSG_SEND_TROUBLE:
			TTIA_MsgSendTrouble();

			gTTIA_MsgProc = MSG_BREAK;

		  break;

		case MSG_REPLY_TROUBLE:
			if(bTTIA_MsgReplyOK == TRUE)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF TROUBLE MSG REPLY is %d mS\r\n", SysTick_2_mS(HAL_GetTick() - uiTTIA_MsgSendStart));
			}
			else if(HAL_GetTick() - uiTTIA_MsgSendStart >= MSG_TIMEOUT_DEF)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF TROUBLE MSG REPLY Timeout!!\r\n");
			}

		break;

		case MSG_SEND_OD:
			TTIA_MsgSendOD();

			gTTIA_MsgProc = MSG_BREAK;

		  break;

		case MSG_REPLY_OD:
			if(bTTIA_MsgReplyOK == TRUE)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF OD-RECODE MSG REPLY is %d mS\r\n", SysTick_2_mS(HAL_GetTick() - uiTTIA_MsgSendStart));
			}
			else if(HAL_GetTick() - uiTTIA_MsgSendStart >= MSG_TIMEOUT_DEF)
			{
				gTTIA_MsgProc = MSG_BREAK;

				RTOSprintf("\r\n> PRINTF OD-RECODE MSG REPLY Timeout!!\r\n");
			}

		  break;
	}
}

bool TTIA_Process(void)
{
	TTIA_MsgProc();

	TTIA_EdrProc();

	return TRUE;
}

void SetTID_TTIAProc(void)
{
