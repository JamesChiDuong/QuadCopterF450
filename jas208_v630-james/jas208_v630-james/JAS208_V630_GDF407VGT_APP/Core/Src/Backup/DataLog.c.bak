static bool Datalog_SaveBuf_Proc(void)
{
	bool RESULT;


	if(u16Log_SaveBufLen == 0)
		return TRUE;

	RESULT = SD_AddBuffToFile(FILENAME_DATALOG_BIN, gLog_SaveBuf, u16Log_SaveBufLen);

	if(RESULT == TRUE)
	{
		memset(gLog_SaveBuf, 0x00, sizeof(gLog_SaveBuf));

		u16Log_SaveBufLen = 0;
	}

	return RESULT;
}
