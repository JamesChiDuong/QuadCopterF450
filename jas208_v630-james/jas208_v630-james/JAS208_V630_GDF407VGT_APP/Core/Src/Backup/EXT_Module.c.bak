//============================================================================//
//============================================================================//
//TPMS:胎溫壓系統
//問輪胎資料send :01001@
//010   為固定.
//01    為輪胎代碼 (目前01~06六個輪胎)
//@     為固定
//將收到的資料截取 16Byte 資料 以事件送出
//$AS+TPMS=01002020108P025C000@(4~20 Byte)
//截取 16Byte 資料:02020108P025C000
//01	：02	 代表左前輪
//00	：02	 代表Tx  之ID  尾碼(TireNum)
//0033  ：0108	 表示壓力，  33  數值
//N	：P	 代表壓力單位，P  代表PSI、K  代表KPa、B  代表Bar
//020	：025	 表示溫度，  20  數值
//M	：C	 代表溫度單位，C  表示攝氏、F  表示華氏
//X	：0	 此位置為1  表示此輪胎壓力低於23PSI，為  0  則代表正常
//Y	：0	 此位置為1  表示此輪胎溫度高於85C，為  0  則代表正常
//Z	：0	 此位置為1  表示此輪胎正處於漏氣，為  0  則代表正常
//後三碼為1代表異常,才需送事件
//============================================================================//
#if ENABLE_TPMS
#define TPMS_COMPORT_DEF		    EXT_COMPORT_DEF
#define TPMS_DBG_MODE				    DBG_EXT
#define TPMS_BUF					      ExtBuf

#define	TIMER_TPMS_PROC				  100
#define	MAX_TPMS_PKG_TIMEOUT		(500 / TIMER_TPMS_PROC)

//  控制多久問一個輪胎
#define	TPMS_SEND_TIMER				  (S_2_mS(2) / TIMER_TPMS_PROC)

#define	TPMS_DEVICE_SEND_HEAD		"010"

//	第1輪  開始碼
#define	TPMS_FIRST_TIRE				  (1)

//	讀多少輪資料
#define	TPMS_LAST_TIRE				  (10)

#define	TPMS_DEVICE_RECV_HEAD		"$AS+TPMS="
#endif

//============================================================================//
//	RFID_READER_RR10
//
//Block Amount
//This field is absent if “Result” field is not equal to 0x00.
//Tag has “Block Amount”+1 blocks.
//3F = 63+1=64
//
//Block Size
//This field is absent if “Result” field is not equal to 0x00.
//The block size is “Block Size”+1 bytes.
//3+1 = 4
//
//============================================================================//
#if ENABLE_RFID
#define RFID_COMPORT_DEF		        EXT_COMPORT_DEF

#define	TIMER_RFID_PROC					    (100)

#define	TIMER_RFID_WAIT 				    (100)

#define	TIMER_RFID_TOTAL_WAIT       (500)

// 多久確認一次卡片 RFID_SCAN_TIME x TIMER_RFID_PROC ==> 4X100mS = 400mS
#define	RFID_SCAN_TIME			 		    (5)

#define	RFID_MAX_GET_PKG_TIMEOUT		(S_2_mS(1) / TIMER_RFID_PROC)

#define RFID_SEND_TX_HEAD				    (0x55)

#define RFID_SEND_RX_HEAD	          (0xAA)

#define RFID_RECV_TX_HEAD			     	(0xA5)

#define RFID_RECV_RX_HEAD				    (0x5A)

#define RFID_CONNECTION_OK				  ("\x06\x01\x05\x00\x0C\x00")

// 表示卡片無資料
#define RFID_TAG_NO_DATA				    ("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")

#define RFID_READ_BYTE					    (64)

//#define RFID_READ_BYTE					    (256)
#endif


