void EXT_SendBuffer(uint8_t *pu8Buf, uint16_t u16BufLen)
{
	UART_SendBuffer(EXT_COMPORT_DEF, pu8Buf, u16BufLen);

	if(g_Setting.DebugMode == DBG_EXT)
		UART_SendBuffer(SET_COMPORT_DEF, pu8Buf, u16BufLen);
}

#if ENABLE_LCM
void LCM_SendCmdPkg(uint8_t *Pkg, uint16_t PkgLen) // Heinz
{
#if ENABLE_EXT_BOX
	char *pStr;
	uint8_t Buf[UART_MAX_BUFFER_SIZE];
	uint16_t BufLen;


	memset(Buf, 0x00, sizeof(Buf));

	pStr = (char*)Buf;

	sprintf(pStr, "%s%s,", STR_AS_EXTBOX, "LCD"); // Heinz

	BufLen = strlen(pStr);

	pStr += BufLen;

	memcpy(pStr, Pkg, PkgLen);

	BufLen += PkgLen;

	EXT_SendBuffer(Buf, BufLen); // Heinz

	//Delay_mS(50);	// Heinz
#else
	EXT_SendBuffer(Pkg, PkgLen);

	Delay_mS(50);
#endif
}

void LCM_VideoOn(void)
{
	if(LCD_VideoState == SET)
		return;

	LCD_CMD = LCD_VIDEO;

	LCD_VideoState = SET;

	LCD_VideoCtrlCount = MAX_VIDEO_CTRL_COUNT;
}

void LCM_VideoOff(void)
{
	if(LCD_VideoState == RESET
	        && LCD_VideoChannel != VIDEO_INIT)
		return;

	LCD_CMD = LCD_VIDEO;

	LCD_VideoState = RESET;

	LCD_VideoCtrlCount = MAX_VIDEO_CTRL_COUNT;
}

FlagStatus LCM_GetVideoState(void)
{
	return LCD_VideoState;
}

void LCM_VideoCH1(void)
{
	if(LCD_VideoChannel != VIDEO_CH1)
		LCD_VideoState = RESET;

	LCD_VideoChannel = VIDEO_CH1;
}

void LCM_VideoCH2(void)
{
	if(LCD_VideoChannel != VIDEO_CH2)
		LCD_VideoState = RESET;

	LCD_VideoChannel = VIDEO_CH2;
}

void LCM_VideoCH3(void)
{
#if CUSTOMER_TYPE == CUSTOMER_FORMOSA
	if(g_SysInfo.DrvInfo.WorkTime < MINUTE_2_SECOND(2))
	{
		LCD_VideoChannel = VIDEO_INIT;

		LCM_VideoOff();
	}
	else
	{
		//if((g_SysInfo.DrvInfo.WorkTime * 1000) < S_2_mS(130))
		if(g_SysInfo.DrvInfo.WorkTime < MINUTE_2_SECOND(4))
		{
			LCD_VideoChannel = VIDEO_CH3;

			LCM_VideoOn();
		}
		else
		{
			LCD_VideoChannel = VIDEO_CH2;

			LCM_VideoOff();
		}
	}
#else
	LCD_VideoChannel = VIDEO_CH3;
#endif
}

void LCM_SendPkg(char *pStr)
{
	char *pMsg;


	pMsg = (char*)LCD_PkgBuf;

	pMsg += strlen(pMsg);

	strncpy(pMsg, pStr, strlen(pStr));
}

bool LCM_ChkInfo(void)
{
	if(GSM_GetCallStatus() == TRUE
	        && LCD_CallState != CALL_RING)
	{
		LCD_CMD = LCD_CALL;

		return TRUE;
	}

	if(GSM_GetDialStatus() == TRUE
	        && LCD_CallState != CALL_TALK)
	{
		LCD_CMD = LCD_CALL;

		return TRUE;
	}

	if(GSM_GetCallStatus() == FALSE
	        && GSM_GetDialStatus() == FALSE
	        && LCD_CallState != CALL_CANCEL)
	{
		LCD_CMD = LCD_CALL;

		return TRUE;
	}

	return FALSE;
}

void LCM_SendHead(void)	// Heinz
{
	char *pStr;
	time_t rawtime;


	memset(ExtBuf, 0x00, sizeof(ExtBuf));

	pStr = (char*)ExtBuf;

	if(LCD_TimeSync <= MAX_TIME_COUNT) // Heinz 12
	{
		LCD_TimeSync ++;

		time(&rawtime);

		rawtime += g_Setting.i32TimeZoneOffset;

		sprintf(pStr, "@ %s", STR_AS_LCD_TIME);

		pStr += strlen(pStr);

		strftime(pStr, sizeof(ExtBuf), "%Y/%m/%d %H:%M:%S\r\n", localtime(&rawtime));

		pStr = (char*)ExtBuf;

		LCM_SendCmdPkg(ExtBuf, strlen(pStr));  // Heinz
	}

#if CUSTOMER_TYPE == CUSTOMER_FORMOSA
	sprintf(pStr, "@ %s%.1f\r\n", STR_AS_LCD_SPEED,(float)(u16hmSpeedAvg)/10); // Heinz	FMS
#else
	sprintf(pStr, "@ %s%.1f\r\n", STR_AS_LCD_SPEED, M_2_KM((float)g_SysInfo.VehicleState.u32Speed));
#endif

	LCM_SendCmdPkg(ExtBuf, strlen(pStr));

	sprintf(pStr, "@ %s%d\r\n", STR_AS_LCD_RPM, g_SysInfo.VehicleState.u16RPM);

	LCM_SendCmdPkg(ExtBuf, strlen(pStr));
}

void LCM_SendInfo(LCD_CMD_t CMD)
{
	char *pStr;


	memset(ExtBuf, 0x00, sizeof(ExtBuf));

	pStr = (char *)ExtBuf;

	switch(CMD)
	{
		case LCD_SIGNAL:
			GPS_DATA_t GPS_AllData;
			uint8_t GPS_SIGNAL;
			uint8_t GSM_SQ;
			uint8_t GSM_SIGNAL;


			GPS_SIGNAL = 0;

			GPS_GetAllData(&GPS_AllData);

			if(GPS_AllData.Fixed == TRUE)
			{
				GPS_SIGNAL = 1;

				if(GPS_AllData.StlNum >= 3)
					GPS_SIGNAL = 3;

				if(GPS_AllData.StlNum >= 4)
					GPS_SIGNAL = 6;

				if(GPS_AllData.StlNum >= 5)
					GPS_SIGNAL = 9;
			}

			GSM_SIGNAL = 0;

			if(GSM_GetSQ(&GSM_SQ) == TRUE)
			{
				if(GSM_GetNetStatus() == TRUE)
					GSM_SIGNAL = 1;

				if(GSM_SQ >= 5)
					GSM_SIGNAL = 3;	// 3

				if(GSM_SQ >= 9) // 10
					GSM_SIGNAL = 5;	// 3

				if(GSM_SQ >= 13) // 15
					GSM_SIGNAL = 6; // 3

				if(GSM_SQ >= 17) // 20
					GSM_SIGNAL = 7;

				if(GSM_SQ >= 21) // 25
					GSM_SIGNAL = 8;	// 3

				if(GSM_SQ >= 25) // 30
					GSM_SIGNAL = 9;
			}

			sprintf(pStr, "@ %s%d,%d\r\n",
			        STR_AS_LCD_SIGNAL,
			        GPS_SIGNAL,
			        GSM_SIGNAL);

			break;

		case LCD_DIST:
			DistTemp++;

			if(DistTemp >= MAX_DIST_COUNT) // Heinz
			{
				DistTemp = 0;

				sprintf(pStr, "@ %s%.2f\r\n", STR_AS_LCD_DIST, M_2_KM(g_SysInfo.VehicleState.dDistance));
			}

			break;

		case LCD_GPS:
			GpsTemp++;

			if(GpsTemp >= MAX_GPS_COUNT)	// Heinz
			{
				GPS_DATA_t GPS_AllData;

				GpsTemp = 0;

				GPS_GetAllData(&GPS_AllData);

				sprintf(pStr, "@ %sGPS=> %c%03d%02d.%04d,%c%02d%02d.%04d\r\n",
				        STR_AS_LCD_GPS,
				        GPS_AllData.Longitude.Indicator,
				        GPS_AllData.Longitude.ddd,
				        GPS_AllData.Longitude.mm,
				        GPS_AllData.Longitude.mmmm,
				        GPS_AllData.Latitude.Indicator,
				        GPS_AllData.Latitude.dd,
				        GPS_AllData.Latitude.mm,
				        GPS_AllData.Latitude.mmmm);
			}

			break;

		case LCD_CALL:
			if(GSM_GetCallStatus() == TRUE)
			{
				LCD_CallState = CALL_RING;

				sprintf(pStr, "@ %sRING\r\n", STR_AS_LCD_CALL);  //Heinz
				//sprintf(pStr, "AUTO...\r\n");	//heinz

				break;
			}

			if(GSM_GetDialStatus() == TRUE)
			{
				LCD_CallState = CALL_TALK;

				sprintf(pStr, "@ %sTALK\r\n", STR_AS_LCD_CALL);

				break;
			}

			LCD_CallState = CALL_CANCEL;

			sprintf(pStr, "@ %sCANCEL\r\n", STR_AS_LCD_CALL);

			break;

		case LCD_VIDEO:
			if(LCD_VideoCtrlCount == 0)
			{
#if ENABLE_EXT_BOX
				static bool LcdVideoInit = TRUE;


				LCM_VideoCH3();

				if(LCD_VideoChannel == VIDEO_INIT)
					LcdVideoInit = TRUE;

				if(LcdVideoInit == TRUE
				        && LCD_VideoChannel == VIDEO_CH3)
				{
					LCD_VideoCtrlCount = MAX_VIDEO_CTRL_COUNT;

					LcdVideoInit = FALSE;
				}
#endif

				break;
			}

			LCD_VideoCtrlCount--;

			sprintf(pStr, "@ %s%d,%d\r\n",
			        STR_AS_LCD_VIDEO,
			        LCD_VideoState,
			        LCD_VideoChannel);

			break;

		default:
			break;
	}

	if(strlen(pStr))
		LCM_SendCmdPkg(ExtBuf, strlen(pStr));
}

static bool LCM_GetCmdPkg(uint8_t *pCmdPkg)
{
	static uint16_t GetPkgLen;
	uint16_t BufLen;
	uint8_t Buf[UART_MAX_BUFFER_SIZE];
	uint8_t i = 0, Buf2[UART_MAX_BUFFER_SIZE];


	BufLen = UART_GetRxBufLen(EXT_COMPORT_DEF);

	if(BufLen == 0)
	{
		GetPkgLen = 0;

		return FALSE;
	}
	else
	{
		if(GetPkgLen != BufLen)
		{
			GetPkgLen = BufLen;

			return FALSE;
		}

		GetPkgLen = 0;
	}

	memset(Buf, 0x00, sizeof(Buf));
	memset(Buf2, 0x00, sizeof(Buf2));

	BufLen = UART_GetRxBuffer(EXT_COMPORT_DEF, Buf, sizeof(Buf));

	if((Buf[0] == 0x00) && (Buf[1] != 0x00) ) // Modify 7 inch moniter bug.
	{
		for(i = 0; i <= BufLen; i++ )
		{
			Buf2[i]= Buf[i + 1];
		}

		memcpy(pCmdPkg, Buf2, BufLen);
	}
	else
	{
		memcpy(pCmdPkg, Buf, BufLen);
	}

	return TRUE;
}

static void LCM_ProcCmd(char *pStr)
{
	if(strncmp(pStr, CHK_CMD_VERSION, strlen(CHK_CMD_VERSION)) == 0)
	{
		sprintf(pStr, "%s*", STR_AS_VERSION);

		return;
	}

	if(strncmp(pStr, CHK_CMD_SPD_LIMIT, strlen(CHK_CMD_SPD_LIMIT)) == 0)
	{
		sprintf(pStr, "%s*", STR_AS_SPEED_LIMIT);

		return;
	}
}

static bool LCM_Process(void)
{
	static uint8_t SendInfoCount = COUNT_LCM_SEND_INFO;


	memset(ExtBuf, 0x00, sizeof(ExtBuf));

	if(LCM_GetCmdPkg(ExtBuf) == TRUE)
	{
		char *pStr;


		pStr = (char*)ExtBuf;

		if(strncmp(strstr(pStr, CMD_HEAD_STD), CMD_HEAD_STD, strlen(CMD_HEAD_STD)) == 0)
			//if(strncmp(pStr,CMD_HEAD_STD, strlen(CMD_HEAD_STD)) == 0)
		{
			memcpy(ExtBuf, strstr(pStr, CMD_HEAD_STD), strlen(pStr));

			if(g_Setting.DebugMode == DBG_EXT)
				SET_SendBuffer(ExtBuf, strlen(pStr));

			LCM_ProcCmd(pStr);

			if(Protocl_ChkCmdPkg(pStr, pStr) == TRUE
			        && (pStr != NULL) && (strlen(pStr))	)
				// && strlen(pStr) != 0)
				LCM_SendCmdPkg(ExtBuf, strlen(pStr));
		}
	}

	if(strlen((char*)LCD_PkgBuf))
	{
		LCM_SendCmdPkg(LCD_PkgBuf, strlen((char*)LCD_PkgBuf));

		memset(LCD_PkgBuf, 0x00, sizeof(LCD_PkgBuf));
	}

	SendInfoCount--;

	if(SendInfoCount == 0)
	{
		LCM_SendHead();	// Time /Speed /RPM

		if(LCM_ChkInfo() == TRUE)
			LCM_SendInfo(LCD_CMD); // Heinz
		else
		{
			LCM_SendInfo(LCD_CMD); // Heinz

			LCD_CMD++;

			if(LCD_CMD >= LCD_END)
				LCD_CMD = (LCD_CMD_t)0;
		}

		SendInfoCount = COUNT_LCM_SEND_INFO;
	}

	return TRUE;
}

void SetTID_LcmProc(void)
{
	SWTIM_SetTimer(TIMER_LCM_PROC, TIMER_CONTINUE, LCM_Process);
}
#endif

#if ENABLE_KEYPAD
static bool KEYPAD_GetCmdPkg(void)
{
	static uint8_t GetPkgTimeout = MAX_KEYPAD_PKG_TIMEOUT;
	uint16_t BufLen;
	char *pBuf;


	BufLen = UART_GetRxBufLen(EXT_COMPORT_DEF);

	if(BufLen == 0)
	{
		GetPkgTimeout = MAX_KEYPAD_PKG_TIMEOUT;

		return FALSE;
	}
	else
	{
		if(GetPkgTimeout > 0)
		{
			GetPkgTimeout--;

			return FALSE;
		}

		GetPkgTimeout = MAX_KEYPAD_PKG_TIMEOUT;
	}

	memset(ExtBuf, 0x00, sizeof(ExtBuf));

	BufLen = UART_GetRxBuffer(EXT_COMPORT_DEF, ExtBuf, sizeof(ExtBuf));

	if(BufLen >= UART_MAX_BUFFER_SIZE)
		return FALSE;

	pBuf = (char*)ExtBuf;

	if(strncmp(pBuf, STR_KEYPAD_HEAD, strlen(STR_KEYPAD_HEAD)) == 0)
		strcpy(pBuf, pBuf + strlen(STR_KEYPAD_HEAD));

	StopChar(pBuf, '\r');

	return TRUE;
}

static bool KEYPAD_Process(void)
{
	char szTEMP[UART_MAX_BUFFER_SIZE];


	if(KEYPAD_GetCmdPkg() == FALSE)
		return TRUE;

#if ENABLE_DEBUG_MSG
	RTOSprintf("\r\n> KEYPAD IN: %s", ExtBuf);
#endif

	strncpy(szTEMP, (char*)ExtBuf, KEYIN_SIZE_MAX);

	DataStream_EventBuild(STR_EVENT_BARCODE, szTEMP);

	return TRUE;
}

void SetTID_KeypadProc(void)
{
	SWTIM_SetTimer(TIMER_KEYPAD_PROC, TIMER_CONTINUE, KEYPAD_Process);
}
