//============================================================================//
// @brief  Deinitialize SD card.
// @param  None.
// @retval Result: TRUE: SD card deinitialization success.
//                 FALSE: SD card deinitialization is fail.
//============================================================================//
bool SD_Deinit(void)
{
	FRESULT frRes;
	uint8_t u8Res;
	
	
	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}
	
	if(!bRTOS_En)
		u8Res = disk_status(DRV_SD);
	else
		u8Res = (uint8_t)SD_RequestDo(SD_DISK_STATUS, 1, DRV_SD);
	
	if(u8Res == STA_READY)
	{
		if(!bRTOS_En)
			frRes = f_mount(NULL, (TCHAR const*)USERPath, 0);
		else
			frRes = SD_RequestDo(SD_MOUNT, 3, NULL, (TCHAR const*)USERPath, 0);

		if(frRes == FR_OK)
		{
			//if(bRTOS_En)
			//	osMutexRelease(mutex_spi2_user);

			HAL_Delay(1);

			return TRUE;
		}
		else
		{
			//if(bRTOS_En)
			//	osMutexRelease(mutex_spi2_user);

			HAL_Delay(1);

			return FALSE;
		}
	}
	else
	{
		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return TRUE;
	}
}

//============================================================================//
// @brief  Check if a directory exists.
// @param  pcDirName: Pointer to a char array storing the directory name.
// @retval Result: TRUE: The directory exists.
//                 FALSE: The directory does not exist/ the operation is fail.
//============================================================================//
bool SD_CheckDirExist(char *pcDirName)
{
	FRESULT frRes;
	DIR dirSD_Handle;
	char cfilSD_HandlePath[128];
	uint8_t u8TryCnt = 0;


	if(strlen(pcDirName) == 0)
		return FALSE;

	// Check SD card status
	if(SD_FS_Check(FALSE) == FALSE)
		return FALSE;

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cfilSD_HandlePath, "%d:/", DRV_SD);

	do
	{
		// Try to open directory
		if(!bRTOS_En)
		  frRes = f_opendir(&dirSD_Handle, cfilSD_HandlePath);
		else
		  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cfilSD_HandlePath);

		u8TryCnt++;

	}
	while((frRes != FR_OK) && (u8TryCnt < 2));

	if(frRes == FR_OK)
	{
		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return TRUE;
	}
	else
	{
		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(frRes != 5)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD open directory %s ERROR %d.", pcDirName, frRes);
			//#endif
		}

		return FALSE;
	}
}

//============================================================================//
// @brief  Create a new directory.
// @param  pcDirName: Pointer to a char array storing the directory name.
// @retval Result: TRUE: The operation is successful.
//                 FALSE: The operation is fail.
//============================================================================//
bool SD_MakeDir(char *pcDirName)
{
	FRESULT frRes;
	char cfilSD_HandlePath[128];
	
	
	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cfilSD_HandlePath, "%d:/%s", DRV_SD, pcDirName);

	if(!bRTOS_En)
	  frRes = f_mkdir(cfilSD_HandlePath);
	else
	  frRes = SD_RequestDo(SD_MKDIR, 1, cfilSD_HandlePath);

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	if(frRes == FR_OK)
		return TRUE;
	else
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD make new directory %s ERROR %d.", pcDirName, frRes);
		//#endif

		return FALSE;
	}
}

//============================================================================//
// @brief  Remove a directory if it exists.
// @param  pcDirName: Pointer to a char array storing the directory name.
// @retval Result: TRUE: The operation is successful.
//                 FALSE: The operation is fail.
//============================================================================//
bool SD_RemoveDir(char *pcDirName)
{
	FRESULT frRes;
	char cfilSD_HandlePath[128];
	
	
	if(SD_CheckDirExist(pcDirName) == FALSE)
	{
#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD file %s does not exist anymore.", pcDirName);
#endif

		return TRUE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cfilSD_HandlePath, "%d:/%s", DRV_SD, pcDirName);

	if(!bRTOS_En)
	  frRes = f_unlink(cfilSD_HandlePath);
	else
	  frRes = SD_RequestDo(SD_UNLINK, 1, cfilSD_HandlePath);

	//HAL_Delay(SD_CMD_DELAY);

	if(frRes == FR_OK)
	{
#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD remove directory %s OK.", pcDirName);
#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return TRUE;
	}
	else
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD remove directory %s ERROR %d.", pcDirName, frRes);
		//#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return FALSE;
	}
}

//============================================================================//
// @brief  Check if a file name matches with a name or not.
// @param  pcFileName: Pointer to the file name to be checked.
//         pcFilter: Name to be compared with.
// @retval Result: TRUE: The name is matched.
//                 FALSE: The name is not matched.
//============================================================================//
static bool SD_CheckFileByName(char *pcFileName, char *pcFilter)
{
	char *pcStr;
	uint8_t u8DataBuf[128];


	pcStr = (char *)u8DataBuf;

	strcpy(pcStr, pcFileName);

	// Get file name only
	StopChar(pcStr, '.');

	if(strncmp(pcStr, pcFilter, strlen(pcFilter)) != 0)
		return FALSE;

	return TRUE;
}

//============================================================================//
// @brief  Check if a file name matches with an extension or not.
// @param  pcFileName: Pointer to the file name to be checked.
//         pcFilter: Extension to be compared with.
// @retval Result: TRUE: The extension is matched.
//                 FALSE: The extension is not matched.
//============================================================================//
static bool SD_CheckFileByExten(char *pcFileName, char *pcFilter)
{
	uint8_t u8DataBuf[128];
	char *pcStr;


	pcStr = (char *)u8DataBuf;

	strcpy(pcStr, pcFileName);

	// Get file extension only
	StopChar(pcStr, '.');

	pcStr += strlen(pcStr) + 1;

	if(strncmp(pcStr, pcFilter, strlen(pcFilter)) != 0)
		return FALSE;

	return TRUE;
}

//============================================================================//
// @brief  Check if a file is existing.
// @param  pcFileName: Pointer to the file name to be checked.
// @retval Result: TRUE: The file exists.
//                 FALSE: The file not exist/ operation ERRORed.
//============================================================================//
bool SD_CheckFileExist(char *pcFileName)
{
	FRESULT frRes;
	DIR dirSD_Handle;
	FIL filSD_Handle;
	char cSD_FilePath[128];
	uint8_t u8TryCnt = 0;


	if(strlen(pcFileName) == 0)
	{
		return FALSE;
	}

	// Check SD card status
	if(SD_FS_Check(FALSE) == FALSE)
	{
		return FALSE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cSD_FilePath, "%d:/", DRV_SD);

	// Open directory
	if(!bRTOS_En)
	  frRes = f_opendir(&dirSD_Handle, cSD_FilePath);
	else
	  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cSD_FilePath);

	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("%s ERROR CODE %d.", MSG_SD_OPEN_DIR_ERROR, frRes);
		//#endif

		u8SD_Err++;

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(u8SD_Err >= SD_ERROR_MAX_CNT)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD ERROR %d TIMES. Reset system due to SD ISSUE...", u8SD_Err);
			//#endif

			System_Reset();
		}

		return FALSE;
	}
	else
	{
		u8SD_Err = 0;
	}

	sprintf(cSD_FilePath, "%d:/%s", DRV_SD, pcFileName);

	do
	{
		// Try to open file
		if(!bRTOS_En)
		  frRes = f_open(&filSD_Handle, cSD_FilePath, FA_READ);
		else
		  frRes = SD_RequestDo(SD_OPEN, 3, &filSD_Handle, cSD_FilePath, FA_READ);

		u8TryCnt++;

	}
	while((frRes != FR_OK) && (u8TryCnt < 2));

	if(frRes == FR_OK)
	{
		for(int i = 0; i < 3; i++)
		{
			if(!bRTOS_En)
			  frRes = f_close(&filSD_Handle);
			else
			  frRes = SD_RequestDo(SD_CLOSE, 1, &filSD_Handle);

			if(frRes == FR_OK)
				break;
		}

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return TRUE;
	}
	else
	{
		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(frRes != 4)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD open file %s ERROR %d.", pcFileName, frRes);
			//#endif
		}

		return FALSE;
	}
}

//============================================================================//
// @brief  Find a file having a suggested name.
// @param  pcFindName: Pointer to the file name to find.
//         pcReturnName: Pointer to the name of the found file.
// @retval Result: TRUE: A suitable file is found.
//                 FALSE: No file is found.
//============================================================================//
bool SD_FindFileName(char *pcFindName, char *pcReturnName)
{
	bool bRes = FALSE;
	FRESULT frRes;
	DIR dirSD_Handle;
	FILINFO finfoHandle;
	char cfilSD_HandlePath[128];
	char cName[50] = {0}, cExten[5] = {0};
	char *pcFileName, *pcStr;


	if(strlen(pcFindName) == 0)
		return FALSE;

	// Check SD card status
	if(SD_FS_Check(FALSE) == FALSE)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf(MSG_SD_DISK_INVALID);
		//#endif

		return FALSE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	strcpy(cfilSD_HandlePath, pcFindName);

	pcStr = cfilSD_HandlePath;

	// Split name and extension
	StopChar(pcStr, '.');

	strcpy(cName, pcStr);

#if ENABLE_DEBUG_MSG
	RTOSprintf("\r\n> SD find file with name:\"%s\".", cName);
#endif

	if(strlen(pcStr) < strlen(pcFindName)) // If there is extension
	{
		pcStr += strlen(pcStr) + 1;

		strcpy(cExten, pcStr);
	}
	else // If there is no extension
		sprintf(cExten, "*");

#if ENABLE_DEBUG_MSG
	RTOSprintf("\r\n> SD find file with extension:\"%s\".", cExten);
#endif

	sprintf(cfilSD_HandlePath, "%d:/", DRV_SD);

	if(!bRTOS_En)
	  frRes = f_opendir(&dirSD_Handle, cfilSD_HandlePath);
	else
	  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cfilSD_HandlePath);

	// Open directory
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("%s ERROR CODE %d", MSG_SD_OPEN_DIR_ERROR, frRes);
		//#endif

		u8SD_Err++;

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(u8SD_Err >= SD_ERROR_MAX_CNT)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD ERROR %d TIMES. Reset system due to SD ISSUE...", u8SD_Err);
			//#endif
			System_Reset();

			Delay_mS(500);
		}

		return FALSE;
	}
	else
	{
		u8SD_Err = 0;
	}

	// If use long file name format
#if _USE_LFN
	char cLFN[_MAX_LFN + 1];
	finfoHandle.lfname = cLFN;
	finfoHandle.lfsize = sizeof(cLFN);
#endif

	// Check files through the SD card
	//while(f_readdir(&dirSD_Handle, &finfoHandle) == FR_OK)
	while(SD_RequestDo(SD_READDIR, 2, &dirSD_Handle, &finfoHandle) == FR_OK)
	{
		// If file attribute is AM_ARC then continue
		if((finfoHandle.fattrib & AM_ARC) == 0)
			continue;

		// If encounter no name files then stop
		if(finfoHandle.fname[0] == 0)
			break;

#if _USE_LFN
		pcFileName = *finfoHandle.lfname ? finfoHandle.lfname : finfoHandle.fname;
#else
		pcFileName = finfoHandle.fname;
#endif

		//#if ENABLE_DEBUG_MSG
		//RTOSprintf("\r\n> SD check file name:%s.", pcFileName);
		//#endif

		// If find a random file
		if((strcmp(cName, (char *)"*") == 0) && (strcmp(cExten, (char *)"*") == 0))
		{
			sprintf(pcReturnName, "%s", pcFileName);

			bRes = TRUE;

			break;
		}
		else if(strcmp(cExten, (char *)"*") == 0) // If not care about file extension
		{
			if(SD_CheckFileByName(pcFileName, cName) == TRUE)
			{
				sprintf(pcReturnName, "%s", pcFileName);

				bRes = TRUE;

				break;
			}
		}
		else if(strcmp(cName, (char *)"*") == 0) // If not care about file name
		{
			if(SD_CheckFileByExten(pcFileName, cExten) == TRUE)
			{
				sprintf(pcReturnName, "%s", pcFileName);

				bRes = TRUE;

				break;
			}
		}
		else // If both name and extension have to be matched
		{
			if((SD_CheckFileByName(pcFileName, cName) == TRUE) &&
			   (SD_CheckFileByExten(pcFileName, cExten) == TRUE))
			{
				sprintf(pcReturnName, "%s", pcFileName);

				bRes = TRUE;

				break;
			}
		}
	}

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	return bRes;
}

//============================================================================//
// @brief  Get size of a file.
// @param  pcFileName: Pointer to file name for getting size.
// @retval File size in the uint32_t format.
//============================================================================//
uint32_t SD_GetFileSize(char *pcFileName)
{
	FRESULT frRes;
	DIR dirSD_Handle;
	FIL filSD_Handle;
	char cfilSD_HandlePath[128];
	uint32_t u32FileSize = 0;


	// Check SD card status
	if(SD_FS_Check(FALSE) == FALSE)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf(MSG_SD_DISK_INVALID);
		//#endif

		return 0;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cfilSD_HandlePath, "%d:/", DRV_SD);

	if(!bRTOS_En)
	  frRes = f_opendir(&dirSD_Handle, cfilSD_HandlePath);
	else
	  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cfilSD_HandlePath);

	// Open directory
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("%s ERROR CODE %d", MSG_SD_OPEN_DIR_ERROR, frRes);
		//#endif

		u8SD_Err++;

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(u8SD_Err >= SD_ERROR_MAX_CNT)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD ERROR %d TIMES. Reset system due to SD ISSUE...", u8SD_Err);
			//#endif

			System_Reset();
		}

		return FALSE;
	}
	else
	{
		u8SD_Err = 0;
	}

	sprintf(cfilSD_HandlePath, "%d:/%s", DRV_SD, pcFileName);

	if(!bRTOS_En)
	  frRes = f_open(&filSD_Handle, cfilSD_HandlePath, FA_READ);
	else
	  frRes = SD_RequestDo(SD_OPEN, 3, &filSD_Handle, cfilSD_HandlePath, FA_READ);

	// Try to open file
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD open file %s ERROR %d.", pcFileName, frRes);
		//#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return 0;
	}

	// Get file size
	u32FileSize = f_size(&filSD_Handle);

	if(!bRTOS_En)
	  f_close(&filSD_Handle);
	else
	  SD_RequestDo(SD_CLOSE, 1, &filSD_Handle);

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	return u32FileSize;
}

//============================================================================//
// @brief  Print a list of files in the SD card.
// @param  None.
// @retval TRUE: Operation success.
//         FALSE: Operation ERRORed.
//============================================================================//
bool SD_FileList(void)
{
	FRESULT frRes;
	DIR dirSD_Handle;
	FILINFO finfoHandle;
	char cSD_FilePath[128];
	char *pcFileName;
	struct tm tmTimeInfo;


	// Check SD card status
	if(SD_FS_Check(FALSE) == FALSE)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf(MSG_SD_DISK_INVALID);
		//#endif

		return FALSE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cSD_FilePath, "%d:/", DRV_SD);

	if(!bRTOS_En)
	  frRes = f_opendir(&dirSD_Handle, cSD_FilePath);
	else
	  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cSD_FilePath);

	// Open directory
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("%s ERROR CODE %d", MSG_SD_OPEN_DIR_ERROR, frRes);
		//#endif

		u8SD_Err++;

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(u8SD_Err >= SD_ERROR_MAX_CNT)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD ERROR %d TIMES. Reset system due to SD ISSUE...", u8SD_Err);
			//#endif

			System_Reset();

			Delay_mS(500);
		}

		return FALSE;
	}
	else
	{
		u8SD_Err = 0;
	}

	// If use long name format
#if _USE_LFN
	char cLFN[_MAX_LFN + 1];
	finfoHandle.lfname = cLFN;
	finfoHandle.lfsize = sizeof(cLFN);
#endif

	RTOSprintf("\r\n@ SD file list:");

	// Check files through the SD card
	//while(f_readdir(&dirSD_Handle, &finfoHandle) == FR_OK)
	while(SD_RequestDo(SD_READDIR, 2, &dirSD_Handle, &finfoHandle) == FR_OK)
	{
		// If file attribute is AM_ARC then continue
		if((finfoHandle.fattrib & AM_ARC) == 0)
			continue;

		// If encounter no name files then stop
		if(finfoHandle.fname[0] == 0)
			break;

		// Check file name
#if _USE_LFN
		pcFileName = *finfoHandle.lfname ? finfoHandle.lfname : finfoHandle.fname;
#else
		pcFileName = finfoHandle.fname;
#endif

		tmTimeInfo.tm_year = ((finfoHandle.fdate >> 9) & 0x7F) + 1980;
		tmTimeInfo.tm_mon	= ((finfoHandle.fdate >> 5) & 0x0F);
		tmTimeInfo.tm_mday = finfoHandle.fdate & 0x1F;
		tmTimeInfo.tm_hour = (finfoHandle.ftime >> 11) & 0x1F;
		tmTimeInfo.tm_min = (finfoHandle.ftime >> 5) & 0x3F;
		tmTimeInfo.tm_sec = (finfoHandle.ftime & 0x1F) * 2;

		if(tmTimeInfo.tm_year > 2100)
			continue;

		RTOSprintf("\r\n> #NAME:\"%s\",     #SIZE: %d,     #LAST MODIFIED DATE: %04d/%02d/%02d - %02d:%02d:%02d.",
		           pcFileName, finfoHandle.fsize,
		           tmTimeInfo.tm_year, tmTimeInfo.tm_mon, tmTimeInfo.tm_mday,
		           tmTimeInfo.tm_hour, tmTimeInfo.tm_min, tmTimeInfo.tm_sec);
	}

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	return TRUE;
}

//============================================================================//
// @brief  Get the last time when a file is modified in local time.
// @param  pcFileName: Pointer to file name to be checked.
// @retval Time in time_t format
//============================================================================//
static time_t GetFileTime(FILINFO *pfinfoHandle)
{
	struct tm tmTimeInfo;


	tmTimeInfo.tm_year = ((pfinfoHandle->fdate >> 9) & 0x7F) + 1980 - 1900;
	tmTimeInfo.tm_mon	= ((pfinfoHandle->fdate >> 5) & 0x0F) - 1;
	tmTimeInfo.tm_mday = pfinfoHandle->fdate & 0x1F;
	tmTimeInfo.tm_hour = (pfinfoHandle->ftime >> 11) & 0x1F;
	tmTimeInfo.tm_min = (pfinfoHandle->ftime >> 5) & 0x3F;
	tmTimeInfo.tm_sec = (pfinfoHandle->ftime & 0x1F) * 2;
	tmTimeInfo.tm_isdst = -1;

	return mktime(&tmTimeInfo);
}

//============================================================================//
// @brief  Delete a file existing longer than a keeptime period.
// @param  pcFileNames: Pointer to file name for deleting.
//         u8KeepTime: Time period to keep file in days.
// @retval Result: TRUE: Operation success.
//                 FALSE: Operation ERRORed.
//============================================================================//
bool SD_ClearUp(char *pcFileNames, uint8_t u8KeepTime)
{
	FRESULT frRes;
	DIR dirSD_Handle;
	FILINFO finfoHandle;
	char cSD_FilePath[128];
	char cFileName[50], cFileExten[5];
	char *pcStr;


	// Check SD card status
	if(SD_FS_Check(FALSE) == FALSE)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf(MSG_SD_DISK_INVALID);
		//#endif

		return FALSE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	strcpy(cSD_FilePath, pcFileNames);

	pcStr = cSD_FilePath;

	StopChar(pcStr, '.');

	// Get file name
	strcpy(cFileName, pcStr);

	pcStr += strlen(pcStr) + 1;

	// Get file extension
	strcpy(cFileExten, pcStr);

	sprintf(cSD_FilePath, "%d:/", DRV_SD);

  if(!bRTOS_En)
	  frRes = f_opendir(&dirSD_Handle, cSD_FilePath);
	else
	  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cSD_FilePath);

	// Open directory
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("%s ERROR CODE %d", MSG_SD_OPEN_DIR_ERROR, frRes);
		//#endif

		u8SD_Err++;

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(u8SD_Err >= SD_ERROR_MAX_CNT)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD ERROR %d TIMES. Reset system due to SD ISSUE...", u8SD_Err);
			//#endif

			System_Reset();
		}

		return FALSE;
	}
	else
	{
		u8SD_Err = 0;
	}

	// Check files through the SD card
	//while(f_readdir(&dirSD_Handle, &finfoHandle) == FR_OK)
	while(SD_RequestDo(SD_READDIR, 2, &dirSD_Handle, &finfoHandle) == FR_OK)
	{
		time_t ttTimeNow;


		// If file attribute is AM_ARC then continue
		if((finfoHandle.fattrib & AM_ARC) == 0)
			continue;

		// If encounter no name files then stop
		if(finfoHandle.fname[0] == 0)
			break;

		ttTimeNow = System_GetTime();

		// If file date is within KeepTime day, don't delete
		if((ttTimeNow - GetFileTime(&finfoHandle)) < DAY_2_SECOND(u8KeepTime))
			continue;

		// If delete all files
		if(strcmp(cFileName, "*") == 0 &&
		        strcmp(cFileExten, "*") == 0)
		{
			sprintf(cSD_FilePath, "%d:/%s", DRV_SD, finfoHandle.fname);

			if(!bRTOS_En)
			  frRes = f_unlink(cSD_FilePath);
			else
			  frRes = SD_RequestDo(SD_UNLINK, 1, cSD_FilePath);

			if(frRes == FR_OK)
			{
#if ENABLE_DEBUG_MSG
				RTOSprintf("\r\n> SD delete file %s OK.", finfoHandle.fname);
#endif
			}
			else
			{
				//#if ENABLE_DEBUG_MSG
				RTOSprintf("\r\n> SD delete file %s ERROR %d", finfoHandle.fname, frRes);
				//#endif
			}
		}
		else if(strcmp(cFileName, "*") == 0) // If delete files with matched extension
		{
			if(SD_CheckFileByExten(finfoHandle.fname, cFileExten) == TRUE)
			{
				sprintf(cSD_FilePath, "%d:/%s", DRV_SD, finfoHandle.fname);

				if(!bRTOS_En)
				  frRes = f_unlink(cSD_FilePath);
				else
				  frRes = SD_RequestDo(SD_UNLINK, 1, cSD_FilePath);

				if(frRes == FR_OK)
				{
#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s OK.", finfoHandle.fname);
#endif
				}
				else
				{
					//#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s ERROR %d", finfoHandle.fname, frRes);
					//#endif
				}
			}
		}
		else if(strcmp(cFileExten, "*") == 0) // If delete files with matched name
		{
			if(SD_CheckFileByName(finfoHandle.fname, cFileName) == TRUE)
			{
				sprintf(cSD_FilePath, "%d:/%s", DRV_SD, finfoHandle.fname);

				if(!bRTOS_En)
				  frRes = f_unlink(cSD_FilePath);
				else
				  frRes = SD_RequestDo(SD_UNLINK, 1, cSD_FilePath);

				if(frRes == FR_OK)
				{
#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s OK.", finfoHandle.fname);
#endif
				}
				else
				{
					//#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s ERROR %d", finfoHandle.fname, frRes);
					//#endif
				}
			}
		}
		else // If both name and extension have to be matched
		{
			if(strncmp(finfoHandle.fname, pcFileNames, strlen(pcFileNames)) == 0)
			{
				sprintf(cSD_FilePath, "%d:/%s", DRV_SD, finfoHandle.fname);

				if(!bRTOS_En)
				  frRes = f_unlink(cSD_FilePath);
				else
				  frRes = SD_RequestDo(SD_UNLINK, 1, cSD_FilePath);

				if(frRes == FR_OK)
				{
#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s OK.", finfoHandle.fname);
#endif
				}
				else
				{
					//#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s ERROR %d", finfoHandle.fname, frRes);
					//#endif
				}
			}
		}
	}

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	return TRUE;
}

//============================================================================//
// @brief  Delete a file/ files.
// @param  pcNames: Name or extension of the files to be deleted.
// @retval Result: TRUE: Operation success.
//                 FALSE: Operation ERRORed.
//============================================================================//
bool SD_Delete(char *pcNames)
{
	return SD_ClearUp(pcNames, 0);
}

//============================================================================//
// @brief  Delete all files in SD card except a file having a chosen name or
//         extension.
// @param  pcNames: Name or extension of the file to be kept.
// @retval Result: TRUE: Operation success.
//                 FALSE: Operation ERRORed.
//============================================================================//
bool SD_DelExcept(char *pcNames)
{
	FRESULT frRes;
	DIR dirSD_Handle;
	FILINFO finfoHandle;
	char cSD_FilePath[128];
	char cFileName[50], cFileExten[10];
	char *pcStr;


	// Check USB disk status
	if(SD_FS_Check(FALSE) == FALSE)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf(MSG_SD_DISK_INVALID);
		//#endif

		return FALSE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	strcpy(cSD_FilePath, pcNames);

	pcStr = cSD_FilePath;

	StopChar(pcStr, '.');

	// Get file name
	strcpy(cFileName, pcStr);

	pcStr += strlen(pcStr) + 1;

	// Get file extension
	strcpy(cFileExten, pcStr);

	sprintf(cSD_FilePath, "%d:/", DRV_SD);

  if(!bRTOS_En)
	  frRes = f_opendir(&dirSD_Handle, cSD_FilePath);
	else
	  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cSD_FilePath); 

	// Open directory
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("%s ERROR CODE %d", MSG_SD_OPEN_DIR_ERROR, frRes);
		//#endif

		u8SD_Err++;

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(u8SD_Err >= SD_ERROR_MAX_CNT)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD ERROR %d TIMES. Reset system due to SD ISSUE...", u8SD_Err);
			//#endif

			System_Reset();

			Delay_mS(500);
		}

		return FALSE;
	}
	else
	{
		u8SD_Err = 0;
	}

	// Check files through the SD card
	//while(f_readdir(&dirSD_Handle, &finfoHandle) == FR_OK)
	while(SD_RequestDo(SD_READDIR, 2, &dirSD_Handle, &finfoHandle) == FR_OK)
	{
		// If file attribute is AM_ARC then continue
		if((finfoHandle.fattrib & AM_ARC) == 0)
			continue;

		// If encounter no name files then stop
		if(finfoHandle.fname[0] == 0)
			break;

		// If keep all files
		if(strcmp(cFileName, "*") == 0 &&
		   strcmp(cFileExten, "*") == 0)
		{
			break;
		}
		else if(strcmp(cFileName, "*") == 0) // If only keep file with same extension
		{
			if(SD_CheckFileByExten(finfoHandle.fname, cFileExten) == FALSE)
			{
				sprintf(cSD_FilePath, "%d:/%s", DRV_SD, finfoHandle.fname);

				if(!bRTOS_En)
				  frRes = f_unlink(cSD_FilePath);
				else
				  frRes = SD_RequestDo(SD_UNLINK, 1, cSD_FilePath);

				if(frRes == FR_OK)
				{
#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s OK.", finfoHandle.fname);
#endif
				}
				else
				{
					//#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file%s ERROR %d", finfoHandle.fname, frRes);
					//#endif
				}
			}
		}
		else if(strcmp(cFileExten, "*") == 0) // If only keep files with same name
		{
			if(SD_CheckFileByName(finfoHandle.fname, cFileExten) == FALSE)
			{
				sprintf(cSD_FilePath, "%d:/%s", DRV_SD, finfoHandle.fname);

				if(!bRTOS_En)
				  frRes = f_unlink(cSD_FilePath);
				else
				  frRes = SD_RequestDo(SD_UNLINK, 1, cSD_FilePath);

				if(frRes == FR_OK)
				{
#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s OK.", finfoHandle.fname);
#endif
				}
				else
				{
					//#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s ERROR %d", finfoHandle.fname, frRes);
					//#endif
				}
			}
		}
		else // If only keep a file with exactly matched name and extension
		{
			if(strncmp(finfoHandle.fname, pcNames, strlen(pcNames)) != 0)
			{
				sprintf(cSD_FilePath, "%d:/%s", DRV_SD, finfoHandle.fname);

				if(!bRTOS_En)
				  frRes = f_unlink(cSD_FilePath);
				else
				  frRes = SD_RequestDo(SD_UNLINK, 1, cSD_FilePath);

				if(frRes == FR_OK)
				{
#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s OK.", finfoHandle.fname);
#endif
				}
				else
				{
					//#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD delete file %s ERROR %d", finfoHandle.fname);
					//#endif
				}
			}
		}
	}

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	return TRUE;
}

//============================================================================//
// @brief  Format SD card.
// @param  None.
// @retval Result: TRUE: SD card is formatted successsfully.
//                 FALSE: SD card is not formatted successfully.
//============================================================================//
bool SD_Format(void)
{
	FRESULT frRes;
	uint8_t u8FormatCnt = 0;


	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//	{
	//		u8FormatCnt++;

	//		return FALSE;
	//	}
	//}

	do
	{
		RTOSprintf("\r\n> Format %d times.", (u8FormatCnt + 1));

		if(!bRTOS_En)
		  frRes = f_mkfs((TCHAR const *)USERPath, 0, 0);
		else
		  frRes = SD_RequestDo(SD_MKFS, 3, (TCHAR const *)USERPath, 0, 0);

		u8FormatCnt++;

		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> Format %d times result: %d", u8FormatCnt, frRes);
		//#endif

		Delay_mS(500);

		if(u8FormatCnt >= 15)
		{
			break;
		}
	}
	while(frRes != FR_OK);

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	if(u8FormatCnt >= 15)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD format ERROR %d", frRes);
		//#endif

		return FALSE;
	}
	else
	{
		g_Setting.bSD_FormatFlag = TRUE;

		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD format OK.");
		//#endif

		return TRUE;
	}
}

//============================================================================//
// @brief  Remove a file in the SD card.
// @param  pcFileName: Pointer to an array storing the file name.
// @retval TRUE: The operation is successful.
//         FALSE: The operation is fail.
//============================================================================//
bool SD_RemoveFile(char *pcFilename)
{
	FRESULT frRes;
	char cSD_FilePath[128];
	
	
	if(SD_CheckFileExist(pcFilename) == FALSE)
	{
#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD file %s does not exist anymore.", pcFilename);
#endif

		return TRUE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cSD_FilePath, "%d:/%s", DRV_SD, pcFilename);

	if(!bRTOS_En)
	  frRes = f_unlink(cSD_FilePath);
	else
	  frRes = SD_RequestDo(SD_UNLINK, 1, cSD_FilePath);

	//HAL_Delay(SD_CMD_DELAY);

	if(frRes == FR_OK)
	{
#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD remove file %s OK.", pcFilename);
#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return TRUE;
	}
	else
	{
#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD remove file %s ERROR %d.", pcFilename, frRes);
#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return FALSE;
	}
}

//============================================================================//
// @brief  Remove a file in the SD card.
// @param  pcFileName: Pointer to an array storing the file name.
// @retval TRUE: The operation is successful.
//         FALSE: The operation is fail.
//============================================================================//
bool SD_Rename(char *pcOldName, char *pcNewName)
{
	FRESULT frRes;
	char cSD_FilePath[128];
	
	
	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cSD_FilePath, "%d:/%s", DRV_SD, pcOldName);

	if(!bRTOS_En)
	  frRes = f_rename(cSD_FilePath, pcNewName);
	else
	  frRes = SD_RequestDo(SD_RENAME, 2, cSD_FilePath, pcNewName);

	//HAL_Delay(SD_CMD_DELAY);

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	if(frRes == FR_OK)
		return TRUE;
	else
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD rename file %s to %s ERROR %d", pcOldName, pcNewName, frRes);
		//#endif

		return FALSE;
	}
}

//============================================================================//
// @brief  Write to the bottom of a file.
// @param  pcFileName: Pointer to the file name for writing.
//         pu8SD_Buf: Pointer to the data buffer for writing.
//         u16BufLen: Length of the data for writing.
// @retval Result: TRUE: Operation success.
//                 FALSE: Operation ERRORed.
//============================================================================//
bool SD_AddBuffToFile(char *pcFileName, uint8_t *pu8SD_Buf, uint16_t u16BufLen)
{
	FRESULT frRes;
	DIR dirSD_Handle;
	FIL filSD_Handle;
	char cSD_FilePath[128];
	UINT uBw;
	uint16_t u16BufSize, u16DataSize;


	// Check SD card status
	if(SD_FS_Check(FALSE) == FALSE)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf(MSG_SD_DISK_INVALID);
		//#endif

		return FALSE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cSD_FilePath, "%d:/", DRV_SD);

	if(!bRTOS_En)
	  frRes = f_opendir(&dirSD_Handle, cSD_FilePath);
	else
	  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cSD_FilePath);

	// Open directory
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("%s ERROR CODE %d", MSG_SD_OPEN_DIR_ERROR, frRes);
		//#endif

		u8SD_Err++;

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(u8SD_Err >= SD_ERROR_MAX_CNT)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD ERROR %d TIMES. Reset system due to SD ISSUE...\r\n", u8SD_Err);
			//#endif

			System_Reset();
		}

		return FALSE;
	}
	else
	{
		u8SD_Err = 0;
	}

	sprintf(cSD_FilePath, "%d:/%s", DRV_SD, pcFileName);

	// Open file
	if(!bRTOS_En)
	  frRes = f_open(&filSD_Handle, cSD_FilePath, FA_WRITE);
	else
	  frRes = SD_RequestDo(SD_OPEN, 3, &filSD_Handle, cSD_FilePath, FA_WRITE);

	//HAL_Delay(SD_CMD_DELAY);

	if(frRes == FR_OK)
	{
		if(!bRTOS_En)
		  f_lseek(&filSD_Handle, f_size(&filSD_Handle));
		else
		  SD_RequestDo(SD_LSEEK, 2, &filSD_Handle, f_size(&filSD_Handle));

		//HAL_Delay(SD_CMD_DELAY);
	}
	else // If the specified file is not exist then create a new file
	{
		//f_close(&filSD_Handle);
		//SD_RequestDo(SD_CLOSE, 1, &filSD_Handle);

		if(!bRTOS_En)
		  frRes = f_open(&filSD_Handle, cSD_FilePath, FA_CREATE_ALWAYS | FA_WRITE);
		else
		  frRes = SD_RequestDo(SD_OPEN, 3, &filSD_Handle, cSD_FilePath, FA_CREATE_ALWAYS | FA_WRITE);

		//HAL_Delay(SD_CMD_DELAY);

		if(frRes != FR_OK)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD open file %s ERROR %d", pcFileName, frRes);
			//#endif

			//if(bRTOS_En)
			//	osMutexRelease(mutex_spi2_user);

			return FALSE;
		}
	}

	/*
	u16BufSize = u16DataSize = 0;

	// Write data from the buffer to the file
	do
	{
		u8SD_Buf[u16DataSize++] = pu8SD_Buf[u16BufSize++];

		if((u16DataSize < sizeof(u8SD_Buf)) && (u16BufSize < u16BufLen))
			continue;

		frRes = f_write(&filSD_Handle, &u8SD_Buf, u16DataSize, &uBw);

		//HAL_Delay(SD_CMD_DELAY);

		if(frRes != FR_OK)
			break;

		u16DataSize = 0;

	}while(u16BufSize < u16BufLen);
	*/

  if(!bRTOS_En)
	  frRes = f_write(&filSD_Handle, pu8SD_Buf, u16BufLen, &uBw);
	else
	  frRes = SD_RequestDo(SD_WRITE, 4, &filSD_Handle, pu8SD_Buf, u16BufLen, &uBw);

	FRESULT fRes;

	for(int i = 0; i < 3; i++)
	{
		if(!bRTOS_En)
		  fRes = f_close(&filSD_Handle);
		else
		  fRes = SD_RequestDo(SD_CLOSE, 1, &filSD_Handle);

		if(fRes == FR_OK)
			break;
	}

	if(fRes != FR_OK)
		RTOSprintf("\r\n> SD close file %s ERROR %d.", pcFileName, fRes);

	//HAL_Delay(SD_CMD_DELAY);

	if(frRes == FR_OK)
	{
#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD write to file %s OK.", pcFileName);
#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		//HAL_Delay(1);

		return TRUE;
	}
	else
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD write to file %s at address %d ERROR %d.",
		           pcFileName, f_size(&filSD_Handle) + u16BufSize - u16DataSize, frRes);
		//#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return FALSE;
	}
}

//============================================================================//
// @brief  Write a string to the bottom of a file.
// @param  pcFileName: Pointer to the file name for writing.
//         pcString: Pointer to string for writing.
// @retval Result: TRUE:.
//============================================================================//
bool SD_AddStrToFile(char *pcFileName, char *pcString)
{
	return SD_AddBuffToFile(pcFileName, (uint8_t *)pcString, strlen(pcString));
}

//============================================================================//
// @brief  Read from an address in a file.
// @param  pcFileName: Pointer to the file name for reading.
//         pu8SD_Buf: Pointer to the data buffer for storing.
//         u16BufLen: Length of the data buffer for reading.
//         u32Addr: Address to read from in the file.
// @retval Result: TRUE: Operation success.
//                 FALSE: Operation ERRORed.
//============================================================================//
bool SD_ReadAddrToBuff(char *pcFileName, uint8_t *pu8SD_Buf,
                       uint16_t u16BufLen, uint32_t u32Addr)
{
	FRESULT frRes;
	DIR dirSD_Handle;
	FIL filSD_Handle;
	char cSD_FilePath[128];
	//uint16_t BufSize, DataSize;
	//uint16_t u16DatCnt = 0, u16DatSize;
	UINT uBr;


	// Check SD card status
	if(SD_FS_Check(FALSE) == FALSE)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf(MSG_SD_DISK_INVALID);
		//#endif

		return FALSE;
	}

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	sprintf(cSD_FilePath, "%d:/", DRV_SD);

	if(!bRTOS_En)
	  frRes = f_opendir(&dirSD_Handle, cSD_FilePath);
	else
	  frRes = SD_RequestDo(SD_OPENDIR, 2, &dirSD_Handle, cSD_FilePath);

	// Open directory
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("%s ERROR CODE %d", MSG_SD_OPEN_DIR_ERROR, frRes);
		//#endif

		u8SD_Err++;

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		if(u8SD_Err >= SD_ERROR_MAX_CNT)
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD ERROR %d TIMES. Reset system due to SD ISSUE...\r\n", u8SD_Err);
			//#endif

			System_Reset();
		}

		return FALSE;
	}
	else
	{
		u8SD_Err = 0;
	}

	sprintf(cSD_FilePath, "%d:/%s", DRV_SD, pcFileName);

	if(!bRTOS_En)
	  frRes = f_open(&filSD_Handle, cSD_FilePath, FA_READ);
	else
	  frRes = SD_RequestDo(SD_OPEN, 3, &filSD_Handle, cSD_FilePath, FA_READ);

	// Open file for reading
	if(frRes != FR_OK)
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD open file %s ERROR %d.", pcFileName, frRes);
		//#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return FALSE;
	}

	// Put cursor to the start address
	if(!bRTOS_En)
	  f_lseek(&filSD_Handle, u32Addr);
	else
	  SD_RequestDo(SD_LSEEK, 2, &filSD_Handle, u32Addr);

	//HAL_Delay(SD_CMD_DELAY);

	/*
	BufSize = DataSize = 0;

	// Read data from file to the buffer
	do
	{
		if(DataSize == 0)
		{
			frRes = f_read(&filSD_Handle, &u8SD_Buf, sizeof(u8SD_Buf), &uBr);

			if(frRes != FR_OK)
				break;
		}

		pu8SD_Buf[BufSize++] = u8SD_Buf[DataSize++];

		if((DataSize < sizeof(u8SD_Buf)) && (BufSize < u16BufLen))
		{
			continue;
		}

		DataSize = 0;

	}
	while(BufSize < u16BufLen);
	*/
	/*
	u16DatCnt = 0;

	do
	{
	  u16DatSize = u16BufLen - u16DatCnt;

		if(u16DatSize > sizeof(u8SD_Buf))
		{
		  u16DatSize = sizeof(u8SD_Buf);
		}

		frRes = f_read(&filSD_Handle, u8SD_Buf, u16DatSize, &uBr);

		//HAL_Delay(SD_CMD_DELAY);

		if(frRes != FR_OK)
			break;

		memcpy(pu8SD_Buf, u8SD_Buf, u16DatSize);

		pu8SD_Buf += u16DatSize;

		u16DatCnt += u16DatSize;

	}while(u16DatCnt < u16BufLen);
	*/
	if(!bRTOS_En)
	  frRes = f_read(&filSD_Handle, pu8SD_Buf, u16BufLen, &uBr);
	else
	  frRes = SD_RequestDo(SD_READ, 4, &filSD_Handle, pu8SD_Buf, u16BufLen, &uBr);

	FRESULT fRes;

	for(int i = 0; i < 3; i++)
	{
		if(!bRTOS_En)
		  fRes = f_close(&filSD_Handle);
		else
		  fRes = SD_RequestDo(SD_CLOSE, 1, &filSD_Handle);

		if(fRes == FR_OK)
			break;
	}

	if(fRes != FR_OK)
		RTOSprintf("\r\n> SD close file %s ERROR %d.", pcFileName, fRes);

	//HAL_Delay(SD_CMD_DELAY);

	if(frRes == FR_OK)
	{
#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD read file %s OK.", pcFileName);
#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return TRUE;
	}
	else
	{
		//#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD read file %s at address %d ERROR %d.",
		           pcFileName, u32Addr, frRes);

		RTOSprintf("\r\n> SD number of bytes read:%d.", uBr);
		//#endif

		//if(bRTOS_En)
		//	osMutexRelease(mutex_spi2_user);

		return FALSE;
	}
}

//============================================================================//
// @brief  Read from the beginning of a file.
