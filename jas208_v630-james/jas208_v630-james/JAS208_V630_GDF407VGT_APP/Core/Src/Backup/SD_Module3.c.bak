	u16BufSize = u16DataSize = 0;

	// Write data from the buffer to the file
	do
	{
		u8SD_Buf[u16DataSize++] = pu8SD_Buf[u16BufSize++];

		if((u16DataSize < sizeof(u8SD_Buf)) && (u16BufSize < u16BufLen))
