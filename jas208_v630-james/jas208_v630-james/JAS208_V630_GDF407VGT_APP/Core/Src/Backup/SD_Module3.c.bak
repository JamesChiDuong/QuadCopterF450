#define PROC_SD_ERROR_START		0

#define PROC_SD_ERROR_SETP1		1

#define PROC_SD_ERROR_SETP2		2

//#define PROC_SD_ERROR_STOP		PROC_SD_ERROR_SETP2

#define COUNT_SD_RETRY_MAX		(PROC_SD_ERROR_SETP2 + 1)

#define SD_READ_COUNT_MAX			10

#define SD_ERROR_MAX_CNT      50

