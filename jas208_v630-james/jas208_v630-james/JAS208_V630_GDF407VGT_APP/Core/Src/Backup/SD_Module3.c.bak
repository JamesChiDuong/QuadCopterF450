void SD_PWR_Enable(void)
{
  HwCfg_PBSet(SD_PWR_EN);
}

void SD_PWR_Disable(void)
{
  HwCfg_PBClr(SD_PWR_EN);
}

//============================================================================//
// @brief  Get SD Card Info.
// @param  None.
// @retval None
//============================================================================//
void SD_GetInfo(void)
{
	SD_CardInfo sdCardInfo;
	SD_Error sdStat;


	//Delay_mS(10);

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return;
	//}

	if(!bRTOS_En)
	  sdStat = SD_GetCardInfo(&sdCardInfo);
	else
    sdStat = (SD_Error)SD_RequestDo(SD_GET_INFO, 1, &sdCardInfo);

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	//#if ENABLE_DEBUG_MSG
	if(sdStat == SD_RESPONSE_NO_ERROR)
	{
		RTOSprintf("\r\n> SD disk Product name: %c%c%c%c%c!",
		           (sdCardInfo.SD_cid.ProdName1 >> 24) & 0xFF,
		           (sdCardInfo.SD_cid.ProdName1 >> 16) & 0xFF,
		           (sdCardInfo.SD_cid.ProdName1 >> 8) & 0xFF,
		           sdCardInfo.SD_cid.ProdName1 & 0xFF,
		           sdCardInfo.SD_cid.ProdName2);

		RTOSprintf("\r\n> SD disk ManufactDate: 20%02d.%d!",
		           (sdCardInfo.SD_cid.ManufactDate & 0x0ff0) >> 4,
		           (sdCardInfo.SD_cid.ManufactDate & 0x0f));

		RTOSprintf("\r\n> SD disk capacity : %d MB\r\n",
		           (uint32_t)((long long)sdCardInfo.CardCapacity * sdCardInfo.CardBlockSize / 1024768));
	}
	else
		RTOSprintf("\r\n> SD get information ERROR %d.", sdStat);
	//#endif

	HAL_Delay(1);
}

//============================================================================//
// @brief  Check SD card status.
// @param  bInit: Initialize SD card or not.
// @retval Result: TRUE: SD card works normally.
//                 FALSE: SD card not present/ work normally.
//============================================================================//
static bool SD_FS_Check(bool bInit)
{
	bool bRes;
	DSTATUS dsStat;
	static uint8_t u8RetryCnt = 0;


	if(bInit == TRUE)
	{
		if(!bRTOS_En)
		  dsStat = disk_initialize(DRV_SD);
		else
		  dsStat = (DSTATUS)SD_RequestDo(SD_DISK_INITIALIZE, 1, DRV_SD);
	}
	else if(bSD_ReInit == TRUE)
	{
		uint16_t u16Res;
		
		
		if(!bRTOS_En)
			u16Res = SD_GetStatus();
		else
			u16Res = SD_RequestDo(SD_GET_STATUS, 0);
		
    if(u16Res == SD_RESPONSE_NO_ERROR)
		{
			dsStat = STA_READY;
		}
		else
		{
			if(!bRTOS_En)
			  dsStat = disk_initialize(DRV_SD);
			else
			  dsStat = SD_RequestDo(SD_DISK_INITIALIZE, 1, DRV_SD);
		}
	}
	else
	{
		if(!bRTOS_En)
		  dsStat = disk_status(DRV_SD);
		else
		  dsStat = SD_RequestDo(SD_DISK_STATUS, 1, DRV_SD);
	}

	//#if ENABLE_DEBUG_MSG
	//RTOSprintf("\r\n> dsStat:%d.", dsStat);
	//#endif

	switch(dsStat)
	{
		case STA_OK:
			{
				FRESULT frRes;


				SD_GetInfo();

				if(!bRTOS_En)
				  frRes = f_mount(&USERFatFS, (TCHAR const *)USERPath, 1);
				else
				  frRes = SD_RequestDo(SD_MOUNT, 3, &USERFatFS, (TCHAR const *)USERPath, 1);

				if(frRes == FR_OK)
				{
          #if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD file system initialized OK.");
          #endif

					g_u8HwInfo = (g_u8HwInfo | 0x08);

					RTOSprintf("\r\n> Check SD Card OK. (0x%02X)", g_u8HwInfo);

					bRes = TRUE;
				}
				else
				{
					//#if ENABLE_DEBUG_MSG
					RTOSprintf("\r\n> SD initialization mounting result:%d.", frRes);
					//#endif

					u8SD_ReadCount++;

					if(u8SD_ReadCount >= SD_READ_COUNT_MAX)
					{
						bRes = FALSE;

						System_Reset();
					}
					else
					{
						//#if ENABLE_DEBUG_MSG
						RTOSprintf("\r\n> SD file system initializing ERROR.");
						//#endif

						g_u8HwInfo = (g_u8HwInfo & 0xF7);

						RTOSprintf("\r\n> Check SD Card FAIL. (0x%02X)", g_u8HwInfo);

						bRes = FALSE;
					}
				}
			}
			break;

		case STA_READY:

			u8SD_NoInit = 0;

			bRes = TRUE;
			break;

		case STA_NOINIT:
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD initializing ERROR % d TIMES.", u8SD_NoInit);
			//#endif

			u8SD_NoInit ++;
			if(u8SD_NoInit >= 10 )
			{
				u8SD_NoInit = 0;

				//#if ENABLE_DEBUG_MSG
				RTOSprintf("\r\n> System Restart due to SD ISSUE...");
				//#endif

				System_Reset();
			}

			bRes = FALSE;
			break;

		case STA_NODISK:

			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n> SD card is NOT DETECTED.");
			//#endif

			bRes = FALSE;
			break;

		default:
			bRes = FALSE;
			break;
	}

	if(bInit == TRUE)
		return bRes;

	if(bRes == TRUE)
	{
		bSD_ReInit = FALSE;

		u8RetryCnt = 0;
	}
	else
	{
		bSD_ReInit = TRUE;

#if ENABLE_GSM_NET && ENABLE_EVENT_SD_ERROR
		if(u8RetryCnt == PROC_SD_ERROR_START)
		{
			if(GSM_GetNetStatus() == TRUE)
			{
				if(GSM_ChkCmdBusy() == TRUE)
					return RESULT;

				GSM_TCP_SendDATA(STR_EVENT_SD_ERROR, STR_NULL);
			}
		}

		if(u8RetryCnt == PROC_SD_ERROR_SETP1)
		{
			if(GSM_GetOperatorStatus() == TRUE)
			{
				if(GSM_ChkCmdBusy() == TRUE)
					return RESULT;

				GSM_TCP_SendDATA(STR_EVENT_SD_ERROR, STR_EVENT_ARGUMENT_SMS);
			}
		}

		if(u8RetryCnt == PROC_SD_ERROR_SETP2)
		{
			if(GSM_ChkCmdBusy() == TRUE)
				return RESULT;
		}
#endif

		if(u8RetryCnt < COUNT_SD_RETRY_MAX)
		{
			u8RetryCnt++;
		}
		else
		{
			//#if ENABLE_DEBUG_MSG
			RTOSprintf("\r\n>>> System_Reset due to SD ISSUE...");
			//#endif

			System_Reset();
		}
	}

	return bRes;
}

//============================================================================//
// @brief  Get SD card status with reinitialization.
// @param  None.
// @retval Result: TRUE: SD card works normally.
//                 FALSE: SD card not present/ work normally.
//============================================================================//
bool SD_FS_GetStatus(void)
{
	bool bResult;


	bSD_ReInit = TRUE;

	//if(bRTOS_En)
	//{
	//	osStatus osRes;


	//	osRes = osMutexWait(mutex_spi2_user, S_2_mS(10));

	//	if(osRes == osEventTimeout)
	//		return FALSE;
	//}

	bResult = SD_FS_Check(FALSE);

	//if(bRTOS_En)
	//	osMutexRelease(mutex_spi2_user);

	return bResult;
}

//============================================================================//
// @brief  Initialize SD card.
// @param  None.
// @retval Result: TRUE: SD card is initialized successfully.
//                 FALSE: SD card initialization is fail.
//============================================================================//
bool SD_Init(void)
{
	SD_PWR_Disable();
	
	HAL_Delay(300);
	
	SD_PWR_Enable();
	
	Delay_mS(S_2_mS(1));
	
	SD_RequestInit();

	if(SD_FS_Check(TRUE) == TRUE)
