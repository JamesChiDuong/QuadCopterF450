			if(!bRes)
			{
				tcpRes = TCP_FTP_UPLOAD_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					GSMprintf("\r\n> File upload - upload file FAIL. Logout after 90 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 90);

					procGSM_FTP_Upload_Step = PROC_STEP_30;
				}
				else
				{
				  GSMprintf("\r\n> File upload - retry upload file after 90 secs.");
				
				  FuncSkip_Enable(FUNC_GSM_FTP, 90);
					
					procGSM_FTP_Upload_Step = PROC_STEP_27;
				}

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			u8FileTransRetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_29;

			tcpRes = TCP_OK;

			break;
			*/
		}
		
		// Step 28: Upload file to server directly
		case PROC_STEP_28:
		{
			osEvent event;
			bool bUploadFinish;
			
			
			osStatus osRes = osMutexWait(mutex_data_buf2_user, S_2_mS(20));

			if(osRes != osOK)
			{
				GSMprintf("\r\n> Can't acquire DATA BUF2 mutex to upload file. osRes:%d", osRes);
		
				break; 
			}
			
			u32DatSize = u32FileSize - u32DatCnt;

			if(u32DatSize > sizeof(u8PublicDataBuf))
			{
				u32DatSize = sizeof(u8PublicDataBuf);
				
				bUploadFinish = FALSE;
			}
			else
				bUploadFinish = TRUE;
			
			memset(u8PublicDataBuf, 0x00, sizeof(u8PublicDataBuf));
			
			bRes = SD_ReadAddrToBuff(cSrcFilePath, u8PublicDataBuf, u32DatSize, u32DatCnt);
			
			if(!bRes)
			{
				//GSMprintf("\r\n> Read file %s in SD card fail.", cSrcFilePath);

				tcpRes = TCP_FTP_FILEREAD_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					u8FileTransRetryCnt++;

					if(u8FileTransRetryCnt >= 3)
					{
						GSMprintf("\r\n> Maximum file transfer retries reached. Terminate operation.");

						u8FileTransRetryCnt = 0;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_30;

						GSM_Reset();
					}
					else
						procGSM_FTP_Upload_Step = PROC_STEP_26;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_28;
				
				osMutexRelease(mutex_data_buf2_user);
				
				return tcpRes;
			}

			bRes = GSM_FTP_UploadDirect(u8PublicDataBuf, gsmUploadRequest.cDstFile, u32DatCnt,
			                            u32DatSize, bUploadFinish);
			
			osMutexRelease(mutex_data_buf2_user);

			if(!bRes)
			{
				//GSMprintf("\r\n> Read file %s in SD card fail.", cSrcFilePath);

				tcpRes = TCP_FTP_FILEUPLOAD_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					u8FileTransRetryCnt++;

					if(u8FileTransRetryCnt >= 3)
					{
						GSMprintf("\r\n> Maximum file transfer retries reached. Terminate operation.");

						u8FileTransRetryCnt = 0;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_30;

						GSM_Reset();
					}
					else
						procGSM_FTP_Upload_Step = PROC_STEP_26;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_28;
				
				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_UPLOAD_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_UPLOAD_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_UPLOAD_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_UPLOAD_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_30;

						return TCP_FTP_UPLOAD_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_UploadDirect get event status: %d", event.status);
								
					GSM_Handle_NonBlock_osEventTimeout();

					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			//if(!bRes)
			//{
				//GSMprintf("\r\n> Read file %s in SD card fail.", cSrcFilePath);

			//	tcpRes = TCP_FTP_FILEUPLOAD_ERR;

			//	u8FTP_RetryCnt++;

			//	if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
			//	{
			//		u8FTP_RetryCnt = 0;

			//		u8FileTransRetryCnt++;

			//		if(u8FileTransRetryCnt >= 3)
			//		{
			//			GSMprintf("\r\n> Maximum file transfer retries reached. Terminate operation.");

			//			u8FileTransRetryCnt = 0;
			
			//      ftpRes = GSM_FTP_NET_ERR;
			
			//      GSMprintf("\r\n> File upload - upload file FAIL. Logout after 40 secs.");
			
			//      FuncSkip_Enable(FUNC_GSM_FTP, 40);

			//			procGSM_FTP_Upload_Step = PROC_STEP_30;

			//			GSM_Reset();
			//		}
			//		else
			//			procGSM_FTP_Upload_Step = PROC_STEP_26;
			//	}
			//	else
			//  {
			//    GSMprintf("\r\n> File upload - retry upload file after 40 secs.");
			
			//    FuncSkip_Enable(FUNC_GSM_FTP, 40);
			
			//		procGSM_FTP_Upload_Step = PROC_STEP_28;
			//  }
				
			//	return tcpRes;
			//}
			
			u8FTP_RetryCnt = 0;
			
			u8FileTransRetryCnt = 0;
			
			u32DatCnt += u32DatSize;

	    if(u32DatCnt < u32FileSize)
			  procGSM_FTP_Upload_Step = PROC_STEP_28;
			else
			{
				procGSM_FTP_Upload_Step = PROC_STEP_29;
			}

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 29: Check uploaded file size
		case PROC_STEP_29:
		{
			/*
			osEvent event;


			HAL_Delay(10);

			bRes = GSM_FTP_FileSize(gsmUploadRequest.cDstFile);

			if(!bRes)
			{
