			break;
		}

		// Step 17: Configure FTP timeout
		case PROC_STEP_17:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_CfgTimeout((uint16_t)FTP_FUNCTION_TIMEOUT);

			if(!bRes)
			{
				tcpRes = TCP_FTP_TIMEOUT_CONFIG_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					#if ENABLE_FTPS
					procGSM_FTP_Upload_Step = PROC_STEP_18;
					#else
					bFTP_SetupFinish = TRUE;
					
					procGSM_FTP_Upload_Step = PROC_STEP_24;
					#endif
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_17;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;
		
			//bGSM_FTP_LoginWaiting = FALSE;

			#if ENABLE_FTPS
			procGSM_FTP_Upload_Step = PROC_STEP_18;
			#else
			bFTP_SetupFinish = TRUE;
			
			procGSM_FTP_Upload_Step = PROC_STEP_24;
			#endif

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 18: Select FTP SSL mode
		case PROC_STEP_18:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_CfgSSL_Type(1);

			if(!bRes)
			{
				tcpRes = TCP_FTP_SSL_TYPE_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_31;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_18;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_19;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 19: Select FTP SSL context ID
		case PROC_STEP_19:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_CfgSSL_ID(FTP_SSL_ID_DEF);

			if(!bRes)
			{
				tcpRes = TCP_FTP_SSL_ID_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_20;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_19;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_20;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 20: Select FTP SSL version
		case PROC_STEP_20:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_SSL_Ver(FTP_SSL_ID_DEF, FTP_SSL_VERSION_DEF);

			if(!bRes)
			{
				tcpRes = TCP_FTP_SSL_VER_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_21;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_20;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_21;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 21: Select FTP SSL cipher suit
		case PROC_STEP_21:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_SSL_Cipher(FTP_SSL_ID_DEF, (char *)FTP_SSL_CIPHER_SUIT_DEF);

			if(!bRes)
			{
				tcpRes = TCP_FTP_SSL_CIPHER_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_22;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_21;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_22;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 22: Configure FTP SSL CA path
		case PROC_STEP_22:
		{	
			HAL_Delay(10);

			bRes = GSM_FTP_SSL_CA(FTP_SSL_ID_DEF, (char *)FTP_SSL_CA_DEF);

			if(!bRes)
			{
				tcpRes = TCP_FTP_SSL_CACERT_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_31;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_22;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_23;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 23: Configure FTP SSL security level
		case PROC_STEP_23:
		{	
			HAL_Delay(10);

			bRes = GSM_FTP_SSL_SecLV(FTP_SSL_ID_DEF, FTP_SSL_SEC_LEVEL_DEF);

			if(!bRes)
			{
				tcpRes = TCP_FTP_SSL_SECLV_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_31;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_23;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;
			
			bFTP_SetupFinish = TRUE;

			procGSM_FTP_Upload_Step = PROC_STEP_24;

			tcpRes = TCP_OK;

			break;
		}

		// Step 24: Login FTP server
		case PROC_STEP_24:
		{
			/*
      static uint32_t u32Open_WaitStartTime = 0;
			
			
			if(bFTP_Connect == TRUE)
			{
			  procGSM_FTP_Upload_Step = PROC_STEP_26;

				tcpRes = TCP_OK;

				return tcpRes;
			}
			
			if(bGSM_FTP_LoginWaiting == FALSE)
			{
				bGSM_FTP_LoginWaiting = TRUE;
				
				HAL_Delay(10);
				
				gsmFTP_LoginRes = GSM_EVENT_NULL;
				
				bRes = GSM_FTP_Login((char *)FTP_SERVER_DOMAIN_NAME, (uint16_t)FTP_SERVER_PORT);

				if(!bRes)
				{
					tcpRes = TCP_FTP_LOGIN_ERR;

					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						GSMprintf("\r\n> Open connection to FTP server reached maximum number of retries. Terminate the current operation.");

						u8FTP_RetryCnt = 0;
						
						ftpRes = GSM_FTP_NET_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_30;
					}
					else
					{
						procGSM_FTP_Upload_Step = PROC_STEP_24;
					}

					return tcpRes;
				}
				
				u8FTP_RetryCnt = 0;
				
				procGSM_FTP_Upload_Step = PROC_STEP_24;
				
				u32Open_WaitStartTime = HAL_GetTick();

				tcpRes = TCP_OK;

				break;
			}
      else
      {
				bool bRes = FALSE;
				
				
				if(gsmFTP_LoginRes == GSM_EVENT_NULL)
				{
					if(HAL_GetTick() > (u32Open_WaitStartTime + S_2_mS(FTP_FUNCTION_TIMEOUT + 10)))
					{
						bRes = FALSE;
					}	
					else
					{
						procGSM_FTP_Upload_Step = PROC_STEP_24;

					  tcpRes = TCP_OK;
						
					  break;
					}	
				}
			  else if(gsmFTP_LoginRes == GSM_EVENT_LOGIN_SUCCESS)
				{
				  bRes = TRUE;
				}
				else
				{
				  bRes = FALSE;
				}
				
				if(bRes == FALSE)
				{
					tcpRes = TCP_FTP_LOGIN_ERR;

					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;
						
						ftpRes = GSM_FTP_NET_ERR;
						
						GSMprintf("\r\n> File upload - login FAIL. Deactivate PDP after 40 secs.");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);

						procGSM_FTP_Upload_Step = PROC_STEP_25;
					}
					else
					{
						bGSM_FTP_LoginWaiting = FALSE;
						
						GSMprintf("\r\n> File upload - retry login after 40 secs.");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);
						
						procGSM_FTP_Upload_Step = PROC_STEP_24;
					}

					return tcpRes;
				}
				
				u8FTP_RetryCnt = 0;

				bFTP_Connect = TRUE;

				if(tcp_pdpContext[u8FTP_PDP_ID].bInUse == FALSE)
				{
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = TRUE;

					u8CurrFTP_PDP_ID = u8FTP_PDP_ID;
				}
				
				bGSM_FTP_LoginWaiting = FALSE;

				procGSM_FTP_Upload_Step = PROC_STEP_25;

				tcpRes = TCP_OK;

				break;
			}				
			*/
			
			osEvent event;


			HAL_Delay(10);
			
			u16GSM_CME_ErrCode = 0;
			u16GSM_FTP_ErrCode = 0;
			u16GSM_ProtocolErrCode = 0;

			bRes = GSM_FTP_Login(g_Setting.tGSM_SET.tFTP_Set.cAddr, g_Setting.tGSM_SET.tFTP_Set.u16Port);

			if(!bRes)
			{
				tcpRes = TCP_FTP_LOGIN_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					GSMprintf("\r\n> Open connection to FTP server reached maximum number of retries.");

					u8FTP_RetryCnt = 0;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_30;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_24;

				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_FUNCTION_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_LOGIN_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_LOGIN_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_LOGIN_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_30;

						return TCP_FTP_LOGIN_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_Login get event status: %d", event.status);
								
					GSM_Handle_NonBlock_osEventTimeout();

					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			if(!bRes)
			{
				tcpRes = TCP_FTP_LOGIN_ERR;
				
			  if(u16GSM_CME_ErrCode == 610)
				{
				  sprintf(g_Setting.tGSM_SET.tFTP_Set.cAddr, "%s", (char *)FTP_SERVER_DOMAIN_NAME);
					
					System_SaveSetting();
				}
				else if(u16GSM_CME_ErrCode == 625) 
				{
					GSMprintf("\r\n> GSM file upload - Login CME ERROR 625! Terminate the operation.");
					
					bFTP_UploadWaiting = FALSE;
					
					ftpRes = GSM_FTP_OK;
					
					procGSM_FTP_Upload_Step = PROC_STEP_31;
					
					return tcpRes;
				}
			  else if(u16GSM_FTP_ErrCode == 604)
				{
					GSMprintf("\r\n> GSM file upload - DNS incorrect! Terminate the operation.");
					
					bFTP_UploadWaiting = FALSE;
					
					ftpRes = GSM_FTP_OK;
					
					procGSM_FTP_Upload_Step = PROC_STEP_31;
					
					return tcpRes;
				}
				else if((u16GSM_FTP_ErrCode == 625) && (u16GSM_ProtocolErrCode == 530))
				{
					GSMprintf("\r\n> GSM file upload - Account incorrect! Terminate the operation.");
					
					bFTP_UploadWaiting = FALSE;
					
					ftpRes = GSM_FTP_OK;
					
					procGSM_FTP_Upload_Step = PROC_STEP_31;
					
					return tcpRes;
				}

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					GSMprintf("\r\n> File upload - login FAIL. Deactivate PDP after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FTP_Upload_Step = PROC_STEP_30;
				}
				else
				{
					FuncSkip_Enable(FUNC_GSM_FTP, 40);
					
					GSMprintf("\r\n> File upload - retry login after 40 secs.");
					
					procGSM_FTP_Upload_Step = PROC_STEP_24;
				}

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			bFTP_Connect = TRUE;

			if(tcp_pdpContext[u8FTP_PDP_ID].bInUse == FALSE)
			{
				tcp_pdpContext[u8FTP_PDP_ID].bInUse = TRUE;

				u8CurrFTP_PDP_ID = u8FTP_PDP_ID;
			}

			procGSM_FTP_Upload_Step = PROC_STEP_25;

			tcpRes = TCP_OK;

			break;
			
		}

		// Step 25: Config working directory on FTP server
		case PROC_STEP_25:
		{
			char cFilePath[30];
			osEvent event;


			sprintf(cFilePath, "%s", gsmUploadRequest.cDstDir);

			HAL_Delay(10);
			
			u16GSM_CME_ErrCode = 0;
			u16GSM_FTP_ErrCode = 0;
			u16GSM_ProtocolErrCode = 0;

			bRes = GSM_FTP_SetDir(cFilePath);

			if(!bRes)
			{
				tcpRes = TCP_FTP_SETDIR_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_30;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_25;

				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_FUNCTION_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_SETDIR_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_SETDIR_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_SETDIR_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_30;

						return TCP_FTP_SETDIR_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_SetDir get event status: %d", event.status);
								
					GSM_Handle_NonBlock_osEventTimeout();

					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			if(!bRes)
			{
				tcpRes = TCP_FTP_SETDIR_ERR;
				
				if(u16GSM_CME_ErrCode == 625) 
				{
					GSMprintf("\r\n> GSM file upload - Working directory CME ERROR 625! Terminate the operation.");
					
					bFTP_UploadWaiting = FALSE;
					
					ftpRes = GSM_FTP_OK;
					
					procGSM_FTP_Upload_Step = PROC_STEP_30;
					
					return tcpRes;
				}
				else if((u16GSM_FTP_ErrCode == 627) && (u16GSM_ProtocolErrCode == 550))
				{
					GSMprintf("\r\n> GSM file upload - Working directory incorrect! Terminate the operation.");
					
					bFTP_UploadWaiting = FALSE;
					
					ftpRes = GSM_FTP_OK;
					
					procGSM_FTP_Upload_Step = PROC_STEP_30;
					
					return tcpRes;
				}
				else if((u16GSM_FTP_ErrCode == 607) && (u16GSM_ProtocolErrCode == 0))
				{
					GSMprintf("\r\n> FTP server close connection! Retry to upload file to FTP server.");
					
					bFTP_UploadWaiting = FALSE;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					procGSM_FTP_Upload_Step = PROC_STEP_31;
					
					return tcpRes;
				}

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					GSMprintf("\r\n> File upload - set working directory FAIL. Logout after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FTP_Upload_Step = PROC_STEP_30;
				}
				else
				{
					GSMprintf("\r\n> File upload - retry set working directory after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);
					
					procGSM_FTP_Upload_Step = PROC_STEP_25;
				}

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;
			
			bFTP_UploadWaiting = FALSE;
				
			//procGSM_FTP_Upload_Step = PROC_STEP_26;
			procGSM_FTP_Upload_Step = PROC_STEP_27;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 26: Delete file in the FTP server if it is already existing
		case PROC_STEP_26:
		{
			osEvent event;


			HAL_Delay(10);

			bRes = GSM_FTP_FileDel(gsmUploadRequest.cDstFile);

			if(!bRes)
			{
				tcpRes = TCP_FTP_FILEDEL_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					bFTP_UploadWaiting = FALSE;
				
				  procGSM_FTP_Upload_Step = PROC_STEP_27;
				}
				else
				{
					procGSM_FTP_Upload_Step = PROC_STEP_26;
				}

				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_FUNCTION_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_FILEDEL_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_FILEDEL_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_FILEDEL_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						ftpRes = GSM_FTP_OTHER_ERR;
						
						procGSM_FTP_Upload_Step = PROC_STEP_30;

						return TCP_FTP_FILEDEL_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_FileDel get event status: %d", event.status);
								
					GSM_Handle_NonBlock_osEventTimeout();
					
					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			//if(!bRes)
			//{
			//	tcpRes = TCP_FTP_FILEDEL_ERR;

			//	u8FTP_RetryCnt++;

			//	if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
			//	{
			//		u8FTP_RetryCnt = 0;

			//		bFTP_UploadWaiting = FALSE;
				
			//    procGSM_FTP_Upload_Step = PROC_STEP_27;
			//	}
			//	else
			//		procGSM_FTP_Upload_Step = PROC_STEP_26;

			//	bFTP_Connect = FALSE;

			//	return tcpRes;
			//}

			u8FTP_RetryCnt = 0;

			//bFTP_Connect = FALSE;

			/*
			if(tcp_pdpContext[u8FTP_PDP_ID].bInUse == FALSE)
			{
				tcp_pdpContext[u8FTP_PDP_ID].bInUse = TRUE;

				u8CurrFTP_PDP_ID = u8FTP_PDP_ID;
			}
			*/

			bFTP_UploadWaiting = FALSE;
				
			procGSM_FTP_Upload_Step = PROC_STEP_27;

			u32DatCnt = 0;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 27: Upload file to server indirectly
		case PROC_STEP_27:
		{
			static uint32_t u32Upload_WaitStartTime = 0;
			
			
			if(bFTP_UploadWaiting == FALSE)
			{
				HAL_Delay(10);
				
				gsmFTP_UploadRes = GSM_EVENT_NULL;
				
				u16GSM_CME_ErrCode = 0;
				u16GSM_FTP_ErrCode = 0;
				u16GSM_ProtocolErrCode = 0;
				
				bRes = GSM_FTP_UploadFile((char *)FTP_LOCAL_STORAGE_FILE_2, gsmUploadRequest.cDstFile);

				if(!bRes)
				{
					tcpRes = TCP_FTP_UPLOAD_ERR;

					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						GSMprintf("\r\n> Upload file to FTP server reached maximum number of retries. Terminate the current operation.");

						u8FTP_RetryCnt = 0;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_30;
					}
					else
					{
						procGSM_FTP_Upload_Step = PROC_STEP_27;
					}

					return tcpRes;
				}
				
				u8FTP_RetryCnt = 0;
				
				bFTP_UploadWaiting = TRUE;
				
				procGSM_FTP_Upload_Step = PROC_STEP_27;
				
				u32Upload_WaitStartTime = HAL_GetTick();

				tcpRes = TCP_OK;

				break;
			}
      else
      {
				bool bRes = FALSE;
				
				
				if(gsmFTP_UploadRes == GSM_EVENT_NULL)
				{
					if(HAL_GetTick() > (u32Upload_WaitStartTime + S_2_mS(FTP_UPLOAD_TIMEOUT + 10)))
					{
						bRes = FALSE;
					}	
					else
					{
						procGSM_FTP_Upload_Step = PROC_STEP_27;

					  tcpRes = TCP_OK;
						
					  break;
					}	
				}
			  else if(gsmFTP_UploadRes == GSM_EVENT_UPLOAD_SUCCESS)
				{
				  bRes = TRUE;
				}
				else
				{
				  bRes = FALSE;
				}
				
				if(bRes == FALSE)
				{
					tcpRes = TCP_FTP_UPLOAD_ERR;
					
					if(u16GSM_CME_ErrCode == 625) 
					{
					  GSMprintf("\r\n> GSM file upload - Upload file CME ERROR 625! Terminate the operation.");
						
					  bFTP_UploadWaiting = FALSE;
						
						ftpRes = GSM_FTP_OK;
						
						procGSM_FTP_Upload_Step = PROC_STEP_30;
						
						return tcpRes;
					}
					else if((u16GSM_FTP_ErrCode == 627) && (u16GSM_ProtocolErrCode == 550))
					{
						GSMprintf("\r\n> GSM file upload - File name duplicated! Terminate the operation.");
						
					  bFTP_UploadWaiting = FALSE;
						
						ftpRes = GSM_FTP_OK;
						
						procGSM_FTP_Upload_Step = PROC_STEP_30;
						
						return tcpRes;
					}
					else if((u16GSM_FTP_ErrCode == 607) && (u16GSM_ProtocolErrCode == 0))
					{
						GSMprintf("\r\n> FTP server close connection! Retry to upload file to FTP server.");
						
					  bFTP_UploadWaiting = FALSE;
						
						ftpRes = GSM_FTP_NET_ERR;
						
						procGSM_FTP_Upload_Step = PROC_STEP_31;
						
						return tcpRes;
					}

					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;
						
						ftpRes = GSM_FTP_NET_ERR;
						
						GSMprintf("\r\n> File upload - upload file FAIL. Logout after 90 secs.");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 90);

						procGSM_FTP_Upload_Step = PROC_STEP_30;
					}
					else
					{
						bFTP_UploadWaiting = FALSE;
						
						GSMprintf("\r\n> File upload - retry upload file after 90 secs.");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 90);
						
						procGSM_FTP_Upload_Step = PROC_STEP_27;
					}

					return tcpRes;
				}
				
				u8FTP_RetryCnt = 0;

				u8FileTransRetryCnt = 0;
				
				bFTP_UploadWaiting = FALSE;
				
				GSMprintf("\r\n> File %s is uploaded successfully!", gsmUploadRequest.cDstFile);
				
				if(g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt > 0)
				{
				  g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt = 0;
					
					System_SaveSetting();
				}

				//procGSM_FTP_Upload_Step = PROC_STEP_29;
				procGSM_FTP_Upload_Step = PROC_STEP_30;

				tcpRes = TCP_OK;

				break;
			}				
			
			/*
			osEvent event;
			
			
			HAL_Delay(10);

			bRes = GSM_FTP_UploadFile((char *)FTP_LOCAL_STORAGE_FILE_2, gsmUploadRequest.cDstFile);

			if(!bRes)
			{
				tcpRes = TCP_FTP_UPLOAD_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_30;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_27;

				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_UPLOAD_TIMEOUT + 10));
				
