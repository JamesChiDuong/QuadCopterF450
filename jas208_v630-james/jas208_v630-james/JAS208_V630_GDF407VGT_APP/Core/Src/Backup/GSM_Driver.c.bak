					else if(event.value.v == GSM_EVENT_UPLOAD_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_UPLOAD_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_30;

						return TCP_FTP_UPLOAD_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_UploadFile get event status: %d", event.status);
								
