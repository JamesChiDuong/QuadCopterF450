					GSMprintf("\r\n> File upload - Get file size FAIL. Retry after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FTP_Upload_Step = PROC_STEP_30;
				}
				else
				{
					GSMprintf("\r\n> File upload - Retry get file size after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);
					
					procGSM_FTP_Upload_Step = PROC_STEP_29;
				}

				return tcpRes;
			}

			GSMprintf("\r\n> FTP uploaded file size:%d", u32GetFileSize);
			
			u8FTP_RetryCnt = 0;

			if(u32GetFileSize != u32FileSize)
			{
				GSMprintf("\r\n> Uploaded file size is not correct(%d != %d)! Operation failed!",
				          u32GetFileSize,
				          u32FileSize);
				
				GSMprintf("\r\n> Upload file - Logout after 40 secs.");
				
