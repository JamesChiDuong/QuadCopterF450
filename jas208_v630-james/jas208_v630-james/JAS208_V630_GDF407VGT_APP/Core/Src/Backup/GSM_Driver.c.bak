void GSM_TCP_ReportEvent(char *pcEventCode, char *pcEventMsg)
{
	//uint16_t u16TimeOut = 20000;


	//while(u16TimeOut--)
	//{
	//	if(gsmEventDatRequest.bInUse == FALSE)
	//		break;

	//	HAL_Delay(1);
	//}

	//if(u16TimeOut == 0)
	//{
	//	return;
	//}

	//gsmEventDatRequest.bInUse = TRUE;

	//memset(gsmEventDatRequest.cEventCode, 0x00, sizeof(gsmEventDatRequest.cEventCode));

	//memset(gsmEventDatRequest.cEventMsg, 0x00, sizeof(gsmEventDatRequest.cEventMsg));

	//sprintf(gsmEventDatRequest.cEventCode, "%s", pcEventCode);

	//sprintf(gsmEventDatRequest.cEventMsg, "%s", pcEventMsg);

	//gsmEventDatRequest.bInRequest = TRUE;
	
	//GSMprintf("\r\n> Check to send event %s", pcEventCode);
	
	//if((strncmp(g_Setting.cJAS_Ver, (char *)JAS208_GSM, 7) == 0) &&
	if((bSD_ReportErrFlag == FALSE) && 
