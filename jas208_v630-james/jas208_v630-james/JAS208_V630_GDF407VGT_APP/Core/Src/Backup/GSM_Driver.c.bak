									u16GSM_FTP_ErrCode = u16ErrCode;
									
									pcPtr += strlen(pcPtr) + 1;
									
									StopChar(pcPtr, '\r');
									
									if((strlen(pcPtr) > 0) && (strlen(pcPtr) < 4))
									{
									  u16GSM_ProtocolErrCode = atoi(pcPtr);
									}

									if(u16ErrCode == 0)
										gsmEvent = GSM_EVENT_FILEDEL_SUCCESS;
									else
										gsmEvent = GSM_EVENT_FILEDEL_ERROR;
								}
								else
									gsmEvent = GSM_EVENT_FILEDEL_ERROR;
							}

							u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos3 + 2 - u16FindPos1) %
													rbBuf[GSM_COMPORT_DEF].u16Size;
						}
						else
						{
							if(gsmCurrNonBlockCmd == QTEC21_FTP_FILE_DEL)
								gsmEvent = GSM_EVENT_FILEDEL_ERROR;

							u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 1 - u16FindPos1) %
													rbBuf[GSM_COMPORT_DEF].u16Size;
						}
					}
					else
					{
						if(gsmCurrNonBlockCmd == QTEC21_FTP_FILE_DEL)
							gsmEvent = GSM_EVENT_FILEDEL_ERROR;

						u16DatLen = 11;
					}

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "\r\n+QFTPCLOSE:"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_FTP_CLOSE, &u16FindPos1))
				{
					uint8_t u8Cnt = 0;


					if(gsmCurrNonBlockCmd == QTEC21_FTP_LOGOUT)
						osTimerStop(timerRTOS_GSM_NonBlockHandle);

					while(u8Cnt < 50)
					{
						HAL_Delay(1);

						bRes = UART_RecvFindPos(GSM_COMPORT_DEF, (char *)",", &u16FindPos2, u16FindPos1);

						if(bRes)
							break;

						u8Cnt++;
					}

					// If find ","
					if(bRes)
					{
						u8Cnt = 0;

						while(u8Cnt < 50)
						{
							HAL_Delay(1);

							bRes = UART_RecvFindPos(GSM_COMPORT_DEF, (char *)RESP_END, &u16FindPos3, u16FindPos2);

							if(bRes)
								break;

							u8Cnt++;
						}

						// If find "\r\n"
						if(bRes)
						{
							if(gsmCurrNonBlockCmd == QTEC21_FTP_LOGOUT)
							{
								u16DatLen = UART_RecvDataLenPos(GSM_COMPORT_DEF, u16FindPos1);

								// Get the preview data
								UART_PeekRecvData(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

								pcPtr = (char *)cContent + 14;

								StopChar(pcPtr, ',');

								if((strlen(pcPtr) > 0) && (strlen(pcPtr) < 4))
								{
									uint16_t u16ErrCode = atoi(pcPtr);
									
									u16GSM_FTP_ErrCode = u16ErrCode;
									
									pcPtr += strlen(pcPtr) + 1;
									
									StopChar(pcPtr, '\r');
									
									if((strlen(pcPtr) > 0) && (strlen(pcPtr) < 4))
									{
									  u16GSM_ProtocolErrCode = atoi(pcPtr);
									}

									if(u16ErrCode == 0)
										gsmEvent = GSM_EVENT_LOGOUT_SUCCESS;
									else
										gsmEvent = GSM_EVENT_LOGOUT_ERROR;
								}
								else
									gsmEvent = GSM_EVENT_LOGOUT_ERROR;
							}

							u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos3 + 2 - u16FindPos1) %
													rbBuf[GSM_COMPORT_DEF].u16Size;
						}
						else
						{
							if(gsmCurrNonBlockCmd == QTEC21_FTP_LOGOUT)
								gsmEvent = GSM_EVENT_LOGOUT_ERROR;

							u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 1 - u16FindPos1) %
													rbBuf[GSM_COMPORT_DEF].u16Size;
						}
					}
					else
					{
						if(gsmCurrNonBlockCmd == QTEC21_FTP_LOGOUT)
							gsmEvent = GSM_EVENT_LOGOUT_ERROR;

						u16DatLen = 13;
					}

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "\r\nRING\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_RING, &u16FindPos1))
				{
					gsmEvent = GSM_EVENT_RECV_CALL;

					u16DatLen = 8;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "\r\n+CMTI: "SM","
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_CMTI_MSG, &u16FindPos1))
				{
					GSMprintf("\r\n> Found SMS message header.");
					
					uint8_t u8Cnt = 0;


					while(u8Cnt < 50)
					{
						HAL_Delay(1);

						bRes = UART_RecvFindPos(GSM_COMPORT_DEF, (char *)RESP_END, &u16FindPos2, u16FindPos1 + 2);

						if(bRes)
							break;

						u8Cnt++;
					}

					// If find "\r\n"
					if(bRes)
					{
						u16DatLen = UART_RecvDataLenPos(GSM_COMPORT_DEF, u16FindPos1);

						// Get the preview data
						UART_PeekRecvData(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

						pcPtr = (char *)cContent;

						StopChar(pcPtr, ',');

						pcPtr += strlen(pcPtr) + 1;

						StopChar(pcPtr, '\r');

						if(strlen(pcPtr) > 0)
						{
							u8SMS_ID = atoi(pcPtr);

							if(EXTIO_IsMainPowerNormal() == TRUE)
							{
								//if(procGSM_FOTA_Step == PROC_STEP_NULL)
								//{
							  gsmEvent = GSM_EVENT_RECV_MSG;
								//}
							}
						}

						u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 2 - u16FindPos1) %
												rbBuf[GSM_COMPORT_DEF].u16Size;
					}
					else
					{
						u16DatLen = 14;
					}

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "\r\n+QIURC: "recv","
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_RECEIVE_PACKET, &u16FindPos1))
				{
					uint8_t u8Cnt = 0;


					while(u8Cnt < 50)
					{
						HAL_Delay(1);

						bRes = UART_RecvFindPos(GSM_COMPORT_DEF, (char *)RESP_END, &u16FindPos2,
																		(u16FindPos1 + 2) + rbBuf[GSM_COMPORT_DEF].u16Size);

						if(bRes)
							break;

						u8Cnt++;
					}

					// If find "\r\n"
					if(bRes)
					{
						u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 2 - u16FindPos1) %
												rbBuf[GSM_COMPORT_DEF].u16Size;

						// Get the preview data
						UART_PeekRecvData(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

						pcPtr = (char *)cContent;

						StopChar(pcPtr, ',');

						pcPtr += strlen(pcPtr) + 1;

						StopChar(pcPtr, '\r');

						if(strlen(pcPtr) > 0)
						{
							u8ConnSrcID = atoi(pcPtr);

							//if(procGSM_FOTA_Step == PROC_STEP_NULL)
							//{
								if(u8ConnSrcID == u8CurrTCP_Socket[0])
								{
									gsmEvent = GSM_EVENT_RECV_PACKET;
								}
								#if ENABLE_MULTI_SERVER
								else if(u8ConnSrcID == u8CurrTCP_Socket[1])
								{
									gsmEvent = GSM_EVENT_RECV_PACKET;
								}
								#endif
						  //}
						}

						//u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 2 - u16FindPos1) %
						//						rbBuf[GSM_COMPORT_DEF].u16Size;
					}
					else
					{
						u16DatLen = 17;
					}

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "\r\n+QIURC: "closed","
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_CONN_CLOSED, &u16FindPos1))
				{
					uint8_t u8Cnt = 0;


					while(u8Cnt < 50)
					{
						HAL_Delay(1);

						bRes = UART_RecvFindPos(GSM_COMPORT_DEF, (char *)RESP_END, &u16FindPos2,
																		(u16FindPos1 + 2) + rbBuf[GSM_COMPORT_DEF].u16Size);

						if(bRes)
							break;

						u8Cnt++;
					}

					// If find "\r\n"
					if(bRes)
					{
						u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 2 - u16FindPos1) %
												rbBuf[GSM_COMPORT_DEF].u16Size;

						// Get the preview data
						UART_PeekRecvData(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

						pcPtr = (char *)cContent;

						StopChar(pcPtr, ',');

						pcPtr += strlen(pcPtr) + 1;

						StopChar(pcPtr, '\r');

						if(strlen(pcPtr) > 0)
						{
							u8ConnSrcID = atoi(pcPtr);

							if(u8ConnSrcID == u8CurrTCP_Socket[0])
							{
								gsmEvent = GSM_EVENT_CONN_CLOSED;
							}
							#if ENABLE_MULTI_SERVER
							else if(u8ConnSrcID == u8CurrTCP_Socket[1])
							{
								gsmEvent = GSM_EVENT_CONN_CLOSED;
							}
							#endif
						}

						//u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 2 - u16FindPos1) %
						//						rbBuf[GSM_COMPORT_DEF].u16Size;
					}
					else
					{
						u16DatLen = 17;
					}

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "\r\n+QIURC: "pdpdeact","
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_MSG_PDP_DEACT, &u16FindPos1))
				{
					uint8_t u8Cnt = 0;


					while(u8Cnt < 50)
					{
						HAL_Delay(1);

						bRes = UART_RecvFindPos(GSM_COMPORT_DEF, (char *)RESP_END, &u16FindPos2,
																		(u16FindPos1 + 2) + rbBuf[GSM_COMPORT_DEF].u16Size);

						if(bRes)
							break;

						u8Cnt++;
					}

					// If find "\r\n"
					if(bRes)
					{
						u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 2 - u16FindPos1) %
												rbBuf[GSM_COMPORT_DEF].u16Size;

						// Get the preview data
						UART_PeekRecvData(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

						pcPtr = (char *)cContent;

						StopChar(pcPtr, ',');

						pcPtr += strlen(pcPtr) + 1;

						StopChar(pcPtr, '\r');

						if(strlen(pcPtr) > 0)
						{
							u8DeactPDP_ID = atoi(pcPtr);

							if((u8DeactPDP_ID == u8CurrTCP_PDP_ID[0]) || (u8DeactPDP_ID == u8CurrFTP_PDP_ID))
							{
								gsmEvent = GSM_EVENT_PDP_DEACT;
							}
							#if ENABLE_MULTI_SERVER
							else if(u8DeactPDP_ID == u8CurrTCP_PDP_ID[1])
							{
								gsmEvent = GSM_EVENT_PDP_DEACT;
							}
							#endif
						}

						//u16DatLen = (rbBuf[GSM_COMPORT_DEF].u16Size + u16FindPos2 + 2 - u16FindPos1) %
						//						rbBuf[GSM_COMPORT_DEF].u16Size;
					}
					else
					{
						u16DatLen = 17;
					}

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "\r\nNO CARRIER\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_RESPONSE_NO_CARRIER, &u16FindPos1))
				{
					gsmEvent = GSM_EVENT_NO_CARRIER;

					u16DatLen = 14;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "r\n+CFUN: 1\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_ME_FUNC_READY, &u16FindPos1))
				{
					u16DatLen = 12;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);

					gsmEvent = GSM_EVENT_ME_FUNC_READY;
				}
				// If find "\r\n+CPIN: READY\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_SIM_READY, &u16FindPos1))
				{
					u16DatLen = 16;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);

					gsmEvent = GSM_EVENT_SIM_READY;
				}
				// If find "\r\n+CPIN: NOT READY\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_SIM_NOT_READY, &u16FindPos1))
				{
					u16DatLen = 20;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);

					gsmEvent = GSM_EVENT_SIM_NOT_READY;
				}
				// If find "\r\n+CPIN: NOT INSERTED\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_SIM_NOT_INSERTED, &u16FindPos1))
				{
					u16DatLen = 23;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);

					gsmEvent = GSM_EVENT_SIM_NOT_INSERTED;
				}
				// If find "\r\n+QUSIM: 1\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_QUSIM_OK, &u16FindPos1))
				{
					u16DatLen = 13;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);

					gsmEvent = GSM_EVENT_QUSIM_OK;
				}
				// If find "\r\n+QIND: SMS DONE\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_SMS_READY, &u16FindPos1))
				{
					u16DatLen = 19;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);

					gsmEvent = GSM_EVENT_SMS_READY;
				}
				// If find "\r\n+QIND: PB DONE\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_PHONEBOOK_READY, &u16FindPos1))
				{
					u16DatLen = 18;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);

					gsmEvent = GSM_EVENT_PHONEBOOK_READY;
				}
				// If find "\r\nNORMAL POWER DOWN\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_NORMAL_POWER_DOWN, &u16FindPos1))
				{
					u16DatLen = 21;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);
				}
				// If find "\r\nPOWERED DOWN\r\n"
				else if(UART_RecvFind(GSM_COMPORT_DEF, (char *)STR_POWERED_DOWN, &u16FindPos1))
				{
					u16DatLen = 16;

					UART_GetRecvDataPos(GSM_COMPORT_DEF, u16FindPos1, (uint8_t *)cContent, u16DatLen);

					cContent[u16DatLen] = 0;

					GSMprintf("\r\n> GSM data:\n%s\r\n> GSM data end.", cContent);

					gsmEvent = GSM_EVENT_POWERED_DOWN;
				}
				// If find no special string
				else
				{
					if(u16DatLen > (rbBuf[GSM_COMPORT_DEF].u16Size * 3 / 4))
					{
						u16DatLen = UART_RecvDataLen(GSM_COMPORT_DEF);

						UART_GetRecvData(GSM_COMPORT_DEF, (uint8_t *)cContent, u16DatLen);

						cContent[u16DatLen] = 0;
						
				    GSMprintf("\r\n> GSM ring buffer has %d bytes. Clear GSM ring buffer.", u16DatLen);

						//GSMprintf("\r\n> GSM RX buffer data:\n%s\r\n> GSM RX buffer data end.", cContent);
					}
				}
			}
	  }
	}

	osMutexRelease(mutex_gsm_rx_user);
	
	taskInfo[TASK_GSM_RX].u16TaskStep++;

	switch((uint8_t)gsmEvent)
	{
		case GSM_EVENT_INIT:
		{
			bQtEC21_Ready = TRUE;
		
			HAL_Delay(200);
			
			procGSM_SetupStep = PROC_STEP_1;
			
			while((procGSM_SetupStep != PROC_STEP_NULL) && (bQtEC21_Ready == TRUE))
			{
				GSM_SetupProc();
			}
			
			bQtEC21_InitFinish = TRUE;
			
			RTOSprintf("\r\n> ### GSM FUNCTION ON ###");

			break;
		}

	  case GSM_EVENT_PROCESS:
		{
			//if(gsmCurrNonBlockCmd == QTEC21_TCP_CONN_CLOSE)
			//	break;
			
			if(EXTIO_IsMainPowerNormal() == TRUE)
			{
				u16TurnCnt1++;
				u16TurnCnt2++;
				u16TurnCnt3++;
				

				if(u16TurnCnt1 >= 5001)
				{
					u16TurnCnt1 = 0;

					//if((strncmp(g_Setting.cJAS_Ver, (char *)JAS208_GSM, 7) == 0) && 
					if((bQtEC21_State == TRUE) &&
						 (bQtEC21_InitFinish == TRUE))// &&  
						 //(procGSM_FOTA_Step == PROC_STEP_NULL) &&
						 //(procGSM_FTP_Upload_Step == PROC_STEP_NULL))
					{
						uint8_t u8RSSI, u8Ber;


						bRes = GSM_Net_GetCSQ(&u8RSSI, &u8Ber);
						//bRes = QtEC21_Net_GetCSQ(&u8RSSI, &u8Ber);
						
						if(bRes)
						{
							GSMprintf("\r\n> RSSI:%d \r\n", u8RSSI);

							//GSMprintf("\r\n> BER:%d", u8Ber);

							g_Setting.tGSM_SET.tNetSet.u8GSM_CSQ = u8RSSI;
						}
						else
							GSMprintf("\r\n> Get CSQ FAIL.\r\n");
					}
				}
				
				if(u16TurnCnt2 >= 20001)
				{
					u16TurnCnt2 = 0;
					
					//if((strncmp(g_Setting.cJAS_Ver, (char *)JAS208_GSM, 7) == 0) && 
					if((bQtEC21_State == TRUE) && 
						 (bQtEC21_InitFinish == TRUE) &&  
						 (GSM_IsAccessFTP() == FALSE))
					{
				    GSM_SMS_CheckUnread();
						
						HAL_Delay(100);
					}
				}
				
				if(u16TurnCnt3 >= 10001)
				{	
					u16TurnCnt3 = 0;
					
					for(int i = 0; i < MAX_SOCKET_BANK; i++)
				  {
						//if((strncmp(g_Setting.cJAS_Ver, (char *)JAS208_GSM, 7) == 0) && 
						if((bQtEC21_State == TRUE) && 
							 (bQtEC21_InitFinish == TRUE) &&  
							 (GSM_IsAccessFTP() == FALSE) &&
						   (bTCPIP_Connect[i] == TRUE))
						{
							uint16_t u16RecvDatLen, u16ReadLen;
							
							
							bRes = GSM_TCP_RecvDataLen(u8CurrTCP_Socket[i], &u16RecvDatLen);
							
							if(bRes && u16RecvDatLen)
							{
								HAL_Delay(50);
								
								bRes = GSM_TCP_RecvDataLen(u8CurrTCP_Socket[i], &u16RecvDatLen);
								//bRes = QtEC21_TCP_RecvDataLen(u8ConnSrcID, &u16RecvDatLen);			
								
								if(!bRes)
								{
									GSMprintf("\r\n> Fail to get the number of bytes received from TCP/IP connection.");

									return;
								}

								if(u16RecvDatLen == 0)
								{
									GSMprintf("\r\n> TCP/IP message contains no byte.");

									return;
								}
								
								memset(cContent, 0x00, sizeof(cContent));

								bRes = GSM_TCP_GetRecvData(u8CurrTCP_Socket[i], (uint8_t *)cContent, u16RecvDatLen, &u16ReadLen);
								//bRes = QtEC21_TCP_GetRecvData(u8ConnSrcID, (uint8_t *)cContent, u16RecvDatLen, &u16ReadLen);
								
								if(!bRes)
								{
									GSMprintf("\r\n> Fail to get the received TCP/IP message.");

									return;
								}

								//cContent[u16ReadLen] = 0;

								GSMprintf("\r\n> GSM check TCP/IP get message:\r\n%s\r\n> TCP/IP message end.", cContent);

								GSM_TCP_MsgProc(cContent, u8CurrTCP_Socket[i]);

								HAL_Delay(100);
							}
						}
				  }
				}
		  }

			break;
		}

		case GSM_EVENT_ME_FUNC_READY:
		case GSM_EVENT_SIM_READY:
		case GSM_EVENT_SIM_NOT_READY:
		case GSM_EVENT_SIM_NOT_INSERTED:
		case GSM_EVENT_QUSIM_OK:
		case GSM_EVENT_SMS_READY:
		case GSM_EVENT_PHONEBOOK_READY:
			break;
		
		case GSM_EVENT_POWERED_DOWN:
		  GSMprintf("\r\n> Turn on GSM module.");	
		
		  QtEC21_TurnOnPwrKey();

      HAL_Delay(S_2_mS(1));

      GSM_ResetWithCheckFTP();		
		
			break;

		case GSM_EVENT_SENDSMS_SUCCESS:
		{
			GSMprintf("\r\n> Send short message successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_SEND_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_SENDSMS_ERROR:
		{
			GSMprintf("\r\n> Send SMS error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_SEND_ERROR, 0);

			break;
		}

		case GSM_EVENT_OPEN_SUCCESS:
		{
			GSMprintf("\r\n> Open TCP/IP connection successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_OPEN_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_OPEN_ERROR:
		{
			GSMprintf("\r\n> Open TCP/IP connection error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_OPEN_ERROR, 0);

			break;
		}

		case GSM_EVENT_CLOSE_SUCCESS:
		{
			GSMprintf("\r\n> Close TCP/IP connection successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_CLOSE_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_CLOSE_ERROR:
		{
			GSMprintf("\r\n> Close TCP/IP connection error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_CLOSE_ERROR, 0);

			break;
		}

		case GSM_EVENT_LOGIN_SUCCESS:
		{
			GSMprintf("\r\n> Login FTP server successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_LOGIN_SUCCESS, 0);
			
			//gsmFTP_LoginRes = GSM_EVENT_LOGIN_SUCCESS;

			break;
		}

		case GSM_EVENT_LOGIN_ERROR:
		{
			GSMprintf("\r\n> Login FTP server error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_LOGIN_ERROR, 0);
			
			//gsmFTP_LoginRes = GSM_EVENT_LOGIN_ERROR;

			break;
		}

		case GSM_EVENT_SETDIR_SUCCESS:
		{
			GSMprintf("\r\n> Set working directory on FTP server successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_SETDIR_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_SETDIR_ERROR:
		{
			GSMprintf("\r\n> Set working directory on FTP server error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_SETDIR_ERROR, 0);

			break;
		}
		
		case GSM_EVENT_UPLOAD_SUCCESS:
		{
			GSMprintf("\r\n> Upload file to FTP server successfully.");

			//gsmCurrNonBlockCmd = QTEC21_NULL;

			//qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_UPLOAD_SUCCESS, 0);
			
			gsmFTP_UploadRes = GSM_EVENT_UPLOAD_SUCCESS;

			break;
		}
		
		case GSM_EVENT_UPLOAD_ERROR:
		{
			GSMprintf("\r\n> Upload file to FTP server error.");

			//gsmCurrNonBlockCmd = QTEC21_NULL;

			//qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_UPLOAD_ERROR, 0);
			
			gsmFTP_UploadRes = GSM_EVENT_UPLOAD_ERROR;

			break;
		}

		case GSM_EVENT_DOWNLOAD_SUCCESS:
		{
			GSMprintf("\r\n> Download file from FTP server successfully.");

			//gsmCurrNonBlockCmd = QTEC21_NULL;

			//qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_DOWNLOAD_SUCCESS, 0);
			
			gsmFTP_DownloadRes = GSM_EVENT_DOWNLOAD_SUCCESS;

			break;
		}

		case GSM_EVENT_DOWNLOAD_ERROR:
		{
			GSMprintf("\r\n> Download file from FTP server error.");

			//gsmCurrNonBlockCmd = QTEC21_NULL;

			//qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_DOWNLOAD_ERROR, 0);
			
			gsmFTP_DownloadRes = GSM_EVENT_DOWNLOAD_ERROR;

			break;
		}

		case GSM_EVENT_GETSIZE_SUCCESS:
		{
			GSMprintf("\r\n> Get file size from FTP server successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_GETSIZE_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_GETSIZE_ERROR:
		{
			GSMprintf("\r\n> Get file size from FTP server error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_GETSIZE_ERROR, 0);

			break;
		}

		case GSM_EVENT_GETDATE_SUCCESS:
		{
			GSMprintf("\r\n> Get file date from FTP server successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_GETDATE_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_GETDATE_ERROR:
		{
			GSMprintf("\r\n> Get file date from FTP server error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_GETDATE_ERROR, 0);

			break;
		}

		case GSM_EVENT_TRANSLEN_SUCCESS:
		{
			GSMprintf("\r\n> Get number of bytes tranferred from FTP server successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_TRANSLEN_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_TRANSLEN_ERROR:
		{
			GSMprintf("\r\n> Get number of bytes tranferred from FTP server error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_TRANSLEN_ERROR, 0);

			break;
		}
		
		case GSM_EVENT_FILEDEL_SUCCESS:
		{
			GSMprintf("\r\n> Delete file in FTP server successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_FILEDEL_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_FILEDEL_ERROR:
		{
			//GSMprintf("\r\n> Delete file in FTP server failed.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_FILEDEL_ERROR, 0);

			break;
		}

		case GSM_EVENT_LOGOUT_SUCCESS:
		{
			GSMprintf("\r\n> Logout FTP server successfully.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_LOGOUT_SUCCESS, 0);

			break;
		}

		case GSM_EVENT_LOGOUT_ERROR:
		{
			//GSMprintf("\r\n> Login FTP server error.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_LOGOUT_ERROR, 0);

			break;
		}

		case GSM_EVENT_RECV_CALL:
		{
			//GSMprintf("\r\n> Incoming call!.");
			
			GSM_Call_Disconn();

			break;
		}

		case GSM_EVENT_RECV_MSG:
		{
			//if(gsmCurrNonBlockCmd == QTEC21_TCP_CONN_CLOSE)
			//	break;
			
			GSMprintf("\r\n> Received a short message.");
			
			memset(cContent, 0x00, sizeof(cContent));

			bRes = GSM_SMS_Read(u8SMS_ID, (uint8_t *)cContent);
      //bRes = QtEC21_SMS_Read(u8SMS_ID, (uint8_t *)cContent);

			GSMprintf("\r\n> Short message read result:%d", bRes);

			if(bRes)
			{
				char cPhoneNbr[15] = {0};
				char cRecvTime[20] = {0};
				char cSMS_Content[128] = {0};


				GSMprintf("\r\n> Message length:%d", strlen(cContent));

				//GSMprintf("\r\n> SMS content:\r\n%s\r\nSMS content end.", cContent);

				bRes = QtEC21_SMS_Parse(cContent, cPhoneNbr, cRecvTime, cSMS_Content);

				if(bRes)
				{
					GSMprintf("\r\n> Short message sender:%s", cPhoneNbr);

					GSMprintf("\r\n> Short message receiving time:%s", cRecvTime);

					GSMprintf("\r\n> Short message content:\n%s\nShort message end.", cSMS_Content);

					GSM_SMS_Del(u8SMS_ID, 0);
          //QtEC21_SMS_Del(u8SMS_ID, 0);
					
					gsmCmdSrc = GSM_CMD_SRC_SMS;

					GSM_SMS_Proc(cSMS_Content, cPhoneNbr);

					if(g_Setting.tUpgrade.bFOTA_Flag == TRUE)
					{
						sprintf(cCmdPhoneNum, "%s", cPhoneNbr);
					}
				}
				else
				{
					GSMprintf("\r\n> Parse message fail.");

					GSM_SMS_Del(u8SMS_ID, 0);
					//QtEC21_SMS_Del(u8SMS_ID, 0);
				}
			}

			break;
		}

		case GSM_EVENT_RECV_PACKET:
		{
			uint16_t u16RecvDatLen, u16ReadLen;


			//if(gsmCurrNonBlockCmd == QTEC21_TCP_CONN_CLOSE)
			//	break;
			
			HAL_Delay(100);
			
			//GSMprintf("\r\n> Received a TCP/IP data packet.");

			bRes = GSM_TCP_RecvDataLen(u8ConnSrcID, &u16RecvDatLen);
      //bRes = QtEC21_TCP_RecvDataLen(u8ConnSrcID, &u16RecvDatLen);			
			
			if(!bRes)
			{
				GSMprintf("\r\n> Fail to get the number of bytes received from TCP/IP connection.");

				break;
			}

			if(u16RecvDatLen == 0)
			{
				GSMprintf("\r\n> TCP/IP message contains no byte.");

				break;
			}
			
			memset(cContent, 0x00, sizeof(cContent));

			bRes = GSM_TCP_GetRecvData(u8ConnSrcID, (uint8_t *)cContent, u16RecvDatLen, &u16ReadLen);
      //bRes = QtEC21_TCP_GetRecvData(u8ConnSrcID, (uint8_t *)cContent, u16RecvDatLen, &u16ReadLen);
			
			if(!bRes)
			{
				GSMprintf("\r\n> Fail to get the received TCP/IP message.");

				break;
			}

			//cContent[u16ReadLen] = 0;

			GSMprintf("\r\n> GSM get TCP/IP message:\r\n%s\r\n> TCP/IP message end.", cContent);

			if(u8ConnSrcID == u8CurrTCP_Socket[0])
				gsmCmdSrc = GSM_CMD_SRC_TCP_1;
			#if ENABLE_MULTI_SERVER
			else if(u8ConnSrcID == u8CurrTCP_Socket[1])
				gsmCmdSrc = GSM_CMD_SRC_TCP_2;
			#endif

			GSM_TCP_MsgProc(cContent, u8ConnSrcID);

			break;
		}
		
		case GSM_EVENT_CONN_CLOSED:
		{
			if(u8ConnSrcID == u8CurrTCP_Socket[0])
				bTCPIP_Connect[0] = FALSE;
			#if ENABLE_MULTI_SERVER
			if(u8ConnSrcID == u8CurrTCP_Socket[1])
				bTCPIP_Connect[1] = FALSE;
			#endif

			break;
		}
		
		case GSM_EVENT_PDP_DEACT:
		{
			GSM_TCP_DeactivPDP(u8DeactPDP_ID);
			//QtEC21_TCP_DeactivPDP(u8DeactPDP_ID);

			tcp_pdpContext[u8DeactPDP_ID].bActiv = FALSE;

			tcp_pdpContext[u8DeactPDP_ID].bInUse = FALSE;

			if(u8DeactPDP_ID == u8CurrTCP_PDP_ID[0])
			{
				tcpSocket[u8CurrTCP_Socket[0]].bConnect = FALSE;

				bTCPIP_Connect[0] = FALSE;

				u8CurrTCP_PDP_ID[0] = 0;

				u8CurrTCP_Socket[0] = 12;
			}
			#if ENABLE_MULTI_SERVER
			if(u8DeactPDP_ID == u8CurrTCP_PDP_ID[1])
			{
				tcpSocket[u8CurrTCP_Socket[1]].bConnect = FALSE;

				bTCPIP_Connect[1] = FALSE;

				u8CurrTCP_PDP_ID[1] = 0;

				u8CurrTCP_Socket[1] = 12;
			}
			#endif
			else
			{
				bFTP_Connect = FALSE;

				u8CurrFTP_PDP_ID = 0;
			}

			break;
		}
		
		case GSM_EVENT_NO_CARRIER:
		{
			//GSMprintf("\r\n> Call disconnected.");

			break;
		}

		default:
			break;
	}
}

//============================================================================//
// @brief  Handle the GSM data transmission.
// @param  None.
// @retval None.
//============================================================================//
void GSM_TX_Proc(void)
{
	GSM_BlockCmdHandle();
		
	taskInfo[TASK_GSM_TX].u16TaskStep++;
	
	GSM_NonBlockCmdHandle();
}

//============================================================================//
// @brief  Handle the GSM functions at low-level.
// @param  None.
// @retval None.
//============================================================================//
void GSM_LL_Proc(void)
{
	GSM_TX_Proc();
	
	taskInfo[TASK_GSM_RX].u16TaskStep++;
	
	HAL_Delay(1);
	
	GSM_RX_Proc();
}

//============================================================================//
// @brief  Check to directly report an event when an emergency failure occurs.
// @param  None.
// @retval None.
//============================================================================//
void GSM_CheckEmergEvent(void)
{
	bool bRes;
	
	
  if(bSD_ReportErrFlag == TRUE)
	{
		bRes = FALSE;
		
	  if(bTCPIP_Connect[SOCKET_BANK_DEF] == TRUE)
		{
		  bRes = GSM_TCP_SendEVENT_Direct(EVENT_SD_FAIL, STR_NULL, SOCKET_BANK_DEF);
		}
		
		if((bRes == TRUE) || (HAL_GetTick() >= (u32SD_ReportErrLastTick + SD_REPORT_ERR_TIMEOUT)))
		{
			System_Stop();
			
			bSD_ReportErrFlag = FALSE;
			
			bQtEC21_InitFinish = FALSE;
		}
	}
	
	if(bMX25L_ReportErrFlag == TRUE)
	{
		bRes = FALSE;
		
	  if(bTCPIP_Connect[SOCKET_BANK_DEF] == TRUE)
		{
		  bRes = GSM_TCP_SendEVENT_Direct(EVENT_MX25L_FAIL, STR_NULL, SOCKET_BANK_DEF);
		}
		
		if((bRes == TRUE) || (HAL_GetTick() >= (u32MX25L_ReportErrLastTick + MX25L_REPORT_ERR_TIMEOUT)))
		{
			System_Stop();
			
			bMX25L_ReportErrFlag = FALSE;
			
			bQtEC21_InitFinish = FALSE;
			
		  //HW_WriteBackupRegister(MX25L_ERROR_CHK, 0x80);
			
			//if(bRTOS_En)
			//{
			//	osMutexWait(mutex_setting_user, S_2_mS(5));
			//}
			
			//System_Reset();
		}
	}
}

//============================================================================//
// @brief  Process the FTP tasks.
// @param  None.
// @retval None.
//============================================================================//
static void GSM_FTP_Proc(void)
{
	//if((bFTP_StopAccess == FALSE) || 
	//	 (HAL_GetTick() >= (u32FTP_StopLastTick + S_2_mS(STOP_FTP_ACCESS_TIMEOUT))))
	if(FuncSkip_IsEnable(FUNC_GSM_FTP) == FALSE)
	{
		//if(bFTP_StopAccess == TRUE)
		//	bFTP_StopAccess = FALSE;
		
		if(u8FTP_AccessRetryCnt < FTP_ACCESS_RETRY_MAX)
		{
			if((g_Setting.tUpgrade.bFOTA_Flag == TRUE) && (procGSM_FTP_Upload_Step == PROC_STEP_NULL))
			{
				if((bMX25L_ReportErrFlag == FALSE) && (procGSM_FOTA_Step == PROC_STEP_NULL))
				{
					procGSM_FOTA_Step = PROC_STEP_1;
				}
				
				g_Setting.tUpgrade.bFOTA_Flag = FALSE;
				
				System_SaveSetting();
			}
			
			if((u16UnsendFileNum > 0) && (bSD_ReportErrFlag == FALSE) && 
				 (procGSM_FTP_Upload_Step == PROC_STEP_NULL) &&
				 (procGSM_FOTA_Step == PROC_STEP_NULL))
			{
				GSM_FTP_FileUploadInit();
			}
			
			if((bMX25L_ReportErrFlag == FALSE) && 
				 (procGSM_FTP_Upload_Step == PROC_STEP_NULL) && (procGSM_FOTA_Step != PROC_STEP_NULL))
			{
				HAL_Delay(1);
				
				GSM_FOTA_Proc();
			}
			
			if((procGSM_FOTA_Step == PROC_STEP_NULL) && (bSD_ReportErrFlag == FALSE) &&
				 (procGSM_FTP_Upload_Step != PROC_STEP_NULL))
			{
				HAL_Delay(1);
				
				GSM_FTP_Upload_Proc();
			}
		}
		else
		{
			u8FTP_AccessRetryCnt = 0;
			
			g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt++;
			
			if(g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt < FTP_ACCESS_STOP_MAX)
			{
				GSMprintf("\r\n> GSM having issue to access FTP server. Waiting %d seconds before trying again.",
									STOP_FTP_ACCESS_TIMEOUT);

				//u32FTP_StopLastTick = HAL_GetTick();
				
				//bFTP_StopAccess = TRUE;
				
				FuncSkip_Enable(FUNC_GSM_FTP, STOP_FTP_ACCESS_TIMEOUT);
			}
			else
			{
				g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt = 0;
				
				GSMprintf("\r\n> GSM having issue to access FTP server. Reset module QTEC21.");
				
				GSM_Reset();
			}
			
			System_SaveSetting();
		}
	}
}

//============================================================================//
// @brief  Process the TCP resend task.
// @param  None.
// @retval None.
//============================================================================//
static void GSM_TCP_Resend_Proc(void)
{
  bool bRes = FALSE;
	
	
	if(bSD_ReportErrFlag == TRUE)
		return;
	
	#if ENABLE_MULTI_SERVER
	if(GSM_IsAccessFTP() == FALSE)
	{
		bRes = FALSE;
		
		if((bTCPIP_Connect[SOCKET_BANK_DEF] == TRUE) && (bTCPIP_Connect[SOCKET_BANK_EXT] == TRUE))
			bRes = TRUE;
		
		if((bTCPIP_Connect[SOCKET_BANK_DEF] == TRUE) && 
			 (strlen(g_Setting.tGSM_SET.tServerInfo[SOCKET_BANK_EXT].cIP_Addr) < 7) && 
			 (strlen(g_Setting.tGSM_SET.tServerInfo[SOCKET_BANK_EXT].cIP_Addr) > 
				sizeof(g_Setting.tGSM_SET.tServerInfo[SOCKET_BANK_EXT].cIP_Addr)))
			bRes = TRUE;
				
		if((bTCPIP_Connect[SOCKET_BANK_EXT] == TRUE) && 
			 (strlen(g_Setting.tGSM_SET.tServerInfo[SOCKET_BANK_DEF].cIP_Addr) < 7) && 
			 (strlen(g_Setting.tGSM_SET.tServerInfo[SOCKET_BANK_DEF].cIP_Addr) > 
				sizeof(g_Setting.tGSM_SET.tServerInfo[SOCKET_BANK_DEF].cIP_Addr)))
			bRes = TRUE;
	}	
	#else
	if((GSM_IsAccessFTP() == FALSE) && (bTCPIP_Connect[0] == TRUE))
	{
		bRes = TRUE;
	}
	#endif
	
	if(bRes == TRUE)
	{
		if((u16UnsendPkgNum > 0) && (g_Setting.tGSM_SET.tNetSet.u8GSM_CSQ > 7))
		{
			uint8_t u8Dst;
			uint16_t u16PkgLen;
			MsgSendStatusTypeDef smsRes;
			GSM_SocketDataTypeDef gsmTCP_Data;


			uint16_t u16TempPkgIdx = u16UnsendPkgNum;
			
			if(bRTOS_En)
			{
				osStatus osRes;
				
				
				// Acquire GSM_SD synchronization
				osRes = osMutexWait(mutex_gsm_sd_user, S_2_mS(10));

				if(osRes != osOK)
				{
					return;
				}
			}
	
			bRes = GSM_GetTempPkg(u8GSM_TempPkgBuf, &u16PkgLen, &u8Dst);
			
			if(bRTOS_En)
				osMutexRelease(mutex_gsm_sd_user);

			if(bRes)
			{
				//GSMprintf("\r\n> GSM get unsent packet %d OK.", u16TempPkgIdx);

				if(u16PkgLen > 0)
				{
					// If the server has a valid IP address 
					if((strlen(g_Setting.tGSM_SET.tServerInfo[u8Dst].cIP_Addr) >= 7) && 
						 (strlen(g_Setting.tGSM_SET.tServerInfo[u8Dst].cIP_Addr) <= 
							sizeof(g_Setting.tGSM_SET.tServerInfo[u8Dst].cIP_Addr)))
					{
						gsmTCP_Data.SocketNum = u8CurrTCP_Socket[u8Dst];
						gsmTCP_Data.pcData = (char *)u8GSM_TempPkgBuf;
						gsmTCP_Data.u16DataLen = u16PkgLen;

						smsRes = GSM_TCP_Send(&gsmTCP_Data);

						if(smsRes != SEND_OK)
						{
							GSMprintf("\r\n> GSM request to send packet %d to server %d ERROR.\r\n", u16TempPkgIdx, u8Dst);

							bRes = FALSE;

							u8SendLogFailCnt[u8Dst]++;

							if(u8SendLogFailCnt[u8Dst] >= GSM_SEND_LOG_RETRY_MAX)
							{
								u8SendLogFailCnt[u8Dst] = 0;

								bTCPIP_Connect[u8Dst] = FALSE;
							}
						}
						else
						{
							uint16_t u16UnAckBytes;
							uint8_t u8QueryCnt = 0;


							//GSMprintf("\r\n> GSM request to send packet %d to server %d OK.", u16TempPkgIdx, u8Dst);

							while(u8QueryCnt < 5)
							{
								HAL_Delay(1000);
								
								if(bTCPIP_Connect[u8Dst] == FALSE)
								{
									bRes = FALSE;
									
									break;
								}
								
								bRes = GSM_TCP_SendingStatus(u8CurrTCP_Socket[u8Dst], &u16UnAckBytes);
								
								if(bRes)
								{
									if(u16UnAckBytes == 0)
									{
										break;
									}
								}

								u8QueryCnt++;
							}

							//GSMprintf("\r\n> Number of unsent bytes in connection socket %d: %d",
							//          u8CurrTCP_Socket[u8Dst], u16UnAckBytes);

							if(bRes)
							{
								if(u16UnAckBytes > 0)
								{
									//GSMprintf("\r\n> GSM send packet %d to server %d has %d bytes unsent.\r\n",
									//					u16TempPkgIdx, u8Dst, u16UnAckBytes);

									bRes = FALSE;

									u8SendLogFailCnt[u8Dst]++;

									if(u8SendLogFailCnt[u8Dst] >= GSM_SEND_LOG_RETRY_MAX)
									{
										u8SendLogFailCnt[u8Dst] = 0;

										bTCPIP_Connect[u8Dst] = FALSE;
									}
								}
								else
								{
									GSMprintf("\r\n> GSM send packet %d to server %d OK.\r\n", u16TempPkgIdx, u8Dst);
								}
							}
						}
						
						if(bRes == FALSE)
						{
							GSM_SaveTempPkg(u8GSM_TempPkgBuf, u16PkgLen, u8Dst);
						}
					}
				}
				else
				{
					GSMprintf("\r\n GSM unsent packet %d is in wrong format!\r\n", u16TempPkgIdx);
				}
			}
			else
			{
				GSMprintf("\r\n> GSM get unsent packet %d FAIL!\r\n", u16TempPkgIdx);
			}
			
			HAL_Delay(100);
		}
	}
}

//============================================================================//
// @brief  Handling TCP connection.
// @param  None.
// @retval None.
//============================================================================//
static void GSM_TCP_Connection_Handle(void)
{
  //if(EXTIO_IsMainPowerNormal() == TRUE)
	{
		for(int i = 0; i < MAX_SOCKET_BANK; i++)
		{
			// If the server has no valid IP address then ignore
			if((strlen(g_Setting.tGSM_SET.tServerInfo[i].cIP_Addr) < 7) || 
				 (strlen(g_Setting.tGSM_SET.tServerInfo[i].cIP_Addr) > 
			    sizeof(g_Setting.tGSM_SET.tServerInfo[i].cIP_Addr)))
				continue;
			
			//if((bTCP_StopConnect[i] == TRUE) && 
			//	 (HAL_GetTick() < (u32TCP_StopLastTick[i] + S_2_mS(STOP_TCP_CONNECT_TIMEOUT))))
			//	continue;

			//if(bTCP_StopConnect[i] == TRUE)
			//	bTCP_StopConnect[i] = FALSE;
					
			if(i == SOCKET_BANK_DEF)
			{
			  if(FuncSkip_IsEnable(FUNC_GSM_TCP_SERVER_DEF) == TRUE)
					continue;
			}
			else if(i == SOCKET_BANK_EXT)
			{
			  if(FuncSkip_IsEnable(FUNC_GSM_TCP_SERVER_EXT) == TRUE)
					continue;
			}
			
			if((bTCPIP_Connect[i] == FALSE) && (procGSM_TCP_Step[i] == PROC_STEP_NULL))
			{
				if(u8TCP_ConnectRetryCnt[i] < TCP_CONNECT_RETRY_MAX)
				{
					if(u8CurrTCP_Socket[i] != 12)
					{
						//osEvent event;
						bool bRes;


						HAL_Delay(10);
						
						for(int i = 0; i < 2; i++)
						{
						  bRes = GSM_TCP_CloseConn(u8CurrTCP_Socket[i], TCP_CLOSE_CONN_TIMEOUT);
							
							if(bRes)
								break;
						}
					
						//while(1)
						//{
						//	event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(TCP_CLOSE_CONN_TIMEOUT + 5));

						//	if(event.status == osEventMessage)
						//	{
						//		break;
						//	}
						//	else if((event.status == osEventTimeout) || (event.status == osErrorOS))
						//	{
						//		GSMprintf("\r\n> GSM_TCP_CloseConn get event status: %d", event.status);
								
						//		gsmCurrNonBlockCmd = QTEC21_NULL;
								
						//		GSM_Handle_NonBlock_osEventTimeout();
								
						//		break;
						//	}

						//	HAL_Delay(1);
						//}

						tcpSocket[u8CurrTCP_Socket[i]].bConnect = FALSE;

						tcpSocket[u8CurrTCP_Socket[i]].ptcp_pdpHandle->bInUse = FALSE;
					}

					procGSM_TCP_Step[i] = PROC_STEP_1;

					u8TCP_ConnectRetryCnt[i]++;
				}
				else
				{
					u8TCP_ConnectRetryCnt[i] = 0;
					
					g_Setting.tGSM_SET.tGSM_Err.u8TCP_ErrCnt++;
					
					if(g_Setting.tGSM_SET.tGSM_Err.u8TCP_ErrCnt < TCP_CONNECT_STOP_MAX)
					{
						GSMprintf("\r\n> GSM having issue to open TCP/IP connection to server %d. Waiting %d seconds before trying again.",
						          i,
											STOP_TCP_CONNECT_TIMEOUT);

						//u32TCP_StopLastTick[i] = HAL_GetTick();
						
						//bTCP_StopConnect[i] = TRUE;
						
						if(i == SOCKET_BANK_DEF)
						{
						  FuncSkip_Enable(FUNC_GSM_TCP_SERVER_DEF, STOP_TCP_CONNECT_TIMEOUT);
						}
						else
						{
						  FuncSkip_Enable(FUNC_GSM_TCP_SERVER_EXT, STOP_TCP_CONNECT_TIMEOUT);
						}
					}
					else
					{
						g_Setting.tGSM_SET.tGSM_Err.u8TCP_ErrCnt = 0;
						
						GSMprintf("\r\n> GSM having issue to open TCP/IP connection. Reset module QtEC21.");
						
						GSM_Reset();
					}
					
					System_SaveSetting();
				}
			}

			if(procGSM_TCP_Step[i] != PROC_STEP_NULL)
			{
				HAL_Delay(1);
				
				GSM_TCP_Connect_Proc(i);
			}
		}
	}
}

//============================================================================//
// @brief  Process the GSM task.
// @param  None.
// @retval None.
//============================================================================//
void GSM_Task_Proc(void)
{
	//static bool bTCP_StopConnect[MAX_SOCKET_BANK] = {FALSE};
	//static uint32_t u32TCP_StopLastTick[MAX_SOCKET_BANK] = {0};
	//static bool bFTP_StopAccess = FALSE;
	//static uint32_t u32FTP_StopLastTick = 0;
	//bool bRes;
	
	
	if(bQtEC21_State == FALSE)
		return;
	
	GSM_CheckEmergEvent();
	
	taskInfo[TASK_GSM_PROC].u16TaskStep++;
	
	if((bQtEC21_State == FALSE) || (bQtEC21_InitFinish == FALSE))
		return;
	
	//if(strncmp(g_Setting.cJAS_Ver, (char *)JAS208_GSM, 7) == 0)
	{
		if(EXTIO_IsMainPowerNormal() == TRUE)
	  {
		  GSM_FTP_Proc();
			
			taskInfo[TASK_GSM_PROC].u16TaskStep++;
		}
		
		if(u8USB_ReportEvent == 1) // Report event USB connected
		{
			GSM_TCP_ReportEvent((char *)EVENT_USB_CON, STR_NULL);
			
			u8USB_ReportEvent = 0;
		}	
		else if(u8USB_ReportEvent == 2) // Report event USB disconnected
		{
			GSM_TCP_ReportEvent((char *)EVENT_USB_DISCON, STR_NULL);
			
			u8USB_ReportEvent = 0;
		}
		
		taskInfo[TASK_GSM_PROC].u16TaskStep++;
		
		GSM_TCP_Resend_Proc();
	}
	
	taskInfo[TASK_GSM_PROC].u16TaskStep++;
	
	GSM_TCP_Connection_Handle();
}

//============================================================================//
// @brief  Handle the callback of the timer for GSM block requests.
// @param  None.
// @retval None.
//============================================================================//
void GSM_BlockCallBackHandle(void)
{
	bGSMTimeOut = TRUE;
	
	//printf("\r\n> GSM block function timeout!");

	if((qtec21_BlockCmdInstance.qtec21Cmd != QTEC21_FTP_CONFIG_ACC) &&
	        (qtec21_BlockCmdInstance.qtec21Cmd != QTEC21_FIL_OPEN) &&
	        (qtec21_BlockCmdInstance.qtec21Cmd != QTEC21_FIL_SEEK) &&
	        (qtec21_BlockCmdInstance.qtec21Cmd != QTEC21_FIL_READ))
		QtEC21_RetryCheck();
}

//============================================================================//
// @brief  Handle the callback of the timer for GSM non block requests.
// @param  None.
// @retval None.
//============================================================================//
void GSM_NonBlockCallBackHandle(void)
{
	//printf("\r\n> GSM non-block function timeout!");

	switch((uint8_t)gsmCurrNonBlockCmd)
	{
		case QTEC21_SMS_SEND:
		{
			//printf("\r\n> Send short message timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_SEND_NO_RESPONSE, 0);

			QtEC21_RetryCheck();

			break;
		}

		case QTEC21_TCP_CONN_OPEN:
		{
			printf("\r\n> Open TCP/IP connection timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_OPEN_NO_RESPONSE, 0);

			QtEC21_RetryCheck();

			break;
		}

		//case QTEC21_TCP_CONN_CLOSE:
		//{
			//printf("\r\n> Close TCP/IP connection timeout.");

		//	gsmCurrNonBlockCmd = QTEC21_NULL;

		//	qtec21_NonBlockCmdInstance.bInUse = FALSE;

		//	osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_CLOSE_NO_RESPONSE, 0);

		//	QtEC21_RetryCheck();
			
		//	break;
		//}

		case QTEC21_FTP_LOGIN:
		{
			//printf("\r\n> Login FTP server timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_LOGIN_NO_RESPONSE, 0);
			
			//gsmFTP_LoginRes = GSM_EVENT_LOGIN_NO_RESPONSE;

			QtEC21_RetryCheck();

			break;
		}

		case QTEC21_FTP_SET_DIR:
		{
			//printf("\r\n> Set working directory on FTP server timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_SETDIR_NO_RESPONSE, 0);

			QtEC21_RetryCheck();

			break;
		}
		
		case QTEC21_FTP_UPLOAD:
		case QTEC21_FTP_UPLOAD_DIRECT:
		{
			printf("\r\n> Upload file to FTP server timeout.");

			//gsmCurrNonBlockCmd = QTEC21_NULL;

			//qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_UPLOAD_NO_RESPONSE, 0);
			
			gsmFTP_UploadRes = GSM_EVENT_UPLOAD_NO_RESPONSE;

			QtEC21_RetryCheck();

			break;
		}

		case QTEC21_FTP_DOWNLOAD:
		{
			printf("\r\n> Download file from FTP server timeout.");

			//gsmCurrNonBlockCmd = QTEC21_NULL;

			//qtec21_NonBlockCmdInstance.bInUse = FALSE;

			//osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_DOWNLOAD_NO_RESPONSE, 0);
			
			gsmFTP_DownloadRes = GSM_EVENT_DOWNLOAD_NO_RESPONSE;

			QtEC21_RetryCheck();

			break;
		}

		case QTEC21_FTP_FILE_SIZE:
		{
			//printf("\r\n> Get file size from FTP server timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_GETSIZE_NO_RESPONSE, 0);

			QtEC21_RetryCheck();

			break;
		}

		case QTEC21_FTP_FILE_DATE:
		{
			//printf("\r\n> Get file last modification date from FTP server timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_GETDATE_NO_RESPONSE, 0);

			QtEC21_RetryCheck();

			break;
		}

		case QTEC21_FTP_TRANS_LEN:
		{
			//printf("\r\n> Get number of bytes transferred from FTP server timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_TRANSLEN_NO_RESPONSE, 0);

			QtEC21_RetryCheck();

			break;
		}
		
		case QTEC21_FTP_FILE_DEL:
		{
			//printf("\r\n> Delete file in FTP server timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_FILEDEL_NO_RESPONSE, 0);

			QtEC21_RetryCheck();

			break;
		}

		case QTEC21_FTP_LOGOUT:
		{
			//printf("\r\n> Log out from FTP server timeout.");

			gsmCurrNonBlockCmd = QTEC21_NULL;

			qtec21_NonBlockCmdInstance.bInUse = FALSE;

			osMessagePut(GSM_NonBlockCompleteHandle, GSM_EVENT_LOGOUT_NO_RESPONSE, 0);

			QtEC21_RetryCheck();

			break;
		}

		default:
			break;
	}
}

//============================================================================//
// @brief  Handle the TCP/IP connecting process.
// @param  u8ConnDst: Destination code. 0: Connect to server 0.
//                                      1: Connect to server 1.
// @retval Result in TCP_StatusTypeDef format.
//============================================================================//
TCP_StatusTypeDef GSM_TCP_Connect_Proc(uint8_t u8ConnDst)
{
	TCP_StatusTypeDef tcpRes = TCP_OK;
	bool bRes = FALSE;
	static uint32_t u32QueryCS_LastTick[2] = {0}, u32QueryPS_LastTick[2] = {0};


	if(procGSM_TCP_Step[u8ConnDst] == PROC_STEP_NULL)
		return TCP_OK;

	switch((int)(procGSM_TCP_Step[u8ConnDst]))
	{
		// Step 1: Find PDP context slot and socket slot
		case PROC_STEP_1:
		{
			uint8_t u8PDP_ID = 0, u8SocketID = 12;


			bTCPIP_Connect[u8ConnDst] = FALSE;

			// Find an available PDP context IP
			for(int i = 1; i < 17; i++)
			{
				if(tcp_pdpContext[i].bInUse == FALSE)
				{
					u8PDP_ID = i;

					break;
				}
			}

			// If there is no PDP context ID is available then return
			if(u8PDP_ID == 0)
			{
				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_NO_PDP;

				//u8TCP_ConnectRetryCn[u8ConnDst]t++;

				break;
			}

			// Find an available socket ID
			for(int i = 0; i < 12; i++)
			{
				if(tcpSocket[i].bConnect == FALSE)
				{
					u8SocketID = i;

					break;
				}
			}

			// If there is no socket ID is available then return
			if(u8SocketID == 12)
			{
				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_NO_SOCKET;

				break;
			}

			u8TCP_PDP_ID[u8ConnDst] = u8PDP_ID;

			u8TCP_SocketID[u8ConnDst] = u8SocketID;

			if(tcp_pdpContext[u8PDP_ID].bActiv == TRUE)
				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_8;
			else
				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_2;

			tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = TRUE;

			tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = TRUE;

			tcpRes = TCP_OK;

			break;
		}

		// Step 2: Query USIM
		case PROC_STEP_2:
		{
			// Query USIM status
			bRes = GSM_SIM_QueryUSIM();

			// Reset QtEC21 module if failed to query USIM status
			if(bRes == TRUE)
			{
			  if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt > 0)
				{
				  g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
					
					System_SaveSetting();
				}
			}
			else
			{
				tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

				tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_NO_USIM;
				
				g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt++;
				
				//GSMprintf("\r\n> GSM SIM Error: %d", g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt);
					
				if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt >= 3)
				{
				  g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
					
				  bQtEC21_State = FALSE;
						
				  RTOSprintf("\r\n> GSM SIM ERROR! Maximum QTEC21 reset reached. Stop GSM functions!");

				  LCD_SetShowAutoTestPage(51);
				}
				else
				{
				  RTOSprintf("\r\n> GSM SIM ERROR! Reset QTEC21 module.");
					
					HAL_Delay(S_2_mS(1));
				
				  GSM_ResetWithCheckFTP();
				}
				
				System_SaveSetting();

				break;
			}

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_3;

			tcpRes = TCP_OK;
			
			u32QueryCS_LastTick[u8ConnDst] = HAL_GetTick();

			break;
		}

		// Step 3: Query CS service
		case PROC_STEP_3:
		{
			if(HAL_GetTick() < (u32QueryCS_LastTick[u8ConnDst] + S_2_mS(GSM_CREG_QUERY_TIMEOUT)))
			{
				//GSMprintf("\r\n> Socket %d query CS", u8ConnDst);
				
			  // Query CS service
			  bRes = GSM_Net_QueryCS();
				
				if(!bRes)
				{
					GSMprintf("\r\n> Socket %d query CS again", u8ConnDst);
					
				  procGSM_TCP_Step[u8ConnDst] = PROC_STEP_3;

					tcpRes = TCP_OK;

					break;
				}
			}
			else
			{
				GSMprintf("\r\n> GSM Query CS ERROR! Reset QTEC21 module.");
				
			  GSM_ResetWithCheckFTP();

				tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

				tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_NO_CS;

				break;
			}
			
			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_4;

			tcpRes = TCP_OK;
			
			u32QueryPS_LastTick[u8ConnDst] = HAL_GetTick();

			break;
			
			/*
			// Query CS service
			bRes = GSM_Net_QueryCS();

			// Reset module if failed to query CS service
			if(!bRes)
			{
				GSM_ResetWithCheckFTP();

				tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

				tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_NO_CS;

				break;
			}

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_4;

			tcpRes = TCP_OK;

			break;
			*/
		}

		// Step 4: Query PS service
		case PROC_STEP_4:
		{
			if(HAL_GetTick() < (u32QueryPS_LastTick[u8ConnDst] + S_2_mS(GSM_CGREG_QUERY_TIMEOUT)))
			{
				//GSMprintf("\r\n> Socket %d query PS", u8ConnDst);
				
			  // Query PS service
			  bRes = GSM_PD_QueryPS();
				
				if(!bRes)
				{
					GSMprintf("\r\n> Socket %d query PS again", u8ConnDst);
					
				  procGSM_TCP_Step[u8ConnDst] = PROC_STEP_4;

					tcpRes = TCP_OK;

					break;
				}
			}
			else
			{
				g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt++;
				
				System_SaveSetting();
				
				//GSMprintf("\r\n> GSM Query PS Error: %d", g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt);
					
				if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt >= 3)
				{
					g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
					
					System_SaveSetting();
					
					bQtEC21_State = FALSE;
						
					GSMprintf("\r\n> GSM Query PS ERROR! Maximum QTEC21 reset reached. Stop GSM function!");

					LCD_SetShowAutoTestPage(51);
					
					tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

					tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

					procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

					return TCP_NO_PS;
				}
				else
				{
					GSMprintf("\r\n> GSM Query PS ERROR! Reset QTEC21 module.");
				
					GSM_ResetWithCheckFTP();

					procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

					tcpRes = TCP_NO_PS;
				}
			
				break;
			}
				
			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_5;

			tcpRes = TCP_OK;

			break;
			
			/*
			bRes = GSM_PD_QueryPS();
			
			if(bRes)
			{
				if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt > 0)
				{
					g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
					
					System_SaveSetting();
				}
				
			  // If the current version is JAS208S then change it to JAS208U
				//if(strncmp(g_Setting.cJAS_Ver, (char *)JAS208_NO_GSM, 7) == 0)
				{
					GSMprintf("\r\n> GSM network register OK, change to version JAS208U.");

					memset(g_Setting.cJAS_Ver, 0x00, sizeof(g_Setting.cJAS_Ver));

					sprintf(g_Setting.cJAS_Ver, "%s", JAS208_GSM);

					System_SaveSetting();
					
					GSM_CheckTempFile();
				}
			}
			else
			{
				//if(strncmp(g_Setting.cJAS_Ver, (char *)JAS208_GSM, 7) == 0)
				//{
				//	g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt++;
					
				//	GSMprintf("\r\n> Number of failed PS register: %d", g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt);
					
				//	System_SaveSetting();
					
				//	if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt >= 3)
				//	{
				//		g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
						
				//		GSMprintf("\r\n> GSM network register locked, change to version JAS208S.");

				//		memset(g_Setting.cJAS_Ver, 0x00, sizeof(g_Setting.cJAS_Ver));

				//		sprintf(g_Setting.cJAS_Ver, "%s", JAS208_NO_GSM);

				//		System_SaveSetting();
				//	}
			  //}
				
				GSM_ResetWithCheckFTP();
				
				tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

				tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_NO_PS;

				break;
			}

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_5;

			tcpRes = TCP_OK;

			break;
			*/
		}

		// Step 5: Config the selected PDP context
		case PROC_STEP_5:
		{
			// Config PDP context
			bRes = GSM_TCP_ConfigPDP(u8TCP_PDP_ID[u8ConnDst], 
			                         (char *)(g_Setting.tGSM_SET.tNetSet.cAPN),
															 (char *)TCP_USER_NAME, 
															 (char *)TCP_USER_PW);

			// If failed to config the PDP context then return
			if(!bRes)
			{
				tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

				tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_PDP_CONFIG_ERR;

				break;
			}

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_6;

			tcpRes = TCP_OK;

			break;
		}

		// Step 6: Activate PDP context
		case PROC_STEP_6:
		{
			HAL_Delay(10);
			
			bRes = GSM_TCP_ActivPDP(u8TCP_PDP_ID[u8ConnDst]);

			// If timeout and the PDP context is still not activated then reset
			// the module and return
			if(bGSMTimeOut)
			{
				GSM_ResetWithCheckFTP();

				tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

				tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_PDP_ACTV_ERR;

				break;
			}

			if(!bRes)
			{
				u8TCP_RetryCnt[u8ConnDst]++;

				if(u8TCP_RetryCnt[u8ConnDst] >= TCP_PDP_ACTIV_RETRY_MAX)
				{
					u8TCP_RetryCnt[u8ConnDst] = 0;

					GSMprintf("\r\n> Maximum PDP activation retries reached. Terminate the current operation.");

					GSM_ResetWithCheckFTP();

					tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

					tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

					procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

					tcpRes = TCP_PDP_ACTV_ERR;

					break;
				}

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_6;

				tcpRes = TCP_PDP_ACTV_ERR;

				break;
			}

			tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bActiv = TRUE;

			u8TCP_RetryCnt[u8ConnDst] = 0;

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_8;

			tcpRes = TCP_OK;

			break;
		}

		// Step 7: Get the assigned IP for the PDP context
		case PROC_STEP_7:
		{
			char cPDP_IP[20];


			bRes = GSM_TCP_GetIP(u8TCP_PDP_ID[u8ConnDst], cPDP_IP);

			// If timeout and still not get the IP then reset the module
			if(bGSMTimeOut)
			{
				tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bActiv = FALSE;

				GSM_ResetWithCheckFTP();

				tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

				tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

				tcpRes = TCP_PDP_IP_QUERY_ERR;

				break;
			}

			// If failed to get the IP then deactivate the PDP context
			if(!bRes)
			{
				u8TCP_RetryCnt[u8ConnDst]++;

				if(u8TCP_RetryCnt[u8ConnDst] >= TCP_PDP_ACTIV_RETRY_MAX)
				{
					u8TCP_RetryCnt[u8ConnDst] = 0;

					GSMprintf("\r\n> Maximum PDP ID query retries reached. Deactivate the PDP context and terminate the current operation.");

					procGSM_TCP_Step[u8ConnDst] = PROC_STEP_9;

					tcpRes = TCP_PDP_IP_QUERY_ERR;

					break;
				}

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_7;

				tcpRes = TCP_PDP_IP_QUERY_ERR;

				break;
			}

			memset(tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].cIP_Addr, 0x00,
						 sizeof(tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].cIP_Addr));

			// Save the assigned IP
			strcpy(tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].cIP_Addr, cPDP_IP);

			u8TCP_RetryCnt[u8ConnDst] = 0;

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_8;

			tcpRes = TCP_OK;

			break;
		}

		// Step 8: Open the TCP/IP connection
		case PROC_STEP_8:
		{
			GSM_SocketConnTypeDef gsmConnHandle;
			osEvent event;

			
			memset(gsmConnHandle.cServType, 0x00, sizeof(gsmConnHandle.cServType));
			memset(gsmConnHandle.cRemoteAddr, 0x00, sizeof(gsmConnHandle.cRemoteAddr));

			sprintf(gsmConnHandle.cServType, "%s",  (char *)TCP_SERVICE_TYPE);
			sprintf(gsmConnHandle.cRemoteAddr, "%s", g_Setting.tGSM_SET.tServerInfo[u8ConnDst].cIP_Addr);
			gsmConnHandle.u16LocalPort = (uint16_t)TCP_LOCAL_PORT;
			gsmConnHandle.u16RemotePort = g_Setting.tGSM_SET.tServerInfo[u8ConnDst].u16Port;
			gsmConnHandle.u8ConnMode = 0;
			
			HAL_Delay(10);

			GSM_TCP_OpenConn(u8TCP_PDP_ID[u8ConnDst], u8TCP_SocketID[u8ConnDst], &gsmConnHandle);

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(TCP_OPEN_CONN_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_OPEN_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_OPEN_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_OPEN_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

			      tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

						procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;
						
						return TCP_OPEN_ERR;
					}
				}
				// If no response then deactivate the PDP context and terminate the operation
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_TCP_OpenConn get event status: %d", event.status);
								
				  GSM_Handle_NonBlock_osEventTimeout();
					
					procGSM_TCP_Step[u8ConnDst] = PROC_STEP_9;

					return TCP_OPEN_ERR;
				}
			}

			if(!bRes)
			{
				u8TCP_RetryCnt[u8ConnDst]++;
				
				HAL_Delay(10);

			  for(int i = 0; i < 2; i++)
			  {
				  bRes = GSM_TCP_CloseConn(u8TCP_SocketID[u8ConnDst], TCP_CLOSE_CONN_TIMEOUT);
					
					if(bRes)
						break;
				}

				//while(1)
				//{
				//	event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(TCP_CLOSE_CONN_TIMEOUT + 5));

				//	if(event.status == osEventMessage)
				//	{
				//		break;
				//	}
				//	else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				//	{
				//		gsmCurrNonBlockCmd = QTEC21_NULL;
						
				//		break;
				//	}

				//	HAL_Delay(1);
				//}

				if(u8TCP_RetryCnt[u8ConnDst] >= TCP_OPEN_CONN_RETRY_MAX)
				{
					u8TCP_RetryCnt[u8ConnDst] = 0;

					procGSM_TCP_Step[u8ConnDst] = PROC_STEP_9;

					tcpRes = TCP_OPEN_ERR;

					break;
				}

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_8;

				tcpRes = TCP_OPEN_ERR;

				break;
			}
			
			uint8_t u8PDP_ID = u8TCP_PDP_ID[u8ConnDst];
			
			uint8_t u8SocID = u8TCP_SocketID[u8ConnDst];
			
			//tcp_pdpContext[u8PDP_ID].bInUse = TRUE;

			strcpy(cCurrIP[u8ConnDst],tcp_pdpContext[u8PDP_ID].cIP_Addr);

			//tcpSocket[u8SocID].bConnect = TRUE;

			tcpSocket[u8SocID].ptcp_pdpHandle = &tcp_pdpContext[u8PDP_ID];

			u8CurrTCP_PDP_ID[u8ConnDst] = u8PDP_ID;

			u8CurrTCP_Socket[u8ConnDst] = u8SocID;

			//GSMprintf("\r\n> Open TCP/IP connection successfully.");
			
			GSMprintf("\r\n> Connection PDP context ID:%d", u8PDP_ID);

			GSMprintf("\r\n> Connection socket ID:%d", u8SocID);

			u8TCP_RetryCnt[u8ConnDst] = 0;

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_10;

			tcpRes = TCP_OK;

			break;
		}

		// Step 9: Deactivate the PDP context
		case PROC_STEP_9:
		{
			HAL_Delay(10);
			
			bRes = GSM_TCP_DeactivPDP(u8TCP_PDP_ID[u8ConnDst]);

			if(!bRes)
			{
				// If failed to deactivate the PDP context due to timeout then reset
				// the module
				if(bGSMTimeOut)
				{
					GSM_ResetWithCheckFTP();
				}

				tcpRes = TCP_PDP_DEACTV_ERR;
			}
			else
			{
				tcpRes = TCP_OK;
			}

			tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bActiv = FALSE;

			tcp_pdpContext[u8TCP_PDP_ID[u8ConnDst]].bInUse = FALSE;

			tcpSocket[u8TCP_SocketID[u8ConnDst]].bConnect = FALSE;

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

			break;
		}

		case PROC_STEP_10:
		{
			MsgSendStatusTypeDef gsmRes;


			HAL_Delay(10);
			
			if(g_Setting.tGSM_SET.tServerInfo[u8ConnDst].bEnableChk == TRUE)
			{
        gsmRes = GSM_TCP_SendCHK(u8ConnDst);
			}
			else
			{
				if(strlen(g_Setting.tGSM_SET.tMobileInfo.cIMEI) != 15)
				{
					bRes = GSM_GetIMEI(g_Setting.tGSM_SET.tMobileInfo.cIMEI);
					
					System_SaveSetting();
				}
				
				if(strlen(g_Setting.tGSM_SET.tMobileInfo.cIMSI) != 15)
				{
					bRes = GSM_GetIMSI(g_Setting.tGSM_SET.tMobileInfo.cIMSI);
					
					System_SaveSetting();
				}
				
			  gsmRes = SEND_OK;
			}
			
			//if(strncmp(g_Setting.tGSM_SET.tServerInfo[u8ConnDst].cADDR,
			//	         (char *)SERVER_GOV_IP_ADDR,
			//					 strlen((char *)SERVER_GOV_IP_ADDR)) 
			//	 == 0) 
			//{
			//  gsmRes = SEND_OK;
			//}
		  //else
			//{
			//  gsmRes = GSM_TCP_SendCHK(u8ConnDst);
			//}
			  
			if(gsmRes != SEND_OK)
			{
				u8TCP_RetryCnt[u8ConnDst]++;

				if(u8TCP_RetryCnt[u8ConnDst] == 3)
				{
					u8TCP_RetryCnt[u8ConnDst] = 0;

					GSMprintf("\r\n> Maximum CHK sending retries reached. Terminate the current operation.");

					bTCPIP_Connect[u8ConnDst] = FALSE;

					procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

					tcpRes = TCP_SEND_ERR;

					break;
				}

				procGSM_TCP_Step[u8ConnDst] = PROC_STEP_10;

				tcpRes = TCP_SEND_ERR;

				break;
			}

			bTCPIP_Connect[u8ConnDst] = TRUE;
			
			if(g_Setting.tGSM_SET.tGSM_Err.u8TCP_ErrCnt > 0)
			{
				g_Setting.tGSM_SET.tGSM_Err.u8TCP_ErrCnt = 0;
				
				System_SaveSetting();
			}

			u8TCP_RetryCnt[u8ConnDst] = 0;
			
			bGSM_DatalogBegin = TRUE;

			procGSM_TCP_Step[u8ConnDst] = PROC_STEP_NULL;

			tcpRes = TCP_OK;

			break;
		}

		default:
			tcpRes = TCP_OK;

			break;
	}

	return tcpRes;
}

//============================================================================//
// @brief  Handle firmware upgrade through FTP.
// @param  None.
// @retval Result in TCP_StatusTypeDef.
//============================================================================//
TCP_StatusTypeDef GSM_FOTA_Proc(void)
{
	TCP_StatusTypeDef tcpRes;
	bool bRes;
	static GSM_FTP_ResTypeDef ftpRes;
	const uint32_t u32ExFlashTempAddr = (uint32_t)EXFLASH_TEMP_START_ADDR;
	static uint32_t u32FileID;
	static uint32_t u32FileSize, u32DatCnt, u32DatSize;
	static uint16_t u16CRC16_Check, u16CRC16_Cal = 0;
	static bool bFTP_DownloadWaiting = FALSE;
	static uint32_t u32QueryCS_LastTick = 0, u32QueryPS_LastTick = 0;
	//static uint32_t u32StartTime = 0, u32EndTime = 0;


	if(procGSM_FOTA_Step == PROC_STEP_NULL)
		return TCP_OK;

	switch((int)procGSM_FOTA_Step)
	{
		// Step 1: Find a PDP context
		case PROC_STEP_1:
		{
			//u32StartTime = HAL_GetTick();
			
			ftpRes = GSM_FTP_OK;
			
			u8FTP_PDP_ID = 0;
			
			// Find an available PDP context IP
			for(int i = 1; i < 17; i++)
				if(tcp_pdpContext[i].bInUse == FALSE)
				{
					u8FTP_PDP_ID = i;

					break;
				}

			// If there is no PDP context ID is available then retry
			if(u8FTP_PDP_ID == 0)
			{
				tcpRes = TCP_NO_PDP;
				
				ftpRes = GSM_FTP_NET_ERR;

				procGSM_FOTA_Step = PROC_STEP_28;

				return tcpRes;
			}

			//u8CurrFTP_PDP_ID = u8FTP_PDP_ID;
			
			tcp_pdpContext[u8FTP_PDP_ID].bInUse = TRUE;

			//GSMprintf("\r\n> Selected PDP context: %d", u8FTP_PDP_ID);

			if(tcp_pdpContext[u8FTP_PDP_ID].bActiv == TRUE)
				procGSM_FOTA_Step = PROC_STEP_7;
			else
			{
				procGSM_FOTA_Step = PROC_STEP_2;
				
				u32QueryCS_LastTick = HAL_GetTick();
			}

			tcpRes = TCP_OK;

			break;
		}

		// Step 2: Check CS service
		case PROC_STEP_2:
		{
			if(HAL_GetTick() < (u32QueryCS_LastTick + S_2_mS(GSM_CREG_QUERY_TIMEOUT)))
			{
			  bRes = GSM_Net_QueryCS();
				
				if(!bRes)
				{
				  tcpRes = TCP_OK;

					procGSM_FOTA_Step = PROC_STEP_2;

					break;
				}
			}
			else
			{
				GSMprintf("\r\n> GSM Query CS ERROR! Reset QTEC21 module.");
				
				GSM_Reset();

				tcpRes = TCP_NO_CS;
				
				if(bGSMTimeOut)
        {
				  ftpRes = GSM_FTP_OTHER_ERR;
				}
				else
				{
				  ftpRes = GSM_FTP_NET_ERR;
        }
				
				procGSM_FOTA_Step = PROC_STEP_28;
				
				return tcpRes;
			}
			
			tcpRes = TCP_OK;

			procGSM_FOTA_Step = PROC_STEP_3;
			
			u32QueryPS_LastTick = HAL_GetTick();

			break;
			
			/*
			bRes = GSM_Net_QueryCS();

			if(!bRes)
			{
				GSM_Reset();

				tcpRes = TCP_NO_CS;

				procGSM_FOTA_Step = PROC_STEP_NULL;

				return tcpRes;
			}

			tcpRes = TCP_OK;

			procGSM_FOTA_Step = PROC_STEP_3;

			break;
			*/
		}

		// Step 3: Check PS service
		case PROC_STEP_3:
		{
			if(HAL_GetTick() < (u32QueryPS_LastTick + S_2_mS(GSM_CGREG_QUERY_TIMEOUT)))
			{
				bRes = GSM_PD_QueryPS();
				
				if(!bRes)
				{
					tcpRes = TCP_OK;

					procGSM_FOTA_Step = PROC_STEP_3;

					break;
				}
			}
			else
			{
				g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt++;
				
				System_SaveSetting();
				
				//GSMprintf("\r\n> GSM Query PS Error: %d", g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt);
					
				if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt >= 3)
				{
					g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
					
					System_SaveSetting();
					
					bQtEC21_State = FALSE;
						
					GSMprintf("\r\n> GSM Query PS ERROR! Maximum QTEC21 reset reached. Stop GSM function!");

					LCD_SetShowAutoTestPage(51);
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_OTHER_ERR;

				  procGSM_FOTA_Step = PROC_STEP_28;

					return TCP_NO_PS;
				}
				else
				{
					GSMprintf("\r\n> GSM Query PS ERROR! Reset QTEC21 module.");
				
					GSM_Reset();
					
					ftpRes = GSM_FTP_NET_ERR;

					procGSM_FOTA_Step = PROC_STEP_28;

					tcpRes = TCP_NO_PS;
				}
			
				break;
			}
			
			tcpRes = TCP_OK;

			procGSM_FOTA_Step = PROC_STEP_4;

			break;
			
			/*
			bRes = GSM_PD_QueryPS();
			
			if(bRes)
			{
				if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt > 0)
				{
					g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
					
					System_SaveSetting();
				}
				
			  // If the current version is JAS208S then change it to JAS208U
				//if(strncmp(g_Setting.cJAS_Ver, (char *)JAS208_NO_GSM, 7) == 0)
				{
					GSMprintf("\r\n> GSM network register OK, change to version JAS208U.");

					memset(g_Setting.cJAS_Ver, 0x00, sizeof(g_Setting.cJAS_Ver));

					sprintf(g_Setting.cJAS_Ver, "%s", (char *)JAS208_GSM);

					System_SaveSetting();
					
					GSM_CheckTempFile();
				}
			}
			else
			{
				GSM_Reset();

				tcpRes = TCP_NO_PS;
				
				tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
				
				ftpRes = GSM_FTP_NET_ERR;

				procGSM_FOTA_Step = PROC_STEP_28;

				return tcpRes;
			}

			tcpRes = TCP_OK;

			procGSM_FOTA_Step = PROC_STEP_4;

			break;
			*/
		}

		// Step 4: Configure PDP context
		case PROC_STEP_4:
		{
			if(tcp_pdpContext[u8FTP_PDP_ID].bActiv == TRUE)
			{
				procGSM_FOTA_Step = PROC_STEP_7;

				return TCP_OK;
			}

			HAL_Delay(10);

			// Config PDP context
			bRes = GSM_TCP_ConfigPDP(u8FTP_PDP_ID, 
			                         (char *)(g_Setting.tGSM_SET.tNetSet.cAPN), 
				                       (char *)TCP_USER_NAME, 
															 (char *)TCP_USER_PW);

			if(!bRes)
			{
				tcpRes = TCP_PDP_CONFIG_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_OTHER_ERR;
					
					procGSM_FOTA_Step = PROC_STEP_28;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_4;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FOTA_Step = PROC_STEP_5;

			tcpRes = TCP_OK;

			break;
		}

		// Step 5: Activate PDP context
		case PROC_STEP_5:
		{
			HAL_Delay(10);

			// Activate PDP context
			bRes = GSM_TCP_ActivPDP(u8FTP_PDP_ID);

			if(!bRes)
			{
				if(bGSMTimeOut)
				{
					u8FTP_RetryCnt = 0;

					GSM_Reset();

					tcpRes = TCP_PDP_ACTV_ERR;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FOTA_Step = PROC_STEP_28;

					return tcpRes;
				}
				else
				{
					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;

						GSM_Reset();

						tcpRes = TCP_PDP_ACTV_ERR;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_NET_ERR;
						
						GSMprintf("\r\n> FOTA - activate PDP context FAIL. Terminate the operation.");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);

						procGSM_FOTA_Step = PROC_STEP_28;

						return tcpRes;
					}

					tcpRes = TCP_PDP_ACTV_ERR;
					
					GSMprintf("\r\n> FOTA - retry activate PDP context after 15 secs");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FOTA_Step = PROC_STEP_5;

					return tcpRes;
				}
			}

			u8FTP_RetryCnt = 0;

			tcp_pdpContext[u8FTP_PDP_ID].bActiv = TRUE;

			tcpRes = TCP_OK;

			procGSM_FOTA_Step = PROC_STEP_6;

			break;
		}

		// Step 6: Query PDP context activation status
		case PROC_STEP_6:
		{
			/*
			HAL_Delay(10);

			// Query PDP context activation status
			bRes = GSM_TCP_GetIP(u8FTP_PDP_ID, cFTP_IP_Addr);

			if(!bRes)
			{
				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					GSM_Reset();

					tcpRes = TCP_PDP_ACTV_ERR;

					procGSM_FOTA_Step = PROC_STEP_7;

					return tcpRes;
				}

				tcpRes = TCP_PDP_ACTV_ERR;
				
				GSMprintf("\r\n> FOTA - retry query PDP status after 10 secs");
				
				FuncSkip_Enable(FUNC_GSM_FTP, 10);

				procGSM_FOTA_Step = PROC_STEP_6;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;
			*/

			tcpRes = TCP_OK;

			procGSM_FOTA_Step = PROC_STEP_7;

			break;
		}

		// Step 7: Configure the PDP context ID for FTP
		case PROC_STEP_7:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_CfgPDP(u8FTP_PDP_ID);

			if(!bRes)
			{
				tcpRes = TCP_FTP_PDP_CONFIG_ERR;

				u8FTP_RetryCnt++;
				
				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FOTA_Step = PROC_STEP_19;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_7;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FOTA_Step = PROC_STEP_8;

			tcpRes = TCP_OK;

			break;
		}

		// Step 8: Configure FTP server account
		case PROC_STEP_8:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_CfgAcc(g_Setting.tGSM_SET.tFTP_Set.cUserName, 
			                      g_Setting.tGSM_SET.tFTP_Set.cPassword);

			if(!bRes)
			{
				tcpRes = TCP_FTP_ACC_CONFIG_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					//if(u8FTP_RetryCnt == 3)
				{
					u8FTP_RetryCnt = 0;
					
					//tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					//ftpRes = GSM_FTP_OTHER_ERR;

					//procGSM_FOTA_Step = PROC_STEP_19;

					procGSM_FOTA_Step = PROC_STEP_9;

					//GSM_Reset();

					return tcpRes;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_8;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FOTA_Step = PROC_STEP_9;

			tcpRes = TCP_OK;

			break;
		}

		// Step 9: Configure FTP file type
		case PROC_STEP_9:
		{
			/*
			HAL_Delay(10);

			bRes = GSM_FTP_CfgFileType();

			if(!bRes)
			{
				tcpRes = TCP_FTP_FILETYPE_CONFIG_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			
			    tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FOTA_Step = PROC_STEP_19;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_9;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;
			*/

			procGSM_FOTA_Step = PROC_STEP_10;

			tcpRes = TCP_OK;

			break;
		}

		// Step 10: Configure FTP transfer mode
		case PROC_STEP_10:
		{
			/*
			HAL_Delay(10);

			bRes = GSM_FTP_CfgTransMode();

			if(!bRes)
			{
				tcpRes = TCP_FTP_TRANSMODE_CONFIG_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			    
			    tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FOTA_Step = PROC_STEP_19;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_10;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;
			*/

			procGSM_FOTA_Step = PROC_STEP_11;

			tcpRes = TCP_OK;

			break;
		}

		// Step 11: Configure FTP timeout
		case PROC_STEP_11:
		{
			
			HAL_Delay(10);

			bRes = GSM_FTP_CfgTimeout((uint16_t)FTP_FUNCTION_TIMEOUT);

			if(!bRes)
			{
				tcpRes = TCP_FTP_TIMEOUT_CONFIG_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
			  
			    tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					//procGSM_FOTA_Step = PROC_STEP_19;
					procGSM_FOTA_Step = PROC_STEP_12;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_11;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;
			
			
			//bGSM_FTP_LoginWaiting = FALSE;

			procGSM_FOTA_Step = PROC_STEP_12;

			tcpRes = TCP_OK;

			break;
		}

		// Step 12: Login FTP server
		case PROC_STEP_12:
		{
			/*
			static uint32_t u32Open_WaitStartTime = 0;
			
			
			if(bFTP_Connect == TRUE)
			{
			  procGSM_FOTA_Step = PROC_STEP_13;

				tcpRes = TCP_OK;

				return tcpRes;
			}
				
			if(bGSM_FTP_LoginWaiting == FALSE)
			{
				bGSM_FTP_LoginWaiting = TRUE;
				
				HAL_Delay(10);
				
				gsmFTP_LoginRes = GSM_EVENT_NULL;
				
				bRes = GSM_FTP_Login((char *)FTP_SERVER_DOMAIN_NAME, (uint16_t)FTP_SERVER_PORT);

				if(!bRes)
				{
					tcpRes = TCP_FTP_LOGIN_ERR;

					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						GSMprintf("\r\n> Open connection to FTP server reached maximum number of retries. Terminate the current operation.");

						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FOTA_Step = PROC_STEP_19;
					}
					else
					{
					  procGSM_FOTA_Step = PROC_STEP_12;
					}

					return tcpRes;
				}
				
				u8FTP_RetryCnt = 0;
				
				bGSM_FTP_LoginWaiting = TRUE;
				
				procGSM_FOTA_Step = PROC_STEP_12;
				
				u32Open_WaitStartTime = HAL_GetTick();

				tcpRes = TCP_OK;

				break;
			}
      else
      {
				bool bRes = FALSE;
				
				
				if(gsmFTP_LoginRes == GSM_EVENT_NULL)
				{
					if(HAL_GetTick() > (u32Open_WaitStartTime + S_2_mS(FTP_FUNCTION_TIMEOUT + 10)))
					{
						bRes = FALSE;
					}	
					else
					{
						procGSM_FOTA_Step = PROC_STEP_12;

					  tcpRes = TCP_OK;
						
					  break;
					}	
				}
			  else if(gsmFTP_LoginRes == GSM_EVENT_LOGIN_SUCCESS)
				{
				  bRes = TRUE;
				}
				else
				{
				  bRes = FALSE;
				}
				
				if(bRes == FALSE)
				{
					tcpRes = TCP_FTP_LOGIN_ERR;

					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_NET_ERR;
						
						GSMprintf("\r\n> FOTA - login FAIL, deactivate PDP context after 15 secs");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);

						procGSM_FOTA_Step = PROC_STEP_19;
					}
					else
					{
						bGSM_FTP_LoginWaiting = FALSE;
						
						GSMprintf("\r\n> FOTA - retry login after 15 secs");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);
						
						procGSM_FOTA_Step = PROC_STEP_12;
					}

					return tcpRes;
				}
				
				u8FTP_RetryCnt = 0;

				bFTP_Connect = TRUE;
				
				u8CurrFTP_PDP_ID = u8FTP_PDP_ID;

				//if(tcp_pdpContext[u8FTP_PDP_ID].bInUse == FALSE)
				//{
				//	tcp_pdpContext[u8FTP_PDP_ID].bInUse = TRUE;
				//}
				
				bGSM_FTP_LoginWaiting = FALSE;

				procGSM_FOTA_Step = PROC_STEP_13;

				tcpRes = TCP_OK;

				break;
			}
			*/
			
			osEvent event;


			HAL_Delay(10);
			
			u16GSM_CME_ErrCode = 0;
			u16GSM_FTP_ErrCode = 0;
			u16GSM_ProtocolErrCode = 0;

			bRes = GSM_FTP_Login(g_Setting.tGSM_SET.tFTP_Set.cAddr, g_Setting.tGSM_SET.tFTP_Set.u16Port);

			if(!bRes)
			{
				tcpRes = TCP_FTP_LOGIN_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					GSMprintf("\r\n> Open connection to FTP server reached maximum number of retries. Terminate the current operation.");

					u8FTP_RetryCnt = 0;
			  
				  tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FOTA_Step = PROC_STEP_19;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_12;

				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_FUNCTION_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_LOGIN_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_LOGIN_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_LOGIN_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FOTA_Step = PROC_STEP_18;

						return TCP_FTP_LOGIN_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_Login get event status: %d", event.status);
								
				  GSM_Handle_NonBlock_osEventTimeout();

					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			if(!bRes)
			{
				tcpRes = TCP_FTP_LOGIN_ERR;
				
				if(u16GSM_CME_ErrCode == 610)
				{
				  sprintf(g_Setting.tGSM_SET.tFTP_Set.cAddr, "%s", (char *)FTP_SERVER_DOMAIN_NAME);
					
					System_SaveSetting();
				}
				else if(u16GSM_CME_ErrCode == 625) 
				{
					GSMprintf("\r\n> GSM FOTA - Login CME ERROR 625! Deactivate PDP and terminate the operation.");
					
					bFTP_DownloadWaiting = FALSE;
					
					ftpRes = GSM_FTP_FINISH;
					
					procGSM_FTP_Upload_Step = PROC_STEP_19;
					
					return tcpRes;
				}
				else if(u16GSM_FTP_ErrCode == 604)
				{
					GSMprintf("\r\n> GSM FOTA - DNS incorrect! Deactivate PDP and terminate the operation.");
					
					bFTP_DownloadWaiting = FALSE;
					
					ftpRes = GSM_FTP_FINISH;
					
					procGSM_FTP_Upload_Step = PROC_STEP_19;
					
					return tcpRes;
				}
				else if((u16GSM_FTP_ErrCode == 625) && (u16GSM_ProtocolErrCode == 530))
				{
					GSMprintf("\r\n> GSM FOTA - Account incorrect! Deactivate PDP and terminate the operation.");
					
					bFTP_DownloadWaiting = FALSE;
					
					ftpRes = GSM_FTP_FINISH;
					
					procGSM_FTP_Upload_Step = PROC_STEP_19;
					
					return tcpRes;
				}
				
				u8FTP_RetryCnt++;
				
				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					GSMprintf("\r\n> FOTA - login FAIL, deactivate PDP context after 15 secs");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FOTA_Step = PROC_STEP_19;
				}
				else
				{
					bFTP_DownloadWaiting = FALSE;
					
					GSMprintf("\r\n> FOTA - retry login after 15 secs");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);
					
					procGSM_FOTA_Step = PROC_STEP_12;
				}

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			bFTP_Connect = TRUE;
			
			u8CurrFTP_PDP_ID = u8FTP_PDP_ID;

			if(tcp_pdpContext[u8FTP_PDP_ID].bInUse == FALSE)
			{
				tcp_pdpContext[u8FTP_PDP_ID].bInUse = TRUE;
			}

			procGSM_FOTA_Step = PROC_STEP_13;

			tcpRes = TCP_OK;

			break;
			
		}

		// Step 13: Config working directory on FTP server
		case PROC_STEP_13:
		{
			char cFilePath[30];
			osEvent event;


			sprintf(cFilePath, "%s%s", FTP_SERVER_DIR, DEVICE_TYPE);

			HAL_Delay(10);
			
			u16GSM_CME_ErrCode = 0;
			u16GSM_FTP_ErrCode = 0;
			u16GSM_ProtocolErrCode = 0;

			bRes = GSM_FTP_SetDir(cFilePath);

			if(!bRes)
			{
				tcpRes = TCP_FTP_SETDIR_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FOTA_Step = PROC_STEP_18;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_13;

				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_FUNCTION_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_SETDIR_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_SETDIR_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_SETDIR_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FOTA_Step = PROC_STEP_18;

						return TCP_FTP_SETDIR_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_SetDir get event status: %d", event.status);
								
					GSM_Handle_NonBlock_osEventTimeout();

					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			if(!bRes)
			{
				tcpRes = TCP_FTP_SETDIR_ERR;
				
				if(u16GSM_CME_ErrCode == 625) 
				{
					GSMprintf("\r\n> GSM FOTA - Working directory CME ERROR 625! Logout and erminate the operation.");
					
					bFTP_DownloadWaiting = FALSE;
					
					ftpRes = GSM_FTP_FINISH;
					
					procGSM_FOTA_Step = PROC_STEP_18;
					
					return tcpRes;
				}
				else if((u16GSM_FTP_ErrCode == 627) && (u16GSM_ProtocolErrCode == 550))
				{
					GSMprintf("\r\n> GSM FOTA - Working directory incorrect! Logout and terminate the operation.");
					
					bFTP_DownloadWaiting = FALSE;
					
					ftpRes = GSM_FTP_FINISH;
					
					procGSM_FOTA_Step = PROC_STEP_18;
					
					return tcpRes;
				}
				
				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					GSMprintf("\r\n> FOTA - set working directory FAIL, logout after 15 secs");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FOTA_Step = PROC_STEP_18;
				}
				else
				{
					GSMprintf("\r\n> FOTA - retry set working directory after 15 secs");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);
					
					procGSM_FOTA_Step = PROC_STEP_13;
				}

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FOTA_Step = PROC_STEP_14;

			tcpRes = TCP_OK;

			break;
		}

		// Step 14: Get DF2 file size
		case PROC_STEP_14:
		{
			char cDF2_FileName[30];
			osEvent event;


			sprintf(cDF2_FileName, "%s_%02d_%02d_%02d.%s", DEVICE_TYPE, MODEL_NAME,
							CUSTOMER_TYPE, HW_VER, UPGRADE_FILE_EXT);

			HAL_Delay(10);
			
			u16GSM_CME_ErrCode = 0;
			u16GSM_FTP_ErrCode = 0;
			u16GSM_ProtocolErrCode = 0;

			bRes = GSM_FTP_FileSize(cDF2_FileName);

			if(!bRes)
			{
				tcpRes = TCP_FTP_FILESIZE_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FOTA_Step = PROC_STEP_18;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_14;

				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_FUNCTION_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_GETSIZE_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_GETSIZE_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_GETSIZE_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FOTA_Step = PROC_STEP_18;

						return TCP_FTP_FILESIZE_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_FileSize get event status: %d", event.status);
								
					GSM_Handle_NonBlock_osEventTimeout();

					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			if(!bRes)
			{
				tcpRes = TCP_FTP_FILESIZE_ERR;
				
				if(u16GSM_CME_ErrCode == 625) 
				{
					GSMprintf("\r\n> GSM FOTA - Get file size CME ERROR 625! Terminate the operation.");
					
					bFTP_DownloadWaiting = FALSE;
					
					ftpRes = GSM_FTP_FINISH;
					
					procGSM_FOTA_Step = PROC_STEP_18;
					
					return tcpRes;
				}
				else if((u16GSM_FTP_ErrCode == 627) && (u16GSM_ProtocolErrCode == 550))
				{
					GSMprintf("\r\n> GSM FOTA - File does not exist! Terminate the operation.");
					
					bFTP_DownloadWaiting = FALSE;
					
					ftpRes = GSM_FTP_FINISH;
					
					procGSM_FOTA_Step = PROC_STEP_18;
					
					return tcpRes;
				}
				
				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					GSMprintf("\r\n> FOTA - get file size FAIL, logout after 15 secs");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FOTA_Step = PROC_STEP_18;
				}
				else
				{
					GSMprintf("\r\n> FOTA - retry get file size after 15 secs");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);
					
					procGSM_FOTA_Step = PROC_STEP_14;
				}

				return tcpRes;
			}

			GSMprintf("\r\n> DF2 file latest upgrade size:%d", u32GetFileSize);
			
			if(u32GetFileSize == 0)
			{
			  GSMprintf("\r\n> FOTA file is empty! Terminate FOTA!");
				
				ftpRes = GSM_FTP_FINISH;
				
				procGSM_FOTA_Step = PROC_STEP_18;
				
				return TCP_FTP_FILESIZE_ERR;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FOTA_Step = PROC_STEP_15;

			tcpRes = TCP_OK;

			break;
		}

		// Step 15: Get DF2 file date
		case PROC_STEP_15:
		{
			/*
			char cDF2_FileName[30];
			osEvent event;


			sprintf(cDF2_FileName, "%s_%02d_%02d_%02d.%s", DEVICE_TYPE, MODEL_NAME,
