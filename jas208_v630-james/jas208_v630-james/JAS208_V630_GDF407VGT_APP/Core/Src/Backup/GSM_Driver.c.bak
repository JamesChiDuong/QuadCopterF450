			HAL_Delay(10);

			bRes = GSM_FTP_FileDate(cDF2_FileName);

			if(!bRes)
			{
				tcpRes = TCP_FTP_FILEDATE_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
