			u8RetVal = FALSE;
			
			break;
		}
		
		event = osMessagePeek(GSM_BlockCompleteHandle, S_2_mS(2));

		if(event.status == osEventMessage)
		{
			if(event.value.v == QTEC21_STAT_CONFIG_RI)
			{
				osMessageGet(GSM_BlockCompleteHandle, S_2_mS(1));
				
				break;
			}
		}
		else if((event.status == osEventTimeout) || (event.status == osErrorOS))
		{
			u8RetVal = FALSE;
			
			GSMprintf("\r\n> GSM_Stat_ConfigRI get event status: %d", event.status);
			
			GSM_Handle_Block_osEventTimeout();

			break;
		}

		HAL_Delay(1);
	}

	HAL_Delay(1);
	
	return (bool)u8RetVal;
}

