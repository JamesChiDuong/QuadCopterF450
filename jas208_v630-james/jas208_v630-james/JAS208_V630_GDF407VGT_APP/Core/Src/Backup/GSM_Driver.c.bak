				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					GSMprintf("\r\n> FOTA - get file date FAIL, logout after 15 secs");
				
				  FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FOTA_Step = PROC_STEP_18;
				}
				else
				{
				  GSMprintf("\r\n> FOTA - retry get file date after 15 secs");
				
				  FuncSkip_Enable(FUNC_GSM_FTP, 40);
				
					procGSM_FOTA_Step = PROC_STEP_15;
				}

				return tcpRes;
			}

			GSMprintf("\r\n> DF2 file latest upgrade date:%s", cGetFileLastDate);

			u8FTP_RetryCnt = 0;
			*/

			procGSM_FOTA_Step = PROC_STEP_16;

			tcpRes = TCP_OK;

			break;
		}

		// Step 16: Delete device RAM content
		case PROC_STEP_16:
		{
			char cDeletePath[20];


			sprintf(cDeletePath, "%s%s", FTP_LOCAL_STORAGE_2, STR_STORAGE_DEL_ALL);
			//sprintf(cDeletePath, "%s%s.%s", FTP_LOCAL_STORAGE_2, FTP_LOCAL_STORAGE_FILE,
			//				UPGRADE_FILE_EXT);

			HAL_Delay(10);

			bRes = GSM_FileDelete(cDeletePath);

			if(!bRes)
			{
				tcpRes = TCP_FTP_FILEDEL_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt == 5)
				{
					u8FTP_RetryCnt = 0;

					procGSM_FOTA_Step = PROC_STEP_17;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_17;

				return tcpRes;
			}

			GSMprintf("\r\n> Delete device RAM content successfully.");

			u8FTP_RetryCnt = 0;
			
			bFTP_DownloadWaiting = FALSE;

			procGSM_FOTA_Step = PROC_STEP_17;

			tcpRes = TCP_OK;

			break;
		}

		// Step 17: Download DF2 file to RAM
		case PROC_STEP_17:
		{
			char cDF2_FileName[30];
			char cTempFileName[20];
			static uint32_t u32Download_WaitStartTime = 0;
			//osEvent event;


			sprintf(cDF2_FileName, "%s_%02d_%02d_%02d.%s", DEVICE_TYPE, MODEL_NAME,
							CUSTOMER_TYPE, HW_VER, UPGRADE_FILE_EXT);

			sprintf(cTempFileName, "%s%s.%s", FTP_LOCAL_STORAGE_2, FTP_LOCAL_STORAGE_FILE,
							UPGRADE_FILE_EXT);

			if(bFTP_DownloadWaiting == FALSE)
			{
				HAL_Delay(10);
				
				gsmFTP_DownloadRes = GSM_EVENT_NULL;
				
				u16GSM_CME_ErrCode = 0;
				u16GSM_FTP_ErrCode = 0;
				u16GSM_ProtocolErrCode = 0;
				
				bRes = GSM_FTP_DownloadFile(cDF2_FileName, cTempFileName, 0);

				if(!bRes)
				{
					tcpRes = TCP_FTP_DOWNLOAD_ERR;

					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						GSMprintf("\r\n> Download file from FTP server reached maximum number of retries. Terminate the current operation.");

						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_NET_ERR;

						procGSM_FOTA_Step = PROC_STEP_18;
					}
					else
					{
						procGSM_FOTA_Step = PROC_STEP_16;
					}

					return tcpRes;
				}
				
				u8FTP_RetryCnt = 0;
				
				bFTP_DownloadWaiting = TRUE;
				
				procGSM_FOTA_Step = PROC_STEP_17;
				
				u32Download_WaitStartTime = HAL_GetTick();

				tcpRes = TCP_OK;

				break;
			}
      else
      {
			  if(gsmFTP_DownloadRes == GSM_EVENT_NULL)
				{
					if(HAL_GetTick() > (u32Download_WaitStartTime + S_2_mS(FTP_DOWNLOAD_TIMEOUT + 10)))
					{
						bRes = FALSE;
					}	
					else
					{
						procGSM_FOTA_Step = PROC_STEP_17;

					  tcpRes = TCP_OK;
						
					  break;
					}	
				}
			  else if(gsmFTP_DownloadRes == GSM_EVENT_DOWNLOAD_SUCCESS)
				{
				  bRes = TRUE;
				}
				else
				{
				  bRes = FALSE;
				}
				
				if(bRes == FALSE)
				{
					tcpRes = TCP_FTP_DOWNLOAD_ERR;
					
					if(u16GSM_CME_ErrCode == 625) 
					{
					  GSMprintf("\r\n> GSM FOTA - Download file CME ERROR 625! Terminate the operation.");
						
					  bFTP_DownloadWaiting = FALSE;
						
						ftpRes = GSM_FTP_FINISH;
						
						procGSM_FOTA_Step = PROC_STEP_18;
						
						return tcpRes;
					}
					else if((u16GSM_FTP_ErrCode == 627) && (u16GSM_ProtocolErrCode == 550))
					{
						GSMprintf("\r\n> GSM FOTA - File ERROR! Terminate the operation.");
						
					  bFTP_DownloadWaiting = FALSE;
						
						ftpRes = GSM_FTP_FINISH;
						
						procGSM_FOTA_Step = PROC_STEP_18;
						
						return tcpRes;
					}
					
					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_NET_ERR;
						
						GSMprintf("\r\n> FOTA - download file FAIL, logout after 40 secs");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);

						procGSM_FOTA_Step = PROC_STEP_18;
					}
					else
					{
						bFTP_DownloadWaiting = FALSE;
						
						GSMprintf("\r\n> FOTA - retry download file after 40 secs");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);
						
						procGSM_FOTA_Step = PROC_STEP_16;
					}

					return tcpRes;
				}
				
				GSMprintf("\r\n> DF2 file size after download:%d", u32GetTransLen);

				if(u32GetTransLen != u32GetFileSize)
				{
					GSMprintf("\r\n> File size after download is not correct!");

					tcpRes = TCP_FTP_DOWNLOAD_ERR;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					u8FTP_RetryCnt++;
					
					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_NET_ERR;
						
						GSMprintf("\r\n> FOTA - download file FAIL, logout after 40 secs");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);

						procGSM_FOTA_Step = PROC_STEP_18;
					}
					else
					{
						bFTP_DownloadWaiting = FALSE;
						
						GSMprintf("\r\n> FOTA - retry download file after 40 secs");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);
						
						procGSM_FOTA_Step = PROC_STEP_16;
					}

					return tcpRes;
				}
				
				u8FTP_RetryCnt = 0;

				u8FileTransRetryCnt = 0;
				
				bFTP_DownloadWaiting = FALSE;
				
				if(g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt > 0)
				{
				  g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt = 0;
					
					System_SaveSetting();
				}

				procGSM_FOTA_Step = PROC_STEP_18;

				tcpRes = TCP_OK;

				break;
			}			
			
			/*
			HAL_Delay(10);

			bRes = GSM_FTP_DownloadFile(cDF2_FileName, cTempFileName, 0);

			if(!bRes)
			{
				tcpRes = TCP_FTP_DOWNLOAD_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt == 5)
				{
					u8FTP_RetryCnt = 0;
			
			    tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
			
			    ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FOTA_Step = PROC_STEP_18;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_16;

				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_DOWNLOAD_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_DOWNLOAD_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_DOWNLOAD_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_DOWNLOAD_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FOTA_Step = PROC_STEP_18;

						return TCP_FTP_DOWNLOAD_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_DownloadFile get event status: %d", event.status);
								
					GSM_Handle_NonBlock_osEventTimeout();

					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			if(!bRes)
			{
				tcpRes = TCP_FTP_DOWNLOAD_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_NET_ERR;
					
					GSMprintf("\r\n> FOTA - download file FAIL, logout after 40 secs");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FOTA_Step = PROC_STEP_18;
				}
				else
				{
				  GSMprintf("\r\n> FOTA - retry download file after 40 secs");
				
				  FuncSkip_Enable(FUNC_GSM_FTP, 40);
				
					procGSM_FOTA_Step = PROC_STEP_16;
				}

				return tcpRes;
			}

			GSMprintf("\r\n> DF2 file size after download:%d", u32GetTransLen);

			if(u32GetTransLen != u32GetFileSize)
			{
				//GSMprintf("\r\n> File size after download is not correct.");

				tcpRes = TCP_FTP_DOWNLOAD_ERR;
				
				tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
				
				ftpRes = GSM_FTP_NET_ERR;

				procGSM_FOTA_Step = PROC_STEP_18;

				return tcpRes;
			}

			//GSM_FTP_Logout();

			//GSM_TCP_DeactivPDP(u8FTP_PDP_ID);

			//tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;

			//tcp_pdpContext[u8FTP_PDP_ID].bActiv = FALSE;

			//u8CurrPDP_ID = u8FTP_PDP_ID;

			//bFTP_Connect = FALSE;

			u8FTP_RetryCnt = 0;

			u8FileTransRetryCnt = 0;
			
			if(g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt > 0)
			{
				g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt = 0;
				
				System_SaveSetting();
			}

			procGSM_FOTA_Step = PROC_STEP_18;

			tcpRes = TCP_OK;

			break;
			*/
		}

		// Step 18: Logout FTP server
		case PROC_STEP_18:
		{
			osEvent event;


			HAL_Delay(10);

			bRes = GSM_FTP_Logout();

			if(!bRes)
			{
				tcpRes = TCP_FTP_LOGOUT_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					procGSM_FOTA_Step = PROC_STEP_19;
				}
				else
				{
					procGSM_FOTA_Step = PROC_STEP_18;
        } 
				
				return tcpRes;
			}

			while(1)
			{
				event = osMessageGet(GSM_NonBlockCompleteHandle, S_2_mS(FTP_FUNCTION_TIMEOUT + 10));

				if(event.status == osEventMessage)
				{
					if(event.value.v == GSM_EVENT_LOGOUT_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_LOGOUT_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_LOGOUT_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;

						procGSM_FOTA_Step = PROC_STEP_19;

						return TCP_FTP_LOGOUT_ERR;
					}
				}
				else if((event.status == osEventTimeout) || (event.status == osErrorOS))
				{
					GSMprintf("\r\n> GSM_FTP_LogOut get event status: %d", event.status);
								
					GSM_Handle_NonBlock_osEventTimeout();
					
					bRes = FALSE;

					break;
				}

				HAL_Delay(1);
			}

			if(!bRes)
			{
				tcpRes = TCP_FTP_LOGOUT_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					bFTP_Connect = FALSE;
					
					GSMprintf("\r\n> FOTA - logout FAIL, deactivate PDP after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FOTA_Step = PROC_STEP_19;
				}
				else
				{
					GSMprintf("\r\n> FOTA - retry logout after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);
					
					procGSM_FOTA_Step = PROC_STEP_18;
				}

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			bFTP_Connect = FALSE;

			procGSM_FOTA_Step = PROC_STEP_19;

			tcpRes = TCP_OK;

			break;
		}

		// Step 19: Deactivate PDP context
		case PROC_STEP_19:
		{
			HAL_Delay(10);

			// Activate PDP context
			bRes = GSM_TCP_DeactivPDP(u8FTP_PDP_ID);

			if(!bRes)
			{
				if(bGSMTimeOut)
				{
					u8FTP_RetryCnt = 0;

					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;

					tcp_pdpContext[u8FTP_PDP_ID].bActiv = FALSE;

					tcpRes = TCP_PDP_DEACTV_ERR;

					if(ftpRes == GSM_FTP_OK)
					  procGSM_FOTA_Step = PROC_STEP_20;
					else if(ftpRes == GSM_FTP_FINISH)
						procGSM_FOTA_Step = PROC_STEP_NULL;
          else
						procGSM_FOTA_Step = PROC_STEP_28;
					
					return tcpRes;
				}
				else
				{
					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;

						tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;

						tcp_pdpContext[u8FTP_PDP_ID].bActiv = FALSE;

						tcpRes = TCP_PDP_DEACTV_ERR;

						if(ftpRes == GSM_FTP_OK)
						  procGSM_FOTA_Step = PROC_STEP_20;
            else
						  procGSM_FOTA_Step = PROC_STEP_28;
						
						return tcpRes;
					}

					tcpRes = TCP_PDP_DEACTV_ERR;
					
					GSMprintf("\r\n> FOTA - retry deactivate PDP after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FOTA_Step = PROC_STEP_19;

					return tcpRes;
				}
			}

			u8FTP_RetryCnt = 0;

			tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;

			tcp_pdpContext[u8FTP_PDP_ID].bActiv = FALSE;

			u8CurrFTP_PDP_ID = 0;

			if(ftpRes == GSM_FTP_OK)
			  procGSM_FOTA_Step = PROC_STEP_20;
      else
				procGSM_FOTA_Step = PROC_STEP_28;
			
			break;
		}

		// Step 20: Open DF2 file in QTEC21 RAM
		case PROC_STEP_20:
		{
			char cTempFileName[20];


			sprintf(cTempFileName, "%s%s.%s", FTP_LOCAL_STORAGE_2, FTP_LOCAL_STORAGE_FILE,
							UPGRADE_FILE_EXT);

			HAL_Delay(10);

			bRes = GSM_FileOpen(cTempFileName, &u32FileID, 2);

			if(!bRes)
			{
				tcpRes = TCP_FTP_FILEOPEN_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					procGSM_FOTA_Step = PROC_STEP_27;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_20;

				return tcpRes;
			}

			GSMprintf("\r\n> Open DF2 file in device RAM successfully with ID: %d", u32FileID);

			u8FTP_RetryCnt = 0;

			procGSM_FOTA_Step = PROC_STEP_21;

			u32DatCnt = 0;

			u32FileSize = u32GetTransLen;

			tcpRes = TCP_OK;

			break;
		}

		// Step 21: Check file information
		case PROC_STEP_21:
		{
			uint8_t u8FW_Header[FLASH_HEADER_SIZE];
			//char cDF2_FileName[30];
			char cCurr_FW_Ver[20];
			char cFW_Ver[20];
			uint32_t u32FW_Size;
			uint16_t u16ModelID, u16CustID, u16HW_ID;
			uint8_t u8FW_ID[3];
			uint32_t u32ActualReadLen;
			//MX25L_StatusTypeDef mxlRes;


			//sprintf(cDF2_FileName, "%s_%02d_%02d_%02d.%s", DEVICE_TYPE, MODEL_NAME,
			//        CUSTOMER_TYPE, HW_VER, UPGRADE_FILE_EXT);

			//bRes = SD_ReadAddrToBuff(cDF2_FileName, u8FW_Header,
			//                         (uint32_t)FLASH_HEADER_SIZE, 0);

			bRes = GSM_FileRead(u32FileID, (uint32_t)FLASH_HEADER_SIZE, &u32ActualReadLen, (char *)u8FW_Header);

			if(!bRes)
			{
				GSMprintf("\r\n> Read DF2 file header in local storage error");

				tcpRes = TCP_FTP_TRANSFER_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					procGSM_FOTA_Step = PROC_STEP_27;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_21;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			// Get firmware CRC checksum
			u16CRC16_Check = ((uint16_t)(u8FW_Header[3]) << 8) | (uint16_t)u8FW_Header[2];

			// Get firmware size
			u32FW_Size = ((uint32_t)(u8FW_Header[7]) << 24) |
									 ((uint32_t)(u8FW_Header[6]) << 16) |
									 ((uint32_t)(u8FW_Header[5]) << 8) |
									 (uint32_t)(u8FW_Header[4]);

			u16ModelID = ((uint16_t)(u8FW_Header[9]) << 8) | (uint16_t)u8FW_Header[8];

			u16CustID = ((uint16_t)(u8FW_Header[11]) << 8) | (uint16_t)u8FW_Header[10];
			
			u16HW_ID = ((uint16_t)(u8FW_Header[13]) << 8) | (uint16_t)u8FW_Header[12];

			u8FW_ID[0] = u8FW_Header[14];
			u8FW_ID[1] = u8FW_Header[15];
			u8FW_ID[2] = u8FW_Header[16];

      if(u8FW_ID[2] == 0)
			{
			  sprintf(cFW_Ver, "%d.%03d", u8FW_ID[0], u8FW_ID[1]);
			}
			else
			{
			  sprintf(cFW_Ver, "%d.%03d_Alpha%d", u8FW_ID[0], u8FW_ID[1], u8FW_ID[2]);
			}

			GSMprintf("\r\n> Firmware version:%s", cFW_Ver);
			GSMprintf("\r\n> Firmware for model ID:%d", u16ModelID);
			GSMprintf("\r\n> Firmware for customer ID:%d", u16CustID);
			GSMprintf("\r\n> Firmware for hardware ID:%d", u16HW_ID);
			GSMprintf("\r\n> Firmware size:%d", u32FW_Size);
			GSMprintf("\r\n> Firmware CRC16:0x%04x", u16CRC16_Check);

			sprintf(cCurr_FW_Ver, "%s%s", FIRMWARE_VERSION, FW_VERSION_CHK);

			if(strcmp(cCurr_FW_Ver, cFW_Ver) == 0)
			{
				GSMprintf("\r\n> Firmware version is the same, terminate the current operation.");
				
				ftpRes = GSM_FTP_OK;

				procGSM_FOTA_Step = PROC_STEP_27;

				return TCP_OK;
			}

			if(u16ModelID != (uint16_t)MODEL_NAME)
			{
				GSMprintf("\r\n> Model ID is not matched, terminate the current operation.");
				
				ftpRes = GSM_FTP_OK;

				procGSM_FOTA_Step = PROC_STEP_27;

				return TCP_FTP_CHECKFW_ERR;
			}

			if(u16CustID != (uint16_t)CUSTOMER_TYPE)
			{
				GSMprintf("\r\n> Customer type is not matched, terminate the current operation.");
				
				ftpRes = GSM_FTP_OK;

				procGSM_FOTA_Step = PROC_STEP_27;

				return TCP_FTP_CHECKFW_ERR;
			}
			
			if(u16HW_ID != (uint16_t)HW_VER)
			{
				GSMprintf("\r\n> Hardware ID is not matched, terminate the current operation.");
				
				ftpRes = GSM_FTP_OK;

				procGSM_FOTA_Step = PROC_STEP_27;

				return TCP_FTP_CHECKFW_ERR;
			}

			if(u32FW_Size != (u32FileSize - (uint32_t)FLASH_HEADER_SIZE))
			{
				GSMprintf("\r\n> Firmware size is not matched, terminate the current operation.");
				
				ftpRes = GSM_FTP_OK;

				procGSM_FOTA_Step = PROC_STEP_27;

				return TCP_FTP_CHECKFW_ERR;
			}

			u32FileSize = u32FW_Size;

			sprintf(cFW_NewVer, "%s", cFW_Ver);

			GSMprintf("\r\n> Proceed to download firmware content from local storage to ExFlash and check CRC.");

			tcpRes = TCP_OK;

			procGSM_FOTA_Step = PROC_STEP_22;

			break;
		}

		// Step 22: Initialize to transfer firmware from local storage to ExFlash and reset CRC16 value.
		case PROC_STEP_22:
		{
			uint16_t u16SectEraseNum;
			MX25L_StatusTypeDef mxlRes;


			u16SectEraseNum = (uint16_t)(u32FileSize / MX25L_SECTOR_SIZE);

			if(u32FileSize % MX25L_SECTOR_SIZE)
				u16SectEraseNum++;

			//MX25L_BlockUnlock();

			mxlRes = MX25L_MultiSectorsErase((u32ExFlashTempAddr / MX25L_SECTOR_SIZE), u16SectEraseNum);
			//mxlRes = MX25L_OK;

			if(mxlRes != MX25L_OK)
			{
				GSMprintf("\r\n> Erase ExFlash fail with error code %d.", mxlRes);

				tcpRes = TCP_FTP_TRANSFER_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					procGSM_FOTA_Step = PROC_STEP_27;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_22;

				return tcpRes;
			}

			GSMprintf("\r\n> Erase ExFlash successfully.");

			//u8FTP_RetryCnt = 0;

			u32DatCnt = 0;

			CRC16_Reset(&u16CRC16_Cal);

			//u8FileTransRetryCnt = 0;

			tcpRes = TCP_OK;

			procGSM_FOTA_Step = PROC_STEP_23;

			break;
		}

		// Step 23: Set pointer for DF2 file in QTEC21 RAM
		case PROC_STEP_23:
		{
			bRes = GSM_FileSeek(u32FileID, (uint32_t)FLASH_HEADER_SIZE + u32DatCnt);

			if(!bRes)
			{
				GSMprintf("\r\n> Set pointer for DF2 file in device RAM fail.");
				
				tcpRes = TCP_FTP_FILESEEK_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt == 5)
				{
					u8FTP_RetryCnt = 0;

					u8FileTransRetryCnt++;

					if(u8FileTransRetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						GSMprintf("\r\n> Maximum file seek retries reached. Terminate operation.");

						u8FileTransRetryCnt = 0;

						procGSM_FOTA_Step = PROC_STEP_27;

						GSM_Reset();
					}
					else
						procGSM_FOTA_Step = PROC_STEP_22;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_23;

				return tcpRes;
			}

			//GSMprintf("\r\n> Set pointer for DF2 file in device RAM successfully.");

			//u8FTP_RetryCnt = 0;

			procGSM_FOTA_Step = PROC_STEP_24;

			tcpRes = TCP_OK;

			break;
		}

		// Step 24: Read data from the DF2 file in device RAM
		case PROC_STEP_24:
		{
			const int iDownloadSize = 1024;
			uint8_t u8Buf[1024];
			uint32_t u32ActualReadLen;
			//char cDF2_FileName[30];
			MX25L_StatusTypeDef mxlRes;
			uint32_t u32PageOffset;


			//sprintf(cDF2_FileName, "%s_%02d_%02d_%02d.%s", DEVICE_TYPE, MODEL_NAME,
			//        CUSTOMER_TYPE, HW_VER, UPGRADE_FILE_EXT);

			u32DatSize = u32FileSize - u32DatCnt;

			if(u32DatSize > iDownloadSize)
				u32DatSize = iDownloadSize;

			memset(u8Buf, 0x00, sizeof(u8Buf));

			bRes = GSM_FileRead(u32FileID, u32DatSize, &u32ActualReadLen, (char *)u8Buf);

			//GSMprintf("\r\n> Read %d bytes from DF2 file in device RAM.", u32ActualReadLen);

			if(!bRes)
			{
				//GSMprintf("\r\n> Read DF2 file in device RAM fail.");

				tcpRes = TCP_FTP_FILEREAD_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt == 5)
				{
					u8FTP_RetryCnt = 0;

					u8FileTransRetryCnt++;

					if(u8FileTransRetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						GSMprintf("\r\n> Maximum file transfer retries reached. Terminate operation.");

						u8FileTransRetryCnt = 0;

						procGSM_FOTA_Step = PROC_STEP_27;

						GSM_Reset();
					}
					else
						procGSM_FOTA_Step = PROC_STEP_22;
				}
				else
					procGSM_FOTA_Step = PROC_STEP_24;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			u32PageOffset = (u32ExFlashTempAddr + u32DatCnt) / (uint32_t)MX25L_PAGE_SIZE;

			mxlRes = MX25L_MultiPagesProgram(u32PageOffset, u8Buf, u32DatSize);
			//mxlRes = MX25L_OK;

			if(mxlRes != MX25L_OK)
			{
				GSMprintf("\r\n> Fail to write to exflash at position %d", u32DatCnt);

				tcpRes = TCP_FTP_FILEWRITE_ERR;

				u8FileTransRetryCnt++;

				if(u8FileTransRetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					GSMprintf("\r\n> Maximum file transfer retries reached. Terminate operation.");

					u8FileTransRetryCnt = 0;

					procGSM_FOTA_Step = PROC_STEP_27;
					
					//if(bRTOS_En)
					//{
					//	osMutexWait(mutex_setting_user, S_2_mS(5));
					//}

					//GSM_Reset();
					//System_Reset();
				}
				else
				{
					procGSM_FOTA_Step = PROC_STEP_22;
				}

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			u8FileTransRetryCnt = 0;

			u32DatCnt += u32DatSize;

			for(int i = 0; i < u32DatSize; i++)
			{
				u16CRC16_Cal = CRC16_Calc(u16CRC16_Cal, u8Buf[i]);
			}

			//GSMprintf("\r\n> Finish write %d bytes to SD card.");

			//if((u32DatCnt % 4096) == 0)
			//	GSMprintf("\r\n> Finish transfer %d bytes from device RAM to SD card.", u32DatCnt);

			if(u32DatCnt >= u32FileSize)
			{
				GSMprintf("\r\n> Finish transfer data from device RAM to ExFlash.");

				procGSM_FOTA_Step = PROC_STEP_25;
			}
			else
				procGSM_FOTA_Step = PROC_STEP_23;

			tcpRes = TCP_OK;

			break;
		}

		// Step 25: Close DF2 file in QTEC21 RAM and proceed to upgrade firmware
		case PROC_STEP_25:
		{
			HAL_Delay(10);

			bRes = GSM_FileClose(u32FileID);

			if(bRes)
			  GSMprintf("\r\n> Close DF2 file in device RAM successfully.");
			else
				GSMprintf("\r\n> Close DF2 file in device RAM fail.");

			if(u16CRC16_Cal != u16CRC16_Check)
			{
				GSMprintf("\r\n> CRC16 check for firmware file is not correct. Calculated CRC:0x%04x, original CRC:0x%04x", u16CRC16_Cal, u16CRC16_Check);

				procGSM_FOTA_Step = PROC_STEP_NULL;

				return TCP_FTP_CRC_ERR;
			}
			else
				GSMprintf("\r\n> CRC16 check for firmware file correct.");

			tcpRes = TCP_OK;
			
			procGSM_FOTA_Step = PROC_STEP_NULL;
			
			//procGSM_FOTA_Step = PROC_STEP_26;

			//break;

			//if(gsmCmdSrc == GSM_CMD_SRC_SMS)
			//{
			//	GSM_MsgDataTypeDef smsHandle;
			//	char cSMS_Msg[64] = {0};


				//GSMprintf("\r\n> Send notification SMS.");

			//	smsHandle.pcPhoneNum = cCmdPhoneNum;

			//	sprintf(cSMS_Msg, "System upgraded to firmware version %s successfully.", cFW_NewVer);

			//	smsHandle.cData = cSMS_Msg;

			//	smsHandle.u16DataLen = strlen(smsHandle.cData);

			//	GSM_SMS_Send(&smsHandle);
				
			//	HAL_Delay(500);
			//}
			/*
			else if(gsmCmdSrc == GSM_CMD_SRC_TCP_1)
			{
				if(bTCPIP_Connect[0] == TRUE)
				{
					GSM_SocketDataTypeDef tcpHandle;
					char cTCP_Msg[64] = {0};


					GSMprintf("\r\n> Send notification TCP message.");

					tcpHandle.SocketNum = u8CurrTCP_Socket[0];

					sprintf(cTCP_Msg, "@ System upgraded to firmware version %s successfully.", cFW_NewVer);

					tcpHandle.cData = cTCP_Msg;

					tcpHandle.u16DataLen = strlen(tcpHandle.cData);

					GSM_TCP_Send(&tcpHandle);
					
					HAL_Delay(S_2_mS(1));
				}
			}
			#if ENABLE_MULTI_SERVER
			else if(gsmCmdSrc == GSM_CMD_SRC_TCP_2)
			{
				if(bTCPIP_Connect[1] == TRUE)
				{
					GSM_SocketDataTypeDef tcpHandle;
					char cTCP_Msg[64] = {0};


					GSMprintf("\r\n> Send notification TCP message.");

					tcpHandle.SocketNum = u8CurrTCP_Socket[1];

					sprintf(cTCP_Msg, "@ System upgraded to firmware version %s successfully.", cFW_NewVer);

					tcpHandle.cData = cTCP_Msg;

					tcpHandle.u16DataLen = strlen(tcpHandle.cData);

					GSM_TCP_Send(&tcpHandle);
					
					HAL_Delay(S_2_mS(1));
				}
			}
			#endif
			*/
			
			//u32EndTime = HAL_GetTick();
			
		  //GSMprintf("\r\n> FOTA download time:%d", u32EndTime - u32StartTime);
			
			// Set and save upgrade flag
			if(bSD_ReportErrFlag == FALSE)
			{
			  V161_RecordTechnical(2);
			}
			
			if(EXTIO_IsMainPowerNormal())
			{
			  g_Setting.tUpgrade.bUpgradeFlag = TRUE;
				
				g_Setting.tUpgrade.ttLastInstall = System_GetTime();
			
			  System_SaveSetting();
			}
			
			// Write the new firmware size to BKP register
			HW_WriteBackupRegister(BKP_FW_SIZE, u32FileSize);

			// Notify the bootloader to download new firmware from the ExFlash after reset.
			HW_WriteBackupRegister(BKP_DFU_CHK, BKP_LOAD_VALUE);

			// Reset the system
			GSMprintf("\r\n> Reset system to upgrade firmware version %s.", cFW_NewVer);
			
			if(bRTOS_En)
			{
				osMutexWait(mutex_setting_user, S_2_mS(5));
			}

			System_Reset();

			break;
		}

		// Step 26: Check the written data and reset the system to upgrade firmware.
		case PROC_STEP_26:
		{
			const int iDownloadSize = 1024;
			uint8_t u8Buf[1024];
			MX25L_StatusTypeDef mxlRes;


			u32DatCnt = 0;

			CRC16_Reset(&u16CRC16_Cal);

			while(u32DatCnt < u32FileSize)
			{
				u32DatSize = u32FileSize - u32DatCnt;

				if(u32DatSize > iDownloadSize)
					u32DatSize = iDownloadSize;

				mxlRes = MX25L_MultiBytesRead(u32ExFlashTempAddr + u32DatCnt, u8Buf, u32DatSize);

				if(mxlRes != MX25L_OK)
				{
					tcpRes = TCP_FTP_FILEREAD_ERR;

					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;

						procGSM_FOTA_Step = PROC_STEP_NULL;

						return tcpRes;
					}

					procGSM_FOTA_Step = PROC_STEP_26;
				}

				for(int i = 0; i < u32DatSize; i++)
				{
					u16CRC16_Cal = CRC16_Calc(u16CRC16_Cal, u8Buf[i]);
				}

				u32DatCnt += u32DatSize;

				if((u32DatCnt % 10240) == 0)
				{
					GSMprintf("\r\n> Finish comparing %d bytes of firmware in ExFlash.", u32DatCnt);
				}
			}

			if(u16CRC16_Cal != u16CRC16_Check)
			{
				GSMprintf("\r\n> CRC check stage 2 is not correct. Calculated CRC:0x%04x, original CRC:0x%04x", u16CRC16_Cal, u16CRC16_Check);

				procGSM_FOTA_Step = PROC_STEP_NULL;

				return TCP_FTP_CRC_ERR;
			}
			else
				GSMprintf("\r\n> CRC16 check stage 2 correct.");

			procGSM_FOTA_Step = PROC_STEP_NULL;

			tcpRes = TCP_OK;
			
			// Set and save upgrade flag
			if(bSD_ReportErrFlag == FALSE)
			{
			  V161_RecordTechnical(2);
			}
			
			if(EXTIO_IsMainPowerNormal())
			{
			  g_Setting.tUpgrade.bUpgradeFlag = TRUE;
				
				g_Setting.tUpgrade.ttLastInstall = System_GetTime();
			
			  System_SaveSetting();
      }
			
			// Write the new firmware size to BKP register
			HW_WriteBackupRegister(BKP_FW_SIZE, u32FileSize);

			// Notify the bootloader to download new firmware from the ExFlash after reset.
			HW_WriteBackupRegister(BKP_DFU_CHK, BKP_LOAD_VALUE);

			// Reset the system
			GSMprintf("\r\n> Reset system to upgrade firmware.");

			if(bRTOS_En)
			{
				osMutexWait(mutex_setting_user, S_2_mS(5));
			}
				
			//System_Reset();

			break;
		}
		
		// Step 27: Close DF2 file in QTEC21 RAM 
		case PROC_STEP_27:
		{
			HAL_Delay(10);

			bRes = GSM_FileClose(u32FileID);

			if(bRes)
			  GSMprintf("\r\n> Close DF2 file in device RAM successfully.");
			else
				GSMprintf("\r\n> Close DF2 file in device RAM fail.");
			
			u8FTP_RetryCnt = 0;

			u8FileTransRetryCnt = 0;

			if(ftpRes == GSM_FTP_OK)
				procGSM_FOTA_Step = PROC_STEP_NULL;
			else
			  procGSM_FOTA_Step = PROC_STEP_28;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 28: If the operation failed then make another request 
		case PROC_STEP_28:
		{
			// Net error then retry unlimited
			if(ftpRes == GSM_FTP_NET_ERR)
			{
			  u8FTP_AccessRetryCnt++;
				
				g_Setting.tUpgrade.bFOTA_Flag = TRUE;
				
				System_SaveSetting();
			}
			// Not net error then retry limited
			else if(ftpRes == GSM_FTP_OTHER_ERR)
			{
			  g_Setting.tUpgrade.u8FOTA_RetryCnt++;
				
				u8FTP_AccessRetryCnt = 0;
				
				g_Setting.tGSM_SET.tGSM_Err.u8FTP_ErrCnt = 0;
				
				if(g_Setting.tUpgrade.u8FOTA_RetryCnt < FOTA_RETRY_MAX)
				{
					g_Setting.tUpgrade.bFOTA_Flag = TRUE;
				}
				else
				{
					g_Setting.tUpgrade.u8FOTA_RetryCnt = 0;
					
					GSM_TCP_ReportEvent(EVENT_FOTA_FAIL, STR_NULL);
				}
				
				System_SaveSetting();
				
				GSMprintf("\r\n> FOTA ERROR. Reset module QtEC21.");
				
				GSM_Reset();
			}
			
			tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
			
			procGSM_FOTA_Step = PROC_STEP_NULL;
			
			break;
		}

		default:
			break;
	}

	return tcpRes;
}

//============================================================================//
// @brief  Put a request to upload a file from the SD card to the FTP server.
// @param  pcSrcFile: Pointer to a char array storing the name of the source file. 
//         pcDstFile: Pointer to a char array storing the name of the file on 
//         the FTP server.
//         pcSrcDir: Pointer to a char array storing the name of the source directory.
//         pcDstDir: Pointer to a char array storing the name of the destination 
//         directory on the FTP server.
//         bUploadMode: 0: The file is uploaded to the module storage first then
//                         the module uploads the file to the FTP server.
//                      1: The file is uploaded directly to the FTP server.
// @result True: The operation is successful
//         False: The operation is failed.
//============================================================================//
bool GSM_FTP_FileUploadRequest(char *pcSrcFile, char *pcDstFile, char *pcSrcDir, 
	                             char *pcDstDir, bool bReUpload)
{
  GSM_UploadRequestTypeDef gsmUploadHandle;
	char cFilePath[130];
	uint32_t u32FileSize;
	osStatus osRes;
	bool bRes;
	
	
	if((strlen(pcSrcFile) == 0) ||
		 (strlen(pcSrcFile) > sizeof(gsmUploadRequest.cSrcFile)) ||		
		 (strlen(pcSrcDir) > sizeof(gsmUploadRequest.cSrcDir)) ||					 
		 (strlen(pcDstFile) == 0) || 
		 (strlen(pcDstFile) > sizeof(gsmUploadRequest.cDstFile)) ||
		 (strlen(pcDstDir) == 0) ||
		 (strlen(pcDstDir) > sizeof(gsmUploadRequest.cDstDir)))
	{
		GSMprintf("\r\n> FTP upload request has unsuitable parameter.");
		
		procGSM_FTP_Upload_Step = PROC_STEP_NULL;
		
		return FALSE;
	}
	
	if(bRTOS_En)
	{
		// Acquire GSM_SD synchronization
		osRes = osMutexWait(mutex_gsm_sd_user, S_2_mS(10));

		if(osRes != osOK)
		{
			GSMprintf("\r\n> Can't acquire GSM_SD mutex. osRes:%d", osRes);
			
			return FALSE;
		}
	}
	
	memset(cFilePath, 0x00, sizeof(cFilePath));
	
	if(strlen(pcSrcDir) == 0)
		sprintf(cFilePath, "%s", pcSrcFile);
	else
		sprintf(cFilePath, "%s/%s", pcSrcDir, pcSrcFile);

	if(SD_CheckFileExist(cFilePath) == FALSE)
	{
		GSMprintf("\r\n> Source file does not exist.");
		
		if(bRTOS_En)
			// Release GSM_SD synchronization
			osRes = osMutexRelease(mutex_gsm_sd_user);
		
		return FALSE;
	}
	
	u32FileSize = SD_GetFileSize(cFilePath);
	
	if((u32FileSize == 0) || (u32FileSize > FTP_FILE_UPLOAD_SIZE_MAX))
	{
		GSMprintf("\r\n> Source file size is insufficient.");
		
		if(bRTOS_En)
			// Release GSM_SD synchronization
			osRes = osMutexRelease(mutex_gsm_sd_user);
		
		return FALSE;
	}
	
	strcpy(gsmUploadHandle.cSrcFile, pcSrcFile);
  strcpy(gsmUploadHandle.cSrcDir, pcSrcDir);
	strcpy(gsmUploadHandle.cDstFile, pcDstFile);
	strcpy(gsmUploadHandle.cDstDir, pcDstDir);
	gsmUploadHandle.u32UploadSize = u32FileSize;
	
	if(bReUpload == FALSE)
	{
	  gsmUploadHandle.u8ReUploadCnt = 0;
	}
	
	memset(cFilePath, 0x00, sizeof(cFilePath));
	
	#ifndef DIRNAME_TEMP
		sprintf(cFilePath, "%s", SEND_FILE_TEMP_FILE);
	#else
		sprintf(cFilePath, "%s/%s", DIRNAME_TEMP, SEND_FILE_TEMP_FILE);
	#endif
	
	bRes = SD_WriteBuffToAddr(cFilePath, 
	                          (uint8_t *)gsmUploadHandle.cSrcFile, 
	                          sizeof(GSM_UploadRequestTypeDef), 
														2 + u16UnsendFileNum * sizeof(GSM_UploadRequestTypeDef));
														
  if(bRes)
	{
		GSM_FTP_IncUploadIdx();
		
		GSMprintf("\r\n> GSM add FTP upload request for file %s/%s", pcSrcDir, pcSrcFile);
	}
	else
	{
		GSMprintf("\r\n> Write FTP upload request to %s file failed!", cFilePath);
	}
	
	if(bRTOS_En)
		// Release GSM_SD synchronization
		osRes = osMutexRelease(mutex_gsm_sd_user);
	
	return bRes;
}

//============================================================================//
// @brief  Get a file upload request from the request list and initialize the
//         upload process.
// @param  None.
// @retval True: Operation is done successfully.
//         False: Operation fail.
//============================================================================//
bool GSM_FTP_FileUploadInit(void)
{
  bool bRes;
	osStatus osRes;
	char cFilePath[128] = {0};
	
	
	if(u16UnsendFileNum == 0)
		return FALSE;
	
	if(bRTOS_En)
	{
		// Acquire GSM_SD synchronization
		osRes = osMutexWait(mutex_gsm_sd_user, S_2_mS(10));

		if(osRes != osOK)
		{
			GSMprintf("\r\n> Can't acquire GSM_SD mutex. osRes:%d", osRes);
			
			return FALSE;
		}
	}
	
	#ifndef DIRNAME_TEMP
		sprintf(cFilePath, "%s", SEND_FILE_TEMP_FILE);
	#else
		sprintf(cFilePath, "%s/%s", DIRNAME_TEMP, SEND_FILE_TEMP_FILE);
	#endif
	
	bRes = SD_ReadAddrToBuff(cFilePath, 
	                         (uint8_t *)gsmUploadRequest.cSrcFile, 
	                         sizeof(GSM_UploadRequestTypeDef), 
													 2 + (u16UnsendFileNum - 1) * sizeof(GSM_UploadRequestTypeDef));
													 
	if(bRes)
	{
		GSMprintf("\r\n> Get FTP upload request %d OK.", u16UnsendFileNum);
		
	  GSM_FTP_DecUploadIdx();
		
		procGSM_FTP_Upload_Step = PROC_STEP_1;
	}
	else
	{
		GSMprintf("\r\n> Get FTP upload request failed!");
	}
	
	if(bRTOS_En)
		// Release GSM_SD synchronization
		osRes = osMutexRelease(mutex_gsm_sd_user);
	
	return bRes;
}

//============================================================================//
// @brief  Increase the index of pending upload request number by 1 then write 
//         the index to the request list.
// @param  None.
// @retval None.
//============================================================================//
void GSM_FTP_IncUploadIdx(void)
{
	bool bRes;
	char cFileName[64] = {0};
	
	
	sprintf(cFileName, "%s/%s", DIRNAME_TEMP, SEND_FILE_TEMP_FILE);
	
  u16UnsendFileNum++;
	
	for(int i = 0; i < 3; i++)
  {
	  bRes = SD_WriteBuffToAddr(cFileName, (uint8_t *)&u16UnsendFileNum, 2, 0);
		
		if(bRes)
			break;
	}
}

//============================================================================//
// @brief  Decrease the index of the pending upload request number by 1 then
//         write the index to the request list.
// @param  None.
// @retval None.
//============================================================================//
void GSM_FTP_DecUploadIdx(void)
{
	bool bRes;
	char cFileName[64] = {0};
	
	
	if(u16UnsendFileNum == 0)
		return;
	
	sprintf(cFileName, "%s/%s", DIRNAME_TEMP, SEND_FILE_TEMP_FILE);
	
  u16UnsendFileNum--;
	
	for(int i = 0; i < 3; i++)
  {
	  bRes = SD_WriteBuffToAddr(cFileName, (uint8_t *)&u16UnsendFileNum, 2, 0);
		
		if(bRes)
			break;
	}
}

//============================================================================//
// @brief  Process the current file upload request.
// @param  None.
// @retval Result in TCP_StatusTypedef format.
//============================================================================//
TCP_StatusTypeDef GSM_FTP_Upload_Proc(void)
{
	TCP_StatusTypeDef tcpRes;
	bool bRes;
	static GSM_FTP_ResTypeDef ftpRes;
	static char cSrcFilePath[130];
	//static char cFTP_IP_Addr[20];
	static uint32_t u32FileID;
	static uint32_t u32FileSize, u32DatCnt, u32DatSize;
	static uint32_t u32QueryCS_LastTick = 0, u32QueryPS_LastTick = 0;
	static bool bFTP_UploadWaiting = FALSE; 
	static uint32_t u32StartTime = 0, u32EndTime = 0;


	if(procGSM_FTP_Upload_Step == PROC_STEP_NULL)
		return TCP_OK;

	switch((int)procGSM_FTP_Upload_Step)
	{
		// Step 1: Check upload parameters
		case PROC_STEP_1:
		{
		  if((strlen(gsmUploadRequest.cSrcFile) == 0) ||
         (strlen(gsmUploadRequest.cSrcFile) > sizeof(gsmUploadRequest.cSrcFile)) ||		
         (strlen(gsmUploadRequest.cSrcDir) > sizeof(gsmUploadRequest.cSrcDir)) ||					 
				 (strlen(gsmUploadRequest.cDstFile) == 0) || 
				 (strlen(gsmUploadRequest.cDstFile) > sizeof(gsmUploadRequest.cDstFile)) ||
			   (strlen(gsmUploadRequest.cDstDir) == 0) ||
				 (strlen(gsmUploadRequest.cDstDir) > sizeof(gsmUploadRequest.cDstDir)) ||
				 (gsmUploadRequest.u32UploadSize == 0) || 
				 (gsmUploadRequest.u32UploadSize > FTP_FILE_UPLOAD_SIZE_MAX))
		  {
				GSMprintf("\r\n> FTP request parameters incorrect!");
				
			  procGSM_FTP_Upload_Step = PROC_STEP_NULL;
				
				tcpRes = TCP_FTP_OTHER_ERR;
				
				break;
			}
			
			u32StartTime = HAL_GetTick();
			
			memset(cSrcFilePath, 0x00, sizeof(cSrcFilePath));
			
			if(strlen(gsmUploadRequest.cSrcDir) == 0)
				sprintf(cSrcFilePath, "%s", gsmUploadRequest.cSrcFile);
		  else
				sprintf(cSrcFilePath, "%s/%s", gsmUploadRequest.cSrcDir, gsmUploadRequest.cSrcFile);
		
			if(SD_CheckFileExist(cSrcFilePath) == FALSE)
			{
				GSMprintf("\r\n> FTP upload source file not found!");
				
			  procGSM_FTP_Upload_Step = PROC_STEP_NULL;
				
				tcpRes = TCP_FTP_NO_SRC_FILE;
				
				break;
			}
			
			u32FileSize = SD_GetFileSize(cSrcFilePath);
			
			if((u32FileSize == 0) || (u32FileSize > FTP_FILE_UPLOAD_SIZE_MAX))
			{
				GSMprintf("\r\n> FTP upload source file size is insufficient!");
				
			  procGSM_FTP_Upload_Step = PROC_STEP_NULL;
				
				tcpRes = TCP_FTP_NO_SRC_FILE;
				
				break;
			}
			
			if(gsmUploadRequest.u32UploadSize > u32FileSize)
			{
				GSMprintf("\r\n> FTP upload requests to upload more bytes than the current source file size!");
				
			  procGSM_FTP_Upload_Step = PROC_STEP_NULL;
				
				tcpRes = TCP_FTP_OTHER_ERR;
				
				break;
			}
			
			u8FTP_RetryCnt = 0;
			
			ftpRes = GSM_FTP_OK;
			
			procGSM_FTP_Upload_Step = PROC_STEP_2;
			
			break;
		}
		
		// Step 2: Delete all contents in the RAM.
		case PROC_STEP_2:
		{ 
			char cDeletePath[20];


			sprintf(cDeletePath, "%s", STR_STORAGE_DEL_ALL);
			//sprintf(cDeletePath, "%s%s", FTP_LOCAL_STORAGE, STR_STORAGE_DEL_ALL);
			//sprintf(cDeletePath, "%s%s.%s", FTP_LOCAL_STORAGE, FTP_LOCAL_STORAGE_FILE,
			//				UPGRADE_FILE_EXT);

			HAL_Delay(10);

			bRes = GSM_FileDelete(cDeletePath);

			//GSMprintf("\r\n> Delete device RAM content successfully.");

			u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_3;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 3: Create a new TEMP file in the QTEC21 RAM storage
		case PROC_STEP_3:
		{
			//char cFileName[64] = {0};
			char cTempFileName[20] = {0};


			//if(strlen(gsmUploadRequest.cSrcDir) == 0)
			//	sprintf(cFileName, "%s", gsmUploadRequest.cSrcFile);
		  //else
			//	sprintf(cFileName, "%s/%s", gsmUploadRequest.cSrcDir, gsmUploadRequest.cSrcFile);
			
			sprintf(cTempFileName, "%s%s", FTP_LOCAL_STORAGE, FTP_LOCAL_STORAGE_FILE_2);

			HAL_Delay(10);

			bRes = GSM_FileOpen(cTempFileName, &u32FileID, 1);
			//bRes = GSM_FileUpload(cFileName, cTempFileName);

			if(!bRes)
			{
				tcpRes = TCP_FTP_FILEOPEN_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					ftpRes = GSM_FTP_OTHER_ERR;
					
					procGSM_FTP_Upload_Step = PROC_STEP_32;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_3;

				return tcpRes;
			}

			GSMprintf("\r\n> Open TEMP file in device RAM successfully with ID: %d", u32FileID);

			u8FTP_RetryCnt = 0;

			u8FileTransRetryCnt = 0;

			u32DatCnt = 0;
			
			procGSM_FTP_Upload_Step = PROC_STEP_4;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 4: Set the file pointer in the TEMP file
		case PROC_STEP_4:
		{
			bRes = GSM_FileSeek(u32FileID, u32DatCnt);

			if(!bRes)
			{
				GSMprintf("\r\n> Set pointer for TEMP file in device RAM fail.");
				
				tcpRes = TCP_FTP_FILESEEK_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					u8FileTransRetryCnt++;

					if(u8FileTransRetryCnt >= 3)
					{
						GSMprintf("\r\n> Maximum file seek retries reached. Terminate operation.");

						u8FileTransRetryCnt = 0;
						
						bRes = GSM_FileClose(u32FileID);

						if(bRes)
							GSMprintf("\r\n> Close upload file in device RAM successfully.");
						else
							GSMprintf("\r\n> Close upload file in device RAM fail.");
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_32;

						GSM_Reset();
					}
					else
						procGSM_FTP_Upload_Step = PROC_STEP_2;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_4;

				return tcpRes;
			}

			//GSMprintf("\r\n> Set pointer for TEMP file in device RAM successfully.");

			//u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_5;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 5: Read data from SD card and write to the TEMP file
		case PROC_STEP_5:
		{
			osStatus osRes = osMutexWait(mutex_data_buf2_user, S_2_mS(20));

			if(osRes != osOK)
			{
				GSMprintf("\r\n> Can't acquire DATA BUF2 mutex to upload file. osRes:%d", osRes);
		
				break; 
			}
			
			u32DatSize = u32FileSize - u32DatCnt;

			if(u32DatSize > sizeof(u8PublicDataBuf))
				u32DatSize = sizeof(u8PublicDataBuf);
			
			memset(u8PublicDataBuf, 0x00, sizeof(u8PublicDataBuf));
			
			bRes = SD_ReadAddrToBuff(cSrcFilePath, u8PublicDataBuf, u32DatSize, u32DatCnt);
			
			if(!bRes)
			{
				GSMprintf("\r\n> Read file %s in SD card fail.", cSrcFilePath);

				tcpRes = TCP_FTP_FILEREAD_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					u8FileTransRetryCnt++;

					if(u8FileTransRetryCnt >= 3)
					{
						GSMprintf("\r\n> Maximum file transfer retries reached. Terminate operation.");

						u8FileTransRetryCnt = 0;
						
						bRes = GSM_FileClose(u32FileID);

						if(bRes)
							GSMprintf("\r\n> Close upload file in device RAM successfully.");
						else
							GSMprintf("\r\n> Close upload file in device RAM fail.");
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_32;

						GSM_Reset();
					}
					else
						procGSM_FTP_Upload_Step = PROC_STEP_2;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_5;
				
				osMutexRelease(mutex_data_buf2_user);
				
				return tcpRes;
			}
			
			bRes = GSM_FileWrite(u32FileID, u8PublicDataBuf, u32DatSize);
			
			osMutexRelease(mutex_data_buf2_user);
				
			if(!bRes)
			{
				//GSMprintf("\r\n> Read file %s in SD card fail.", cSrcFilePath);

				tcpRes = TCP_FTP_FILEWRITE_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					u8FileTransRetryCnt++;

					if(u8FileTransRetryCnt >= 3)
					{
						GSMprintf("\r\n> Maximum file transfer retries reached. Terminate operation.");

						u8FileTransRetryCnt = 0;
						
						bRes = GSM_FileClose(u32FileID);

						if(bRes)
							GSMprintf("\r\n> Close upload file in device RAM successfully.");
						else
							GSMprintf("\r\n> Close upload file in device RAM fail.");
						
						ftpRes = GSM_FTP_OTHER_ERR;

						procGSM_FTP_Upload_Step = PROC_STEP_32;

						GSM_Reset();
					}
					else
						procGSM_FTP_Upload_Step = PROC_STEP_2;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_4;
				
				return tcpRes;
			}
			
			u8FTP_RetryCnt = 0;
			
			u8FileTransRetryCnt = 0;
			
			u32DatCnt += u32DatSize;
			
			if(u32DatCnt < u32FileSize)
				procGSM_FTP_Upload_Step = PROC_STEP_4;
			else
				procGSM_FTP_Upload_Step = PROC_STEP_6;
			
			break;
		}
		
		// Step 6: Close TEMP file
		case PROC_STEP_6:
		{
			bRes = GSM_FileClose(u32FileID);
			
			if(!bRes)
			{
				tcpRes = TCP_FTP_FILECLOSE_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					procGSM_FTP_Upload_Step = PROC_STEP_7;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_6;

				return tcpRes;
			}

			GSMprintf("\r\n> Close DF2 file in device RAM successfully.");

			u8FTP_RetryCnt = 0;
			
			procGSM_FTP_Upload_Step = PROC_STEP_7;

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 7: Find a PDP context
		case PROC_STEP_7:
		{
			u8FTP_PDP_ID = 0;
			
		  // Find an available PDP context IP
			for(int i = 1; i < 17; i++)
				if(tcp_pdpContext[i].bInUse == FALSE)
				{
					u8FTP_PDP_ID = i;

					break;
				}

			// If there is no PDP context ID is available then return
			if(u8FTP_PDP_ID == 0)
			{
				tcpRes = TCP_NO_PDP;
				
				ftpRes = GSM_FTP_NET_ERR;

				procGSM_FTP_Upload_Step = PROC_STEP_32;

				return tcpRes;
			}

			u8CurrFTP_PDP_ID = u8FTP_PDP_ID;
			
			tcp_pdpContext[u8FTP_PDP_ID].bInUse = TRUE;
			
			GSMprintf("\r\n> Selected PDP context: %d", u8FTP_PDP_ID);

			if(tcp_pdpContext[u8FTP_PDP_ID].bActiv == TRUE)
				procGSM_FTP_Upload_Step = PROC_STEP_13;
			else
			{
				procGSM_FTP_Upload_Step = PROC_STEP_8;
				
				u32QueryCS_LastTick = HAL_GetTick();
			}

			tcpRes = TCP_OK;

			break;
		}
		
		// Step 8: Check CS service
		case PROC_STEP_8:
		{
			if(HAL_GetTick() < (u32QueryCS_LastTick + S_2_mS(GSM_CREG_QUERY_TIMEOUT)))
			{
			  bRes = GSM_Net_QueryCS();
				
				if(!bRes)
				{
				  tcpRes = TCP_OK;

			    procGSM_FTP_Upload_Step = PROC_STEP_8;
					
					break;
				}
			}
			else
			{
				GSMprintf("\r\n> GSM Query CS ERROR! Reset QTEC21 module.");
				
				GSM_Reset();

				tcpRes = TCP_NO_CS;

				if(bGSMTimeOut)
				{
					ftpRes = GSM_FTP_OTHER_ERR;
				}
				else
				{
					ftpRes = GSM_FTP_NET_ERR;
        }
				
				procGSM_FTP_Upload_Step = PROC_STEP_32;
				
				return tcpRes;
			}
			
			tcpRes = TCP_OK;

			procGSM_FTP_Upload_Step = PROC_STEP_9;
			
			u32QueryPS_LastTick = HAL_GetTick();

			break;
			
			/*
			bRes = GSM_Net_QueryCS();

			if(!bRes)
			{
				GSM_Reset();

				tcpRes = TCP_NO_CS;
			
			  ftpRes = GSM_FTP_NET_ERR;

				procGSM_FTP_Upload_Step = PROC_STEP_32;

				return tcpRes;
			}

			tcpRes = TCP_OK;

			procGSM_FTP_Upload_Step = PROC_STEP_9;

			break;
			*/
		}
		
		// Step 9: Check PS service
		case PROC_STEP_9:
		{
			if(HAL_GetTick() < (u32QueryPS_LastTick + S_2_mS(GSM_CGREG_QUERY_TIMEOUT)))
			{
			  bRes = GSM_PD_QueryPS();
				
				if(!bRes)
				{
				  tcpRes = TCP_OK;

			    procGSM_FTP_Upload_Step = PROC_STEP_9;

			    break;
				}
			}
			else
			{
				g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt++;
				
				System_SaveSetting();
				
				//GSMprintf("\r\n> GSM Query PS Error: %d", g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt);
					
				if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt >= 3)
				{
					g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
					
					System_SaveSetting();
					
					bQtEC21_State = FALSE;
						
					GSMprintf("\r\n> GSM Query PS ERROR! Maximum QTEC21 reset reached. Stop GSM function!");

					LCD_SetShowAutoTestPage(51);
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;

				  procGSM_FTP_Upload_Step = PROC_STEP_NULL;

					return TCP_NO_PS;
				}
				else
				{
					GSMprintf("\r\n> GSM Query PS ERROR! Reset QTEC21 module.");
				
					GSM_Reset();
					
					ftpRes = GSM_FTP_NET_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_32;

					tcpRes = TCP_NO_PS;
				}
			
				break;
			}
			
			tcpRes = TCP_OK;

			procGSM_FTP_Upload_Step = PROC_STEP_10;

			break;
			
			/*
			bRes = GSM_PD_QueryPS();
			
			if(bRes)
			{
				if(g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt > 0)
				{
					g_Setting.tGSM_SET.tGSM_Err.u8SIM_ErrCnt = 0;
					
					System_SaveSetting();
				}
				
			  // If the current version is JAS208S then change it to JAS208U
				//if(strncmp(g_Setting.cJAS_Ver, (char *)JAS208_NO_GSM, 7) == 0)
				{
					GSMprintf("\r\n> GSM network register OK, change to version JAS208U.");

					memset(g_Setting.cJAS_Ver, 0x00, sizeof(g_Setting.cJAS_Ver));

					sprintf(g_Setting.cJAS_Ver, "%s", JAS208_GSM);

					System_SaveSetting();
					
					GSM_CheckTempFile();
				}
			}
			else
			{
				GSM_Reset();

				tcpRes = TCP_NO_PS;
				
				ftpRes = GSM_FTP_OTHER_ERR;

				procGSM_FTP_Upload_Step = PROC_STEP_32;

				return tcpRes;
			}

			tcpRes = TCP_OK;

			procGSM_FTP_Upload_Step = PROC_STEP_10;

			break;
			*/
		}

		// Step 10: Configure PDP context
		case PROC_STEP_10:
		{
			if(tcp_pdpContext[u8FTP_PDP_ID].bActiv)
			{
				procGSM_FTP_Upload_Step = PROC_STEP_13;

				return TCP_OK;
			}

			HAL_Delay(10);

			// Config PDP context
			bRes = GSM_TCP_ConfigPDP(u8FTP_PDP_ID, 
			                         (char *)(g_Setting.tGSM_SET.tNetSet.cAPN), 
															 (char *)TCP_USER_NAME, 
															 (char *)TCP_USER_PW);

			if(!bRes)
			{
				tcpRes = TCP_PDP_CONFIG_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					tcp_pdpContext[u8FTP_PDP_ID].bInUse = FALSE;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_32;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_10;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_11;

			tcpRes = TCP_OK;

			break;
		}

		// Step 11: Activate PDP context
		case PROC_STEP_11:
		{
			HAL_Delay(10);

			// Activate PDP context
			bRes = GSM_TCP_ActivPDP(u8FTP_PDP_ID);

			if(!bRes)
			{
				if(bGSMTimeOut)
				{
					u8FTP_RetryCnt = 0;

					GSM_Reset();

					tcpRes = TCP_PDP_ACTV_ERR;
					
					ftpRes = GSM_FTP_NET_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_31;

					return tcpRes;
				}
				else
				{
					u8FTP_RetryCnt++;

					if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
					{
						u8FTP_RetryCnt = 0;

						GSM_Reset();

						tcpRes = TCP_PDP_ACTV_ERR;
						
						ftpRes = GSM_FTP_NET_ERR;
						
						GSMprintf("\r\n> File upload - activate PDP FAIL. Terminate the operation.");
						
						FuncSkip_Enable(FUNC_GSM_FTP, 40);

						procGSM_FTP_Upload_Step = PROC_STEP_32;

						return tcpRes;
					}

					tcpRes = TCP_PDP_ACTV_ERR;
					
					GSMprintf("\r\n> File upload - retry activate PDP after 40 secs.");
					
					FuncSkip_Enable(FUNC_GSM_FTP, 40);

					procGSM_FTP_Upload_Step = PROC_STEP_11;

					return tcpRes;
				}
			}

			u8FTP_RetryCnt = 0;

			tcp_pdpContext[u8FTP_PDP_ID].bActiv = TRUE;

			tcpRes = TCP_OK;

			procGSM_FTP_Upload_Step = PROC_STEP_12;

			break;
		}

		// Step 12: Query PDP context activation status
		case PROC_STEP_12:
		{
			/*
			HAL_Delay(10);

			// Query PDP context activation status
			bRes = GSM_TCP_GetIP(u8FTP_PDP_ID, cFTP_IP_Addr);

			if(!bRes)
			{
				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;

					GSM_Reset();

					tcpRes = TCP_PDP_ACTV_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_13;

					return tcpRes;
				}

				tcpRes = TCP_PDP_ACTV_ERR;
				
				GSMprintf("\r\n> File upload - retry query PDP status after 40 secs.");
				
				FuncSkip_Enable(FUNC_GSM_FTP, 40);

				procGSM_FTP_Upload_Step = PROC_STEP_12;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;
			*/

			tcpRes = TCP_OK;

			procGSM_FTP_Upload_Step = PROC_STEP_13;

			break;
		}
		
		// Step 13: Configure the PDP context ID for FTP
		case PROC_STEP_13:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_CfgPDP(u8FTP_PDP_ID);

			if(!bRes)
			{
				tcpRes = TCP_FTP_PDP_CONFIG_ERR;

				u8FTP_RetryCnt++;
				
				if(u8FTP_RetryCnt == GSM_FUNCTION_RETRY_MAX)
				{
					u8FTP_RetryCnt = 0;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_31;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_13;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			if(bFTP_SetupFinish == TRUE)
				procGSM_FTP_Upload_Step = PROC_STEP_24;
			else
				procGSM_FTP_Upload_Step = PROC_STEP_14;

			tcpRes = TCP_OK;

			break;
		}

		// Step 14: Configure FTP server account
		case PROC_STEP_14:
		{
			HAL_Delay(10);

			bRes = GSM_FTP_CfgAcc(g_Setting.tGSM_SET.tFTP_Set.cUserName, 
			                      g_Setting.tGSM_SET.tFTP_Set.cPassword);

			if(!bRes)
			{
				tcpRes = TCP_FTP_ACC_CONFIG_ERR;

				u8FTP_RetryCnt++;

				if(u8FTP_RetryCnt >= GSM_FUNCTION_RETRY_MAX)
				//if(u8FTP_RetryCnt == 3)
				{
					u8FTP_RetryCnt = 0;
					
					ftpRes = GSM_FTP_OTHER_ERR;

					procGSM_FTP_Upload_Step = PROC_STEP_31;

					//GSM_Reset();

					return tcpRes;
				}
				else
					procGSM_FTP_Upload_Step = PROC_STEP_14;

				return tcpRes;
			}

			u8FTP_RetryCnt = 0;

			procGSM_FTP_Upload_Step = PROC_STEP_15;

			tcpRes = TCP_OK;

			break;
		}

		// Step 15: Configure FTP file type
		case PROC_STEP_15:
		{
			/*
			HAL_Delay(10);
			
			bRes = GSM_FTP_CfgFileType();

			if(!bRes)
