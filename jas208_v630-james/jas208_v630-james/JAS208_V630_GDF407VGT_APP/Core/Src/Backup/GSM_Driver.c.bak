//============================================================================//
// @brief  Handle the GSM non-blocking requests.
// @param  None.
// @retval None.
//============================================================================//
void GSM_NonBlockCmdHandle(void)
{
	uint32_t u32Arg[5];
	uint8_t u8RetVal;


	if(qtec21_NonBlockCmdInstance.qtec21Cmd == QTEC21_NULL)
		return;

	u32Arg[0] = qtec21_NonBlockCmdInstance.u32Arg[0];
	u32Arg[1] = qtec21_NonBlockCmdInstance.u32Arg[1];
	u32Arg[2] = qtec21_NonBlockCmdInstance.u32Arg[2];
	u32Arg[3] = qtec21_NonBlockCmdInstance.u32Arg[3];
	u32Arg[4] = qtec21_NonBlockCmdInstance.u32Arg[4];


	switch(qtec21_NonBlockCmdInstance.qtec21Cmd)
	{
		case QTEC21_SMS_SEND:
		{
			osStatus osRes;


			osRes = osMutexWait(mutex_gsm_rx_user, S_2_mS(120));

			if(osRes != osOK)
			{
				qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

				if(qtec21_NonBlockCmdInstance.pu8RetVal != NULL)
					*(qtec21_NonBlockCmdInstance.pu8RetVal) = 0;

				osMessagePut(GSM_NonBlockCompleteHandle, QTEC21_SMS_SEND, 0);

				HAL_Delay(3);

				qtec21_NonBlockCmdInstance.bInUse = FALSE;

				return;
			}

			qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

			u8RetVal = (uint8_t)QtEC21_SMS_Send((GSM_MsgDataTypeDef *)u32Arg[0]);

			gsmCurrNonBlockCmd = QTEC21_SMS_SEND;

			if(qtec21_NonBlockCmdInstance.pu8RetVal != NULL)
				*(qtec21_NonBlockCmdInstance.pu8RetVal) = u8RetVal;

			osMessagePut(GSM_NonBlockCompleteHandle, QTEC21_SMS_SEND, 0);

			osTimerStart(timerRTOS_GSM_NonBlockHandle, S_2_mS(GSM_SMS_SEND_TIMEOUT));

			osMutexRelease(mutex_gsm_rx_user);

			break;
		}

		case QTEC21_TCP_CONN_OPEN:
		{
			osStatus osRes;


			osRes = osMutexWait(mutex_gsm_rx_user, S_2_mS(120));
			
			if(osRes != osOK)
			{
				qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

				if(qtec21_NonBlockCmdInstance.pu8RetVal != NULL)
					*(qtec21_NonBlockCmdInstance.pu8RetVal) = 0;

				osMessagePut(GSM_NonBlockCompleteHandle, QTEC21_TCP_CONN_OPEN, 0);

				HAL_Delay(3);

				qtec21_NonBlockCmdInstance.bInUse = FALSE;

				return;
			}
			
			qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

			gsmCurrNonBlockCmd = QTEC21_TCP_CONN_OPEN;

			QtEC21_TCP_OpenConn((uint8_t)u32Arg[0], (uint8_t)u32Arg[1], (GSM_SocketConnTypeDef *)u32Arg[2]);

			osTimerStart(timerRTOS_GSM_NonBlockHandle, S_2_mS(TCP_OPEN_CONN_TIMEOUT));
			
			osMutexRelease(mutex_gsm_rx_user);

			break;
		}

		//case QTEC21_TCP_CONN_CLOSE:
		//{
		//	osStatus osRes;


		//	osRes = osMutexWait(mutex_gsm_rx_user, S_2_mS(120));
			
		//	if(osRes != osOK)
		//	{
		//		qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

		//		if(qtec21_NonBlockCmdInstance.pu8RetVal != NULL)
		//			*(qtec21_NonBlockCmdInstance.pu8RetVal) = 0;

		//		osMessagePut(GSM_NonBlockCompleteHandle, QTEC21_TCP_CONN_CLOSE, 0);

		//		HAL_Delay(3);

		//		qtec21_NonBlockCmdInstance.bInUse = FALSE;

		//		return;
		//	}
			
		//	qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

		//	gsmCurrNonBlockCmd = QTEC21_TCP_CONN_CLOSE;

		//	QtEC21_TCP_CloseConn((uint8_t)u32Arg[0], (uint16_t)u32Arg[1]);

		//	osTimerStart(timerRTOS_GSM_NonBlockHandle, S_2_mS((uint16_t)u32Arg[1] + 5));
			
		//	osMutexRelease(mutex_gsm_rx_user);

		//	break;
		//}

		case QTEC21_FTP_LOGIN:
		{
			osStatus osRes;


			osRes = osMutexWait(mutex_gsm_rx_user, S_2_mS(120));

			if(osRes != osOK)
			{
				qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

				if(qtec21_NonBlockCmdInstance.pu8RetVal != NULL)
					*(qtec21_NonBlockCmdInstance.pu8RetVal) = 0;

				osMessagePut(GSM_NonBlockCompleteHandle, QTEC21_FTP_LOGIN, 0);

				HAL_Delay(3);

				qtec21_NonBlockCmdInstance.bInUse = FALSE;

				return;
			}

			qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

			u8RetVal = (uint8_t)QtEC21_FTP_Login((char *)u32Arg[0], (uint16_t)u32Arg[1]);

			if(qtec21_NonBlockCmdInstance.pu8RetVal != NULL)
				*(qtec21_NonBlockCmdInstance.pu8RetVal) = u8RetVal;

			osMessagePut(GSM_NonBlockCompleteHandle, QTEC21_FTP_LOGIN, 0);

			if(u8RetVal)
			{
				gsmCurrNonBlockCmd = QTEC21_FTP_LOGIN;

				osTimerStart(timerRTOS_GSM_NonBlockHandle, S_2_mS(FTP_FUNCTION_TIMEOUT));
				
				//HAL_Delay(3);
				
				//qtec21_NonBlockCmdInstance.bInUse = FALSE;
			}
			else
			{
				HAL_Delay(3);

				qtec21_NonBlockCmdInstance.bInUse = FALSE;
			}

			osMutexRelease(mutex_gsm_rx_user);

			break;
		}

		case QTEC21_FTP_SET_DIR:
		{
			osStatus osRes;


			osRes = osMutexWait(mutex_gsm_rx_user, S_2_mS(120));

			if(osRes != osOK)
			{
				qtec21_NonBlockCmdInstance.qtec21Cmd = QTEC21_NULL;

				if(qtec21_NonBlockCmdInstance.pu8RetVal != NULL)
					*(qtec21_NonBlockCmdInstance.pu8RetVal) = 0;

