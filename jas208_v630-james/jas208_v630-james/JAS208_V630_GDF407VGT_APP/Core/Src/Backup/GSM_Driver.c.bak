					if(event.value.v == GSM_EVENT_GETDATE_SUCCESS)
					{
						bRes = TRUE;

						break;
					}
					else if(event.value.v == GSM_EVENT_GETDATE_ERROR)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_GETDATE_NO_RESPONSE)
					{
						bRes = FALSE;

						break;
					}
					else if(event.value.v == GSM_EVENT_NULL)
					{
						u8FTP_RetryCnt = 0;
						
