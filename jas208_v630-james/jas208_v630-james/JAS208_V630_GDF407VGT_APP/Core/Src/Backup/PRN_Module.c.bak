//============================================================================//
// User Functions
//============================================================================//
#if ENABLE_PRINTER
static void PRN_SendBuffer(uint8_t *Buf, uint16_t BufLen)
{
	UART_SendBuffer(PRINTER_COMPORT_DEF, Buf, BufLen);

	if(g_Setting.DebugMode == DBG_DB9)
	{
		UART_SendBuffer(SET_COMPORT_DEF, Buf, BufLen);
	}
}

void PRN_PrintTest(void)
{
	uint8_t PrnBuf[UART_BASE_BUFFER_SIZE];
	char *pBuf;


	PRN_SendBuffer((uint8_t*)STR_PRINT_HEAD, strlen(STR_PRINT_HEAD));

	pBuf = (char*)PrnBuf;

	sprintf(pBuf, "This is test page\r\n");

	pBuf += strlen(pBuf);

	sprintf(pBuf, "%s %s %s %s V%d.%02d B%04d%s\r\n",
	        STR_TITLE,
	        STR_PRODUCT,
	        STR_CUST,
	        STR_HW,
	        VERSION_MAJOR,
	        VERSION_MINOR,
	        VERSION_BUILD,
	        VERSION_TEST);
	pBuf += strlen(pBuf);

	pBuf = (char*)PrnBuf;

	PRN_SendBuffer(PrnBuf, strlen(pBuf));

	PRN_SendBuffer((uint8_t*)STR_PRINT_END, strlen(STR_PRINT_END));
}

#if ENABLE_BGTVT_2011
void PRN_PrintStd(time_t *rawtime)
{
	bool DrvLogin;
	char *pStr, PrnBuf[512];
	time_t LocalTime;


	Datalog_DirectSave();

	PRN_SendBuffer((uint8_t*)STR_PRINT_HEAD, strlen(STR_PRINT_HEAD));

	LocalTime = *rawtime + g_Setting.i32TimeZoneOffset;

	pStr = PrnBuf;

	sprintf(pStr, "%s ", strPRN_Date);

	pStr += strlen(pStr);

	strftime(pStr, sizeof(PrnBuf), "%y/%m/%d\r\n", localtime(&LocalTime));

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	pStr = PrnBuf;

	sprintf(pStr, "%s ", strPRN_Time);

	pStr += strlen(pStr);

	strftime(pStr, sizeof(PrnBuf), "%H:%M:%S\r\n", localtime(&LocalTime));

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	sprintf(PrnBuf, "%s\r  %s\r\n", strPRN_CompName, g_Setting.szCompName);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	sprintf(PrnBuf, "%s\r  %s\r\n", strPRN_CompAddr, g_Setting.szCompAddr);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	sprintf(PrnBuf, "%s\r  %s\r\n", strPRN_VehicleID, g_Setting.szVIN);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	sprintf(PrnBuf, "%s\r  %s\r\n", strPRN_VehicleLPN, g_Setting.szBus_ID);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	{
		uint8_t i;
		DRV_DATA_t DrvData;


		DrvLogin = FALSE;
		// 取得駕駛資訊
		for(i = 0; i < DRIVER_INFO_MAX; i++)
		{
			if(Info_GetDrvData(i, &DrvData) == TRUE
			        && DrvData.IN == g_Setting.u32DrvIdNum)
			{
				DrvLogin = TRUE;

				break;
			}
		}

		if(DrvLogin == TRUE)
		{
			time_t TempTime;


			sprintf(PrnBuf, "%s\r %s\r\n", strPRN_DrvName, DrvData.NAME);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s\r %s\r\n", strPRN_DrvLN, DrvData.szLicense);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			pStr = PrnBuf;

			sprintf(pStr, "%s\r ", strPRN_DrvIssue);

			pStr += strlen(pStr);

			TempTime = DrvData.ISSUE_DATE;

			strftime(pStr, sizeof(PrnBuf), "%y/%m/%d\r\n", localtime(&TempTime));

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			pStr = PrnBuf;

			sprintf(pStr, "%s\r ", strPRN_DrvExpire);

			pStr += strlen(pStr);

			TempTime = DrvData.EXPIRE_DATE;

			strftime(pStr, sizeof(PrnBuf), "%y/%m/%d\r\n", localtime(&TempTime));

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
		}
		else
		{
			sprintf(PrnBuf, "%s\r xxxxxxxxxx\r\n", strPRN_DrvName);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s\r xxxxxxxxxx\r\n", strPRN_DrvLN);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s\r xx/xx/xx\r\n", strPRN_DrvIssue);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s\r xx/xx/xx\r\n", strPRN_DrvExpire);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
		}
	}

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	{
		time_t DestTime;
		uint8_t i;
		DATALOG_BGTVT_t DataLog;


		sprintf(PrnBuf, "%s\r\n", strPRN_SpeedInfo);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		DestTime = *rawtime - (*rawtime % MINUTE_2_SECOND(1));

		for(i = 0; i < COUNT_SPD_PRN; i++)
		{
			pStr = PrnBuf;


			LocalTime = DestTime + g_Setting.i32TimeZoneOffset;

			strftime(PrnBuf, sizeof(PrnBuf), "%y/%m/%d,%H:%M:%S", localtime(&LocalTime));

			pStr += strlen(pStr);

			if(Datalog_GetLogByTime(&DestTime, &DataLog) == TRUE)
			{
				sprintf(pStr, "%03d", DataLog.SPEED);
			}
			else
			{
				sprintf(pStr, "000");
			}

			pStr += strlen(pStr);

			sprintf(pStr, "\r\n");

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			DestTime -= MINUTE_2_SECOND(1);
		}
	}

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	{
		if(DrvLogin == TRUE)
		{
			sprintf(PrnBuf, "%s %03d\r\n\n",
			        strPRN_CntOverSpeed,
			        g_SysInfo.DrvInfo.CntOverSpeed);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s %02d:%02d\r\n",
			        strPRN_WorkTime,
			        (g_SysInfo.DrvInfo.WorkTime / 60) / 60,
			        (g_SysInfo.DrvInfo.WorkTime / 60) % 60);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s %02d\r\n\n",
			        strPRN_CntOverWork,
			        g_SysInfo.DrvInfo.CntOverWork);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s %02d:%02d\r\n",
			        strPRN_AccumTime,
			        (g_SysInfo.DrvInfo.AccumTime / 60) / 60,
			        (g_SysInfo.DrvInfo.AccumTime / 60) % 60);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s %02d\r\n\n",
			        strPRN_CntOverAccum,
			        g_SysInfo.DrvInfo.CntOverAccum);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s %03d\r\n",
			        strPRN_CntDoorOpen,
			        g_SysInfo.DrvInfo.CntDoorOpen);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s %03d\r\n",
			        strPRN_CntDoorClose,
			        g_SysInfo.DrvInfo.CntDoorClose);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s %03d\r\n",
			        strPRN_CntEngineOn,
			        g_SysInfo.DrvInfo.CntEngineOn);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s %03d\r\n",
			        strPRN_CntEngineOff,
			        g_SysInfo.DrvInfo.CntEngineOff);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
		}
		else
		{
			sprintf(PrnBuf, "%s xxx\r\n\n", strPRN_CntOverSpeed);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s xx:xx\r\n", strPRN_WorkTime);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s xx\r\n\n", strPRN_CntOverWork);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s xx:xx\r\n", strPRN_AccumTime);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s xx\r\n\n", strPRN_CntOverAccum);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf,  "%s xxx\r\n", strPRN_CntDoorOpen);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s xxx\r\n", strPRN_CntDoorClose);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s xxx\r\n", strPRN_CntEngineOn);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

			sprintf(PrnBuf, "%s xxx\r\n", strPRN_CntEngineOff);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
		}
	}

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	PRN_SendBuffer((uint8_t*)STR_PRINT_END, strlen(STR_PRINT_END));
}

void PRN_PrintExt1(time_t *rawtime)
{
	bool DrvLogin;
	char PrnBuf[512];
	DATALOG_BGTVT_t DataLog;
	uint8_t i;
	DRV_DATA_t DrvData;
	time_t LocalTime;


	if(Datalog_GetLogByTime(rawtime, &DataLog) == FALSE)
	{
		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		sprintf(PrnBuf, "BKS: %s\r\n", g_Setting.szBus_ID);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "LX: xxxxxxxxxx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "So GPLX: xxxxxxxxxx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "So se-ri TBGSHT:%s\r\n", g_Setting.szBus_SN);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		LocalTime = *rawtime + g_Setting.i32TimeZoneOffset;

		strftime(PrnBuf, 64, "Thoi diem in: %H:%M:%S\r\n              %d/%m/%y\r\n", localtime(&LocalTime));

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		sprintf(PrnBuf, "So lan vuot toc do: xx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		sprintf(PrnBuf, "So lan mo cua xe: xx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		sprintf(PrnBuf, "LXLT: xx gio xx phut\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "LXTN: xx gio xx phut\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		PRN_SendBuffer((uint8_t*)STR_PRINT_END, strlen(STR_PRINT_END));

		return;
	}

	DrvLogin = FALSE;

	// 取得駕駛資訊
	for(i = 0; i < DRIVER_INFO_MAX; i++)
	{
		if(Info_GetDrvData(i, &DrvData) == TRUE
		        && DrvData.IN == DataLog.u32DRV_IN)
		{
			DrvLogin = TRUE;

			break;
		}
	}

	PRN_SendBuffer((uint8_t*)STR_PRINT_HEAD, strlen(STR_PRINT_HEAD));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	sprintf(PrnBuf, "BKS: %s\r\n", g_Setting.szBus_ID);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	if(DrvLogin == TRUE)
	{
		sprintf(PrnBuf, "LX: %s\r\n", DrvData.NAME);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "So GPLX: %s\r\n", DrvData.szLicense);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
	}
	else
	{
		sprintf(PrnBuf, "LX: xxxxxxxxxx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "So GPLX: xxxxxxxxxx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
	}

	sprintf(PrnBuf, "So se-ri TBGSHT:%s\r\n", g_Setting.szBus_SN);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	LocalTime = DataLog.UTC + g_Setting.i32TimeZoneOffset;

	strftime(PrnBuf, 64, "Thoi diem in: %H:%M:%S\r\n              %d/%m/%y\r\n", localtime(&LocalTime));

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	memset((uint8_t*)PrnBuf, 0x00, strlen(PrnBuf));

	if(Datalog_EventPrnByLog(&DataLog, PrnBuf) == TRUE)
	{
		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
	}
	else
	{
		sprintf(PrnBuf, "So lan vuot toc do: 00\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		sprintf(PrnBuf, "So lan mo cua xe: 00\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
	}

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	if(DrvLogin == TRUE)
	{
		sprintf(PrnBuf, "LXLT: %02d gio %02d phut\r\n",
		        S_2_HOUR(DataLog.DRV_LCDT),
		        S_2_MIN(DataLog.DRV_LCDT) % 60);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "LXTN: %02d gio %02d phut\r\n",
		        S_2_HOUR(DataLog.DRV_LTWT),
		        S_2_MIN(DataLog.DRV_LTWT) % 60);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
	}
	else
	{
		sprintf(PrnBuf, "LXLT: xx gio xx phut\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "LXTN: xx gio xx phut\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
	}

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	PRN_SendBuffer((uint8_t*)STR_PRINT_END, strlen(STR_PRINT_END));

}

void PRN_PrintExt2(time_t *rawtime)
{
	bool DrvLogin;
	char PrnBuf[512];
	DATALOG_BGTVT_t DataLog;
	uint8_t i;
	DRV_DATA_t DrvData;
	time_t LocalTime;


	if(Datalog_GetLogByTime(rawtime, &DataLog) == FALSE)
	{
		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		sprintf(PrnBuf, "BKS: %s\r\n", g_Setting.szBus_ID);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "LX: xxxxxxxxxx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "So GPLX: xxxxxxxxxx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "So se-ri TBGSHT:%s\r\n", g_Setting.szBus_SN);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		LocalTime = *rawtime + g_Setting.i32TimeZoneOffset;

		strftime(PrnBuf, 64, "Thoi diem in: %H:%M:%S\r\n              %d/%m/%y\r\n", localtime(&LocalTime));

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		// 取得駕駛資訊
		for(i = 0; i < COUNT_SPD_PRN; i++)
		{
			sprintf(PrnBuf, "%2d: 000 km/h\r\n", i + 1);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
		}

		// 列印區分間隔
		PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

		PRN_SendBuffer((uint8_t*)STR_PRINT_END, strlen(STR_PRINT_END));

		return;
	}

	DrvLogin = FALSE;
	// 取得駕駛資訊
	for(i = 0; i < DRIVER_INFO_MAX; i++)
	{
		if(Info_GetDrvData(i, &DrvData) == TRUE
		        && DrvData.IN == DataLog.u32DRV_IN)
		{
			DrvLogin = TRUE;

			break;
		}
	}

	PRN_SendBuffer((uint8_t*)STR_PRINT_HEAD, strlen(STR_PRINT_HEAD));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	sprintf(PrnBuf, "BKS: %s\r\n", g_Setting.szBus_ID);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	if(DrvLogin == TRUE)
	{
		sprintf(PrnBuf, "LX: %s\r\n", DrvData.NAME);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "So GPLX: %s\r\n", DrvData.szLicense);

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
	}
	else
	{
		sprintf(PrnBuf, "LX: xxxxxxxxxx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

		sprintf(PrnBuf, "So GPLX: xxxxxxxxxx\r\n");

		PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
	}

	sprintf(PrnBuf, "So se-ri TBGSHT:%s\r\n", g_Setting.szBus_SN);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	LocalTime = DataLog.UTC + g_Setting.i32TimeZoneOffset;

	strftime(PrnBuf, 64, "Thoi diem in: %H:%M:%S\r\n              %d/%m/%y\r\n", localtime(&LocalTime));

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	sprintf(PrnBuf, " 1: %03d km/h\r\n", DataLog.SPEED);

	PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));

	for(i = 1; i < COUNT_SPD_PRN; i++)
	{
		time_t DestTime;


		DestTime = *rawtime - i;

		if(Datalog_GetLogByTime(&DestTime, &DataLog) == TRUE)
		{
			sprintf(PrnBuf, "%2d: %03d km/h\r\n", i + 1, DataLog.SPEED);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
		}
		else
		{
			sprintf(PrnBuf, "%2d: 000 km/h\r\n", i + 1);

			PRN_SendBuffer((uint8_t*)PrnBuf, strlen(PrnBuf));
		}
	}

	// 列印區分間隔
	PRN_SendBuffer((uint8_t*)STR_SEPARATE, strlen(STR_SEPARATE));

	PRN_SendBuffer((uint8_t*)STR_PRINT_END, strlen(STR_PRINT_END));
}
#else // ENABLE_BGTVT_2011
