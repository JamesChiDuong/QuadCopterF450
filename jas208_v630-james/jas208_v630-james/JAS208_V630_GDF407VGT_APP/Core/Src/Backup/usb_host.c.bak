/**
  * Init USB host library, add supported class and start the library
  * @retval None
  */
void MX_USB_HOST_Init(void)
{
  /* USER CODE BEGIN USB_HOST_Init_PreTreatment */

  /* USER CODE END USB_HOST_Init_PreTreatment */

  /* Init host Library, add supported class and start the library. */
  if (USBH_Init(&hUsbHostFS, USBH_UserProcess, HOST_FS) != USBH_OK)
  {
    Error_Handler();
  }
  if (USBH_RegisterClass(&hUsbHostFS, USBH_MSC_CLASS) != USBH_OK)
  {
    Error_Handler();
  }
  if (USBH_Start(&hUsbHostFS) != USBH_OK)
  {
    Error_Handler();
  }
  /* USER CODE BEGIN USB_HOST_Init_PostTreatment */

  /* USER CODE END USB_HOST_Init_PostTreatment */
}

/*
 * user callback definition
 */
static void USBH_UserProcess  (USBH_HandleTypeDef *phost, uint8_t id)
{
  /* USER CODE BEGIN CALL_BACK_1 */

	switch(id)
	{
		case HOST_USER_SELECT_CONFIGURATION:
			bUSB_Ready = FALSE;

			bUSB_Mounted = FALSE;

			break;

		case HOST_USER_DISCONNECTION:
			Appli_state = APPLICATION_DISCONNECT;

			bUSB_Ready = FALSE;

			bUSB_Mounted = FALSE;

			RTOSprintf("\r\n> USB device disconnected.");
		
		  u8USB_ReportEvent = 2;
		
		  if(u8ShowMenuItem == 26)
				LCD_SetShowAutoTestPage(50);

			break;

		case HOST_USER_CLASS_ACTIVE:
			Appli_state = APPLICATION_READY;

			bUSB_Ready = TRUE;

			bUSB_Mounted = FALSE;

			bUSB_RunOne = TRUE;
		
			gAppCfg.AUTH = APP_AUTH_USER;

			gAppCfg.LOG_CNT = GET_DATALOG_USER_DEF;
		
			RTOSprintf("\r\n> USB device ready.");
		
		  u8USB_ReportEvent = 1;

			//osMessagePut(AppliEventHandle, APPLICATION_READY, 0);

			break;

		case HOST_USER_CONNECTION:
			Appli_state = APPLICATION_START;

			bUSB_Ready = FALSE;

			bUSB_Mounted = FALSE;

			RTOSprintf("\r\n> USB device connected.");

			break;

		default:
			break;
	}

  /* USER CODE END CALL_BACK_1 */
}

