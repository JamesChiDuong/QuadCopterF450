//
//============================================================================//
void SIM968_BuildTestCmd(char *CMD)
{
	uint8_t Buf[GSM_MAX_BUFFER_SIZE];
	char *pStr;

	//
	pStr = (char*)Buf;
	//
	sprintf(pStr, "%d,%s", AT_CMD_TEST, CMD);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
}

//============================================================================//
//
//============================================================================//
static void SIM968_RetrieveUpgradeFile(void)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	//
	sprintf(pStr, "%d,AT+FTPSIZE", AT_FTP_GET_SIZE);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));

	//
	UpgradeFileSize = 0;
	//
	UpgradeFileOffset = 0;

}

//============================================================================//
//
//============================================================================//
static bool SIM968_UpgradeFirmware(void)
{
	//
	if(SIM968_GetNetStatus() == FALSE)
		return FALSE;

	//
	SIM968_RetrieveUpgradeFile();

	//
	return TRUE;
}

//============================================================================//
//
//============================================================================//
bool SIM968_SystemUpgrade(void)
{
	//
	if(UpgradeFileSize || UpgradeFileOffset)
		return FALSE;

	//
	if(TID_UpgradeFirmware != TIMER_INVALID_ID)
		return FALSE;
	//
	TID_UpgradeFirmware = SWTIM_SetTimer(S_2_mS(MINUTE_2_SECOND(1)), TIMER_ONESHOT, SIM968_UpgradeFirmware);

	//
	return TRUE;
}

