//============================================================================//
//
#define	RANGE_FULL_LEVEL		100
//
#define	RANGE_SPK_LEVEL_MAX		100
//
#define	RANGE_MIC_LEVEL_MAX		15

//============================================================================//
//
//============================================================================//
static uint8_t SIM968_GetSpkGain(void)
{
	//
	return (uint16_t)g_Setting.GSM_SET.LevelSpkGain * RANGE_SPK_LEVEL_MAX / RANGE_FULL_LEVEL;
}

//============================================================================//
//
//============================================================================//
void SIM968_SetSpeakerGain(void)
{
	uint8_t Buf[32];
	char *pStr;

	//
	pStr = (char*)Buf;
	//
	sprintf(pStr, "%d,AT+CLVL=%d",
	        AT_SPK_VOLUME_SET,
	        SIM968_GetSpkGain());
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
}

//============================================================================//
//
//============================================================================//
static uint8_t SIM968_GetMicGain(void)
{
	//
	return (uint16_t)g_Setting.GSM_SET.LevelMicGain * RANGE_MIC_LEVEL_MAX / RANGE_FULL_LEVEL;
}

