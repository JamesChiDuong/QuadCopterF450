			  osRes = osMutexWait(mutex_uart_user[SET_COMPORT_DEF], S_2_mS(5));
			else
			  osRes = osMutexWait(mutex_uart_user[DB9_COMPORT_DEF], S_2_mS(5));

			if(osRes != osOK)
			{
				va_end(arg);

				return;
			}
		}

		vfprintf(stdout, format, arg);

		if(bRTOS_En)
		{
			// Release uart synchronization
		  if(UART_IsTerminalUsingSET())
			  osMutexRelease(mutex_uart_user[SET_COMPORT_DEF]);
			else
			  osMutexRelease(mutex_uart_user[DB9_COMPORT_DEF]);
		}
	}
	
	va_end(arg);
}

//============================================================================//
// @brief  Print a string for CAN function with consideration to RTOS 
//         implementation and debug mode.
// @param  format: formatted string for print.
//         ... varied length argument
// @retval None.
//============================================================================//
void GSprintf(char* format,...)
{
	va_list arg;
	osStatus osRes;


	if(UART_IsDebugMode(DBG_GS) == FALSE)
		return;
	
	va_start(arg, format);

	if(bPrintfEn)
	{
		if(bRTOS_En)
		{
			// Acquire uart synchronization
			if(UART_IsTerminalUsingSET())
			  osRes = osMutexWait(mutex_uart_user[SET_COMPORT_DEF], S_2_mS(5));
			else
			  osRes = osMutexWait(mutex_uart_user[DB9_COMPORT_DEF], S_2_mS(5));

			if(osRes != osOK)
			{
				va_end(arg);

				return;
			}
		}

		vfprintf(stdout, format, arg);

		if(bRTOS_En)
		{
			// Release uart synchronization
		  if(UART_IsTerminalUsingSET())
			  osMutexRelease(mutex_uart_user[SET_COMPORT_DEF]);
			else
			  osMutexRelease(mutex_uart_user[DB9_COMPORT_DEF]);
		}
	}
	
	va_end(arg);
}

