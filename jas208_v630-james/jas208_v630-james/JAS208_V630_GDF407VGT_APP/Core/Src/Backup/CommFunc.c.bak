//============================================================================//
// User Functions
//============================================================================//

//============================================================================//
// @brief  Delay in microseconds.
// @param  u32_uSec: Number of microseconds to delay.
// @retval None.
//============================================================================//
void Delay_uS(const uint32_t u32uSec)
{
	uint32_t u32Cnt = 0;
	const uint32_t u32Time = (120 * u32uSec / 7);


	do
	{
		if(++u32Cnt > u32Time)
			return;
	}
	while(1);
}

//============================================================================//
// @brief  Delay in milliseconds.
// @param  u32_uSec: Number of microseconds to delay.
// @retval None.
//============================================================================//
void Delay_mS(uint32_t u32mSec)
{
	if(bRTOS_En)
		osDelay(u32mSec);
	else
		HAL_Delay(u32mSec);
}

//============================================================================//
// @brief  malloc() with consideration of FreeRTOS implementation.
// @param  size: Number of bytes to allocate.
// @retval void pointer to the allocated memory block.
//============================================================================//
void *RTOSmalloc(size_t size)
{
	void *ptr = NULL;

	
	if(size > 0)
	{
		// We simply wrap the FreeRTOS call into a standard form
		if(bRTOS_En)
		  ptr = pvPortMalloc(size);
		  //ptr = malloc(size);
		else
			ptr = malloc(size);
	} 
	
	return ptr;
}

//============================================================================//
// @brief  free() with consideration of FreeRTOS implementation.
// @param  *ptr: Pointer to the memory block which needs to be freed.
// @retval None.
//============================================================================//
void RTOSfree(void *ptr)
{
	if(ptr)
	{
		// We simply wrap the FreeRTOS call into a standard form
		if(bRTOS_En)
		  vPortFree(ptr);
		  //free(ptr);
		else
			free(ptr);
	}
}

//============================================================================//
// @brief  Convert a number in Binary format to BCD format.
// @param  u8BinVal: Number in Binary format.
// @retval BCD number in uint8_t format.
//============================================================================//
uint8_t Bin_2_BCD(uint8_t u8BinVal)
{
	uint8_t u8BCD_High = 0;


	while (u8BinVal >= 10)
	{
		u8BCD_High++;

		u8BinVal -= 10;
	}

	return ((uint8_t)(u8BCD_High << 4) | u8BinVal);
}

//============================================================================//
// @brief  Convert a number in BCD format to Binary format.
// @param  u8BinVal: Number in BCD format.
// @retval Binary number in uint8_t format.
//============================================================================//
uint8_t BCD_2_Bin(uint8_t u8BCD_Val)
{
	uint8_t u8Temp = 0;


	u8Temp = ((uint8_t)(u8BCD_Val & (uint8_t)0xF0) >> (uint8_t)0x04) * 10;

	return (u8Temp + (u8BCD_Val & (uint8_t)0x0F));
}

//============================================================================//
// @brief  Convert the low part in a BCD byte to a ASCII character.
// @param  u8BCDByte: Number in BCD format.
// @retval Character in ASCII format.
//============================================================================//
uint8_t LowBCDToASCII(uint8_t u8BCDByte)
{
	uint8_t u8Buf;


	u8Buf = u8BCDByte & 0x0F;

	u8Buf |= 0x30;

	return u8Buf;
}

//============================================================================//
// @brief  Convert the high part in a BCD byte to a ASCII character.
// @param  u8BCDByte: Number in BCD format.
// @retval Character in ASCII format.
//============================================================================//
uint8_t HIGHBCDToASCII(uint8_t u8BCDByte)
{
	uint8_t u8Buf;


	u8Buf = (u8BCDByte >> 4);

	u8Buf &= 0x0F;

	u8Buf |= 0x30;

	return u8Buf;
}

//============================================================================//
// @brief  Convert the low part in a BCD byte to a decimal number.
// @param  u8BCDByte: Number in BCD format.
// @retval Character in ASCII format.
//============================================================================//
uint8_t LowBCDToNum(uint8_t u8BCDByte)
{
	uint8_t u8Buf;


	u8Buf = u8BCDByte & 0x0F;

	return u8Buf;
}

//============================================================================//
// @brief  Convert the high part in a BCD byte to a decimal number.
// @param  u8BCDByte: Number in BCD format.
// @retval Character in ASCII format.
//============================================================================//
uint8_t HIGHBCDToNum(uint8_t u8BCDByte)
{
	uint8_t u8Buf;


	u8Buf = (u8BCDByte >> 4);

	u8Buf &= 0x0F;

	return u8Buf;
}

//============================================================================//
// @brief  Convert a number in Binary format to BCD format ver 2.
// @param  u8BinVal: Number in Binary format.
// @retval BCD number in uint8_t format.
//============================================================================//
uint8_t Bin_2_BCD2(uint8_t u8BinValue)
{
	uint8_t u8BCDHigh = 0;


	while(u8BinValue >= 10)
	{
		u8BCDHigh++;

		u8BinValue -= 10;
	}

	return ((uint8_t)(u8BCDHigh << 4) | u8BinValue);
}

//============================================================================//
// @brief  Convert a number in BCD format to Binary format ver 2.
// @param  u8BinVal: Number in BCD format.
// @retval Binary number in uint8_t format.
//============================================================================//
uint8_t BCD2_2_Bin(uint8_t u8BCDValue)
{
	uint8_t u8Temp = 0;


	u8Temp = ((uint8_t)(u8BCDValue & (uint8_t)0xF0) >> (uint8_t)0x04) * 10;

	return (u8Temp + (u8BCDValue & (uint8_t)0x0F));
}

//============================================================================//
// @brief  Convert a number of seconds to date time values.
// @param  u32SecData: Number of seconds to convert.
//         u8BCDTime: Pointer to a uint8_t array to store the date time values
// @retval None.
//============================================================================//
void SecToBCDTime(uint32_t u32SecData, uint8_t *pu8BCDTime)
{
	struct tm *ptmHandle;
	time_t ttSecTime;
	uint8_t u8Buf;


	ttSecTime = (time_t)u32SecData; //+ g_Setting.i32TimeZoneOffset;

	ptmHandle = localtime(&ttSecTime);

	u8Buf = (ptmHandle->tm_year + 1900) / 100;

	pu8BCDTime[0] = Bin_2_BCD2(u8Buf);

	u8Buf = (ptmHandle->tm_year + 1900) % 100;

	pu8BCDTime[1] = Bin_2_BCD2(u8Buf);
	pu8BCDTime[2] = Bin_2_BCD2(ptmHandle->tm_mon + 1);
	pu8BCDTime[3] = Bin_2_BCD2(ptmHandle->tm_mday);
	pu8BCDTime[4] = Bin_2_BCD2(ptmHandle->tm_hour);
	pu8BCDTime[5] = Bin_2_BCD2(ptmHandle->tm_min);
	pu8BCDTime[6] = Bin_2_BCD2(ptmHandle->tm_sec);
}

//============================================================================//
// @brief  Convert a number of seconds to date time values.
// @param  u32SecData: Number of seconds to convert.
//         u8BCDTime: Pointer to a uint8_t array to store the date time values
// @retval Second in format uint32_t.
//============================================================================//
uint32_t BCDTimeToSec(uint8_t *u8BCDTime)
{
	uint16_t u16Year = 0;
	uint8_t u8MM = 0, u8DD = 0, u8Hr = 0, u8Min = 0, u8Sec = 0;
	uint32_t u32SecTime = 0;
	struct tm tmHandle;


	u16Year = HIGHBCDToNum(u8BCDTime[0]) * 1000 + LowBCDToNum(u8BCDTime[0]) * 100 +
	          HIGHBCDToNum(u8BCDTime[1]) * 10 + LowBCDToNum(u8BCDTime[1]);
	u8MM = HIGHBCDToNum(u8BCDTime[2]) * 10 + LowBCDToNum(u8BCDTime[2]);
	u8DD = HIGHBCDToNum(u8BCDTime[3]) * 10 + LowBCDToNum(u8BCDTime[3]);
	u8Hr = HIGHBCDToNum(u8BCDTime[4]) * 10 + LowBCDToNum(u8BCDTime[4]);
	u8Min = HIGHBCDToNum(u8BCDTime[5]) * 10 + LowBCDToNum(u8BCDTime[5]);
	u8Sec = HIGHBCDToNum(u8BCDTime[6]) * 10 + LowBCDToNum(u8BCDTime[6]);

	//RTOSprintf("\r\n> ### BCDTimeToSec: %04d %02d %02d %02d %02d %02d ###", u16Year, u8MM, u8DD, u8Hr, u8Min, u8Sec);

	tmHandle.tm_year = u16Year - 1900;
	tmHandle.tm_mon = u8MM - 1;
	tmHandle.tm_mday = u8DD;
	tmHandle.tm_hour = u8Hr;
	tmHandle.tm_min = u8Min;
	tmHandle.tm_sec = u8Sec;
	tmHandle.tm_isdst = 0;

	u32SecTime = mktime(&tmHandle); //- g_Setting.i32TimeZoneOffset;
	//RTOSprintf("\r\n> ### u32SecTime: %d ###", u32SecTime);

	return u32SecTime;
}

//============================================================================//
// @brief  Set the first occurence of a character in a string to null character.
// @param  pcStr: Pointer to the string.
//         cEnd: Character to be changed.
// @retval None.
//============================================================================//
void StopChar(char *pcStr, char cEnd)
{
	ChangeChar(pcStr, cEnd, '\0');
}

//============================================================================//
// @brief  Set the first occurence of a character in a string to
//         another character.
// @param  pcStr: Pointer to the string.
//         cSource: Character to be changed.
//         cTarget: Character for changing to.
// @retval None.
//============================================================================//
void ChangeChar(char *pcStr, char cSource, char cTarget)
{
	while(*pcStr)
	{
		if(*(pcStr) == cSource)
		{
			*(pcStr) = cTarget;

			return;
		}

		pcStr++;
	}
}

//============================================================================//
// @brief  Count the number of a character in a string.
// @param  pcStr: Pointer to the string.
//         cChar: Character to count.
// @retval The number of character founded in format uint8_t.
//============================================================================//
uint8_t CountChar(char *pcStr, char cChar)
{
	uint8_t i = 0, CntCh = 0;


	while(*(pcStr + i))
	{
		if(*(pcStr + i) == cChar)
			CntCh++;

		i++;
	}

	return CntCh;
}

//============================================================================//
// @brief  Find the first occurrence of a character sequence in a string.
// @param  pcDat: Pointer to the string.
//         pcSeq: Pointer to the character sequence.
//         pu16Pos: Pointer to the variable indicating the first occurence of
//                  the character sequence.
// @retval True: The character sequence exists in the string.
//         False: The character sequence does not exist in the string.
//============================================================================//
bool FindSequence(char* pcDat, char* pcSeq, uint16_t u16DatLen, uint16_t u16SeqLen, uint16_t* pu16Pos)
{
	char *pcBuf;


	if(u16SeqLen == 0)
		return FALSE;
	
	if(u16DatLen < u16SeqLen)
		return FALSE;

	pcBuf = (char *)RTOSmalloc(sizeof(char) * u16SeqLen);

	if(pcBuf == NULL)
		RTOSprintf("\r\n> Not enough momery space to allocate %d bytes to find sequence \"%s\"!", u16SeqLen, pcSeq);

	*pu16Pos = 0;

	// Compare data string at different positions to the characters sequence
	while((*pu16Pos) != (u16DatLen - u16SeqLen + 1))
	{
		memcpy(pcBuf, &(pcDat[*pu16Pos]), u16SeqLen);

		if(strncmp(pcBuf, pcSeq, u16SeqLen) == 0)
		{
			RTOSfree(pcBuf);

			pcBuf = NULL;

			return TRUE;
		}

		(*pu16Pos)++;
	}

	RTOSfree(pcBuf);

	pcBuf = NULL;

	return FALSE;
}

//============================================================================//
// @brief  Get the date value from the system current time.
// @param  u8BinVal: Number in BCD format.
// @retval Binary number in uint8_t format.
//============================================================================//
uint8_t GetWeekday(uint16_t year, uint8_t month, uint8_t day)
{
	uint8_t days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
	uint16_t d;
	

	days[1] += (year % 400 == 0) || ((year % 4== 0) && (year % 100!= 0));

	d = day;
	
	for(int i = 0; i < month - 1; i++)
	{
		d += days[i];
	}

	year--;
	
	d += year + (year / 4) - (year / 100) + (year / 400);
	d += 7;
	d %= 7;

	return d;
}

//============================================================================//
// @brief  Enable a function to be skipped.
// @param  tFuncTag: Function tag in FuncTagTypeDef format.
//         u32TimeOut: Function skipping timeout, uint Sec.
// @retval None.
//============================================================================//
void FuncSkip_Enable(FuncTagTypeDef tFuncTag, uint32_t u32TimeOut)
{
  if((uint8_t)tFuncTag >= FUNC_SKIP_NUM_MAX)
		return;
	
	if(u32TimeOut > FUNC_SKIP_TIMEOUT_MAX)
		return;
	
	tFuncSkip[tFuncTag].u32TimeOut = S_2_mS(u32TimeOut);
	
	tFuncSkip[tFuncTag].u32LastTick = HAL_GetTick();
	
	tFuncSkip[tFuncTag].bSkip = TRUE;
	
	//RTOSprintf("\r\n> Set function skip for function %d", (uint8_t)tFuncTag);
}

//============================================================================//
// @brief  Enable a function to be skipped.
// @param  tFuncTag: Function tag in FuncTagTypeDef format.
//         u32TimeOut: Function skipping timeout.
// @retval None.
//============================================================================//
void FuncSkip_Disable(FuncTagTypeDef tFuncTag)
{
  if((uint8_t)tFuncTag >= FUNC_SKIP_NUM_MAX)
		return;
	
	tFuncSkip[tFuncTag].bSkip = FALSE;
}

//============================================================================//
// @brief  Enable a function to be skipped.
// @param  tFuncTag: Function tag in FuncTagTypeDef format.
//         u32TimeOut: Function skipping timeout.
// @retval None.
//============================================================================//
bool FuncSkip_IsEnable(FuncTagTypeDef tFuncTag)
{
  if((tFuncSkip[tFuncTag].bSkip == TRUE) &&
		 (HAL_GetTick() < (tFuncSkip[tFuncTag].u32LastTick + tFuncSkip[tFuncTag].u32TimeOut)))
	{
	  return TRUE;
	}
	else
	{
	  return FALSE;
	}
}

//============================================================================//
// @brief  Set the current CRC8 value to an initial value.
// @param  *pu8CRC_Value: Pointer to the value that needs to be reset.
// @retval None.
//============================================================================//
void CRC8_Reset(uint8_t *pu8CRC_Value)
{
	*pu8CRC_Value = CRC8_RESET_VAL;
}

//============================================================================//
// @brief  Calculate and return a CRC8 value.
// @param  u8CRC8_Value: Current CRC8 value.
//         u8Dat: Data for calculating the new CRC8 value.
// @retval The updated CRC32 value in uint8_t format.
//============================================================================//
uint8_t CRC8_Calc(uint8_t u8CRC8_Value, uint8_t u8Dat)
{
	u8CRC8_Value += (uint16_t)u8Dat;

	return u8CRC8_Value;
}

//============================================================================//
// @brief  Set the current CRC16 value to an initial value.
// @param  pu16CRC16_Value: Pointer to the value that needs to be reset.
// @retval None.
//============================================================================//
void CRC16_Reset(uint16_t *pu16CRC16_Value)
{
	// Initial value 0 or 0xFFFF, CRC init. by CRC-CCITT
	*pu16CRC16_Value = CRC16_RESET_VAL;
}

//============================================================================//
// @brief  Calculate and update the current CRC16 value.
// @param  u16CRC16_Value: The current CRC16 value.
//         u8Dat: Data for calculating the new CRC32 value.
// @retval The updated CRC32 value in uint16_t format.
//============================================================================//
uint16_t CRC16_Calc(uint16_t u16CRC16_Value, uint8_t u8Dat)
{
	u16CRC16_Value += (uint16_t)u8Dat;

	return u16CRC16_Value;
}

//============================================================================//
// @brief  Set the current CRC32 value to an initial value.
// @param  pu32CRC32_Value: Pointer to the value that needs to be reset.
// @retval None.
//============================================================================//
void CRC32_Reset(uint32_t *pu32CRC32_Value)
{
	*pu32CRC32_Value = CRC32_RESET_VAL;
}

//============================================================================//
// @brief  Calculate and update the current CRC32 value.
//         u32CRC32_Value: The current CRC32 value.
// @param  u8Dat: Data for calculating the new CRC32 value.
// @retval The updated CRC32 value in uint32_t format.
//============================================================================//
uint32_t CRC32_Calc(uint32_t u32CRC32_Value, uint8_t u8Dat)
{
	CALC_CRC32(u32CRC32_Value, u8Dat);

	return u32CRC32_Value;
}

//============================================================================//
// @brief  Calculate checksum for a data array.
// @param  pu8Dat: Pointer to data array.
//         u32Datlen: Number of bytes to calculate checksum.
// @retval The updated CRC32 value in uint32_t format.
//============================================================================//
uint8_t CalCheckSum(uint8_t *pu8Dat, uint32_t u32DatLen)
{
	uint8_t u8CheckSum = 0;


	for(int i = 0; i < u32DatLen; i++)
	{
		u8CheckSum ^= *pu8Dat;

		pu8Dat++;
	}

	return u8CheckSum;
}

//============================================================================//
// @brief  Print a string with consideration to RTOS implementation.
// @param  format: formatted string for print.
//         ... varied length argument
// @retval None.
//============================================================================//
void RTOSprintf(char* format,...)
{
	va_list arg;
	osStatus osRes;


	va_start(arg, format);

	if(bPrintfEn)
	{
		if(bRTOS_En)
		{
			// Acquire uart synchronization
			if(UART_IsTerminalUsingSET())
			  osRes = osMutexWait(mutex_uart_user[SET_COMPORT_DEF], S_2_mS(5));
			else
			  osRes = osMutexWait(mutex_uart_user[DB9_COMPORT_DEF], S_2_mS(5));
			
			if(osRes != osOK)
			{
				va_end(arg);

				return;
			}
		}

		vfprintf(stdout, format, arg);

		if(bRTOS_En)
		{
			// Release uart synchronization
		  if(UART_IsTerminalUsingSET())
			  osMutexRelease(mutex_uart_user[SET_COMPORT_DEF]);
			else
			  osMutexRelease(mutex_uart_user[DB9_COMPORT_DEF]);
		}
	}

	va_end(arg);
	
	if((bSystemStop == TRUE) || (bSD_ReportErrFlag == TRUE))
		return;

	if(strncmp(format, (char *)STR_SYSTEM_LOG, 9) == 0)
	{
		if(bSysLogEn && bSysInitFinish)
		{
			time_t ttLogTime;
			uint8_t u8LogTime[7];


			va_start(arg, format);

			uint16_t u16EventCode = (uint16_t)va_arg(arg, int);

			ttLogTime = System_GetTime();

			SecToBCDTime(ttLogTime, u8LogTime);

			memset(cSysLogBuf, 0x00, sizeof(cSysLogBuf));

			// Write SYSLOG date and time
			sprintf((char *)cSysLogBuf, "%02X%02X/%02X/%02X %02X:%02X:%02X",
			        u8LogTime[0], u8LogTime[1], u8LogTime[2], u8LogTime[3],
			        u8LogTime[4], u8LogTime[5], u8LogTime[6]);

			cSysLogBuf[19] = 0x00;

			// Write SYSLOG event code
			cSysLogBuf[20] = (uint8_t)u16EventCode;
			cSysLogBuf[21] = (uint8_t)(u16EventCode >> 8);

			u16SysLogSize = 32;

			SD_AddBuffToFile((char *)FILENAME_SYSLOG, (uint8_t *)cSysLogBuf, u16SysLogSize);

			va_end(arg);
		}
	}
}

