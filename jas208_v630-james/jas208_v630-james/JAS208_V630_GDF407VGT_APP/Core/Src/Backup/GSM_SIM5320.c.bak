//============================================================================//
//
//============================================================================//
void SIM5320_GpsOn(void)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	//
	sprintf(pStr, "%d,AT+CGPS=1,2", AT_GPS_TURN_ON);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
