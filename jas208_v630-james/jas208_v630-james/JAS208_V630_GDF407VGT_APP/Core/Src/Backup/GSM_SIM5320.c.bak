//
//============================================================================//
bool SIM5320_GpsColdStart(void)
{
	uint8_t Buf[64];
	char *pStr;

	//
	if(bGSM_GpsPower == TRUE)
		return FALSE;

	//
	pStr = (char*)Buf;

	//
	sprintf(pStr, "%d,AT+CGPSCOLD", AT_GPS_TURN_ON);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));

	//
	return TRUE;
}

