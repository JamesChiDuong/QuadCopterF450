//============================================================================//
//
//============================================================================//
static void SIM5320_ChkNetStatus(FlagStatus NET_FLAG)
{
	static uint8_t LED_COUNT = COUNT_LED_NET_DISCONN;
	static uint16_t RECONN_COUNT = COUNT_NET_RECONNECT;
	static uint16_t RESTART_COUNT = COUNT_GSM_RESTART;
	static FunctionalState AutoNetMode = ENABLE;

	//
	LED_COUNT--;
	//
	if(LED_COUNT == 0)
	{
		//
		if(SIM5320_GetPowerStatus() == TRUE)
			HwCfg_LEDOn(LED_GPRS);

		//
		if(SIM5320_GetNetStatus() == TRUE)
			LED_COUNT = COUNT_LED_NET_CONN;
		else
			LED_COUNT = COUNT_LED_NET_DISCONN;
	}
	else
	{
		//
		HwCfg_LEDOff(LED_GPRS);
	}

	//
	if(NET_FLAG == SET
	        && SIM5320_GetNetStatus() == FALSE
	        && SIM5320_ChkCmdIdle() == TRUE
	        && TID_GprsReset == TIMER_INVALID_ID)
	{
		//
		RECONN_COUNT--;
	}
	else
	{
		//
		RECONN_COUNT = COUNT_NET_RECONNECT;
	}
	//
	if(RECONN_COUNT == 0)
	{

#if ENABLE_MULTI_IP
		//
		SIM5320_NetDisconn(SOCKET_BANK_DEF);
		//
		SIM5320_NetDisconn(SOCKET_BANK_EXT);
#else
		//
		SIM5320_NetDisconn(SOCKET_BANK_DEF);
#endif

		//
		SIM5320_NetClose();
		//
		ucGSM_SocketInit = SOCKET_BANK_DEF;

		//
		if(AutoNetMode == ENABLE)
			AutoNetMode = DISABLE;
		else
			AutoNetMode = ENABLE;
		//
		SIM5320_AutoNetMode(AutoNetMode);

		//
		RECONN_COUNT = COUNT_NET_RECONNECT;
	}


	//
	if(NET_FLAG == SET
	        && SIM5320_GetNetStatus() == FALSE
	        && TID_GprsReset == TIMER_INVALID_ID)
	{
		//
		RESTART_COUNT--;
	}
	else
	{
		//
		RESTART_COUNT = COUNT_GSM_RESTART;
	}
	//
	if(RESTART_COUNT == 0)
	{
		//
		SIM5320_ReConnect();
		//
		SIM5320_Reset(RESET_DELAY_SHORT);
		//
		RESTART_COUNT = COUNT_GSM_RESTART;
	}
}

//============================================================================//
//
//============================================================================//
static void SIM5320_ChkProcIdle(FlagStatus IDLE_FLAG)
{
	//static uint8_t IDLE_COUNT = COUNT_GSM_PROC_IDLE;
	static uint16_t IDLE_COUNT = COUNT_GSM_PROC_IDLE;  //Heinz
	static uint8_t GPS_COUNT = COUNT_GET_GPS_INFO;

	//
	if(IDLE_FLAG == RESET)
	{
		//
		IDLE_COUNT = COUNT_GSM_PROC_IDLE;
		//
		GPS_COUNT = COUNT_GET_GPS_INFO;
		//
		return;
	}

	//
	if(SIM5320_GetPowerStatus() == TRUE
	        && SIM5320_ChkCmdBusy() == FALSE)
	{
		//
		IDLE_COUNT--;
		//
		GPS_COUNT--;
	}

	//
	if(IDLE_COUNT == 0)
	{
		//
		SIM5320_ChkSQ();

		//
		if(bGSM_WriteSocket == TRUE)
		{
			//
			SIM5320_ReSendData();
		}

		//
		IDLE_COUNT = COUNT_GSM_PROC_IDLE;
	}

	//
	if(GPS_COUNT == 0)
	{
#if ENABLE_CELL_LOCATION
		//
		SIM5320_GetCellLocation();
#endif

		//
		GPS_COUNT = COUNT_GET_GPS_INFO;
	}
}

//============================================================================//
//
//============================================================================//
static void SIM5320_ChkSendStatus(void)
{
	static uint16_t SEND_COUNT = COUNT_AT_CMD_TIMEOUT;

	//
	if(bGSM_WriteSocket == TRUE)
	{
		//
		SEND_COUNT--;

		//
		if(SEND_COUNT == 0)
		{
			//
			SIM5320_ReSendData();
			//
			bGSM_WriteSocket = FALSE;
		}
	}
	else
	{
		//
		SEND_COUNT = COUNT_AT_CMD_TIMEOUT;
	}
}

//============================================================================//
//
//============================================================================//
static void SIM5320_ChkCallStatus(FlagStatus CALL_FLAG)
{
	static uint8_t CALL_COUNT = 0;
	static uint8_t BID_RING = BUZZER_INVALID_ID;

	//
	bGSM_Calling = TRUE;

	//
	if(bGSM_Dialling == TRUE)
	{
		//
		Buzzer_ClrRing(&BID_RING);
		//
		CALL_COUNT = 0;

		//
		bGSM_Calling = FALSE;

		//
		return;
	}

	//
	if(CALL_FLAG == RESET)	 //Heinz
	{
#if CUSTOMER_TYPE != CUSTOMER_FORMOSA && CUSTOMER_TYPE != CUSTOMER_EUPFIN_B && CUSTOMER_TYPE == CUSTOMER_NORMAL
		//
		Buzzer_ClrRing(&BID_RING);
		//
		Buzzer_SetRing(&BID_RING, BEEP_SHORT, 3);
#endif
		//
		CALL_COUNT = COUNT_CALL_TIMEOUT;
		//
		return;
	}

	//
	if(CALL_COUNT)
		CALL_COUNT--;
	else
		bGSM_Calling = FALSE;
}

//============================================================================//
//
#define XMODEM_CMD_START		'C'
#define XMODEM_CMD_SOH			0x01
#define XMODEM_CMD_STX			0x02
#define XMODEM_CMD_EOT			0x04
#define XMODEM_CMD_ACK			0x06
#define XMODEM_CMD_NAK			0x15
#define XMODEM_CMD_CAN			0x18
#define XMODEM_CMD_CTRLZ		0x1A

//
#define XMODEM_PKG_SOH			0
#define XMODEM_PKG_BLK			1
#define XMODEM_PKG_NOT_BLK		2
#define XMODEM_PKG_DATA0		3
//
#define XMODEM_STD_DATA_SIZE	128
#define XMODEM_STD_PKG_SIZE		XMODEM_STD_DATA_SIZE + 5
#define XMODEM_STD_PKG_CRC0		(XMODEM_PKG_DATA0 + XMODEM_STD_DATA_SIZE)
#define XMODEM_STD_PKG_CRC1		(XMODEM_STD_PKG_CRC0 + 1)
//
#define XMODEM_EXP_DATA_SIZE	1024
#define XMODEM_EXP_PKG_SIZE		XMODEM_EXP_DATA_SIZE + 5
#define XMODEM_EXP_PKG_CRC0		(XMODEM_PKG_DATA0 + XMODEM_EXP_DATA_SIZE)
#define XMODEM_EXP_PKG_CRC1		(XMODEM_EXP_PKG_CRC0 + 1)

//
uint8_t XMODEM_Buf[XMODEM_EXP_PKG_SIZE] = {0};
//
uint32_t FileTransmissionBegin;

//============================================================================//
//
uint32_t UpgradeFileSize = 0;
//
uint32_t UpgradeFileOffset = 0;

//============================================================================//
//
//============================================================================//
static void SIM5320_TransmitUpgradeFile(void)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	//
	SIM5320_ShowNetMode(DISABLE);
	//
	SIM5320_GpsInfoCfg(DISABLE);

	//
	sprintf(pStr, "%d,AT+FSATTRI=%s",
	        AT_FS_GET_SIZE,
	        FILENAME_UPGRADE_DFU);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));

	//
	sprintf(pStr, "%d,AT+CTXFILE=\"%s\",0,0",
	        AT_FS_GET_FILE,
	        FILENAME_UPGRADE_DFU);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));

	//
	SIM5320_GpsInfoCfg(ENABLE);
	//
	SIM5320_ShowNetMode(ENABLE);
}

//============================================================================//
//
//============================================================================//
void SIM5320_GetUpgradeFile(void)
{
	//
	static uint8_t TryChar = XMODEM_CMD_START;
	static uint8_t PkgNum = 1;
	//
	uint16_t BufLen;
	//
	uint32_t DataSize;
	//
	uint32_t target;

	//
	SIM5320_SendBuffer(&TryChar, sizeof(TryChar));

	//
	if(TryChar == XMODEM_CMD_START)
	{
		//
		FileTransmissionBegin = GetSysTickCount();
		//
		RTOSprintf("> System upgrade begin!!\r\n");
	}

	//
	target = GetSysTickCount() + mS_2_SysTick(S_2_mS(1));
	//
	do
	{
		//
		BufLen = UART_GetRxBufLen(GSM_COMPORT_DEF);
		//
		if(BufLen >= XMODEM_STD_PKG_SIZE)
			break;

	}
	while(GetSysTickCount() < target);

	//
	BufLen = UART_GetRxBuffer(GSM_COMPORT_DEF, XMODEM_Buf, UART_MAX_BUFFER_SIZE);
	//
	if(g_Setting.DebugMode == DBG_GSM)
	{
		//
		SET_SendBuffer(XMODEM_Buf, BufLen);
	}

	//
	switch(XMODEM_Buf[XMODEM_PKG_SOH])
	{
		//
		case XMODEM_CMD_SOH:
			{
				uint16_t i, crc;

				// Check the X-Modem package length
				if(BufLen < XMODEM_STD_PKG_SIZE)
				{
					//
					TryChar = XMODEM_CMD_NAK;
					//
					break;
				}

				// 檢查序號與序號捕數
				if(XMODEM_Buf[XMODEM_PKG_BLK] != (uint8_t)(~XMODEM_Buf[XMODEM_PKG_NOT_BLK]))
				{
					TryChar = XMODEM_CMD_NAK;
					break;
				}

				// 檢查是否為正確的封包序號
				if(XMODEM_Buf[XMODEM_PKG_BLK] != PkgNum)
				{
					// 若為前一個封包序號
					if(XMODEM_Buf[XMODEM_PKG_BLK] == PkgNum - 1)
					{
						// 忽略此封包準備接收下一筆封包
						TryChar = XMODEM_CMD_ACK;
					}
					else
					{
						// 若不是上一筆資料, 表示發生嚴重錯誤強制中止接收程序
						TryChar = XMODEM_CMD_CAN;
						//
						SIM5320_SendBuffer(&TryChar, sizeof(TryChar));

						//
						SIM5320_TransmitUpgradeFile();

						//
						TryChar = XMODEM_CMD_START;
						//
						PkgNum = 1;

						//
						UpgradeFileSize = 0;
						//
						UpgradeFileOffset = 0;
						//
						bGSM_TxUpgradeFile = FALSE;
					}

					//
					break;
				}

				//
				CRC16_Reset(0);
				//
				for(i = 0; i < XMODEM_STD_DATA_SIZE; i++)
				{
					//
					crc = CRC16_Calc(XMODEM_Buf[XMODEM_PKG_DATA0 + i]);
				}

				// Check the CRC checksum, Big-endian
				if(XMODEM_Buf[XMODEM_STD_PKG_CRC0] != GET_MSB(crc)
				        && XMODEM_Buf[XMODEM_STD_PKG_CRC1] != GET_LSB(crc))
				{
					//
					TryChar = XMODEM_CMD_NAK;
					//
					break;
				}

				//
				DataSize = UpgradeFileSize - UpgradeFileOffset;
				//
				if(DataSize > XMODEM_STD_DATA_SIZE)
					DataSize = XMODEM_STD_DATA_SIZE;

				//
				SD_AddBuffToFile(FILENAME_UPGRADE_DFU, &XMODEM_Buf[XMODEM_PKG_DATA0], DataSize);
				//
				UpgradeFileOffset += DataSize;

				// 準備接收下一筆封包
				TryChar = XMODEM_CMD_ACK;
				//
				PkgNum++;
			}
			break;
		//
		case XMODEM_CMD_EOT:
			//
			TryChar = XMODEM_CMD_ACK;
			//
			SIM5320_SendBuffer(&TryChar, sizeof(TryChar));

			//
			if(SD_GetFileSize(FILENAME_UPGRADE_DFU) == UpgradeFileSize)
			{
				PRODUCT_INFO_t ProductInfo;

				//
				RTOSprintf("> Upgrade file size is %d bytes, download time is %d mS\r\n",
				           UpgradeFileSize,
				           SysTick_2_mS(GetSysTickCount() - FileTransmissionBegin));

				//
				SD_ReadAddrToBuff(FILENAME_UPGRADE_DFU,
				                  (uint8_t*)&ProductInfo,
				                  sizeof(PRODUCT_INFO_t),
				                  sizeof(DFU_PREFIX_t) + sizeof(DFU_ELEMENT_t) + PRODUCT_INFO_OFFSET);

				//
				if(ProductInfo.PID != PRODUCT_INFO.PID
				        || ProductInfo.CustID != PRODUCT_INFO.CustID
				        || ProductInfo.HwID != PRODUCT_INFO.HwID)
				{
					//
					RTOSprintf("> Check upgrade file product infomation error.\r\n");
					//
					SD_Delete(FILENAME_UPGRADE_DFU);
				}
				else
				{
					//
					if(SD_CheckUpgradeFile() == TRUE)
					{
						char StrBuf[128];

						//
						sprintf(StrBuf, "%s%s,10\r\n", STR_AS_RESET, ResetCmdString[RST_UPGRADE]);
						//
						Protocl_ChkCmdPkg(StrBuf, NULL);
					}
					else
					{
						//
						SIM5320_TransmitUpgradeFile();
					}
				}
			}

			//
			TryChar = XMODEM_CMD_START;
			//
			PkgNum = 1;

			//
			UpgradeFileSize = 0;
			//
			UpgradeFileOffset = 0;
			//
			bGSM_TxUpgradeFile = FALSE;
			break;
		//
		default:
			//
			SIM5320_TransmitUpgradeFile();

			//
			TryChar = XMODEM_CMD_START;
			//
			PkgNum = 1;

			//
			UpgradeFileSize = 0;
			//
			UpgradeFileOffset = 0;
			//
			bGSM_TxUpgradeFile = FALSE;
			break;
	}

}

//============================================================================//
//
#define MAX_WRITE_BLOCK_SIZE	GSM_MAX_BUFFER_SIZE
//
#define MAX_DISK_SEGMENT_SIZE	(MAX_WRITE_BLOCK_SIZE * 1024)

//
uint32_t BackupFileSize = 0;
//
uint32_t BackupFileOffset = 0;
//
uint32_t BackupFileDisk = 0;
//
uint32_t BackupDataSize = 0;
//
char BackupFileName[16];

//
typedef enum
{
	STORE_INIT,
	STORE_RETRY,
	STORE_FINISH,
} FILE_STORE_t;

//============================================================================//
// receive "DATALOG.DTR"
//============================================================================//
static void SIM5320_ReceiveBackupFile(void)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	//
	SIM5320_ShowNetMode(DISABLE);
	//
	SIM5320_GpsInfoCfg(DISABLE);

	//
	sprintf(pStr, "%d,AT+CRXFILE=\"%s\"",
	        AT_FS_SEND_FILE,
	        FILENAME_DATALOG_DTR);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));

	//
	SIM5320_GpsInfoCfg(ENABLE);
	//
	SIM5320_ShowNetMode(ENABLE);
}

//============================================================================//
//
//============================================================================//
static void SIM5320_StoreBackupFile(FILE_STORE_t FILE_STORE)
{
	uint8_t Buf[64];
	char *pStr;
	//
	char FileName[32];

	//
	if(strncmp(BackupFileName, FILENAME_DATALOG_BIN, strlen(FILENAME_DATALOG_BIN)) == 0)
	{
		//
		time_t rawtime;

		//
		time(&rawtime);
		//
		rawtime += g_Setting.i32TimeZoneOffset;
		//
		strftime(FileName, sizeof(FileName), "%Y%m%d", localtime(&rawtime));
	}
	else
	{
		//
		strcpy(FileName, BackupFileName);
		//
		StopChar(FileName, '.');
	}

	//
	pStr = (char*)Buf;
	//
	sprintf(pStr, "%s_%s.DTR", g_Setting.szBus_ID, FileName);
	//
	strcpy(FileName, pStr);

	//
	switch(FILE_STORE)
	{
		//
		case STORE_INIT:
			//
			pStr = (char*)Buf;
			//
			sprintf(pStr, "%d,AT+FSRENAME=%s,%s",
			        AT_FS_REN_FILE,
			        FILENAME_DATALOG_DTR,
			        FileName);
			//
			DataSend_AddCmdToQue(Buf, strlen(pStr));

		//
		case STORE_RETRY:
			//
			pStr = (char*)Buf;
			//
			sprintf(pStr, "%d,AT+CFTPPUTFILE=\"/%s/%s\",0",
			        AT_FTP_PUT_FILE,
			        STR_DIRECTORY_BACKUP,
			        FileName);
			//
			DataSend_AddCmdToQue(Buf, strlen(pStr));

			break;

		//
		case STORE_FINISH:
			//
			BackupFileSize = 0;
			//
			BackupFileOffset = 0;
			break;
	}
}

//============================================================================//
//
//============================================================================//
static void SIM5320_BuildSendPkg(FlagStatus BUILD_FLAG)
{
	//
	static uint8_t PkgNum = 0;
	//
	uint8_t *pBuf;
	//
	uint16_t i, crc;

	//
	PkgNum++;
	//
	if(BUILD_FLAG == RESET)
	{
		//
		PkgNum = 1;
		//
		BackupFileOffset = 0;
	}

	//
	if(BackupFileOffset == BackupFileSize)
	{
		//
		uint8_t TryChar = XMODEM_CMD_EOT;

		//
		SIM5320_SendBuffer(&TryChar, sizeof(TryChar));
		//
		bGSM_RxUpgradeFile = FALSE;

		//
		RTOSprintf("> Datalog file size is %d bytes, upload time is %d mS\r\n",
		           BackupFileSize,
		           SysTick_2_mS(GetSysTickCount() - FileTransmissionBegin));

		//
		SIM5320_StoreBackupFile(STORE_INIT);
		//
		return;
	}

	//
	XMODEM_Buf[XMODEM_PKG_SOH] = XMODEM_CMD_STX;
	//
	XMODEM_Buf[XMODEM_PKG_BLK] = PkgNum;
	//
	XMODEM_Buf[XMODEM_PKG_NOT_BLK] = ~PkgNum;

	//
	pBuf = &XMODEM_Buf[XMODEM_PKG_DATA0];
	//
	memset(pBuf, XMODEM_CMD_CTRLZ, XMODEM_EXP_DATA_SIZE);

	//
	BackupDataSize = BackupFileSize - BackupFileOffset;
	//
	if(BackupDataSize > XMODEM_EXP_DATA_SIZE)
		BackupDataSize = XMODEM_EXP_DATA_SIZE;

	//
	SD_ReadAddrToBuff(BackupFileName,
	                  pBuf,
	                  BackupDataSize,
	                  BackupFileOffset);
	//
	BackupFileOffset += BackupDataSize;

	//
	CRC16_Reset(0);
	//
	for(i = 0; i < XMODEM_EXP_DATA_SIZE; i++)
	{
		//
		crc = CRC16_Calc(*pBuf++);
	}

	//
	XMODEM_Buf[XMODEM_EXP_PKG_CRC0] = GET_MSB(crc);
	//
	XMODEM_Buf[XMODEM_EXP_PKG_CRC1] = GET_LSB(crc);
	//
	SIM5320_SendBuffer(XMODEM_Buf, XMODEM_EXP_PKG_SIZE);
}

//============================================================================//
//
//============================================================================//
void SIM5320_SendBackupFile(void)
{
	//
	uint8_t TryChar;

	//
	if(UART_GetRxBufLen(GSM_COMPORT_DEF) == 0)
		return;

	//
	UART_GetRxBuffer(GSM_COMPORT_DEF, &TryChar, sizeof(TryChar));
	//
	switch(TryChar)
	{
		//
		case XMODEM_CMD_START:
			//
			SIM5320_BuildSendPkg(RESET);
			//
			FileTransmissionBegin = GetSysTickCount();
			break;

		//
		case XMODEM_CMD_ACK:
			//
			SIM5320_BuildSendPkg(SET);
			break;

		//
		case XMODEM_CMD_NAK:
			//
			SIM5320_SendBuffer(XMODEM_Buf, XMODEM_EXP_PKG_SIZE);
			break;

		//
		case XMODEM_CMD_CAN:
			//
			SIM5320_ReceiveBackupFile();
			break;
	}
}

//============================================================================//
//
//============================================================================//
static void SIM5320_ReConnect(void)
{
	//
	SocketState[SOCKET_BANK_DEF].CONN = FALSE;
	//
	SocketState[SOCKET_BANK_EXT].CONN = FALSE;
	//
	gGSM_CurrCmd = gGSM_NextCmd = AT_CMD_BREAK;
	//
	gCMD_STATE = CMD_INIT;
}

//============================================================================//
//
//============================================================================//
static void SIM5320_CmdFinish(void)
{
	//
	gGSM_CurrCmd = gGSM_NextCmd;
	//
	gCMD_STATE = CMD_INIT;
	//
	ucGSM_CmdInterval = 0;
	//
	ucGSM_CmdTimeout = 0;
	//
	ucGSM_CmdErrCnt = 0;
}

//============================================================================//
//
//============================================================================//
static void SIM5320_CmdProc(void)
{

	//
	switch(gCMD_STATE)
	{
		//
		case CMD_INIT:
			//
			ucGSM_CmdInterval++;
			//
			if(ucGSM_CmdInterval < COUNT_AT_CMD_INTERVAL)
				return;

			//
			switch(gGSM_CurrCmd)
			{
					char szTEMP[64];

				//
				case AT_CMD_BEGIN:
					//
					SIM5320_BuildCmd("AT");
					//
					SIM5320_SendCmd();

					//
					gGSM_NextCmd = (AT_CMD_t)(gGSM_CurrCmd + 1);
					break;
				//
				case AT_ECHO_SET:
					//
					SIM5320_BuildCmd("ATE0");
					//
					SIM5320_SendCmd();

					//
					gGSM_NextCmd = (AT_CMD_t)(gGSM_CurrCmd + 1);
					break;
				//
				case AT_GPIO_SET:
					//
					SIM5320_BuildCmd("AT+CKGSWT=0");
					//
					SIM5320_SendCmd();

					//
					gGSM_NextCmd = (AT_CMD_t)(gGSM_CurrCmd + 1);
					break;
				//
				case AT_CME_ERR_EN:
					//
					SIM5320_BuildCmd("AT+CMEE=2");
					//
					SIM5320_SendCmd();

					//
					gGSM_NextCmd = (AT_CMD_t)(gGSM_CurrCmd + 1);
					break;
				//
				case AT_URC_OUTPUT_SET:
					//
					SIM5320_BuildCmd("AT+CATR=1,0");
					//
					SIM5320_SendCmd();

					//
					gGSM_NextCmd = (AT_CMD_t)(gGSM_CurrCmd + 1);
					break;

#if !ENABLE_GPS_MODULE

#if ENABLE_ASSIST_GPS
				//
				case AT_AGPS_SERVER:
					//
					SIM5320_BuildCmd("AT+CGPSURL=\"supl.google.com:7276\"");
					//
					SIM5320_SendCmd();

					//
					gGSM_NextCmd = (AT_CMD_t)(gGSM_CurrCmd + 1);
					break;
				//
				case AT_GPS_CLEAR:
					//
					SIM5320_BuildCmd("AT+CGPSDEL");
					//
					SIM5320_SendCmd();

					//
					gGSM_NextCmd = (AT_CMD_t)(gGSM_CurrCmd + 1);
					break;
				//
				case AT_GPS_START:
					//
					SIM5320_BuildCmd("AT+CGPS=1,2");
					//
					SIM5320_SendCmd();

					//
					gGSM_NextCmd = (AT_CMD_t)(gGSM_CurrCmd + 1);
					break;
				//
				case AT_GPS_START_INFO:
					//
					sprintf(szTEMP, "%s", STR_GPS_INFO_START);
					//
					SIM5320_BuildCmd(szTEMP);
					//
