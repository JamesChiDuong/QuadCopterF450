//============================================================================//
//
//============================================================================//
bool SIM5320_GpsStart(void)
{
	//
	if(bGSM_GpsPower == TRUE)
		return FALSE;

	//
	SIM5320_GpsClear();
	//
	SIM5320_GpsOn();

	//
	return TRUE;
}

//============================================================================//
//
//============================================================================//
void SIM5320_GpsStop(void)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	//
	sprintf(pStr, "%d,AT+CGPS=0", AT_GPS_TURN_OFF);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
}

//============================================================================//
//
//============================================================================//
void SIM5320_GpsTurnOn(GPS_START_t GpsStart)
{
	//
	if(bGSM_TxUpgradeFile == TRUE
	        || bGSM_RxUpgradeFile == TRUE)
		return;

#if ENABLE_ASSIST_GPS
	//
	SWTIM_SetTimer(TIMER_GSM_PROC, TIMER_ONESHOT, SIM5320_GpsStart);
#else
	//
	if(GpsStart == START_COLD)
	{
		//
		SWTIM_SetTimer(TIMER_GSM_PROC, TIMER_ONESHOT, SIM5320_GpsColdStart);
	}

	//
	if(GpsStart == START_HOT)
	{
		//
		SWTIM_SetTimer(TIMER_GSM_PROC, TIMER_ONESHOT, SIM5320_GpsHotStart);
	}
#endif

}

//============================================================================//
//
//============================================================================//
void SIM5320_GpsTurnOff(void)
{
	//
	if(bGSM_TxUpgradeFile == TRUE
	        || bGSM_RxUpgradeFile == TRUE)
		return;

	//
	SIM5320_GpsStop();
}

//============================================================================//
//
//============================================================================//
bool SIM5320_GetGpsPower(void)
{
	//
	return bGSM_GpsPower;
}

//============================================================================//
//
//============================================================================//
bool SIM5320_GetGpsData(GPS_DATA_t *GPS_AllData)
{
	//
	if(bGSM_GpsData == TRUE)
	{
		//
		GSM_GpsData.CurrLocation = g_SysInfo.Location;
		//
		*GPS_AllData = GSM_GpsData;

		//
		return TRUE;
	}

	//
	return FALSE;
}

