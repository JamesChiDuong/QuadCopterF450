//============================================================================//
//
//============================================================================//
//
void GPS_ClrReg(void);
//
static void SIM5320_GpsClrReg(void)
{
	//
	GPS_ClrReg();

	//
	bGSM_GpsPower = FALSE;
	//
	bGSM_GpsData = FALSE;
	//
	memset(&GSM_GpsData, 0x00, sizeof(GPS_DATA_t));
	//
	GSM_GpsData.Latitude.cIndicator = 'N';
	//
	GSM_GpsData.Longitude.cIndicator = 'E';
}

//============================================================================//
//
//============================================================================//
static void SIM5320_GpsInfoCfg(FunctionalState STATE)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	if(STATE == ENABLE)
	{
		//
		sprintf(pStr, "%d,%s", AT_GPS_INFO_CONFIG, STR_GPS_INFO_START);
	}
	else
	{
		//
		sprintf(pStr, "%d,%s", AT_GPS_INFO_CONFIG, STR_GPS_INFO_STOP);
	}

	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));

}

