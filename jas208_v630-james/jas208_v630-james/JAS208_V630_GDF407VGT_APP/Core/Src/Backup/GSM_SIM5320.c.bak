//============================================================================//
//
//============================================================================//
static void SIM5320_ResolveName(uint8_t SocketNum)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;
	//
	sprintf(pStr, "%d,AT+CDNSGIP=\"%s\"",
	        AT_NET_RESOLVE_NAME,
	        g_Setting.TempSet.tServerName[SocketNum].szADDR);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
}

//============================================================================//
//
//============================================================================//
static void SIM5320_NetConnect(uint8_t SocketNum)
{
	uint8_t Buf[128];
	char *pStr;

	//
	pStr = (char*)Buf;
	//
	sprintf(pStr, "%d,AT+CIPOPEN=%d,\"TCP\",\"%d.%d.%d.%d\",%d",
	        AT_NET_CONNECT,
	        SocketState[SocketNum].NUM,
	        g_Setting.GSM_SET.tServerIP[SocketNum].u32ADDR._U8[3],
	        g_Setting.GSM_SET.tServerIP[SocketNum].u32ADDR._U8[2],
	        g_Setting.GSM_SET.tServerIP[SocketNum].u32ADDR._U8[1],
	        g_Setting.GSM_SET.tServerIP[SocketNum].u32ADDR._U8[0],
	        g_Setting.GSM_SET.tServerIP[SocketNum].u16Port);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
}

//============================================================================//
//
//============================================================================//
static void SIM5320_NetConnInit(uint8_t SocketNum)
{
	//
	if(strlen(g_Setting.TempSet.tServerName[SocketNum].szADDR) <= 6 )  //Heinz
	{
		//
		SIM5320_NetConnect(SocketNum);
	}
	else
	{
		//
		SIM5320_ResolveName(SocketNum);
	}
}

//============================================================================//
//
//============================================================================//
static void SIM5320_NetDisconn(uint8_t SocketNum)
{
	uint8_t Buf[32];
	char *pStr;

	//
	pStr = (char*)Buf;
	//
	//sprintf(pStr, "%d,AT+CIPCLOSE=%d", 		 ///heinz
	sprintf(pStr, "%d,AT+QICLOSE=%d",
	        AT_NET_DISCONN,
	        SocketState[SocketNum].NUM);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
}

