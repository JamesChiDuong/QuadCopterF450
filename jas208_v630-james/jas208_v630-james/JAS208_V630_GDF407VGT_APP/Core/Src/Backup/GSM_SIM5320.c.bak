static void SIM5320_ShowNetMode(FunctionalState STATE)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	if(STATE == ENABLE)
	{
		//
		sprintf(pStr, "%d,AT+CNSMOD=1", AT_NET_SHOW_MODE);
	}
	else
	{
		//
		sprintf(pStr, "%d,AT+CNSMOD=0", AT_NET_SHOW_MODE);
	}

	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));

}

