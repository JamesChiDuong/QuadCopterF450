//
//============================================================================//
bool SIM5320_ChkCmdBusy(void)
{
	if(gGSM_CurrCmd == AT_CMD_BREAK
	        && gGSM_NextCmd == AT_CMD_BREAK)
	{
		//
		return FALSE;
	}
	else
	{
		//
		return TRUE;
	}
}

//============================================================================//
//
//============================================================================//
bool SIM5320_GetOperatorStatus(void)
{
	//
	return bGSM_Operator;
}

//============================================================================//
//
//============================================================================//
bool SIM5320_GetNetStatus(void)
{
	static bool NetStatus;

#if ENABLE_MULTI_IP
	//
	if(SocketState[SOCKET_BANK_DEF].CONN == TRUE
	        && SocketState[SOCKET_BANK_EXT].CONN == TRUE)
	{
		//
		if(NetStatus == FALSE)
		{
			//
			RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_NET_CONNECT);
		}
		//
		NetStatus = TRUE;
	}
	else
	{
		//
		if(NetStatus == TRUE)
		{
			//
			RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_NET_DISCONN);
		}
		//
		NetStatus = FALSE;
	}
#else
	//
	if(SocketState[SOCKET_BANK_DEF].CONN == TRUE)
	{
		//
		if(NetStatus == FALSE)
		{
			//
			RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_NET_CONNECT);
		}
		//
		NetStatus = TRUE;
	}
	else
	{
		//
		if(NetStatus == TRUE)
		{
			//

			RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_NET_DISCONN);
		}
		//
		NetStatus = FALSE;
	}
#endif

	//
	return NetStatus;
}

//============================================================================//
//
//============================================================================//
GSM_NET_MODE_t SIM5320_GetNetMode(void)
{
	GSM_NET_MODE_t GSM_NET_MODE = MODE_NULL;

	//
	if(ucGSM_NetMode == 2 || ucGSM_NetMode == 3)
	{
		//
		GSM_NET_MODE = MODE_GPRS;
	}

	//
	if(ucGSM_NetMode >= 4)
	{
		//
		GSM_NET_MODE = MODE_3G;
	}

	//
	return GSM_NET_MODE;
}

