static bool SIM5320_ChkCmdIdle(void)
{
	if(gGSM_CurrCmd == AT_CMD_BREAK
	        || gGSM_CurrCmd == AT_CMD_CSQ
	        || gGSM_CurrCmd == AT_CELL_LOCATION)
	{
		//
		return TRUE;
	}
	else
	{
		//
		return FALSE;
	}
}

//============================================================================//
//
//============================================================================//
static void SIM5320_NetOpen(void)
{
	uint8_t Buf[32];
	char *pStr;

	//
	pStr = (char*)Buf;
	//
	//sprintf(pStr, "%d,AT+NETOPEN=\"TCP\",,1", AT_NET_OPEN);
	sprintf(pStr, "%d,AT+NETOPEN=,,1", AT_NET_OPEN);
	//
