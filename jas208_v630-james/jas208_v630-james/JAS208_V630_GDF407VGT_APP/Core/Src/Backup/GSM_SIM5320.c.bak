//============================================================================//
//
#define	RANGE_FULL_LEVEL		100

#if CUSTOMER_TYPE == CUSTOMER_CPTI
// 	CPTI 嫌原音量太小 所以改以下做法
#define	RANGE_SPK_LEVEL_MAX		65535
#else
//
#define	RANGE_SPK_LEVEL_MAX		8
#endif

//
#define	RANGE_MIC_LEVEL_MAX		0

//============================================================================//
//
//============================================================================//
#if CUSTOMER_TYPE == CUSTOMER_CPTI
static uint16_t SIM5320_GetSpkGain(void)
#else
static uint8_t SIM5320_GetSpkGain(void)
#endif
{
	//
	return (uint16_t)g_Setting.GSM_SET.LevelSpkGain * RANGE_SPK_LEVEL_MAX / RANGE_FULL_LEVEL;
}

//============================================================================//
//
//============================================================================//
void SIM5320_SetSpeakerGain(void)
{
	uint8_t Buf[32];
	char *pStr;

	//
	pStr = (char*)Buf;

#if CUSTOMER_TYPE == CUSTOMER_CPTI
	// 	CPTI 嫌原音量太小 所以改以下做法
	sprintf(pStr, "%d,AT+CRXGAIN=%d",
	        AT_SPK_VOLUME_SET,
	        SIM5320_GetSpkGain());
#else
	//
	sprintf(pStr, "%d,AT+CLVL=%d",
	        AT_SPK_VOLUME_SET,
	        SIM5320_GetSpkGain());
#endif
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
}

