//============================================================================//
//
//============================================================================//
static void SIM5320_ClrReg(void)
{
	//
	memset(gGSM_CmdQue, 0x00, sizeof(gGSM_CmdQue));
	//
	ucGSM_QueWI = 0;
	//
	ucGSM_QueRI = 0;
	//
	ucGSM_RxIdx = 0;

	//
	gGSM_CurrCmd = AT_CMD_BREAK;
	//
	gGSM_NextCmd = AT_CMD_BREAK;
	//
	gCMD_STATE = CMD_INIT;
	//
	ucGSM_CmdInterval = 0;
	//
	ucGSM_CmdTimeout = 0;
	//
	ucGSM_CmdErrCnt = 0;

	//
	memset(SocketState, 0x00, sizeof(SocketState));
	//
	ucGSM_SocketInit = SOCKET_BANK_DEF;
	//
	ucGSM_SocketConnCnt = 0;
	//
	SocketState[SOCKET_BANK_DEF].NUM = SOCKET_BANK_DEF;
	//
	SocketState[SOCKET_BANK_EXT].NUM = SOCKET_BANK_EXT;

	//
	memset(szSendCmd, 0x00, sizeof(szSendCmd));

	//
	bGSM_Operator = TRUE;
	//
	bGSM_Dialling = FALSE;
	//
	bGSM_Calling = FALSE;
	//
	bGSM_WriteSocket = FALSE;

	//
	memset(g_SysInfo.MobileInfo.IMSI, 0x00, OFFSET_SIZE(MOBILE_INFO_t, IMSI));
	//
	memset(g_SysInfo.MobileInfo.IMEI, 0x00, OFFSET_SIZE(MOBILE_INFO_t, IMEI));

	//
	u8GSM_CSQ = 99;
	//
	ucGSM_NetMode = 0;

	//
	DataSend_ClrCmdQue();
	//
	SIM5320_ChkNetStatus(RESET);
	//
	SIM5320_ChkProcIdle(RESET);
}

//============================================================================//
//
//============================================================================//
static void SIM5320_PowerOn(void)
{
	HwCfg_PBClr(GSM_EN);
	//
	Delay_mS(250);

	//
	HwCfg_PBClr(GSM_PWR);

	Delay_mS(500);  //Heinz
	//
	HwCfg_PBSet(GSM_PWR);
	//
	Delay_mS(500);  //Heinz 300
	//
	HwCfg_PBClr(GSM_PWR);

	//
	UART_Init(GSM_COMPORT_DEF, GSM_BAUDRATE_DEF);

	//
	RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_POWER_ON);
}

//============================================================================//
//
//============================================================================//
static void SIM5320_PowerOff(void)
{

	HwCfg_PBSet(GSM_PWR);
	Delay_mS(1200);  //Heinz
	//HwCfg_PBClr(GSM_PWR); //AA001	//002	//777

	HwCfg_PBSet(GSM_EN); //AA001

	bGSM_PowerOn = FALSE;

	//
	RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_POWER_OFF);

}

//============================================================================//
//
uint8_t TID_GprsReset = TIMER_INVALID_ID;

//============================================================================//
//
//============================================================================//
static bool SIM5320_Start(void)
{
	// 若還有命令正在執行則延後重置 GSM
	if(SIM5320_ChkCmdBusy() == TRUE
	        || SIM5320_GetDialStatus() == TRUE)
		return FALSE;

	//
	ClrTID_GsmProc();
	//
	SIM5320_ClrReg();

	//
	//if(bGSM_PowerOn == TRUE)
	{
		//
		SIM5320_PowerOff();
		//
		//return FALSE;
	}

	//

	TID_GprsReset = TIMER_INVALID_ID;

	Delay_mS(1500);  //Heinz
	//
	SIM5320_PowerOn();
	//
	SetTID_GsmProc();

	//
	return TRUE;
}

//============================================================================//
//
//============================================================================//
void SIM5320_Reset(uint8_t RestartTime)
{

	//char BufStr[20];  //Heinz
	//
	if(TID_GprsReset != TIMER_INVALID_ID)
	{
		//
		if(RestartTime > RESET_DELAY_SHORT)
			return;

		//
		SWTIM_ClrTimer(TID_GprsReset);
		//
		TID_GprsReset = TIMER_INVALID_ID;
	}
	//
	TID_GprsReset = SWTIM_SetTimer(S_2_mS(RestartTime), TIMER_ONESHOT, SIM5320_Start);

	//
	RTOSprintf("> GSM will restart after %d second\r\n", RestartTime);

}

//============================================================================//
//
//============================================================================//
void SIM5320_Init(void)
{
	//
	SIM5320_Reset(RESET_DELAY_SHORT);
	//
	SIM5320_GpsClrReg();
}

//============================================================================//
// GSM SEND
//============================================================================//
static void SIM5320_SendBuffer(uint8_t *Buf, uint16_t BufLen)
{
	//
	UART_SendBuffer(GSM_COMPORT_DEF, Buf, BufLen);

	//
	if(g_Setting.DebugMode == DBG_GSM)
	{
		//
		SET_SendBuffer(Buf, BufLen);
	}
}

//============================================================================//
// GSM SEND COMMAND
//============================================================================//
void SIM5320_SendCmd(void)
{
	//
	SIM5320_SendBuffer((uint8_t*)szSendCmd, strlen(szSendCmd));
}

//============================================================================//
//
//============================================================================//
void SIM5320_BuildCmd(char *CMD)
{
	//
	sprintf(szSendCmd, "%s\r\n", CMD);
}

//============================================================================//
//
//============================================================================//
void SIM5320_SendData(GSM_SOCKET_DATA_t SocketData)
{
	char Buf[32];

	//
	gGSM_DataSend.SocketNum = SocketData.SocketNum;
	//
	memcpy(gGSM_DataSend.Buf, SocketData.Data, SocketData.u16DataLen);
	//
	gGSM_DataSend.u16BufLen = SocketData.u16DataLen;

	//
	sprintf(Buf, "AT+CIPSEND=%d,%d", gGSM_DataSend.SocketNum, gGSM_DataSend.u16BufLen);
	//
	SIM5320_BuildCmd(Buf);

	//
	gGSM_NextCmd = AT_SEND_DATA;
	//
	bGSM_WriteSocket = TRUE;
}

//============================================================================//
//
//============================================================================//
void SIM5320_ReSendData(void)
{
	//
	if(gGSM_DataSend.u16BufLen == 0)
		return;

	//
	DataStream_BuffBuild(gGSM_DataSend.SocketNum, gGSM_DataSend.Buf, gGSM_DataSend.u16BufLen);
	//
	memset(&gGSM_DataSend, 0x00, sizeof(DATA_SEND_t));
}

//============================================================================//
//
//============================================================================//
static void SIM5320_ReceiveData(GSM_SOCKET_DATA_t SocketData)
{
#if ENABLE_TTIA
	//
	TTIA_MsgReply(SocketData);
#else
	char szTEMP1[UART_MAX_BUFFER_SIZE];
	char szTEMP2[UART_MAX_BUFFER_SIZE];

	//
	memcpy(szTEMP1, SocketData.Data, SocketData.u16DataLen);
	//
	Protocl_ChkCmdPkg(szTEMP1, szTEMP2);
	//
	if(strlen(szTEMP2) == 0)
		return;

	//
	sprintf(szTEMP1, "%d,%s", SocketData.SocketNum, szTEMP2);
	//
	DataSend_AddDataToQue((uint8_t*)szTEMP1, strlen(szTEMP1));

#endif
}

