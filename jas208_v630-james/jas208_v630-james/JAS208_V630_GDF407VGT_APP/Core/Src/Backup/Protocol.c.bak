			strcpy(g_Setting.tGSM_SET.tServerInfo[SOCKET_BANK_DEF].cHeaderLog, cLogTemp);
			
			memset(g_Setting.tGSM_SET.tServerInfo[SOCKET_BANK_DEF].cHeaderEvent, 
