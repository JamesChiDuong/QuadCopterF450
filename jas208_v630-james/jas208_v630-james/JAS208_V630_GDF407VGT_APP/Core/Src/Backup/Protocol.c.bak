			bResult = TRUE;

			break;

			//sprintf(szCmdMsg, 
		  //        "@ %sServer %d: %s:%d, Chk:%s(%s), Log:%s(%s), Event:%s(%s), Log time:%d sec; " \
		  //        "\r\nServer %d: %s:%d, Chk:%s(%s), Log:%s(%s), Event:%s(%s), Log time:%d sec",
			//        STR_AS_GSM_MULTI_INFO,
