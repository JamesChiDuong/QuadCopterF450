//============================================================================//
// @brief  Process the command related to the vehicle type.
// @param  pStr: Pointer to a string which stores the command.
// @retval TRUE: Command is processed successfully.
//         FALSE: Command processing is incompleted.
//============================================================================//
bool CMD_Car_Type(char *pStr)
{
	bool bResult = FALSE;


	if(strncmp(pStr, STR_AS_CAR_TYPE, strlen(STR_AS_CAR_TYPE)) != 0)
		return FALSE;

	pStr += Protocl_CmdStopHead(pStr);

	switch(*pStr)
	{
		CarTypeTypeDef CarType;

		
		case '\0':
			RTOSprintf("\r\n@ %s<Type>", STR_AS_CAR_TYPE);
			RTOSprintf("\r\n@ \t<Type> Set CAR Type");

			for(CarType = (CarTypeTypeDef)0; CarType < CARTYPE_END;  CarType++)
			{
				RTOSprintf("\r\n@ %d : %s", CarType, szCarType[CarType]);
			}

			bResult = TRUE;

			break;

		case '?':
			sprintf(szCmdMsg, "@ %s%s", STR_AS_CAR_TYPE, szCarType[g_Setting.tBusInfo.tCarType]);

			RTOSprintf("\r\n%s", szCmdMsg);

			bResult = TRUE;

			break;

		default:
			CarType = (CarTypeTypeDef)atoi(pStr);

			if(CarType > CARTYPE_END)
				break;

			g_Setting.tBusInfo.tCarType = CarType;

			switch(CarType)
			{
				//case CARTYPE_DAF_430:
				//case CARTYPE_DAF_510:

				case CARTYPE_AUTO_GAIN:
					g_Setting.tSpeedSet.fGain = 0;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0; // Heinz	Auto gain On

					break;

				case CARTYPE_DAWOO_2012:
					g_Setting.tSpeedSet.fGain = 75;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case CARTYPE_DAF_460:
					g_Setting.tSpeedSet.fGain = 96;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case CARTYPE_DAF_280:
					g_Setting.tSpeedSet.fGain = 100;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case CARTYPE_DAF_380_AUTO:
				case CARTYPE_DAF_410:
					g_Setting.tSpeedSet.fGain = 107;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case CARTYPE_SCANIA_380:
					g_Setting.tSpeedSet.fGain = 110;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case CARTYPE_SCANIA_400:
					g_Setting.tSpeedSet.fGain = 120;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case CARTYPE_FUSO_1841LSE_2015:
					g_Setting.tSpeedSet.fGain = 125;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case CARTYPE_DAF_360:
					g_Setting.tSpeedSet.fGain = 130;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case CARTYPE_DAF_380_HAND:
					g_Setting.tSpeedSet.fGain = 168;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				case	CARTYPE_DAWOO_2018:
				case	CARTYPE_HINO_500:
				case	CARTYPE_HINO_700:
				case	CARTYPE_HINO_SH1EESA:
				case	CARTYPE_FUSO_2016:
				case	CARTYPE_FUSO_FM173:
				case	CARTYPE_UD:
				case	CARTYPE_UD_PKC8YLS:
					g_Setting.tSpeedSet.fGain = 198;
					g_Setting.tSpeedSet.u8Auto_Gain_Count = 0x80; // Heinz	Auto gain Off.

					break;

				default:
					break;
			}

			g_Setting.tSpeedSet.fAutoGain = 0;
			g_SysInfo.tVehicleState.u32DistCount_AGain = 0;
			g_SysInfo.tVehicleState.dDistBase_GPS = 0;
			g_SysInfo.tVehicleState.dDistance_GPS = 0;

			System_SaveSetting();

			sprintf(szCmdMsg, "@ %s%s\r\n", STR_AS_CAR_TYPE, szCarType[g_Setting.tBusInfo.tCarType]);
			
			RTOSprintf(szCmdMsg);
			
			bResult = TRUE;

			break;
	}

	return bResult;
}

