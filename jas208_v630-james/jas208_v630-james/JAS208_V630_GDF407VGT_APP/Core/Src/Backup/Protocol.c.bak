			RTOSprintf("\r\n@ %s<value>", STR_AS_LDW_TIME);
			RTOSprintf("\r\n@ \t<value> = 30 ~ 180, LDW Time second.");
		
			RESULT = TRUE;
		
		  break;

		case '?':
