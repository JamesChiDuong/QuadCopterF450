	SD_ClearUpDir((char *)DIRNAME_TEMP, (char *)"*.tmp", 0);
	
	// .TMP files
	SD_ClearUpDir((char *)DIRNAME_TEMP, (char *)"*.TMP", 0);
	
	RTOSprintf("\r\n@ Command OK !!\r\n");

	if(bRTOS_En)
	{
		osMutexWait(mutex_setting_user, S_2_mS(5));
	}
	
	System_Reset();

	return TRUE;
}

