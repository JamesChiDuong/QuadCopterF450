//============================================================================//
// User Defines
//============================================================================//
#define	FILENAME_EPA_TRACK_TMP	    "EPA_TRACK.TMP"

#define	FILENAME_EPA_BCODE_TMP	    "EPA_BCODE.TMP"

#define EPA_TRACK_SIZE_MAX		      12000

#define EPA_INDEX_END_ID		        0x55AA


//============================================================================//
// User Typedef Variables
//============================================================================//
typedef enum
{
	// 正常傳遞
	EPA_NORMAL = 0,

	// 自動補回傳
	EPA_RESEND_AUTO,

	// 手動補回傳
	EPA_RESEND_MANUAL,

	// 位置確認
	EPA_PING,

	// 軌跡補回傳開始
	EPA_RESEND_TRACK_START,

	// 軌跡補回傳結束
	EPA_RESEND_TRACK_STOP,

	// 條碼補回傳開始
	EPA_RESEND_BCODE_START,

	// 條碼補回傳結束
	EPA_RESEND_BCODE_STOP,

} EPA_STATE_t;

#pragma pack(1)
typedef union
{
	uint8_t	byte;


	struct
	{
		unsigned IN_ACC:1;
		unsigned IN_PWR:1;
		unsigned IN_BAT:1;
		unsigned RESERVE_0:1;
		unsigned RESERVE_1:1;
		unsigned RESERVE_2:1;
		unsigned RESERVE_3:1;
		unsigned RESERVE_4:1;
	} bits;

} EPA_I01_t;

typedef struct
{
	// 系統內部世界標準時間
	time_t tmLocalTime;

	// GPS 緯度資料, 為 10 進制格式再乘 10^6 後只取整數
	int32_t i32Latitude;

	// GPS 經度資料, 為 10 進制格式再乘 10^6 後只取整數
	int32_t i32Longitude;

	// 時速單位為公里
	uint8_t u8Speed;

	// 航向 0 ~ 359度
	uint16_t u16Course;

	// 可用衛星數量
	uint8_t u8StlNum;

	EPA_I01_t EPA_I01;

	uint8_t CustCode[4];

	char szBarCode[20];

} EPA_DATA_t;

typedef struct
{
	uint16_t START;

	uint16_t COUNT;

	uint16_t END;

} EPA_INDEX_t;
#pragma pack()


//============================================================================//
// User Variables
//============================================================================//
static uint8_t Buff[GSM_MAX_BUFFER_SIZE];

BOOL EVENT_PWR_DOWN = 0; // Heinz

time_t ttAccOff = 0; // Heinz

uint16_t ReBuildBegin;
uint16_t ReBuildEnd;
uint16_t ReBuildCurr;

char* FileName_Query;


//============================================================================//
// User Functions
//============================================================================//
void DataBuild_JASS(uint8_t SocketNum, FlagStatus SOS)
{
	char *pStr;
	char szDateStr[10];
	char szTimeStr[10];
	time_t rawtime;


	pStr = (char *)Buff;

	rawtime = System_GetTime() - g_Setting.i32TimeZoneOffset;

	strftime(szDateStr, sizeof(szDateStr), "%d%m%y", localtime(&rawtime));

	strftime(szTimeStr, sizeof(szTimeStr), "%H%M%S", localtime(&rawtime));

#if ENABLE_GPS_LAST_FIXED
	if(g_SysInfo.gpsHandle.bStatus == FALSE
	        && (g_SysInfo.gpsHandle.gpsLocation.dLatitude || g_SysInfo.gpsHandle.gpsLocation.dLongitude))
	{
		Coordinate_LatitudeDDtoDMM(g_SysInfo.gpsHandle.gpsLocation.dLatitude, &g_SysInfo.gpsHandle.gpsLat);

		Coordinate_LongitudeDDtoDMM(g_SysInfo.gpsHandle.gpsLocation.dLongitude, &g_SysInfo.gpsHandle.gpsLon);

		g_SysInfo.gpsHandle.bStatus = TRUE;
	}
#endif

#if ENABLE_FUEL
	memset(&FuelInfo, 0x00, sizeof(FUEL_INFO_t));

	if(g_Setting.TempSet.FuelMeterGain)
	{
		FuelInfo.LEVEL_1 = INT10_DIV(g_SysInfo.DrvInfo.FUEL.LEVEL_1, g_Setting.TempSet.FuelMeterGain);

		FuelInfo.LEVEL_2 = INT10_DIV(g_SysInfo.DrvInfo.FUEL.LEVEL_2, g_Setting.TempSet.FuelMeterGain);

		g_SysInfo.DrvInfo.FUEL.LEVEL_1 = 0;
	}
	else
	{
		FuelInfo.LEVEL_1 = g_SysInfo.DrvInfo.FUEL.LEVEL_1;

		FuelInfo.LEVEL_2 = g_SysInfo.DrvInfo.FUEL.LEVEL_2;

		FuelInfo.TEMPER = g_SysInfo.DrvInfo.FUEL.TEMPER;
	}
#endif // ENABLE_FUEL

	// Fms
	sprintf(pStr, "%d,$,%s,%s,%s,%c,%c%03d%02d.%04d,%c%02d%02d.%04d,%03d,%03d,%08.0f,%04d,%04d,%04d,%04d,%d,%d,%d,%d#\r\n",
	        SocketNum,
#if ENABLE_BGTVT_2011 || ENABLE_BGTVT_2014
	        g_Setting.szBus_SN,
#else
	        g_Setting.tBusInfo.cBus_ID,
#endif
	        szDateStr,
	        szTimeStr,
	        (g_SysInfo.gpsHandle.bStatus == TRUE) ? 'A' : 'V',
	        g_SysInfo.gpsHandle.gpsLon.cIndicator,
	        g_SysInfo.gpsHandle.gpsLon.u8ddd,
	        g_SysInfo.gpsHandle.gpsLon.u8mm,
	        g_SysInfo.gpsHandle.gpsLon.u16mmmm,
	        g_SysInfo.gpsHandle.gpsLat.cIndicator,
	        g_SysInfo.gpsHandle.gpsLat.u8dd,
	        g_SysInfo.gpsHandle.gpsLat.u8mm,
	        g_SysInfo.gpsHandle.gpsLat.u16mmmm,
	        g_SysInfo.gpsHandle.u16Course,
	        M_2_KM(g_SysInfo.VehicleState.u32Speed),
	        M_2_10M(g_SysInfo.VehicleState.dDistance),
	        g_SysInfo.VehicleState.u16RPM,
	        0, //FuelInfo.LEVEL_1,
	        0, //FuelInfo.LEVEL_2,
	        0, //FuelInfo.TEMPER,
	        (g_SysInfo.VehicleState.ACC_ON == TRUE) ? 1 : 0,
	        g_SysInfo.EXTIO.bits.IN_1,
	        g_SysInfo.EXTIO.bits.IN_2,
	        (SOS == SET) ? 1 : 0);

	DataSend_AddDataToQue(Buff, strlen(pStr));
}

bool DataStream_QueryByTime(time_t *TargetTime, uint16_t *INDEX)
{
	bool RESULT;
	uint16_t DataBegin, DataIdx, DataEnd;
	EPA_INDEX_t EPA_INDEX;
	EPA_DATA_t EPA_DATA;


	*INDEX = 0;

	if(SD_GetFileSize(FileName_Query) == 0)
		return FALSE;

	RESULT = SD_ReadAddrToBuff(FileName_Query, (uint8_t*)&EPA_INDEX, sizeof(EPA_INDEX_t), 0);

	if((RESULT == TRUE && EPA_INDEX.END != EPA_INDEX_END_ID)
	        || EPA_INDEX.COUNT == 0
	        || RESULT == FALSE)
		return FALSE;

	DataBegin = 0;

	DataEnd = EPA_INDEX.COUNT;

	do
	{
		DataIdx = (DataEnd - DataBegin) / 2 + DataBegin;

		if(DataIdx <= DataBegin || DataIdx >= DataEnd)
			break;

		RESULT = SD_ReadAddrToBuff(FileName_Query, (uint8_t*)&EPA_DATA, sizeof(EPA_DATA_t),
		                           sizeof(EPA_INDEX_t) + DataIdx * sizeof(EPA_DATA_t));

		if(RESULT == TRUE
		        && EPA_DATA.tmLocalTime == *TargetTime)
		{
			*INDEX = DataIdx;

			return TRUE;
		}

		if(EPA_DATA.tmLocalTime > *TargetTime)
			DataEnd = DataIdx;

		if(EPA_DATA.tmLocalTime < *TargetTime)
			DataBegin = DataIdx;

	}
	while(DataEnd != DataBegin);

	return FALSE;
}
