		HAL_GPIO_WritePin(P_DI_GPIO_Port, P_DI_Pin, GPIO_PIN_RESET);
	else
		HAL_GPIO_WritePin(P_DI_GPIO_Port, P_DI_Pin, GPIO_PIN_SET);
}

