//============================================================================//
// User Includes
//============================================================================//
#include "SD_Driver.h"

#include <cstring>

#include "stm32f2xx_ll_spi.h"
#include "main.h"


//============================================================================//
// User Variables
//============================================================================//

bool bSD_SDHC = FALSE;

bool bSPI_TxDoneFlag = FALSE, bSPI_RxDoneFlag = FALSE;

//uint8_t u8DMA_RX_Buf[256];


//============================================================================//
// User Functions
//============================================================================//

//============================================================================//
// @brief  Select SD Card: ChipSelect pin low.
// @param  None
// @retval None
//============================================================================//
void SD_CS_Low(void)
{
	HwCfg_PBClr(SD_SPI_CS);
}

//============================================================================//
// @brief  Deselect SD Card: ChipSelect pin high.
// @param  None
// @retval None
//============================================================================//
void SD_CS_High(void)
{
	HwCfg_PBSet(SD_SPI_CS);

	SD_WriteByte(SD_DUMMY_BYTE);
}

//============================================================================//
// @brief  Terminate the communication with SD card.
// @param  None
// @retval None
//============================================================================//
void SD_DeInitComm(void)
{
	HAL_SPI_DeInit(&hspi2);

	HAL_SPI_MspDeInit(&hspi2);
}

//============================================================================//
// @brief  Detect if a SD card is correctly plugged in the memory slot or not.
// @param  None
// @retval TRUE: SD card is detected.
//         FALSE: SD card is not detected.
//============================================================================//
bool SD_PlugIn(void)
{
	HwCfg_PBInit(SD_SPI_DETECT, FALSE);

	//Delay_uS(100);

	// If there is response as high signal on pin
	if(HwCfg_PBGetState(SD_SPI_DETECT))
	{
		SD_CS_High();

		HwCfg_PBInit(SD_SPI_CS, FALSE);

		//SD_CS_High();

		return TRUE;
	}
	else
	{
#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> SD card is not detected.");
#endif

		//HwCfg_PBInit(SD_SPI_CS, FALSE);

		//SD_CS_High();

		return FALSE;
	}
  
	/*
	HwCfg_PBInit(SD_SPI_CS, FALSE);

	SD_CS_High();

	return TRUE;
	*/
}

//============================================================================//
// @brief  Returns specific information about an SD card.
// @param  psdCardInfo: Pointer to a SD_CardInfo structure that contains all SD
//         card information.
// @retval Response in the SD_Error format:
//        - SD_RESPONSE_FAILURE: Sequence failed
//        - SD_RESPONSE_NO_ERROR: Sequence success
//============================================================================//
SD_Error SD_GetCardInfo(SD_CardInfo *psdCardInfo)
{
	SD_Error sdRValue = SD_RESPONSE_FAILURE;


	sdRValue = SD_GetCSDRegister(&(psdCardInfo->SD_csd));

	sdRValue = SD_GetCIDRegister(&(psdCardInfo->SD_cid));

	psdCardInfo->CardCapacity = (psdCardInfo->SD_csd.DeviceSize + 1) ;

	psdCardInfo->CardCapacity *= (1 << (psdCardInfo->SD_csd.DeviceSizeMul + 2));

	psdCardInfo->CardBlockSize = 1 << (psdCardInfo->SD_csd.RdBlockLen);


	psdCardInfo->CardCapacity = (uint32_t)((long long)psdCardInfo->CardCapacity * psdCardInfo->CardBlockSize / SD_BLOCK_SIZE);

	psdCardInfo->CardBlockSize = SD_BLOCK_SIZE;

	return sdRValue;
}

//============================================================================//
// @brief  Read a block of data from the SD card.
// @param  pu8Buffer: Pointer to the buffer for data storage.
//         u32ReadAddr: SD card's internal address to read from.
//         u16BlockSize: the SD card data block size.
// @retval Response in the SD_Error format:
//         - SD_RESPONSE_FAILURE: Sequence failed
//         - SD_RESPONSE_NO_ERROR: Sequence success
//============================================================================//
SD_Error SD_ReadBlock(uint8_t *pu8Buffer, uint32_t u32ReadAddr, uint16_t u16BlockSize)
{
	SD_Error sdRValue = SD_RESPONSE_FAILURE;
	HAL_StatusTypeDef halRes;
	//uint32_t u32TimeOut = 0xFFFF;


	SD_CS_Low();

#if ENABLE_SDHC
	if(bSD_SDHC == TRUE)
	{
		u32ReadAddr /= SD_BLOCK_SIZE;
	}
#endif

	// Send CMD17 (SD_CMD_READ_SINGLE_BLOCK) to read one block
	SD_SendCmd(SD_CMD_READ_SINGLE_BLOCK, u32ReadAddr, 0xFF);

	// Check if the SD acknowledged the read block command: R1 response (0x00: no errors)
	if(!SD_GetResponse(SD_RESPONSE_NO_ERROR))
	{
		// Now look for the data token to signify the start of the data
		if (!SD_GetResponse(SD_START_DATA_SINGLE_BLOCK_READ))
		{
			//for (uint32_t i = 0; i < u16BlockSize; i++)
			//{
			// Save the received data
			// *pu8Buffer = SD_ReadByte();

			// Point to the next location where the byte read will be saved
			//pu8Buffer++;
			//}

			memset(pu8Buffer, 0x00, u16BlockSize);

			halRes = HAL_SPI_Receive(&hspi2, pu8Buffer, u16BlockSize, 1000);

			// Get CRC bytes (not really needed by us, but required by SD)
			SD_ReadByte();
			SD_ReadByte();

			if(halRes != HAL_OK)
			{
				//#if ENABLE_DEBUG_MSG
				//RTOSprintf("\r\n> SPI HAL read ERROR %d.", halRes);
				//#endif

				SD_CS_High();

				return SD_DATA_READ_ERROR;
			}

			// Set response value to success
			sdRValue = SD_RESPONSE_NO_ERROR;
		}
		else
		{
			//#if ENABLE_DEBUG_MSG
			//RTOSprintf("\r\n> SPI get CMD17 start token response ERROR.");
			//#endif
		}
	}
	else
	{
		//#if ENABLE_DEBUG_MSG
		//RTOSprintf("\r\n> SPI get CMD17 response ERROR.");
		//#endif
	}

	SD_CS_High();

	return sdRValue;
}

//============================================================================//
// @brief  Read multiple blocks of data from the SD card.
// @param  pu8Buffer: Pointer to the buffer for data storage.
//         u32ReadAddr: SD card's internal address to read from.
//         u16BlockSize: The SD card data block size.
//         u16BlockNum: Number of block to read
// @retval Response in the SD_Error format:
//         - SD_RESPONSE_FAILURE: Sequence failed
//         - SD_RESPONSE_NO_ERROR: Sequence success
//============================================================================//

SD_Error SD_ReadMultiBlocks(uint8_t *pu8Buffer, uint32_t u32ReadAddr,
                            uint16_t u16BlockSize, uint16_t u16BlockNum)
{
	SD_Error sdRValue = SD_RESPONSE_FAILURE;
	HAL_StatusTypeDef halRes;
	uint32_t u32TimeOut = 0xFFFF;


	SD_CS_Low();

#if ENABLE_SDHC
	if(bSD_SDHC == TRUE)
	{
		u32ReadAddr /= SD_BLOCK_SIZE;
	}
#endif

	// Send CMD18 (SD_CMD_READ_MULT_BLOCK) to read one block
	SD_SendCmd(SD_CMD_READ_MULT_BLOCK, u32ReadAddr, 0xFF);

	// Check if the SD acknowledged the read block command: R1 response (0x00: no errors)
	if(!SD_GetResponse(SD_RESPONSE_NO_ERROR))
	{
		for(int i = 0; i < u16BlockNum; i++)
		{
			// Now look for the data token to signify the start of the data
			if(!SD_GetResponse(SD_START_DATA_MULTIPLE_BLOCK_READ))
			{
				memset(pu8Buffer, 0x00, u16BlockSize);

				halRes = HAL_SPI_Receive(&hspi2, pu8Buffer, u16BlockSize, 1000);

				pu8Buffer += u16BlockSize;

				// Get CRC bytes (not really needed by us, but required by SD)
				SD_ReadByte();
				SD_ReadByte();

				if(halRes != HAL_OK)
				{
					//#if ENABLE_DEBUG_MSG
					//RTOSprintf("\r\n> SPI HAL read at block % ERROR %d.", i, halRes);
					//#endif

					sdRValue = SD_DATA_READ_ERROR;

					break;
				}

				sdRValue = SD_RESPONSE_NO_ERROR;
			}
			else
			{
				//#if ENABLE_DEBUG_MSG
				//RTOSprintf("\r\n> SPI get CMD18 start token response ERROR.");
				//#endif

				sdRValue = SD_RESPONSE_FAILURE;

				break;
			}
		}

		// Send CMD12 (SD_CMD_STOP_TRANSMISSION) to stop reading
		SD_SendCmd(SD_CMD_STOP_TRANSMISSION, 0x00, 0xFF);

		// Check if the SD acknowledged the read block command: R1 response (0x00: no errors)
		if(!SD_GetResponse(SD_RESPONSE_NO_ERROR))
		{
			while((SD_ReadByte() != 0xFF) && u32TimeOut)
				u32TimeOut--;

			if(u32TimeOut == 0)
			{
				//#if ENABLE_DEBUG_MSG
				//RTOSprintf("\r\n> SPI wait for CMD12 busy end TIMEOUT.");
				//#endif
			}
		}
		else
		{
			//#if ENABLE_DEBUG_MSG
			//RTOSprintf("\r\n> SPI get CMD12 response ERROR.");
			//#endif

			HAL_Delay(1);
		}
	}
	else
	{
		//#if ENABLE_DEBUG_MSG
		//RTOSprintf("\r\n> SPI get CMD18 response ERROR.");
		//#endif
	}

	SD_CS_High();

	return sdRValue;
}

