*/

SD_Error SD_WriteBlock(uint8_t *pu8Buffer, uint32_t u32WriteAddr, uint16_t u16BlockSize)
{
	SD_Error sdRValue = SD_RESPONSE_FAILURE;


	SD_CS_Low();

#if ENABLE_SDHC
	if(bSD_SDHC == TRUE)
	{
		u32WriteAddr /= SD_BLOCK_SIZE;
	}
#endif

	// Send CMD24 (SD_CMD_WRITE_SINGLE_BLOCK) to write multiple block
	SD_SendCmd(SD_CMD_WRITE_SINGLE_BLOCK, u32WriteAddr, 0xFF);

	// Check if the SD acknowledged the write block command: R1 response (0x00: no errors)
	if(!SD_GetResponse(SD_RESPONSE_NO_ERROR))
	{
		// Send a dummy byte
		SD_WriteByte(SD_DUMMY_BYTE);

		// Send the data token to signify the start of the data
		SD_WriteByte(0xFE);

		// Write the block data to SD : write count data by block
		//HAL_SPI_Transmit(&hspi2, pu8Buffer, u16BlockSize, 1000);

		for(int i = 0; i < u16BlockSize; i++)
		{
			// Send the pointed byte
			SD_WriteByte(*pu8Buffer);

			// Point to the next location where the byte read will be saved
			pu8Buffer++;
		}


		// Put CRC bytes (not really needed by us, but required by SD)
		SD_ReadByte();
		SD_ReadByte();

		// Read data response
		if (SD_GetDataResponse() == SD_DATA_OK)
		{
			sdRValue = SD_RESPONSE_NO_ERROR;
		}
	}

	SD_CS_High();

	return sdRValue;
}

//============================================================================//
// @brief  Writes on many blocks in the SD card
// @param  pu8Buffer: Pointer to teh buffer for data storage.
//         u32WriteAddr: Address to write from.
//         u16BlockSize: the SD card data block size.
//         NumberOfBlocks: Number of blocks to be written.
// @retval Response in the SD_Error format:
//         - SD_RESPONSE_FAILURE: Sequence failed
//         - SD_RESPONSE_NO_ERROR: Sequence success
//============================================================================//
SD_Error SD_WriteMultiBlocks(uint8_t *pu8Buffer, uint32_t u32WriteAddr, uint16_t u16BlockSize, uint32_t u32NumberOfBlocks)
{
	SD_Error sdRValue = SD_RESPONSE_FAILURE;
	HAL_StatusTypeDef halRes;
	uint32_t u32TimeOut;


	SD_CS_Low();

#if ENABLE_SDHC
	if(bSD_SDHC == TRUE)
	{
		// Send CMD25 (SD_CMD_WRITE_MULT_BLOCK) to write multiple blocks
		SD_SendCmd(SD_CMD_WRITE_MULT_BLOCK, u32WriteAddr / SD_BLOCK_SIZE, 0xFF);
	}
	else
	{
		// Send CMD25 (SD_CMD_WRITE_MULT_BLOCK) to write multiple blocks
		SD_SendCmd(SD_CMD_WRITE_MULT_BLOCK, u32WriteAddr, 0xFF);
	}
#else
	// Send CMD25 (SD_CMD_WRITE_MULT_BLOCK) to write multiple blocks
	SD_SendCmd (SD_CMD_WRITE_MULT_BLOCK, u32WriteAddr + u32Offset, 0xFF);
#endif

	// Check if the SD acknowledged the write block command: R1 response (0x00: no errors)
	if(SD_GetResponse(SD_RESPONSE_NO_ERROR))
	{
		//#if ENABLE_DEBUG_MSG
		//RTOSprintf("\r\n> Get CMD25 response ERROR.");

		SD_CS_High();
		//#endif

		return SD_RESPONSE_FAILURE;
	}

	// Read one byte
	SD_ReadByte();

	for(int i = 0; i < u32NumberOfBlocks; i++)
	{
		// Send the data token to signify the start of the data
		SD_WriteByte(SD_START_DATA_MULTIPLE_BLOCK_WRITE);

		// Write the block data to SD : write count data by block

		/*
		for(int i = 0; i < u16BlockSize; i++)
		{
			// Send the pointed byte
			SD_WriteByte(*pu8Buffer);

			// Point to the next location where stores the byte to be written
			pu8Buffer++;
		}
		*/

		halRes = HAL_SPI_Transmit(&hspi2, pu8Buffer, u16BlockSize, 1000);

		pu8Buffer += u16BlockSize;

		// Put CRC bytes (not really needed by us, but required by SD)
		SD_ReadByte();
		SD_ReadByte();

		if(halRes != HAL_OK)
		{
			//#if ENABLE_DEBUG_MSG
			//RTOSprintf("\r\n> SPI HAL write at block %d ERROR %d.", i, halRes);
			//#endif

			sdRValue = SD_DATA_OTHER_ERROR;

			break;
		}

		uint8_t u8DatResp = SD_GetDataResponse();

		// Read data response
		if(u8DatResp == SD_DATA_OK)
		{
			// Set response value to success
			sdRValue = SD_RESPONSE_NO_ERROR;

			u32TimeOut = 0xFFFF;

			while((SD_ReadByte() != 0xFF) && u32TimeOut)
				u32TimeOut--;

			if(u32TimeOut == 0)
			{
				//#if ENABLE_DEBUG_MSG
				//RTOSprintf("\r\n> SPI Wait for CMD25 data busy end TIMEOUT.");
				//#endif
			}
		}
		else
		{
			HAL_Delay(1);

			// Set response value to failure
			SD_CS_High();

			//#if ENABLE_DEBUG_MSG
			//RTOSprintf("\r\n> Get CMD25 data response ERROR %d.", u8DatResp);
			//#endif

			sdRValue = SD_RESPONSE_FAILURE;

			u32TimeOut = 0xFFFF;

			while((SD_ReadByte() != 0xFF) && u32TimeOut)
				u32TimeOut--;

			if(u32TimeOut == 0)
			{
				//#if ENABLE_DEBUG_MSG
				//RTOSprintf("\r\n> SPI Wait for CMD25 data busy end TIMEOUT.");
				//#endif
			}

			break;
		}
	}

	// Send the data token to signify the stop of the data
	SD_WriteByte(SD_STOP_DATA_MULTIPLE_BLOCK_WRITE);

	// Read one byte
	SD_ReadByte();

	u32TimeOut = 0xFFFF;

	while((SD_ReadByte() != 0xFF) && u32TimeOut)
		u32TimeOut--;

	SD_CS_High();

	return sdRValue;
}

//============================================================================//
// @brief  Read the SD card CSD register.
//         Reading the contents of the CSD register in SPI mode is a simple
//         read-block transaction.
// @param  psdSD_csd: Pointer to a SCD register structure
// @retval Response in the SD_Error format:
//         - SD_RESPONSE_FAILURE: Sequence failed
//         - SD_RESPONSE_NO_ERROR: Sequence success
//============================================================================//
SD_Error SD_GetCSDRegister(SD_CSD *psdSD_csd)
{
	SD_Error sdRValue = SD_RESPONSE_FAILURE;
	uint8_t u8CSD_Tab[16];


	SD_CS_Low();

	// Send CMD9 (CSD register) or CMD10(CSD register)
	SD_SendCmd(SD_CMD_SEND_CSD, 0, 0xFF);

	// Wait for response in the R1 format (0x00 is no errors)
	if(!SD_GetResponse(SD_RESPONSE_NO_ERROR))
	{
		if(!SD_GetResponse(SD_START_DATA_SINGLE_BLOCK_READ))
		{
			for(uint8_t i = 0; i < 16; i++)
			{
				// Store CSD register value on CSD_Tab
				u8CSD_Tab[i] = SD_ReadByte();
			}
		}
		// Get CRC bytes (not really needed by us, but required by SD)
		SD_WriteByte(SD_DUMMY_BYTE);
		SD_WriteByte(SD_DUMMY_BYTE);

		// Set response value to success
		sdRValue = SD_RESPONSE_NO_ERROR;
	}

	SD_CS_High();

	// Byte 0
	psdSD_csd->CSDStruct = (u8CSD_Tab[0] & 0xC0) >> 6;
	psdSD_csd->SysSpecVersion = (u8CSD_Tab[0] & 0x3C) >> 2;
	psdSD_csd->Reserved1 = u8CSD_Tab[0] & 0x03;
	// Byte 1
	psdSD_csd->TAAC = u8CSD_Tab[1];
	// Byte 2
	psdSD_csd->NSAC = u8CSD_Tab[2];
	// Byte 3
	psdSD_csd->MaxBusClkFrec = u8CSD_Tab[3];
	// Byte 4
	psdSD_csd->CardComdClasses = u8CSD_Tab[4] << 4;
	// Byte 5
	psdSD_csd->CardComdClasses |= (u8CSD_Tab[5] & 0xF0) >> 4;
	psdSD_csd->RdBlockLen = u8CSD_Tab[5] & 0x0F;
	// Byte 6
	psdSD_csd->PartBlockRead = (u8CSD_Tab[6] & 0x80) >> 7;
	psdSD_csd->WrBlockMisalign = (u8CSD_Tab[6] & 0x40) >> 6;
	psdSD_csd->RdBlockMisalign = (u8CSD_Tab[6] & 0x20) >> 5;
	psdSD_csd->DSRImpl = (u8CSD_Tab[6] & 0x10) >> 4;
	psdSD_csd->Reserved2 = 0;

	if(bSD_SDHC == FALSE)
	{
		psdSD_csd->DeviceSize = (u8CSD_Tab[6] & 0x03) << 10;
		// Byte 7
		psdSD_csd->DeviceSize |= (u8CSD_Tab[7]) << 2;
		// Byte 8
		psdSD_csd->DeviceSize |= (u8CSD_Tab[8] & 0xC0) >> 6;
	}
	else
	{
		//
		psdSD_csd->DeviceSize = (u8CSD_Tab[7] & 0x3F) << 16;
		// Byte 7
		psdSD_csd->DeviceSize += (u8CSD_Tab[8]) << 8;
		// Byte 8
		psdSD_csd->DeviceSize += u8CSD_Tab[9] ;
	}
	//
	psdSD_csd->MaxRdCurrentVDDMin = (u8CSD_Tab[8] & 0x38) >> 3;
	psdSD_csd->MaxRdCurrentVDDMax = (u8CSD_Tab[8] & 0x07);

	// Byte 9
	psdSD_csd->MaxWrCurrentVDDMin = (u8CSD_Tab[9] & 0xE0) >> 5;
	psdSD_csd->MaxWrCurrentVDDMax = (u8CSD_Tab[9] & 0x1C) >> 2;
	psdSD_csd->DeviceSizeMul = (u8CSD_Tab[9] & 0x03) << 1;
	// Byte 10
	psdSD_csd->DeviceSizeMul |= (u8CSD_Tab[10] & 0x80) >> 7;
	psdSD_csd->EraseGrSize = (u8CSD_Tab[10] & 0x7C) >> 2;
	psdSD_csd->EraseGrMul = (u8CSD_Tab[10] & 0x03) << 3;
	// Byte 11
	psdSD_csd->EraseGrMul |= (u8CSD_Tab[11] & 0xE0) >> 5;
	psdSD_csd->WrProtectGrSize = (u8CSD_Tab[11] & 0x1F);
	// Byte 12
	psdSD_csd->WrProtectGrEnable = (u8CSD_Tab[12] & 0x80) >> 7;
	psdSD_csd->ManDeflECC = (u8CSD_Tab[12] & 0x60) >> 5;
	psdSD_csd->WrSpeedFact = (u8CSD_Tab[12] & 0x1C) >> 2;
	psdSD_csd->MaxWrBlockLen = (u8CSD_Tab[12] & 0x03) << 2;
	// Byte 13
	psdSD_csd->MaxWrBlockLen |= (u8CSD_Tab[13] & 0xC0) >> 6;
	psdSD_csd->WriteBlockPaPartial = (u8CSD_Tab[13] & 0x20) >> 5;
	psdSD_csd->Reserved3 = 0;
	psdSD_csd->ContentProtectAppli = (u8CSD_Tab[13] & 0x01);
	// Byte 14
	psdSD_csd->FileFormatGrouop = (u8CSD_Tab[14] & 0x80) >> 7;
	psdSD_csd->CopyFlag = (u8CSD_Tab[14] & 0x40) >> 6;
	psdSD_csd->PermWrProtect = (u8CSD_Tab[14] & 0x20) >> 5;
	psdSD_csd->TempWrProtect = (u8CSD_Tab[14] & 0x10) >> 4;
	psdSD_csd->FileFormat = (u8CSD_Tab[14] & 0x0C) >> 2;
	psdSD_csd->ECC = (u8CSD_Tab[14] & 0x03);
	// Byte 15
	psdSD_csd->CSD_CRC = (u8CSD_Tab[15] & 0xFE) >> 1;
	psdSD_csd->Reserved4 = 1;

	if(bSD_SDHC == TRUE)
	{
		// SDHC memory capacity = (C_SIZE+1) * 512K byte
		psdSD_csd->DeviceSizeMul = 8 ;
	}

	return sdRValue;
}

//============================================================================//
// @brief  Read the CID card register.
//         Reading the contents of the CID register in SPI mode is a simple
//         read-block transaction.
// @param  psdSD_cid: Pointer to a CID register structure
// @retval The SD Response:
//         - SD_RESPONSE_FAILURE: Sequence failed
//         - SD_RESPONSE_NO_ERROR: Sequence success
//============================================================================//
SD_Error SD_GetCIDRegister(SD_CID *psdSD_cid)
{
	SD_Error sdRValue = SD_RESPONSE_FAILURE;
	uint8_t u8CID_Tab[16];


	SD_CS_Low();

	// Send CMD10 (CID register)
	SD_SendCmd(SD_CMD_SEND_CID, 0, 0xFF);

	// Wait for response in the R1 format (0x00 is no errors)
	if (!SD_GetResponse(SD_RESPONSE_NO_ERROR))
	{
		if (!SD_GetResponse(SD_START_DATA_SINGLE_BLOCK_READ))
		{
			// Store CID register value on CID_Tab
			for (uint8_t i = 0; i < 16; i++)
			{
				u8CID_Tab[i] = SD_ReadByte();
			}
		}
		// Get CRC bytes (not really needed by us, but required by SD)
		SD_WriteByte(SD_DUMMY_BYTE);
		SD_WriteByte(SD_DUMMY_BYTE);
		// Set response value to success
		sdRValue = SD_RESPONSE_NO_ERROR;
	}

	SD_CS_High();

	// Byte 0
	psdSD_cid->ManufacturerID = u8CID_Tab[0];
	// Byte 1
	psdSD_cid->OEM_AppliID = u8CID_Tab[1] << 8;
	// Byte 2
	psdSD_cid->OEM_AppliID |= u8CID_Tab[2];
	// Byte 3
	psdSD_cid->ProdName1 = u8CID_Tab[3] << 24;
	// Byte 4
	psdSD_cid->ProdName1 |= u8CID_Tab[4] << 16;
	// Byte 5
	psdSD_cid->ProdName1 |= u8CID_Tab[5] << 8;
	// Byte 6
	psdSD_cid->ProdName1 |= u8CID_Tab[6];
	// Byte 7
	psdSD_cid->ProdName2 = u8CID_Tab[7];
	// Byte 8
	psdSD_cid->ProdRev = u8CID_Tab[8];
	// Byte 9
	psdSD_cid->ProdSN = u8CID_Tab[9] << 24;
	// Byte 10
	psdSD_cid->ProdSN |= u8CID_Tab[10] << 16;
	// Byte 11
	psdSD_cid->ProdSN |= u8CID_Tab[11] << 8;
	// Byte 12
	psdSD_cid->ProdSN |= u8CID_Tab[12];
	// Byte 13
	psdSD_cid->Reserved1 |= (u8CID_Tab[13] & 0xF0) >> 4;
	psdSD_cid->ManufactDate = (u8CID_Tab[13] & 0x0F) << 8;
	// Byte 14
	psdSD_cid->ManufactDate |= u8CID_Tab[14];
	// Byte 15
	psdSD_cid->CID_CRC = (u8CID_Tab[15] & 0xFE) >> 1;
	psdSD_cid->Reserved2 = 1;

	return sdRValue;
}

//============================================================================//
// @brief  Send 5 bytes command to the SD card.
// @param  u8Cmd: The user expected command to send to SD card.
//         u32Arg: The command argument.
//         u8Crc: The CRC.
// @retval None
//============================================================================//
void SD_SendCmd(uint8_t u8Cmd, uint32_t u32Arg, uint8_t u8Crc)
{
	uint8_t u8Frame[6];


	// Construct byte 1
	u8Frame[0] = (u8Cmd | 0x40);
	// Construct byte 2
	u8Frame[1] = (uint8_t)(u32Arg >> 24);
	// Construct byte 3
	u8Frame[2] = (uint8_t)(u32Arg >> 16);
	// Construct byte 4
	u8Frame[3] = (uint8_t)(u32Arg >> 8);
	// Construct byte 5
	u8Frame[4] = (uint8_t)(u32Arg);
	// Construct CRC: byte 6
	u8Frame[5] = (u8Crc);

	// Send the Cmd bytes
	for (uint8_t i = 0; i < 6; i++)
	{
		SD_WriteByte(u8Frame[i]);
	}

	SD_ReadByte();
}

//============================================================================//
// @brief  Get SD card data response.
// @param  None
// @retval The SD status: Read data response xxx0<status>1
//         - status 010: Data accecpted
//         - status 101: Data rejected due to a crc error
//         - status 110: Data rejected due to a Write error.
//         - status 111: Data rejected due to other error.
//============================================================================//
uint8_t SD_GetDataResponse(void)
{
	uint8_t u8Response, u8RValue, u8Cnt = 0;


	while(u8Cnt <= 64)
	{
		// Read resonse
		u8Response = SD_ReadByte();

		// Mask unused bits
		u8Response &= 0x1F;

		switch(u8Response)
		{
			case SD_DATA_OK:
				{
					u8RValue = SD_DATA_OK;
					break;
				}

			case SD_DATA_CRC_ERROR:
				return SD_DATA_CRC_ERROR;

			case SD_DATA_WRITE_ERROR:
				return SD_DATA_WRITE_ERROR;

			default:
				{
					u8RValue = SD_DATA_OTHER_ERROR;
					break;
				}
		}

		// Exit loop in case of data ok
		if (u8RValue == SD_DATA_OK)
			break;

		// Increment loop counter
		u8Cnt++;
	}

	// Wait null data
	while(SD_ReadByte() == 0);

	if(u8Cnt >= 64)
	{
		u8Response = SD_DATA_NO_RESPONSE;
	}

	return u8Response;
}

//============================================================================//
// @brief  Returns the SD response.
// @param  u8Response: Response to wait for
// @retval The SD Response:
//         - SD_RESPONSE_FAILURE: Sequence failed
//         - SD_RESPONSE_NO_ERROR: Sequence success
//============================================================================//
SD_Error SD_GetResponse(uint8_t u8Response)
{
	uint32_t u32Count = 0xFFF;


	// Check if response is got or a timeout is happen
	while((SD_ReadByte() != u8Response) && u32Count)
	{
		u32Count--;
	}

	if (u32Count == 0)
	{
		//RTOSprintf("\r\n> SD get response TIMEOUT.");
		
		return SD_RESPONSE_FAILURE;
	}
	else
	{
		return SD_RESPONSE_NO_ERROR;
	}
}

//============================================================================//
// @brief  Put the SD card in idle state.
// @param  None
// @retval The SD Response:
//         - SD_RESPONSE_FAILURE: Sequence failed
//         - SD_RESPONSE_NO_ERROR: Sequence success
//============================================================================//
SD_Error SD_GoIdleState(void)
{
	uint16_t u16Timeout;


#if ENABLE_SDHC
	uint8_t u8SD_RES[5];

	SD_CS_Low();

	// Send CMD0 (SD_CMD_GO_IDLE_STATE) to put SD in SPI mode
	SD_SendCmd(SD_CMD_GO_IDLE_STATE, 0, 0x95);

	// Wait for In Idle State Response (R1 Format) equal to 0x01
	if(SD_GetResponse(SD_IN_IDLE_STATE))
	{
		//RTOSprintf("\r\n> SD_IN_IDLE_STATE get response 1 FAIL.");
		
		// No Idle State Response: return response failue
		return SD_RESPONSE_FAILURE;
	}

	// Check version
	SD_SendCmd(8, 0x1AA, 0x87);

	// Check if response is got or a timeout is happen
	for(uint8_t i = 0; i < sizeof(u8SD_RES); i++)
	{
		u8SD_RES[i] = SD_ReadByte();
	}

	if((u8SD_RES[0] & SD_IN_IDLE_STATE) == 0)
	{
		//RTOSprintf("\r\n> SD_IN_IDLE_STATE get response 2 FAIL.");
		
		// No Idle State Response: return response failue
		return SD_RESPONSE_FAILURE;
	}

	// SD CARD V2.0
	if(u8SD_RES[0] == SD_IN_IDLE_STATE)
	{
		u16Timeout = 0xFFF;

		do
		{
			SD_SendCmd(55, 0, 0xFF);

			u8SD_RES[0] = SD_ReadByte();

			// Check if response is got or a timeout is happen
			if((u8SD_RES[0] & SD_IN_IDLE_STATE) == 0)
				continue;

			SD_SendCmd(41, 0x40000000, 0);

			u8SD_RES[0] = SD_ReadByte();

			// Check if response is got or a timeout is happen
			if((u8SD_RES[0] & SD_IN_IDLE_STATE) == 0)
				break;

			u16Timeout--;
		}
		while(u16Timeout);

		if(u16Timeout == 0)
		{
			//RTOSprintf("\r\n> SD_IN_IDLE_STATE get response 3 FAIL.");
			
			// No Idle State Response: return response failue
			return SD_RESPONSE_FAILURE;
		}
		else
		{
			SD_SendCmd(58, 0, 0);
			// Check if response is got or a timeout is happen

			for(uint8_t i = 0; i < sizeof(u8SD_RES); i++)
			{
				u8SD_RES[i] = SD_ReadByte();
			}

			SD_CS_High();

			bSD_SDHC = FALSE;

			// Check CCS flag
			if(u8SD_RES[1] & 0x40)
			{
				bSD_SDHC = TRUE;
				
				//RTOSprintf("\r\n> SD disk is SDHC type.");
			}

			return SD_RESPONSE_NO_ERROR;
		}
	}
	else
	{
		//RTOSprintf("\r\n> SD disk is NOT SDHC type.");
		
		bSD_SDHC = FALSE;

		u16Timeout = 0xFF;

		// Activates the card initialization process
		do
		{
			SD_CS_High();

			SD_CS_Low();

			// Send CMD1 (Activates the card process) until response equal to 0x0
			SD_SendCmd(SD_CMD_SEND_OP_COND, 0, 0xFF);

			u16Timeout--;

			if(u16Timeout == 0)
			{
				SD_CS_High();
				
				//RTOSprintf("\r\n> SD_IN_IDLE_STATE get response 4 FAIL.");

				// No Idle State Response: return response failue
				return SD_RESPONSE_FAILURE;
			}

		}
		while(SD_GetResponse(SD_RESPONSE_NO_ERROR));

		SD_CS_High();

		return SD_RESPONSE_NO_ERROR;
	}
#else
	SD_CS_Low();

	// Send CMD0 (SD_CMD_GO_IDLE_STATE) to put SD in SPI mode
	SD_SendCmd(SD_CMD_GO_IDLE_STATE, 0, 0x95);

	// Wait for In Idle State Response (R1 Format) equal to 0x01
	if(SD_GetResponse(SD_IN_IDLE_STATE))
	{
		SD_CS_High();

		// No Idle State Response: return response failue
		return SD_RESPONSE_FAILURE;
	}

	u16Timeout = 0xFF;

	// Activates the card initialization process
	do
	{
		SD_CS_High();

		SD_CS_Low();

		// Send CMD1 (Activates the card process) until response equal to 0x00
		SD_SendCmd(SD_CMD_SEND_OP_COND, 0, 0xFF);

		u16Timeout--;

		if(u16Timeout == 0)
		{
			SD_CS_High();

			// No Idle State Response: return response failue
			return SD_RESPONSE_FAILURE;
		}

	}
	while(SD_GetResponse(SD_RESPONSE_NO_ERROR));

	SD_CS_High();

	return SD_RESPONSE_NO_ERROR;
#endif
}

//============================================================================//
// @brief  Returns the SD card status.
// @param  None
// @retval The SD card status in the uint16_t format.
//============================================================================//
uint16_t SD_GetStatus(void)
{
	uint16_t u16Status = 0;


	SD_CS_Low();

	// Send CMD13 (SD_SEND_STATUS) to get SD status
	SD_SendCmd(SD_CMD_SEND_STATUS, 0, 0xFF);

	u16Status = SD_ReadByte();
	
	u16Status |= (uint16_t)(SD_ReadByte() << 8);

	SD_CS_High();

	return u16Status;
}

//============================================================================//
// @brief  Write a byte to the SD card.
// @param  u8SendData: Byte to send.
// @retval None
//============================================================================//
uint8_t SD_WriteByte(uint8_t u8SendData)
{
	uint8_t u8RecvData;


	// Send the byte then receive a byte
	HAL_SPI_TransmitReceive(&hspi2, &u8SendData, &u8RecvData, 1, 100);

	// Return the byte read from the SPI bus
	return u8RecvData;
}

//============================================================================//
// @brief  Read a byte from the SD card.
// @param  None
// @retval The received byte.
//============================================================================//
uint8_t SD_ReadByte(void)
{
	uint8_t u8SendData = 0xFF;
	uint8_t u8RecvData;


	// Send a DUMMY BYTE then receive a byte
	HAL_SPI_TransmitReceive(&hspi2, &u8SendData, &u8RecvData, 1, 100);

	// Return the received data
	return u8RecvData;
}
