bool SIM908_GetNetStatus(void)
{
	static bool NetStatus;

#if ENABLE_MULTI_IP
	//
	if(SocketState[SOCKET_BANK_DEF].CONN == TRUE
	        && SocketState[SOCKET_BANK_EXT].CONN == TRUE)
	{
		//
		if(NetStatus == FALSE)
		{
			//
			RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_NET_CONNECT);
		}
		//
		NetStatus = TRUE;
	}
	else
	{
		//
		if(NetStatus == TRUE)
		{
			//
			RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_NET_DISCONN);
		}
		//
		NetStatus = FALSE;
	}
#else
	//
	if(SocketState[SOCKET_BANK_DEF].CONN == TRUE)
	{
		//
		if(NetStatus == FALSE)
		{
			//
			RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_NET_CONNECT);
		}
		//
		NetStatus = TRUE;
	}
	else
	{
		//
		if(NetStatus == TRUE)
		{
			//
			RTOSprintf("> [SYS]%04X\r\n", SYS_STATE_GSM_NET_DISCONN);
		}
		//
		NetStatus = FALSE;
	}
#endif

	//
	return NetStatus;
}

