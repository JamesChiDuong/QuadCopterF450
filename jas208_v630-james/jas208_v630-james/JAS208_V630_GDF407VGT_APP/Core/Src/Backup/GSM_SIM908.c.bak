void SIM908_SendMessage(GSM_MSG_DATA_t MsgData)
{
	char szTEMP[32];

	//
	memcpy(gGSM_DataSend.Buf, MsgData.Data, MsgData.u16DataLen);
	//
	gGSM_DataSend.BufLen = MsgData.u16DataLen;

	//
	sprintf(szTEMP, "AT+CMGS=\"%s\"", MsgData.PhoneNum);
	//
	SIM908_BuildCmd(szTEMP);

	//
	gGSM_NextCmd = AT_SEND_MSG;
}

//============================================================================//
//
//============================================================================//
bool SIM908_SendMessageEvent(char *pStr)
{
	//
	char EventMsg[UART_MAX_BUFFER_SIZE];
	//
	char EventName[24];
	char EventMobile[24];
	char EventTime[24];
	char EventSpeed[16];
	char EventCourse[16];
	char EventAddr[100];
	char EventData[UART_MAX_BUFFER_SIZE];

	//
	strcpy(EventMsg, pStr);
	//
	pStr = EventMsg;

	// 事件名稱
	StopChar(pStr, ',');
	//
	GSM_GetSmsEvent(pStr, EventName);
	//
	pStr += strlen(pStr) + 1;

	// 手機門號
	StopChar(pStr, ',');
	//
	if(strlen(pStr) == 0)
	{
		//
		strcpy(EventMobile, g_Setting.GSM_SET.PhoneBank[0].Number);
		//
		if(strlen(EventMobile) == 0)
			return FALSE;
	}
	else
	{
		//
		strcpy(EventMobile, pStr);
	}
	//
	pStr += strlen(pStr) + 1;

	// 事件時間
	StopChar(pStr, ',');
	//
	{
		time_t rawtime;
		struct tm * timeinfo;
		char TEMP[6];

		//
		time(&rawtime);
		//
		rawtime += g_Setting.i32TimeZoneOffset;
		//
		timeinfo = localtime(&rawtime);
		//
		strncpy(TEMP, pStr, 2);
		timeinfo->tm_hour = atoi(TEMP);
		//
		strncpy(TEMP, pStr + 2, 2);
		timeinfo->tm_min = atoi(TEMP);
		//
		strncpy(TEMP, pStr + 4, 2);
		timeinfo->tm_sec = atoi(TEMP);
		//
		rawtime = mktime(timeinfo);

		//
		strftime(EventTime, sizeof(EventTime), "%Y-%m-%d %H:%M:%S", localtime(&rawtime));
	}
	//
	pStr += strlen(pStr) + 1;

	// 事件速度
	StopChar(pStr, ',');
	//
	sprintf(EventSpeed, "%dkm/hr", atoi(pStr));
	//
	pStr += strlen(pStr) + 1;

	// 事件方向
	StopChar(pStr, ',');
	//
	if(pStr[3] == '1')
		strcpy(EventCourse, STR_NORTH);
	else if(pStr[3] == '7')
		strcpy(EventCourse, STR_NORTH_EAST);
	else if(pStr[3] == '2')
		strcpy(EventCourse, STR_EAST);
	else if(pStr[3] == '8')
		strcpy(EventCourse, STR_SOUTH_EAST);
	else if(pStr[3] == '3')
		strcpy(EventCourse, STR_SOUTH);
	else if(pStr[3] == '9')
		strcpy(EventCourse, STR_SOUTH_WEST);
	else if(pStr[3] == '0')
		strcpy(EventCourse, STR_WEST);
	else if(pStr[3] == '6')
		strcpy(EventCourse, STR_NORTH_WEST);
	//
	pStr += strlen(pStr) + 1;

	// GEO名稱
	StopChar(pStr, ',');
	pStr += strlen(pStr) + 1;

	// 事件地址
	strcpy(EventAddr, pStr);

#if CUSTOMER_TYPE == CUSTOMER_POPE
	//
	sprintf(EventData, "%s,%s %s\n%s\n%s\n%s,%s\nWe Track24/7\x1A",
	        EventMobile,
	        g_Setting.szBus_ID,
	        EventName,
	        EventTime,
	        EventAddr,
	        EventCourse,
	        EventSpeed);
#else
	//
	sprintf(EventData, "%s,%s %s\n%s\n%s\n%s,%s\x1A",
	        EventMobile,
	        g_Setting.szBus_ID,
	        EventName,
	        EventTime,
	        EventAddr,
	        EventCourse,
	        EventSpeed);
#endif

	//
	DataSend_AddMsgToQue((uint8_t*)EventData, strlen(EventData));
	//
	return TRUE;
}

