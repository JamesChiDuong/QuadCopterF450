	AT_GPS_DATA_OUT,
	//
	AT_MSG_FORMAT,
	AT_MSG_NEW,
	//
	AT_AUDIO_PATH_SET,
	AT_SPK_VOLUME_INIT,
	AT_MIC_GAIN_INIT,
	//
	AT_REQUEST_IMSI,
	AT_REQUEST_IMEI,
	//
	AT_CGATT_RD,
	//
	AT_NET_SET_MULTI_IP,
	AT_NET_APN_SET,
	AT_NET_BRING_UP,
	AT_NET_GET_LOCAL_IP,
	AT_NET_CONNECT,
	AT_NET_DISCONN,
	AT_NET_CLOSE,
	//
	AT_SEND_DATA,
	AT_SEND_DATA_BEGIN,
	//
	AT_SEND_MSG,
	AT_SEND_MSG_BEGIN,
	//
	AT_SMS_READ,
	AT_SMS_DELETE,
	//
	AT_SPK_VOLUME_SET,
	AT_MIC_GAIN_SET,
	//
	AT_CALL_DIAL,
	AT_CALL_ANSWER,
	AT_CALL_HOOK,
	//
	AT_CMD_CSQ,
	//
	AT_GPS_TURN_ON,
	AT_GPS_TURN_OFF,
	//
	AT_CMD_TEST,
	//
	AT_CMD_BREAK,
} AT_CMD_t;
// GSM command status
typedef enum
{
	//
	CMD_INIT = 0,
