//============================================================================//
//
//============================================================================//
void SIM908_GpsTurnOn(GPS_START_t GpsStart)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	//
	if(GpsStart == START_COLD)
	{
		//
		sprintf(pStr, "%d,AT+CGPSRST=0", AT_GPS_TURN_ON);
		//
		DataSend_AddCmdToQue(Buf, strlen(pStr));
	}

	//
	if(GpsStart == START_HOT)
	{
		//
		sprintf(pStr, "%d,AT+CGPSRST=1", AT_GPS_TURN_ON);
		//
		DataSend_AddCmdToQue(Buf, strlen(pStr));
	}
}

//============================================================================//
//
//============================================================================//
void SIM908_GpsTurnOff(void)
{
	uint8_t Buf[64];
	char *pStr;

	//
	pStr = (char*)Buf;

	//
	sprintf(pStr, "%d,AT+CGPSPWR=0", AT_GPS_TURN_OFF);
	//
	DataSend_AddCmdToQue(Buf, strlen(pStr));
}

