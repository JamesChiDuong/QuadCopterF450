//============================================================================//
// @brief  Setup system when initialize.
// @param  None.
// @retval None.
//============================================================================//
static void System_InitSetup(void)
{
	bool bRes;
	uint32_t u32SettingSize;
	

	memset(&g_SysInfo, 0x00, sizeof(gSysInfoTypeDef));
	
	g_SysInfo.tSpeedInfo.bIsOverSpeed = FALSE;
	g_SysInfo.tSpeedInfo.bIsRPM_Idle = FALSE;

	bRes = System_GetSetting();

	if(bRes == FALSE)
	{
		RTOSprintf("\r\n>>> gSetting is stored incorrectly. Setting gSetting to default.");
		
		System_SetupDefault();

		System_SaveSetting();
	}
	
	u32SettingSize = sizeof(gSettingTypeDef);
	
	if(u32SettingSize != g_Setting.u32SetSize)
	{
		RTOSprintf("\r\n>>> gSetting size changed. Setting gSetting to default.");
		
	  System_SetupDefault();
		
		System_SaveSetting();
	}
	
	#if ENABLE_GSM_NET
	for(int i = 0; i < MAX_SOCKET_BANK; i++)
	{
		if(g_Setting.tGSM_SET.tServerInfo[i].u8LogPeriod > 0)
		{
			u8DATALOG_UPLOAD_MAX[i] = g_Setting.tGSM_SET.tServerInfo[i].u8LogPeriod;
		}
  }
	#endif
}

//============================================================================//
// @brief  Initialize system.
// @param  None.
// @retval None.
//============================================================================//
void System_Init(void)
{
	//RTC_TimeTypeDef rtcTime;
	RTC_DateTypeDef rtcDate;
	MX25L_StatusTypeDef mxlRes;
	//uint8_t u8MX25L_RestartCnt;
	bool bRes;

	
	HAL_PWR_EnableBkUpAccess();
	
	System_IO_3V3_Disable();
	
	HAL_Delay(500);

	System_IO_3V3_Enable();

	HAL_Delay(100);
	
	EXTIO_BatteryEnable();
	
	UART_SetupAll();
	
	bPrintfEn = TRUE;
	
	//RTOSprintf("\r\n> System Init");
	
	System_FlagCheck();
	
	#if ENABLE_INDEX_BUFFER
	if(bSD_ReportErrFlag == FALSE)
	  V161_IndexFileNameInit();
	#endif

	mxlRes = MX25L_Init();
	
	//RTOSprintf("\r\n> MX25L initialization status:%d", mxlRes);

	if(mxlRes != MX25L_OK)
	{
		RTOSprintf("\r\n> MX25L initialization ERROR!");
		
		RTOSprintf("\r\n> MX25L reset.");
		
		MX25L_Restart();
	}
	
	LCD_Init();
	
	//u8MX25L_RestartCnt = HW_ReadBackupRegister(MX25L_ERROR_CHK);
	
	//if((u8MX25L_RestartCnt & 0x80) > 0)
	//{
	//  HW_WriteBackupRegister(MX25L_ERROR_CHK, 0x00);
	//	
	//	RTOSprintf("\r\n>>> MX25L IC HAS FAILURE. SYSTEM STOP!!!");
		
	//	LCD_ScreenClear();
		
	//	LCD_DisplaySubMenu(54);
		
	//	while(1)
	//	{
	//	  EXTIO_DetectACC_2();
			
	//		HAL_IWDG_Refresh(&hiwdg);
			
	//		HAL_Delay(100);
	//	}
	//}

	// Show auto test
	LCD_SetShowAutoTestPage(30);
	
	//RTOSprintf("\r\n> Check IC PCF time.");

	bRes = PCF_GetDate(&rtcDate, 1);
	
	if(bRes == TRUE)
  {
		if((rtcDate.Year > 19) && (rtcDate.Year < 50))
		{
			g_bPCF_EN = TRUE;

			g_u8HwInfo = (g_u8HwInfo | 0x10);

			//RTOSprintf("\r\n> Check IC PCF OK. (0x%02X)", g_u8HwInfo);
			
			bSystemTimeReady = TRUE;
		}
		else
		{
			g_bPCF_EN = FALSE;

			g_u8HwInfo = (g_u8HwInfo & 0xEF);

			RTOSprintf("\r\n> IC PCF time not stored. (0x%02X)", g_u8HwInfo);
		}
  }
	else
	{
	  RTOSprintf("\r\n> PCF initialization FAIL!");
		
		RTOSprintf("\r\n> PCF reset.");
		
		PCF_Restart();
	}
	
	/*
		rtcTime.Hours = 0x07;
		rtcTime.Minutes = 0x14;
		rtcTime.Seconds = 0x01;

		rtcDate.Date = 0x25;
		rtcDate.Month = RTC_MONTH_MARCH;
		rtcDate.WeekDay = RTC_WEEKDAY_WEDNESDAY;
		rtcDate.Year = 0x20;

		PCF_InitTime(&rtcTime, &rtcDate, 0);
	*/
	
	//RTOSprintf("\r\n> System init setup.");

	System_InitSetup();
	
	//if(g_Setting.tSD_State.bSD_State == FALSE)
	//{
	//  g_Setting.tSD_State.bSD_State = TRUE;
		
	//	System_SaveSetting();
		
	//	RTOSprintf("\r\n>>> SD CARD HAS FAILURE. SYSTEM STOP!!!");
		
	//	LCD_ScreenClear();
		
	//	LCD_DisplaySubMenu(53);
		
	//	while(1)
	//	{
	//	  EXTIO_DetectACC_2();
			
	//		HAL_IWDG_Refresh(&hiwdg);
			
	//		HAL_Delay(100);
	//	}
	//}
	
	bRes = SD_Init();
	
	//RTOSprintf("\r\n> SD card initialization status:%d", bRes);

	if(!bRes)
	{
		RTOSprintf("\r\n> SD card initialization ERROR!");
		
		RTOSprintf("\r\n> SD reset.");
		
		SD_Reset();
	}
	
	if(bSD_ReportErrFlag == FALSE)
	{
		if(SD_CheckDirExist(FOLDERNAME_VDR) == FALSE)
			SD_MakeDir(FOLDERNAME_VDR);
  }
	
	//RTOSprintf("\r\n> LCD init");

	#if ENABLE_GSM_NET
	if(strncmp(g_Setting.cJAS_Ver, (char *)JAS208_NO_GSM, 7) == 0)
	{
		RTOSprintf("\r\n> DETECTED GSM FUNCTION ENABLED, CHANGE VERSION TO JAS208U.");

		memset(g_Setting.cJAS_Ver, 0x00, sizeof(g_Setting.cJAS_Ver));

		sprintf(g_Setting.cJAS_Ver, "%s", JAS208_GSM);

		System_SaveSetting();
	}
	
	GSM_BlockCmdInit();
	
	GSM_NonBlockCmdInit();
	
	bQtEC21_State = TRUE; 

	QtEC21_TurnOnPwrKey();
	#else
	if(strncmp(g_Setting.cJAS_Ver, (char *)JAS208_GSM, 7) == 0)
	{
		RTOSprintf("\r\n> DETECTED GSM FUNCTION DISABLED, CHANGE VERSION TO JAS208S.");

		memset(g_Setting.cJAS_Ver, 0x00, sizeof(g_Setting.cJAS_Ver));

		sprintf(g_Setting.cJAS_Ver, "%s", JAS208_NO_GSM);

		System_SaveSetting();
	}
	#endif
	
	//RTOSprintf("\r\n> EXTIO init");

	EXTIO_Init();
	
	//RTOSprintf("\r\n> GPS Init");

  #if ENABLE_GPS_MODULE && GPS_HARDWARE_TYPE == GPS_MODULE_SIM68
	GPS_PowerOn();
	#endif
	
	//RTOSprintf("\r\n> PRN init");

	PRN_Init();
	
	if(bSD_ReportErrFlag == FALSE)
	{
      //RTOSprintf("\r\n> Check TEMP files");	
	
	  System_CheckTempFile();
  }
	
	// Close Admin mode
	g_Setting.tENABLE_SET.bits.ENG_MODE = 0;

	// Close Calibration mode
	g_Setting.tENABLE_SET.bits.CORRECT_MODE = 0;
	
	if(g_Setting.tUpgrade.bUpgradeFlag == TRUE)
	{
		RTOSprintf("\r\n> Have Upgrade, Reflash FW Version");
		
		if(bSD_ReportErrFlag == FALSE)
		  V161_RecordTechnical(3);
		
		g_Setting.tUpgrade.bUpgradeFlag = FALSE;
		
		System_SaveSetting();
	}

	RTOSprintf("\r\n> [SYS]%04X", SYS_STATE_SYSTEM_INIT_OK);
	
	#if ENABLE_GSM_NET
	GSM_TCP_ReportEvent((char *)EVENT_SYSTEM_ON, STR_NULL);
	#endif
}

//============================================================================//
// @brief  Deinitialize system.
// @param  None.
// @retval None.
//============================================================================//
void System_DeInit(void)
{
	//SD_DeInitComm();
	
	#if GPS_HARDWARE_TYPE == GPS_MODULE_SIM68
	GPS_PowerOff();
	#endif
	
	//#if ENABLE_GSM_NET
	//QtEC21_TurnOffPwrKey();
	//#endif
	
	//HAL_Delay(S_2_mS(1));
	
	#if ENABLE_INDEX_BUFFER
	if((bSD_ReportErrFlag == FALSE) && (u8SD_RetryCnt == 0) && (u8SD_ErrCnt == 0))
	{
		//printf("\r\n> ### Save file index before enter standby mode ###");
		
		V161_SaveFileIdxAll();
	}
	#endif
	
	System_IO_3V3_Disable();
}

//============================================================================//
// @brief  System software reset.
// @param  None.
// @retval None.
//============================================================================//
void System_Reset(void)
{
	System_DeInit();

	// Generate system reset 
	NVIC_SystemReset();
}

//============================================================================//
// @brief  Get system time.
// @param  None.
// @retval System time in time_t format.
//============================================================================//
time_t System_GetTime(void)
{
	time_t ttTimeNow;
	osStatus osRes;


	if(bSysInitFinish)
	{
		//osRes = osMutexWait(mutex_ttnow_user, S_2_mS(10));

		//if(osRes != osOK)
		//	return FALSE;

		ttTimeNow = g_SysInfo.ttNow;

		//osMutexRelease(mutex_ttnow_user);
	}
	else
	{
		struct tm tmRTCTimeInfo;
		RTC_TimeTypeDef rtcTime;
		RTC_DateTypeDef rtcDate;
		

		// If using IC PCF as time source
		if(g_bPCF_EN == TRUE)
		{
			// Get current time in Binary format
			if(!PCF_GetTime(&rtcTime, 1))
			{
				RTOSprintf("\r\n> Get system time ERROR.");

				return 0;
			}

			// Get current date in Binary format
			if(!PCF_GetDate(&rtcDate, 1))
			{
				RTOSprintf("\r\n> Get system date ERROR.");

				return 0;
			}
		}
		// If using RTC as time source
		else
		{
		  if(bRTOS_En)
			{
				osRes = osMutexWait(mutex_ttnow_user, S_2_mS(10));
			
				if(osRes != osOK)
					return 0;
			}
			
			// Get current time in Binary format
			if(HAL_RTC_GetTime(&hrtc, &rtcTime, RTC_FORMAT_BIN) != HAL_OK)
			{
				RTOSprintf("\r\n> Get system time ERROR.");
				
				if(bRTOS_En)
		          osMutexRelease(mutex_ttnow_user);

				return 0;
			}

			// Get current date in Binary format
			if(HAL_RTC_GetDate(&hrtc, &rtcDate, RTC_FORMAT_BIN) != HAL_OK)
			{
				RTOSprintf("\r\n> Get system date ERROR.");
				
				if(bRTOS_En)
		          osMutexRelease(mutex_ttnow_user);

				return 0;
			}
			
			if(bRTOS_En)
		    osMutexRelease(mutex_ttnow_user);
		}

		// Year in tm struct is counted from 1900
		tmRTCTimeInfo.tm_year	= rtcDate.Year + 2000 - 1900U;
		// Month in tm struct is counted from 0 corresponding to Jan
		tmRTCTimeInfo.tm_mon	= rtcDate.Month - 1U;
		tmRTCTimeInfo.tm_mday	= rtcDate.Date;
		tmRTCTimeInfo.tm_hour	= rtcTime.Hours;
		tmRTCTimeInfo.tm_min	= rtcTime.Minutes;
		tmRTCTimeInfo.tm_sec	= rtcTime.Seconds;
		tmRTCTimeInfo.tm_isdst = -1;

		ttTimeNow = mktime(&tmRTCTimeInfo);
	}

	return ttTimeNow;
}

//============================================================================//
// @brief  Put the system into standby mode.
// @param  None.
// @retval None.
//============================================================================//
void System_EnterStandbyMode(void)
{
	__HAL_RCC_PWR_CLK_ENABLE();

	// If Standby flag is set
	if(__HAL_PWR_GET_FLAG(PWR_FLAG_SB) != RESET)
	{
		// Clear Standby flag
		__HAL_PWR_CLEAR_FLAG(PWR_FLAG_SB);
	}

	// If Reset flag is set
	if(__HAL_RCC_GET_FLAG(RCC_FLAG_LPWRRST))
	{
		// Clear Reset flag
		__HAL_RCC_CLEAR_RESET_FLAGS();
	}

	// Disable all used wakeup sources: Pin1(PA.0)
	HAL_PWR_DisableWakeUpPin(PWR_WAKEUP_PIN1);

	// Clear all related wakeup flags
	__HAL_PWR_CLEAR_FLAG(PWR_FLAG_WU);

	// Re-enable all used wakeup sources: Pin1(PA.0)
	HAL_PWR_EnableWakeUpPin(PWR_WAKEUP_PIN1);

	if(bSysInitFinish)
		RTOSprintf("\r\n### ENTER STANDBY MODE ###");

	// Enter standby mode
	HAL_PWR_EnterSTANDBYMode();
}

//============================================================================//
// @brief  Save system setting into exflash.
// @param  None.
// @retval TRUE: Operation is successful.
//         FALSE: Operation is failed.
//============================================================================//
bool System_SaveSetting(void)
{
	const uint32_t u32Addr = B32_EXFLASH_G_SETTING_START_ADDR;
	uint16_t u16SectEraseNum = 0;
	MX25L_StatusTypeDef mxlRes;
	uint8_t u8BCDTime[7] = {0};
  uint32_t u32TimeDat;
	

	//RTOSprintf("\r\n> ### System_SaveSetting ###");
	
	u32TimeDat = System_GetTime();
	
	SecToBCDTime(u32TimeDat, u8BCDTime);

	// Gary Test
	//RTOSprintf("\r\n> ### MX25L_SAVE_ORG ###\r\n");
	//for(i=0; i<sizeof(gSettingTypeDef); i++) {
	//	RTOSprintf("0x%02X ", (uint8_t)pu32DatPtr[i]);
	//}

	u16SectEraseNum = sizeof(gSettingTypeDef) / MX25L_SECTOR_SIZE;

	if((sizeof(gSettingTypeDef) % MX25L_SECTOR_SIZE) > 0)
		u16SectEraseNum++;
	
	//RTOSprintf("\r\n> Number of sectors erased:%d", u16SectEraseNum);

	if(bRTOS_En)
	{
		osStatus osRes;


		osRes = osMutexWait(mutex_setting_user, S_2_mS(5));

		if(osRes != osOK)
			return FALSE;
	}

	mxlRes = MX25L_MultiSectorsErase((u32Addr / MX25L_SECTOR_SIZE),
	                                 u16SectEraseNum);
	
	//RTOSprintf("\r\n> Save g_Setting start sector:%d, number of sector erased:%d", u32Addr / MX25L_SECTOR_SIZE, u16SectEraseNum);

	if(mxlRes != MX25L_OK)
	{
		if(bRTOS_En)
			osMutexRelease(mutex_setting_user);

		RTOSprintf("\r\n> Save system setting data fail with erase ERROR:%d.", mxlRes);

		return FALSE;
	}
	
	memset(&(pg_Setting_Buf.u8SetVer), 0xFF, sizeof(gSettingTypeDef));

	memcpy(&(pg_Setting_Buf.u8SetVer), &(g_Setting.u8SetVer), sizeof(gSettingTypeDef));

	mxlRes = MX25L_MultiPagesProgram((u32Addr / MX25L_PAGE_SIZE),
	                                 &(pg_Setting_Buf.u8SetVer), sizeof(gSettingTypeDef));

	if(mxlRes != MX25L_OK)
	{
		if(bRTOS_En)
			osMutexRelease(mutex_setting_user);

		RTOSprintf("\r\n> Save system setting data return MX25L ERROR:%d.", mxlRes);

		return FALSE;
	}

	if(bSystemTimeReady == TRUE)
	{
		RTOSprintf("\r\n> ### %02X%02X/%02X/%02X %02X:%02X:%02X SYSTEM SAVE SETTING OK ###",
							 u8BCDTime[0],
							 u8BCDTime[1],
							 u8BCDTime[2],
							 u8BCDTime[3],
							 u8BCDTime[4],
							 u8BCDTime[5],
							 u8BCDTime[6]);
	}
	else
	{
	  RTOSprintf("\r\n> ### SYSTEM SAVE SETTING OK ###");
	}

	if(bRTOS_En)
		osMutexRelease(mutex_setting_user);
	
	System_CheckSetting();
	
	return TRUE;
}

//============================================================================//
// @brief  Read system setting from exflash.
// @param  None.
// @retval TRUE: Operation is successful.
//         FALSE: Operation is failed.
//============================================================================//
bool System_GetSetting(void)
{
	bool bRes = FALSE;
	const uint32_t u32Addr = B32_EXFLASH_G_SETTING_START_ADDR;
	MX25L_StatusTypeDef mxlRes;


	if(bRTOS_En)
	{
		osStatus osRes;


		osRes = osMutexWait(mutex_setting_user, S_2_mS(5));

		if(osRes != osOK)
			return FALSE;
	}

	mxlRes = MX25L_MultiBytesRead((uint32_t)u32Addr, (uint8_t *)&(pg_Setting_Buf.u8SetVer), sizeof(gSettingTypeDef));

	if(mxlRes != MX25L_OK)
	{
		if(bRTOS_En)
			osMutexRelease(mutex_setting_user);

		RTOSprintf("\r\n> Get system setting data return MX25L ERROR:%d.", mxlRes);

		return FALSE;
	}

	if((pg_Setting_Buf.u8SetVer == SETUP_VERSION) && (pg_Setting_Buf.u8SetVerChk == NOT_SETUP_VERSION))
	{
		memcpy(&(g_Setting.u8SetVer), &(pg_Setting_Buf.u8SetVer), sizeof(gSettingTypeDef));

		bRes = TRUE;
	}
	else 
	{
		uint8_t *pu8Ptr;
		
		
		if(pg_Setting_Buf.u8SetVer != SETUP_VERSION)
		{
			RTOSprintf("\r\n> Setup version not correct of %d. System setting not restored.", pg_Setting_Buf.u8SetVer);
		}
		
		if(pg_Setting_Buf.u8SetVerChk != NOT_SETUP_VERSION)
		{
			RTOSprintf("\r\n> Reverse setup version not correct of %d. System setting not restored.", pg_Setting_Buf.u8SetVerChk);
		}
		
		pu8Ptr = &(pg_Setting_Buf.u8SetVer);
		
		RTOSprintf("\r\n gSetting ERROR data:");
		
		for(int i = 0; i < sizeof(gSettingTypeDef); i++)
		{
		  RTOSprintf("(%d)0x%02X", i, *pu8Ptr++);
		}
  }

	if(bRTOS_En)
		osMutexRelease(mutex_setting_user);
	
	if(bRes == TRUE)
	{
	  RTOSprintf("\r\n> ### SYSTEM GET SETTING OK.");
  }
	
	return bRes;
}

//============================================================================//
// @brief  Check g_Setting header code.
// @param  None.
// @retval TRUE: g_Setting data is OK.
//         FALSE: g_Setting data is ERROR.
//============================================================================//
bool System_CheckSetting(void)
{
  bool bRes = FALSE;
	const uint32_t u32Addr = B32_EXFLASH_G_SETTING_START_ADDR;
	MX25L_StatusTypeDef mxlRes;
	uint8_t u8CheckData[2];
	
	
	if(bRTOS_En)
	{
		osStatus osRes;


		osRes = osMutexWait(mutex_setting_user, S_2_mS(5));

		if(osRes != osOK)
			return FALSE;
	}
	
	mxlRes = MX25L_MultiBytesRead((uint32_t)u32Addr, u8CheckData, 2);

	if(mxlRes != MX25L_OK)
	{
		if(bRTOS_En)
			osMutexRelease(mutex_setting_user);

		RTOSprintf("\r\n> Get system setting check code return MX25L ERROR:%d.", mxlRes);

		return FALSE;
	}
	
	if((u8CheckData[0] == SETUP_VERSION) && (u8CheckData[1] == NOT_SETUP_VERSION))
	{
	  bRes = TRUE;
	}
	else 
	{
		RTOSprintf("\r\n> Check system setting version code ERROR of 0x%02X and 0x%02X", u8CheckData[0], u8CheckData[1]);
		
		System_GetSetting();
		
		System_SetupDefault();
  }
	
	if(bRTOS_En)
		osMutexRelease(mutex_setting_user);
	
	return bRes;
}

//============================================================================//
// @brief  Save setup information to a file in SD card.
// @param  None.
// @retval TRUE: If operation successful.
//         FALSE: If operation fail.
//============================================================================//
void System_SaveSetupData(void)
{
	SD_WriteBuffToFile(FILENAME_SETUP_SYS, (uint8_t*)&g_Setting,
	                   sizeof(gSettingTypeDef));

	SD_WriteBuffToFile(FILENAME_SETUP1_SYS, (uint8_t*)&g_Setting,
	                   sizeof(gSettingTypeDef));
}

//============================================================================//
// @brief  Stop all main functions of the system.
// @param  None.
// @retval None.
//============================================================================//
void System_Stop(void)
{
	osTimerStop(timerRTOS_GSM_BlockHandle);
	osTimerStop(timerRTOS_GSM_NonBlockHandle);
	osTimerStop(timerRTOS_EXTIHandle);
	osTimerStop(timerRTOS_PCTransHandle);
	
	RTOSprintf("\r\n> System STOP!");
	
  bSystemStop = TRUE;
}

//============================================================================//
// @brief  Erase setup storage section in flash.
// @param  None.
// @retval TRUE: if operation successful.
//         FALSE: if operation fail.
//============================================================================//
bool SystemFLASH_Erase(void)
{
	HAL_StatusTypeDef halRes;
	FLASH_EraseInitTypeDef halFlashEraseInstance;
	uint32_t u32EraseError = 0;


	#if HW_MCU == HW_STM32F205
	halFlashEraseInstance.TypeErase = TYPEERASE_SECTORS;
	halFlashEraseInstance.VoltageRange = VOLTAGE_RANGE_3;
	halFlashEraseInstance.Sector = FLASH_SECTOR_11;
	halFlashEraseInstance.NbSectors = 1;
	#endif

	HAL_FLASH_Unlock();

	__HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_EOP | FLASH_FLAG_OPERR |
	                       FLASH_FLAG_WRPERR | FLASH_FLAG_PGAERR |
	                       FLASH_FLAG_PGPERR | FLASH_FLAG_PGSERR);

	halRes = HAL_FLASHEx_Erase(&halFlashEraseInstance, &u32EraseError);

	if(halRes != HAL_OK)
	{
		#if ENABLE_DEBUG_MSG
		RTOSprintf("\r\n> Flash erase error at sector %d with error code %d.", u32EraseError, halRes);
		#endif

		RTOSprintf("\r\n> Flash erase error at sector %d with error code %d.", u32EraseError, halRes);

		HAL_FLASH_Lock();

		return FALSE;
	}

	HAL_FLASH_Lock();

	return TRUE;
}

