// @retval TRUE/ FALSE.
//============================================================================//
bool DriverResponseTimeoutEvent_Proc(void)
{
	// 觸發事件 : 定時回報警報啟動
	//GSM_TCP_ReportEvent(FPTC_EVENT_710, STR_EVENT_MSG);

	return TRUE;
